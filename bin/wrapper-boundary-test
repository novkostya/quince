#!/bin/sh
# wrapper-boundary-test — a BOUNDARY refusal must outrank an ENVIRONMENT refusal (quince#157).
#
# WHY THIS EXISTS. `bin/gh-review` and `bin/gh-arch` both refuse to run on a box that holds the
# implementer identity: one box that can author and approve dissolves `approver ≠ author`, which
# is the property the whole two-seat design is built on. Both also refuse when their dependencies
# are missing. Until 2026-07-29 the dependency check came FIRST, and on the implementer host — a bot
# token present, no `openssl` — the message that actually spoke was:
#
#     gh-review: openssl is not installed
#
# THE PROBLEM IS NOT THAT THE MESSAGE IS LESS USEFUL. It invites the WRONG REPAIR. A session told a
# package is missing installs it, meets the App-key check next, places a key to satisfy that, and
# has now put the reviewer credential on the authoring host — defeating `approver ≠ author` by doing
# exactly what the error told it to do. The environment refusal is an instruction to change the
# environment; the boundary refusal is an instruction to stop.
#
# So the rule this suite pins is one sentence: **an environment can be fixed and a boundary must
# not be, so the boundary speaks first.**
#
# WHAT IT DRIVES, and why a reading of the source would not do. Ordering is the property, and
# ordering is invisible to any check that inspects the two blocks separately — both are present and
# both are correct in isolation, which is exactly why this shipped. The only way to see it is to
# construct the state where both refusals are live and observe WHICH ONE SPEAKS. That needs a PATH
# with the tools removed and a bot token in place, which is what the stub below builds.
#
# THE NEGATIVE CONTROL IS HALF THE SUITE. A wrapper that had its dependency check deleted would pass
# every assertion about the boundary winning. So the same stub PATH is driven WITHOUT a bot token,
# and the dependency refusal must then speak — proving the reorder moved the check rather than
# removing it.
#
# THE IMPLEMENTER IDENTITY IS TWO FILES, AND THE SUITE ONCE KNEW ONLY ONE (quince#204). Every
# assertion here named a BOT TOKEN, because that is what the implementer identity was when the suite
# was written. `decisions/0014` moved it to an App key, and for a day both approving wrappers would
# have reported the separation intact on a box holding `quince-coder.pem` — with a green suite
# behind them, because the suite was asking about a credential that no longer carried the identity.
# Parts 4-6 below drive the App key, so this file now covers BOTH forms of the thing it exists to
# refuse. It is quince#103's rule in a second place: *checking one direction of a two-directional
# property is not a check* — the coder side was complete (parts 7-10) while the approving side was
# not, and a suite that thorough in one direction reads as thorough in both.
#
# Synthetic and hermetic: a temp HOME, a temp token file, a stub PATH. Never reads or writes the
# real ~/.config/quince, and never runs `gh`.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM

# A PATH holding only the shell utilities the wrappers need before their own checks — deliberately
# WITHOUT gh, openssl, curl or jq, so the dependency refusal is live. `env` and `sh` come from the
# real PATH via absolute invocation, so nothing here depends on what the host has installed.
STUB="$WORK/bin"
mkdir -p "$STUB"
# `dirname` IS LOAD-BEARING and its absence made a whole section of this suite vacuous. `git-coder`
# resolves its own directory on its second line, so without `dirname` it died there, exited 1,
# printed nothing — and the assertions about the credential helper refusing correctly passed on
# that, having never reached the helper. Breaking the guard AND removing `set -e` changed nothing,
# which is how it was caught: a test that cannot be made to fail is not testing.
for t in cat printf awk id sed grep dirname; do
	if p=$(command -v "$t" 2>/dev/null); then ln -sf "$p" "$STUB/$t"; fi
done

TOKEN="$WORK/bot.token"
RKEY="$WORK/review.pem"
ATOK="$WORK/arch.token"
CKEY="$WORK/coder.pem"

run() {
	# $1 wrapper, rest: argv. Runs with the stub PATH and credential paths we control. EVERY
	# credential location is overridden, not just the one a given case is about: a wrapper that
	# consulted a real path under the invoking user's home would make this suite's result depend on
	# the box it ran on, which is the property it exists to remove.
	#
	# QUINCE_CODER_KEY_FILE is in that list for the same reason and not as an afterthought: without
	# it, the parts below would be probing whatever the invoking user's real ~/.config/quince holds —
	# which on the implementer box is a live signing key, and on the arch box is nothing. A suite that
	# passes on one seat and fails on the other is worse than no suite, because the failure reads as a
	# finding.
	_w=$1
	shift
	PATH="$STUB" HOME="$WORK" \
		QUINCE_BOT_TOKEN_FILE="$TOKEN" \
		QUINCE_REVIEW_KEY_FILE="$RKEY" \
		QUINCE_ARCH_TOKEN_FILE="$ATOK" \
		QUINCE_CODER_KEY_FILE="$CKEY" \
		"$PWD/$_w" "$@" 2>&1 || true
}

# --- 1. BOUNDARY WINS: a bot token present AND the dependencies absent ------------------------
printf 'a bot token\n' >"$TOKEN"
for w in bin/gh-review bin/gh-arch; do
	out=$(run "$w" pr view 1)
	case "$out" in
	*"BOT TOKEN is present"*)
		ok "$w: the boundary refusal speaks first, with the dependencies also missing"
		;;
	*"is not installed"*)
		bad "$w: an ENVIRONMENT refusal outranked the boundary — the wrong repair is the one it invites"
		printf '       %s\n' "$out" | head -n 1
		;;
	*)
		# Never score an unrecognised outcome green: that is how a check stops being one.
		bad "$w: inconclusive — neither refusal recognised in the output"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done

# --- 2. NEGATIVE CONTROL: no implementer credential, dependencies still absent -----------------
# Without this, deleting the dependency check entirely would pass part 1. BOTH implementer
# credentials are removed, not just the bot token — with the App key check now in these wrappers,
# clearing only one would leave the boundary live and this control would prove nothing.
rm -f "$TOKEN" "$CKEY"
for w in bin/gh-review bin/gh-arch; do
	out=$(run "$w" pr view 1)
	case "$out" in
	*"is not installed"*)
		ok "$w: with no bot token, the dependency refusal still speaks — the check was moved, not removed"
		;;
	*"BOT TOKEN is present"*)
		bad "$w: claimed a bot token that is not there"
		;;
	*)
		bad "$w: no dependency refusal — the check may have been removed rather than reordered"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done

# --- 3. The boundary is the FIRST thing either wrapper does with a token present ---------------
# Part 1 proves it beats the dependency check. This proves it also beats the usage/arity path, which
# is the other refusal that could plausibly be reached first — `gh-review` exits 2 on no arguments,
# and a box that is holding the wrong identity should be told THAT rather than how to call the tool.
printf 'a bot token\n' >"$TOKEN"
for w in bin/gh-review bin/gh-arch; do
	out=$(run "$w")
	case "$out" in
	*"BOT TOKEN is present"*)
		ok "$w: the boundary refusal outranks the usage message too"
		;;
	*)
		bad "$w: with no arguments and a bot token present, the boundary did not speak"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done

# --- 4. THE OTHER FORM OF THE IMPLEMENTER IDENTITY: an App key (quince#204) --------------------
# Parts 1-3 drive a BOT TOKEN, which is what the implementer identity was until `decisions/0014`
# moved it to a GitHub App. The wrappers' assertion is "the implementer identity is absent"; the
# bot-token check is one MECHANISM for it, and a rule that names one mechanism goes quietly false the
# moment the mechanism changes. Concretely and true on `main` until this commit: an architect box
# holding `quince-coder.pem` could author with gh-coder, approve with gh-review, and nothing anywhere
# refused.
#
# Same construction as part 1 — the boundary must beat the live dependency refusal — because the
# failure mode is identical and, on the box where it bites, so is the wrong repair.
rm -f "$TOKEN" "$CKEY"
printf 'an implementer app key\n' >"$CKEY"
for w in bin/gh-review bin/gh-arch; do
	out=$(run "$w" pr view 1)
	case "$out" in
	*"IMPLEMENTER APP KEY is present"*)
		ok "$w: refuses beside the implementer App key, ahead of the missing dependencies"
		;;
	*"is not installed"*)
		bad "$w: an ENVIRONMENT refusal outranked the App-key boundary — the wrong repair is the one it invites"
		printf '       %s\n' "$out" | head -n 1
		;;
	*)
		bad "$w: the App key is the implementer identity and this box can approve — nothing refused"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done

# --- 5. The App-key boundary outranks the usage message too ------------------------------------
# Part 3's assertion, for the second credential. `gh-review` exits 2 on no arguments, and a box
# holding the wrong identity should be told THAT rather than how to call the tool.
for w in bin/gh-review bin/gh-arch; do
	out=$(run "$w")
	case "$out" in
	*"IMPLEMENTER APP KEY is present"*)
		ok "$w: the App-key boundary refusal outranks the usage message too"
		;;
	*)
		bad "$w: with no arguments and an App key present, the boundary did not speak"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done

# --- 6. BOTH implementer credentials at once — the LIVE one is named ---------------------------
# `decisions/0014` condition 1 keeps the suspended bot token in place wherever it lives, so a box
# holding both is a state that exists rather than a contrived one. Both are the implementer identity,
# so either alone is a refusal (parts 1 and 4) — what this pins is WHICH FILE THE MESSAGE NAMES.
# Naming the legacy credential first would send a session to delete the suspended token, watch the
# refusal persist, and conclude the guard is broken. Asserted because both wrappers now claim in a
# comment that the App key is checked first, and an ordering claim nothing drives is a comment.
printf 'a suspended bot token\n' >"$TOKEN"
for w in bin/gh-review bin/gh-arch; do
	out=$(run "$w" pr view 1)
	case "$out" in
	*"IMPLEMENTER APP KEY is present"*)
		ok "$w: with both present, the refusal names the LIVE credential"
		;;
	*"BOT TOKEN is present"*)
		bad "$w: named the suspended bot token while a live App key sat beside it — removing it would not clear the refusal"
		;;
	*)
		bad "$w: with both implementer credentials present, no boundary refusal spoke"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done

# --- 7. gh-coder: THE SAME PROPERTY, ASSERTED FROM THE THIRD CORNER --------------------------
# `gh-review` and `gh-arch` refuse when the IMPLEMENTER identity is present. `gh-coder` IS the
# implementer, so the credentials it must refuse to sit beside are the APPROVING ones. Both
# directions are driven, because a wrapper that refused only one of them would pass a test written
# only for the other, and the box that would then hold two identities is the authoring box.
rm -f "$TOKEN" "$RKEY" "$ATOK" "$CKEY"
printf 'a reviewer key\n' >"$RKEY"
out=$(run bin/gh-coder pr view 1)
case "$out" in
*"REVIEWER APP KEY is present"*)
	ok "bin/gh-coder: refuses beside the reviewer key, ahead of the missing dependencies"
	;;
*"is not installed"*)
	bad "bin/gh-coder: an ENVIRONMENT refusal outranked the boundary — the wrong repair is the one it invites"
	;;
*)
	bad "bin/gh-coder: inconclusive — no boundary refusal for a reviewer key on the authoring box"
	printf '       %s\n' "$out" | head -n 2
	;;
esac

rm -f "$RKEY"
printf 'an architect token\n' >"$ATOK"
out=$(run bin/gh-coder pr view 1)
case "$out" in
*"ARCHITECT CREDENTIAL is present"*)
	ok "bin/gh-coder: refuses beside the architect credential — author-and-merge is the same defect"
	;;
*"is not installed"*)
	bad "bin/gh-coder: the dependency refusal outranked the architect boundary"
	;;
*)
	bad "bin/gh-coder: inconclusive — no boundary refusal for an architect credential"
	printf '       %s\n' "$out" | head -n 2
	;;
esac

# --- 8. THE DELIBERATE NON-REFUSAL, which is a rule too --------------------------------------
# A suspended `quince-bot` token may sit beside the coder key, and `decisions/0014` REQUIRES that it
# be left in place — condition 1 is that nothing is tidied away, because the intact record is what
# makes the good-faith claim checkable. Both are the implementer identity, so together they cross no
# boundary. Pinned as an assertion because the three refusals above make "another credential file is
# present" look like the banned thing, and a reader deleting the bot token to satisfy a rule that
# does not exist would destroy the record the decision rests on.
rm -f "$RKEY" "$ATOK"
printf 'a suspended bot token\n' >"$TOKEN"
out=$(run bin/gh-coder pr view 1)
case "$out" in
*"is not installed"*)
	ok "bin/gh-coder: a bot token beside it is NOT a boundary breach — the dependency refusal speaks"
	;;
*"is present"*)
	bad "bin/gh-coder: refused because of a bot token — both are the implementer identity, and 0014 requires it be kept"
	printf '       %s\n' "$out" | head -n 1
	;;
*)
	bad "bin/gh-coder: inconclusive — expected the dependency refusal with only a bot token present"
	printf '       %s\n' "$out" | head -n 2
	;;
esac

# --- 9. The boundary outranks the usage message for gh-coder too -----------------------------
rm -f "$TOKEN"
printf 'a reviewer key\n' >"$RKEY"
out=$(run bin/gh-coder)
case "$out" in
*"REVIEWER APP KEY is present"*)
	ok "bin/gh-coder: the boundary refusal outranks the usage message too"
	;;
*)
	bad "bin/gh-coder: with no arguments and a reviewer key present, the boundary did not speak"
	printf '       %s\n' "$out" | head -n 2
	;;
esac

# --- 10. git-coder's CREDENTIAL HELPER must fail loudly, not quietly offer an empty password -----
# The defect this pins (quince#198 review): `password=$(gh-coder auth token)` with a FAILING
# substitution still printed a syntactically valid credential with an empty password. git accepted
# it, tried to authenticate, failed, and reported `authentication failed` — while the boundary
# refusal naming the offending file went to stderr and lost the race with git's own output. The
# helper exited 0 while doing it.
#
# "I refused" and "I tried and failed" must not be the same observable (quince#41). And this is the
# path where it matters most: a correctly provisioned box never reaches it, so the only box that
# does is the misconfigured one the boundary exists to catch.
#
# DRIVEN DIRECTLY, WHICH IS WHY THE HELPER IS A FLAG. As an inline `!f() { … }` in a `git -c` value
# it could only be exercised by making git authenticate against a real remote — so the one path that
# had to be right was the one path no suite could reach. Offline, no network, no remote, no git.
rm -f "$TOKEN" "$RKEY" "$ATOK" "$CKEY"
printf 'a reviewer key\n' >"$RKEY"
helper_out=$(PATH="$STUB" HOME="$WORK" \
	QUINCE_BOT_TOKEN_FILE="$TOKEN" QUINCE_REVIEW_KEY_FILE="$RKEY" QUINCE_ARCH_TOKEN_FILE="$ATOK" \
	QUINCE_CODER_KEY_FILE="$CKEY" \
	"$PWD/bin/git-coder" --credential-helper get 2>/dev/null) && helper_rc=0 || helper_rc=$?

if [ "$helper_rc" -ne 0 ]; then
	ok "bin/git-coder: the helper FAILS when the boundary refuses, rather than exiting 0"
else
	bad "bin/git-coder: the helper exited 0 while gh-coder refused — git will report the wrong error"
fi
case "$helper_out" in
*password=*)
	bad "bin/git-coder: the helper emitted a password line despite the refusal — git would try it and fail obscurely"
	;;
*)
	ok "bin/git-coder: no credential is emitted on refusal, so git cannot mistake it for one"
	;;
esac

# The negative control: a non-`get` operation is a no-op and must stay silent and successful, or
# every `git push` would break on the store/erase round trip rather than on anything real.
rm -f "$RKEY"
for op in store erase; do
	_o=$(PATH="$STUB" HOME="$WORK" QUINCE_BOT_TOKEN_FILE="$TOKEN" \
		QUINCE_REVIEW_KEY_FILE="$RKEY" QUINCE_ARCH_TOKEN_FILE="$ATOK" \
		QUINCE_CODER_KEY_FILE="$CKEY" \
		"$PWD/bin/git-coder" --credential-helper "$op" 2>/dev/null) && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ] && [ -z "$_o" ]; then
		ok "bin/git-coder: --credential-helper $op is a silent no-op"
	else
		bad "bin/git-coder: --credential-helper $op returned rc=$_rc and output '$_o'"
	fi
done

printf '\nwrapper-boundary-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
