#!/bin/sh
# closing-refs-check-test — the gate's own failure paths, and the four real instances as fixtures.
#
# WHY THIS SUITE EXISTS IN THIS SHAPE. quince#293 shipped this rule as PROSE, and the prose was wrong
# THREE TIMES in the ninety minutes after it was written:
#
#   wrong range     three-dot reported an already-merged commit
#   wrong surfaces  the body was checked and the commit messages were not
#   wrong pattern   it flagged repo-qualified references, which are measured SAFE
#
# Every one was found by RUNNING it; not one by reading it. So each correction is an assertion below,
# and the four field instances are fixtures rather than anecdotes.
#
# EVERY EXAMPLE IN THIS FILE IS BACKTICKED, REPO-QUALIFIED, OR BUILT AT RUNTIME. Instance 3 was a
# commit message that reproduced the trap while documenting it, so a suite about the trap is exactly
# the file most likely to become instance 5. The bare forms are assembled with `printf` into temp
# files and never written literally here.
set -eu

cd "$(dirname "$0")/.."
CHECK="${CLOSING_REFS_BIN:-$PWD/bin/closing-refs-check}"
[ -x "$CHECK" ] || {
	printf 'closing-refs-check-test: %s is not executable\n' "$CHECK" >&2
	exit 2
}

pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM

# `$1` name, `$2` expected exit, `$3` expected substring (may be empty), rest: argv.
expect() {
	_n=$1 _want=$2 _sub=$3
	shift 3
	_out=$("$@" 2>&1) && _got=0 || _got=$?
	if [ "$_got" -ne "$_want" ]; then
		bad "$_n — wanted exit $_want, got $_got"
		printf '%s\n' "$_out" | sed 's/^/    | /'
		return 0
	fi
	if [ -n "$_sub" ] && ! printf '%s\n' "$_out" | grep -qF "$_sub"; then
		bad "$_n — exit $_got was right, output lacked: $_sub"
		printf '%s\n' "$_out" | sed 's/^/    | /'
		return 0
	fi
	ok "$_n (exit $_got)"
}

# --- 1. THE FOUR INSTANCES, as fixtures ------------------------------------------------------
# Assembled rather than written, so this file never contains a live one. `H` is the hash character.
H='#'
# The backtick is assembled too, for the same reason as the hash and to keep shellcheck honest:
# a literal one inside single quotes reads as an unexpanded command substitution (SC2016), and
# suppressing that warning across a file whose whole subject is literal text is the wrong trade.
TICK=$(printf '\140')
FENCE=$(printf '\140\140\140')

# Instance 1 and 2: a body DISCLAIMING the close. The parser is not negation-aware, so the disclaimer
# is itself the link — and both instances were exactly this sentence.
printf 'Implements the thing. Does not close %s282 — item 1 remains.\n' "$H" >"$WORK/disclaimer.md"
expect "a DISCLAIMED bare reference is still a closing reference" 1 "CLOSING REFERENCE" \
	"$CHECK" --text "$WORK/disclaimer.md"

# Instance 3: the same text inside a COMMIT MESSAGE, which `closingIssuesReferences` never sees.
REPO="$WORK/repo"
mkdir -p "$REPO"
git -C "$REPO" init -q -b main
git -C "$REPO" config user.email fixture@example.invalid
git -C "$REPO" config user.name fixture
echo one >"$REPO/a"
git -C "$REPO" add -A
git -C "$REPO" commit -qm "baseline"
git -C "$REPO" checkout -q -b topic
echo two >>"$REPO/a"
git -C "$REPO" add -A
git -C "$REPO" commit -qm "$(printf 'review fix: drop the phrasing\n\nThe body said Does not close %s282 - the sentence diagnosed earlier.\n' "$H")"
expect "a bare reference in a COMMIT MESSAGE is found" 1 "commit message" \
	sh -c "cd '$REPO' && '$CHECK' --ref main..topic"

# --- 2. THE THREE CORRECTIONS THE PROSE NEEDED -----------------------------------------------

# Correction 1: THREE-DOT would report the already-merged commit. Here `main` carries a bare
# reference the topic branch does not, so a symmetric-difference range finds it and a two-dot one
# does not. Obeying the caller would make the gate cry wolf on somebody else's merged work.
MREPO="$WORK/merged"
mkdir -p "$MREPO"
git -C "$MREPO" init -q -b main
git -C "$MREPO" config user.email fixture@example.invalid
git -C "$MREPO" config user.name fixture
echo base >"$MREPO/a"
git -C "$MREPO" add -A
git -C "$MREPO" commit -qm baseline
git -C "$MREPO" checkout -q -b topic
echo t >>"$MREPO/a"
git -C "$MREPO" add -A
git -C "$MREPO" commit -qm "topic work, nothing to see"
git -C "$MREPO" checkout -q main
echo m >>"$MREPO/b"
git -C "$MREPO" add -A
git -C "$MREPO" commit -qm "$(printf 'someone elses merged work, closes %s999\n' "$H")"
expect "a three-dot range is NORMALISED, not obeyed" 0 "normalised to" \
	sh -c "cd '$MREPO' && '$CHECK' --ref main...topic"
expect "...and the merged commit is NOT reported" 0 "clean" \
	sh -c "cd '$MREPO' && '$CHECK' --ref main...topic"

# Correction 2: BOTH surfaces. A body that is safe and a message that is not must still fail — this
# is quince#291 exactly, where the API field read empty and the issue closed anyway.
printf 'Fixes quince%s290. Qualified, so the body links nothing.\n' "$H" >"$WORK/safebody.md"
expect "a safe BODY does not excuse an unsafe commit message" 1 "commit message" \
	sh -c "cd '$REPO' && '$CHECK' --ref main..topic --text '$WORK/safebody.md'"

# Correction 3: repo-qualified references are SAFE and must not be flagged. Without this the gate
# fires on ordinary citations and becomes wallpaper.
printf 'Refs quince%s282, and quince%s291 closed quince%s290 on merge.\n' "$H" "$H" "$H" >"$WORK/qualified.md"
expect "repo-qualified references are not flagged" 0 "clean" \
	"$CHECK" --text "$WORK/qualified.md"
# The control: the SAME sentence with a bare reference must fail, or assertion above proves only that
# the gate is silent rather than that it discriminates.
printf 'Refs quince%s282, and this closes %s290 on merge.\n' "$H" "$H" >"$WORK/mixed.md"
expect "...but a bare one in the same sentence IS flagged (the control)" 1 "CLOSING REFERENCE" \
	"$CHECK" --text "$WORK/mixed.md"

# --- 2b. THE GATE MUST ACCEPT THE REMEDIATION IT PRINTS (quince#294 review) -------------------
#
# The first version advised "backtick it" and then flagged backticked text — advice the tool refuses.
# Worse than either half alone, and it contradicted this gate's own measured table. Every PR that
# discusses this trap quotes it, and `/report` tells authors to backtick when they do, so the gate
# would have fired on every correctly-written one.
printf 'see %sclose %s282%s for the trap\n' "$TICK" "$H" "$TICK" >"$WORK/inline.md"
expect "a backticked reference is NOT flagged — the advice the gate prints" 0 "clean" \
	"$CHECK" --text "$WORK/inline.md"
printf 'prose here\n\n%s\nclose %s283\n%s\n\nmore prose\n' "$FENCE" "$H" "$FENCE" >"$WORK/fenced.md"
expect "a FENCED reference is not flagged either" 0 "clean" \
	"$CHECK" --text "$WORK/fenced.md"
# THE CONTROL, and it is what stops the strip becoming a blanket amnesty: a bare reference on a line
# OUTSIDE any code must still fail, in the same file as the safe ones.
printf 'see %sclose %s282%s inline\n\n%s\nclose %s283\n%s\n\nand a bare close %s284 here\n' \
	"$TICK" "$H" "$TICK" "$FENCE" "$H" "$FENCE" "$H" >"$WORK/mixed.md"
expect "...but a BARE one in the same file still fails (the control)" 1 "284" \
	"$CHECK" --text "$WORK/mixed.md"
# And the reported LINE NUMBER must survive the stripping — blanked, not deleted — or the reader is
# sent to the wrong line and stops trusting the output.
_mixed_out=$("$CHECK" --text "$WORK/mixed.md" 2>&1 || true)
if printf '%s\n' "$_mixed_out" | grep -q '    7:'; then
	ok "the reported line number survives the code stripping"
else
	bad "the line number is wrong after stripping — blanking must preserve line count"
	printf '%s\n' "$_mixed_out" | sed 's/^/    | /'
fi
# COMMIT MESSAGES ARE DELIBERATELY NOT STRIPPED. The backtick measurement was taken on a PR body,
# which GitHub renders as markdown; whether the auto-close parser honours backticks in a RAW commit
# message is unmeasured, so that surface over-fires on purpose. This pins the asymmetry so nobody
# "makes it consistent" without taking the measurement first.
git -C "$REPO" checkout -q -b ticked
echo three >>"$REPO/a"
git -C "$REPO" add -A
git -C "$REPO" commit -qm "$(printf 'note the trap\n\nsee %sclose %s777%s in the body\n' "$TICK" "$H" "$TICK")"
expect "a backticked reference in a COMMIT MESSAGE still fires (unmeasured, so conservative)" 1 "commit message" \
	sh -c "cd '$REPO' && '$CHECK' --ref main..ticked"
git -C "$REPO" checkout -q topic

# --- 3. IT CANNOT REPORT CLEAN OVER NOTHING (the quince#41 contract) --------------------------
expect "no arguments refuses rather than reporting clean" 2 "nothing to scan" "$CHECK"
expect "an unknown argument refuses" 2 "unknown argument" "$CHECK" --nope
: >"$WORK/empty.md"
expect "an EMPTY text file refuses rather than sweeping nothing" 2 "EMPTY" \
	"$CHECK" --text "$WORK/empty.md"
expect "an unreadable text file refuses" 2 "not readable" \
	"$CHECK" --text "$WORK/does-not-exist.md"
expect "an unusable matcher refuses rather than falling back" 2 "not found" \
	env CLOSING_REFS_GREP=/nonexistent/not-a-grep "$CHECK" --text "$WORK/qualified.md"

# And a clean run SAYS WHAT IT SCANNED — `0` answers "did anything match", only the list answers
# "was anything looked at".
expect "a clean run names the surfaces it scanned" 0 "commit-messages" \
	sh -c "cd '$MREPO' && '$CHECK' --ref main..topic"


# --- THE SECOND DIRECTION: a keyword that binds to NOTHING (quince#315) --------------------------
#
# Measured before this was built: 39 of 98 merged PRs in `quince` carry a bound closing reference
# and 0 of 32 in `quince-devlog` do — and the boundary is sharp. quince#288 (10:00, 2026-07-30) is
# the last to bind; everything from #289 on binds nothing, which is 38 minutes BEFORE this gate
# merged. So the convention did it and the gate locked it in, rather than the gate causing it.
printf 'Closes quince#307.\n' >"$WORK/inert.md"
expect "a repo-shorthand closing line is a finding — it binds to nothing" 1 "BOUND TO NOTHING" \
	./bin/closing-refs-check --text "$WORK/inert.md"

printf 'Closes novkostya/quince#307.\n' >"$WORK/qualified-closing.md"
expect "a FULLY qualified closing line is clean — owner/repo#N binds" 0 "clean" \
	./bin/closing-refs-check --text "$WORK/qualified-closing.md"

# THE CONTROL THAT SHAPED THE IMPLEMENTATION. The first version matched the keyword anywhere on the
# line and flagged this — prose narrating a close that already happened, which binds to nothing and
# is exactly what the author wants. The existing suite caught it. An INERT reference in prose is not
# a defect: unlike a bare one, it does nothing, so there is nothing to warn about.
printf 'Refs quince#282, and quince#291 closed quince#290 on merge.\n' >"$WORK/narration.md"
expect "prose NARRATING a close is not a closing line" 0 "clean" \
	./bin/closing-refs-check --text "$WORK/narration.md"

# The surfaces a closing line really wears in this repository's PR bodies.
printf -- '- Fixes quince-devlog#159\n' >"$WORK/bullet.md"
expect "a bulleted closing line is still a closing line" 1 "BOUND TO NOTHING" \
	./bin/closing-refs-check --text "$WORK/bullet.md"

printf '**Closes quince#12**\n' >"$WORK/bold.md"
expect "a bolded closing line is still a closing line" 1 "BOUND TO NOTHING" \
	./bin/closing-refs-check --text "$WORK/bold.md"

# BOTH DIRECTIONS AT ONCE must exit 1 and name both, because a body can carry one of each and a
# reader who fixes only the loud one has fixed half.
printf 'Closes #307.\nCloses quince#308.\n' >"$WORK/both.md"
expect "a bare AND an inert reference both report" 1 "BOUND TO NOTHING" \
	./bin/closing-refs-check --text "$WORK/both.md"
_both=$(./bin/closing-refs-check --text "$WORK/both.md" 2>&1 || true)
case "$_both" in
*"CLOSING REFERENCE"*) ok "…and the bare one is still named alongside it" ;;
*) bad "the inert finding masked the bare one — a reader would fix half" ;;
esac

printf '\nclosing-refs-check-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
