#!/bin/sh
# gh-wrappers-test — the three gh wrappers must not require $HOME to be set.
#
# WHY THIS EXISTS. All three defaulted their credential path to `${VAR:-$HOME/...}`. The outer
# expansion is guarded, so it reads as safe; the `$HOME` *inside* the default is not, and under
# `set -eu` an unset HOME is fatal. OpenRC gives a service no HOME, so when
# `deploy/runner/preflight` grew an assertion that invokes `bin/gh-review`, the arch box stopped
# starting after a reboot with:
#
#     bin/gh-review: line 19: HOME: parameter not set
#
# which reads as a broken script rather than as a missing environment. It had been latent in
# `gh-bot` since that file was written and was invisible to every test anyone ran, because ssh
# and login both set HOME. **The interactive path and the service path differ, and only the
# service path was broken.** This test pins the service path.
#
# TWO ASSERTIONS, AND THE SECOND IS THE LOAD-BEARING ONE.
#
# 1. Unset HOME must not produce a shell error. Necessary, and NOT sufficient: a wrapper that
#    refuses cleanly also satisfies it, so on a host where the running uid has no /etc/passwd
#    entry — macOS, which resolves users through Directory Services — this passes without ever
#    exercising the path a service takes.
#
# 2. With HOME SET, every credential path must be derived from it. That is deterministic on any
#    host, and it is what proves the wrapper reads the environment rather than a hardcoded path.
#
#    An earlier version of (2) asserted the opposite — that a supplied override should make HOME
#    irrelevant — and it failed against the corrected wrappers, correctly. The wrappers require a
#    resolvable home on purpose: `gh-review` derives the BOT-TOKEN path from it too, and an empty
#    home would make that path `/.config/quince/quince-bot.token`, which cannot exist, so the
#    devlog#7 "this box must not hold the implementer identity" assertion would pass by never
#    being able to fail. Refusing early is the safer trade, and the test was wrong, not the code.
#    Recorded because the first draft of this file shipped a check that could never fire, inside
#    the regression test for exactly that defect class.
#
# Synthetic and hermetic: no credential, no network, no `gh` required.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

for w in gh-bot gh-arch gh-review; do

	# (1) unset HOME must not be a shell error
	out=$(sh -c 'unset HOME; exec "$0" 2>&1' "bin/$w" </dev/null || true)
	case "$out" in
	*"HOME: parameter not set"* | *"HOME: unbound variable"*)
		bad "bin/$w dies on unset HOME — a service cannot run it"
		printf '       %s\n' "$out" | head -n 1
		;;
	*) ok "bin/$w survives unset HOME" ;;
	esac

	# (2) HOME set: every credential path must be derived from it, not hardcoded.
	fake=/tmp/quince-wrappers-test-home
	out=$(sh -c 'HOME="$1"; export HOME; shift; exec "$0" 2>&1' "bin/$w" "$fake" </dev/null || true)
	case "$out" in
	*"$fake/.config/quince/"*)
		ok "bin/$w derives its credential path from HOME"
		;;
	*"cannot locate a home directory"*)
		bad "bin/$w refused despite HOME being set"
		;;
	*)
		# Do not score an unrecognised outcome green — that is how a check stops being one.
		bad "bin/$w: inconclusive, no HOME-derived path in its output"
		printf '       %s\n' "$out" | head -n 2
		;;
	esac
done


printf '\ngh-wrappers-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
