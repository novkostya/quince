#!/bin/sh
# forge-watch-role-test — branch-ownership suppression is ROLE-DEPENDENT (quince#292).
#
# THE DEFECT. `wake_filter` silenced every PR event on the ARCHITECT seat. quince#174 built it so two
# IMPLEMENTER runners on one box would not wake each other, where "another declared runner owns that
# branch" correctly means "not my business" — and on the architect seat it means the opposite, because
# reviewing other runners' branches is the entire job and every implementer PR is on an `r<N>/` branch
# by canon. Measured on that box: four events in, one survived, and the suppressed ones included
# `event=review`.
#
# IT WAS CREATED BY THE FIX FOR THE OPPOSITE BUG. quince#265 found the filter INERT on that seat —
# `other_runner_names` returned empty — and `.claude/seats` populated it (quince#276), which the seat
# PATTERN has since replaced entirely (quince#330). Working, for
# that role, is silence.
#
# WHY A SUITE AND NOT A LOOP FIXTURE. The role comes from WHICH CREDENTIAL IS PRESENT (`owed_role`),
# and the loop-fixture harness has no way to set that. This drives the real `watch` verb with the
# credential paths pointed at temp files, which is the only way to reach all three arms.
#
# THE `none` CASE IS THE ONE THAT MATTERS. `owed_role` has already returned `none` wrongly on a live
# box, undetected across two sessions, when the credentials it knew had been retired (quince#238) —
# and the architect arm survives today only because a legacy PAT happens to remain there, so `none`
# is that box's expected future state. Suppressing on an unidentifiable role would restore the
# deafness through a cleanup nobody connected to the watch.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export QUINCE_SESSION_ID=role-test-session
REPO=novkostya/quince

# NO SEAT LIST TO PROVISION (quince#330). This suite used to write `r1 r4 arch1` into a fixture
# `FORGE_SEATS_FILE`, because `wake_filter` could not attribute a branch whose seat was not in the
# list. A seat is now a PATTERN, so `r1/their-work` is attributable by shape alone and there is
# nothing to set up.
#
# THE OLD PROVISIONING WAS LEFT BEHIND IN THE PR THAT REMOVED THE MECHANISM, and this comment exists
# because that is worse than it sounds: the suite kept writing a file nothing loads and exporting a
# variable nothing reads, and passed 7/7 either way — so no assertion could ever catch it. A reader
# meeting live-looking provisioning concludes the mechanism is live. Found in review.

# A stub whose ONE PR is on ANOTHER seat's branch, and which moves on the second turn. That is the
# whole question: whose business is `r1/their-work` on each seat?
cat >"$WORK/gh" <<'STUB'
#!/bin/sh
case "$1 ${2:-}" in
"issue list") printf '[]\n'; exit 0 ;;
"issue view") printf '{}\n'; exit 0 ;;
esac
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
at=2026-07-30T10:00:00Z
[ "$turn" = 2 ] && at=2026-07-30T11:00:00Z
cat <<ROW | jq -f "$STUB_INVERSE"
[{"number":501,"state":"OPEN","updatedAt":"$at","title":"t","headRefName":"r1/their-work",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}]
ROW
STUB
chmod +x "$WORK/gh"
export STUB_WORK="$WORK"
STUB_INVERSE="$PWD/bin/testdata/forge/gh-array-to-graphql.jq"
export STUB_INVERSE
[ -f "$STUB_INVERSE" ] || {
	printf 'forge-watch-role-test: missing %s — DID NOT RUN\n' "$STUB_INVERSE" >&2
	exit 2
}

# Every credential path is pinned into $WORK, so the suite cannot read this box: without that,
# `owed_role` falls back to the real store and the result depends on which seat runs the suite —
# the trap `preflight-test` documents having been bitten by.
CODER="$WORK/coder.pem"
ARCH="$WORK/arch.token"
BOT="$WORK/bot.token"
REVIEW="$WORK/review.pem"

# `$1` = which credential to place (or none). Returns the watch output for a baseline tick plus a
# tick in which the other seat's PR moves.
run_role() {
	rm -f "$CODER" "$ARCH" "$BOT" "$REVIEW"
	[ "$1" = none ] || printf 'a credential\n' >"$1"
	rm -rf "$WORK/state"
	XDG_STATE_HOME="$WORK/state" QUINCE_CODER_KEY_FILE="$CODER" QUINCE_ARCH_TOKEN_FILE="$ARCH" \
		QUINCE_BOT_TOKEN_FILE="$BOT" QUINCE_REVIEW_KEY_FILE="$REVIEW" \
		./bin/forge-watch runner set r4 >/dev/null 2>&1
	printf '1\n' >"$WORK/turn"
	XDG_STATE_HOME="$WORK/state" QUINCE_CODER_KEY_FILE="$CODER" QUINCE_ARCH_TOKEN_FILE="$ARCH" \
		QUINCE_BOT_TOKEN_FILE="$BOT" QUINCE_REVIEW_KEY_FILE="$REVIEW" \
		./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues \
		--interval 1 --max-wait 3 >/dev/null 2>&1 || true
	# A SECOND declared runner in the registry, so `r1` is genuinely somebody else's rather than
	# unattributable — an unknown prefix wakes everybody and would pass the implementer assertion for
	# the wrong reason.
	printf 'r1\n' >"$WORK/state/quince/runners/another-session"
	printf '2\n' >"$WORK/turn"
	XDG_STATE_HOME="$WORK/state" QUINCE_CODER_KEY_FILE="$CODER" QUINCE_ARCH_TOKEN_FILE="$ARCH" \
		QUINCE_BOT_TOKEN_FILE="$BOT" QUINCE_REVIEW_KEY_FILE="$REVIEW" \
		./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues \
		--interval 1 --max-wait 4 >"$WORK/out" 2>&1 || true
	cat "$WORK/out"
}

# (1) IMPLEMENTER — unchanged, and measured correct on the live box before this change.
_out=$(run_role "$CODER")
if printf '%s\n' "$_out" | grep -q 'watch-idle'; then
	ok "implementer: another runner's PR does NOT wake (quince#174, unchanged)"
else
	bad "implementer: woke on another runner's PR — quince#174's suppression is gone"
	printf '%s\n' "$_out" | grep -E '^event=' | sed 's/^/    | /'
fi

# (2) ARCHITECT — the fix. The same PR, the same branch, the opposite answer, because reviewing
# other runners' branches is what the role IS.
_out=$(run_role "$ARCH")
if printf '%s\n' "$_out" | grep -q 'EXITING on the event'; then
	ok "architect: the same PR DOES wake — reviewing others' branches is the job (quince#292)"
else
	bad "architect: still deaf to another runner's PR"
	printf '%s\n' "$_out" | grep -E '^event=|watch-idle' | sed 's/^/    | /'
fi

# (3) NONE — fails OPEN, and SAYS SO. The case with a measured history of being wrong, and the one
# no box currently produces.
_out=$(run_role none)
if printf '%s\n' "$_out" | grep -q 'EXITING on the event'; then
	ok "unidentifiable role: fails OPEN — the PR wakes"
else
	bad "unidentifiable role: suppressed, so a credential cleanup would restore the deafness silently"
	printf '%s\n' "$_out" | grep -E '^event=|watch-idle' | sed 's/^/    | /'
fi
if printf '%s\n' "$_out" | grep -q 'suppression is DISABLED'; then
	ok "...and says so, rather than degrading silently (CLAUDE.md)"
else
	bad "failed open without reporting it — a silent degraded mode"
	printf '%s\n' "$_out" | sed 's/^/    | /'
fi
# THE CONTROL for (3): a working role must NOT print the degraded-mode note, or the assertion above
# passes on a tool that always prints it and the line means nothing.
_out=$(run_role "$CODER")
if printf '%s\n' "$_out" | grep -q 'suppression is DISABLED'; then
	bad "the degraded-mode note fires on a KNOWN role — it would become wallpaper"
else
	ok "a known role prints no degraded-mode note (the control)"
fi

# (4) THE ARCHITECT SEAT'S *LIVE* CREDENTIAL, which is the App key and not the legacy PAT. This file
# already declared `$REVIEW` and never placed it — (2) proves the architect behaviour using the PAT,
# which is the credential the arch box happens to still hold rather than the one it is identified by.
# So the seat's role rested entirely on a token that `owed_role`'s own comment calls luck, and
# retiring it would have resolved that box to `none` — disarming the `Stop` hook there exactly as
# quince#238 did on the implementer seat, and quietly turning (3)'s fail-open into its steady state.
#
# The assertion is the same as (2) on purpose: same PR, same branch, same answer, different
# credential. If the two ever disagree, one of the two arms has stopped meaning `architect`.
_out=$(run_role "$REVIEW")
if printf '%s\n' "$_out" | grep -q 'EXITING on the event'; then
	ok "the review App key ALONE identifies the architect seat — not only the legacy PAT"
else
	bad "a box holding only the live architect credential does not behave as the architect" \
		"owed_role must branch on QUINCE_REVIEW_KEY_FILE; without it the seat depends on a PAT due for cleanup."
	printf '%s\n' "$_out" | grep -E '^event=|watch-idle|DISABLED' | sed 's/^/    | /'
fi
if printf '%s\n' "$_out" | grep -q 'suppression is DISABLED'; then
	bad "the review key resolved to role=none — the arm is missing or misspelled"
else
	ok "...and does so as a KNOWN role, printing no degraded-mode note"
fi


# (5) `status` MUST SAY WHAT `watch` DOES — quince#1261.
#
# THE DEFECT. `watch` consulted the role; `status` did not, and printed *"their events are printed but
# do NOT wake this watch"* unconditionally. On the architect seat that sentence is false: suppression
# is off, and those events are exactly what the seat is there for.
#
# WHY IT COSTS SOMETHING DESPITE THE WATCH BEING CORRECT. The error is in the REASSURING direction. A
# successor architect reads the note, believes a retired seat's PR cannot wake it, and goes looking
# for a way to adopt that branch into its own watch — work that is unnecessary, because the events
# already wake it. The watch fails open; the REPORT is what misleads, and a reader acts on the report.
#
# THE ASSERTIONS ARE CROSS-CHECKS, NOT STRING TESTS. Each case below compares the sentence `status`
# prints against whether `watch` actually exited on the other runner's event, using the same
# credential and the same state. That is the only form that catches the two drifting apart again —
# asserting the wording alone would have passed happily throughout the bug.
printf '\n(5) status agrees with watch about suppression\n'

status_note() {
	XDG_STATE_HOME="$WORK/state" QUINCE_CODER_KEY_FILE="$CODER" QUINCE_ARCH_TOKEN_FILE="$ARCH" \
		QUINCE_BOT_TOKEN_FILE="$BOT" QUINCE_REVIEW_KEY_FILE="$REVIEW" \
		./bin/forge-watch status --repo "$REPO" 2>&1 |
		grep 'another runner declared on this box' || :
}

# agree asserts the note and the observed wake behaviour say the same thing.
agree() { # <label> <watch-output> <note>
	_lbl=$1 _w=$2 _n=$3
	if printf '%s\n' "$_w" | grep -q 'EXITING on the event'; then _woke=yes; else _woke=no; fi
	case "$_n" in
	*'do NOT wake this watch'*) _claim=no ;;
	*'DO wake this watch'*) _claim=yes ;;
	*) _claim=absent ;;
	esac
	if [ -z "$_n" ]; then
		bad "$_lbl — status printed no note at all, so it claims nothing about a suppression that is real"
	elif [ "$_claim" = "$_woke" ]; then
		ok "$_lbl — status says wake=$_claim and watch woke=$_woke"
	else
		bad "$_lbl — status says wake=$_claim but watch woke=$_woke" \
			"This is the quince#1261 defect: the report describes a mechanism that is not the one running."
		printf '    | %s\n' "$_n"
	fi
}

_out=$(run_role "$CODER")
_note=$(status_note)
agree "implementer" "$_out" "$_note"
case "$_note" in
*'(role implementer)'*) ok "...and names the role it decided on, so the claim is checkable" ;;
*) bad "...and names the role it decided on, so the claim is checkable" ;;
esac

_out=$(run_role "$REVIEW")
_note=$(status_note)
agree "architect" "$_out" "$_note"
case "$_note" in
*'suppression is OFF for role architect'*) ok "...and says WHY, rather than dropping the note and leaving a reader with no answer" ;;
*) bad "...and says WHY, rather than dropping the note and leaving a reader with no answer" ;;
esac

# THE DEGRADED ARM, SURFACED IN THE REPORT AND NOT ONLY AT ARM TIME. `watch` announces `none` when it
# arms; `status` is where a session looks afterwards, so a box that cannot name its role used to say
# nothing about it here. A degraded mode is surfaced, never silent (`CLAUDE.md`).
_out=$(run_role none)
_note=$(status_note)
agree "unidentifiable role" "$_out" "$_note"
case "$_note" in
*'could not determine its role'*) ok "...and status surfaces the degraded mode, not only the arm" ;;
*) bad "...and status surfaces the degraded mode, not only the arm" ;;
esac

printf '\nforge-watch-role-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
