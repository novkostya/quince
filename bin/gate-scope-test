#!/bin/sh
# gate-scope-test — the SKIPPING must never be silent, and the map must never go stale.
#
# gate-scope exists to make CI faster by not running gates a change cannot affect. Every defect it
# can have is the same one: a gate that should have run and did not. So this suite spends almost all
# of its assertions on the refusals and on the map, and only two on the saving.
#
# THE MAP IS THE PART THAT ROTS. Coverage is a hand-written fact about which directory belongs to
# which gate, and the day somebody adds a top-level `server/` it belongs to no product gate and is
# checked by `gates-sh` alone — silently, with a green tick. So the totality assertion below fails
# on any tracked top-level path that is neither claimed by a product gate nor explicitly listed as
# process-only. Adding a directory then requires a decision instead of producing a gap.
#
# `gates-sh` covers `.` — everything — which is why totality cannot be asserted against the union of
# all gates: that is trivially true and would be a check that cannot fail. It is asserted against the
# PRODUCT gates plus a declared process list.
set -eu

cd "$(dirname "$0")/.."
GS=$PWD/bin/gate-scope
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

# --- a synthetic repo with this repo's shape, so the range tests are hermetic ------------------
R="$WORK/repo"
mkdir -p "$R"
git init -q "$R"
git -C "$R" symbolic-ref HEAD refs/heads/main
mkdir -p "$R/core" "$R/ui" "$R/vault" "$R/bin" "$R/docs" "$R/deploy"
for f in core/a.go ui/a.ts vault/a.py bin/a docs/a.md deploy/Dockerfile versions.env Makefile; do
	printf 'x\n' >"$R/$f"
done
cp "$GS" "$R/bin/gate-scope"
git -C "$R" add -A
git -C "$R" commit -qm base

# `set +e` inside the subshell, deliberately. These helpers exist to CAPTURE a non-zero exit, and
# under `set -e` the subshell dies at the failing command before `echo $?` ever runs — so the helper
# returns an empty string and every comparison against it fails for a reason that has nothing to do
# with the tool. Met three times writing this file; it is the same shape as quince#164.
scoped() { (set +e; cd "$R" && ./bin/gate-scope --list "$1" 2>/dev/null | tr '\n' ' ' | sed 's/ $//'); }
needed() { (set +e; cd "$R"; ./bin/gate-scope --needed "$1" "$2" >/dev/null 2>&1; echo $?); }

# --- 1. THE DEFAULT IS EVERYTHING -------------------------------------------------------------
# No range is the offline case, the fresh-clone case, and the did-not-opt-in case. It must never be
# read as "nothing changed".
if [ "$(scoped '')" = "gates-go gates-vault gates-ui gates-sh" ]; then
	ok "no range runs every gate — the offline default"
else
	bad "no range did not run every gate: $(scoped '')"
fi

# --- 2. AN UNRESOLVABLE RANGE RUNS EVERYTHING, AND SAYS SO ------------------------------------
# The shape to expect in CI first: actions/checkout fetches one ref at depth 1, so origin/main does
# not exist without fetch-depth: 0. Answering "nothing changed" there would skip every gate on every
# PR, green.
# `|| true` because the tool exits 2 here BY DESIGN, and under `set -e` an assignment takes its
# status from the substitution — the same defect quince#164 fixed in the wrappers, which is worth
# meeting once in a test that is about refusals.
out=$( (cd "$R" && ./bin/gate-scope --list 'no-such-ref...HEAD' 2>&1) || true )
case "$out" in
*"cannot resolve the range"*gates-go*gates-sh*)
	ok "an unresolvable range runs every gate AND says why"
	;;
*)
	bad "an unresolvable range did not fail safe"
	printf '       %s\n' "$out" | head -n 2
	;;
esac

# --- 2b. AN EMPTY RANGE IS DOUBT, NOT AN ANSWER (quince#682) ----------------------------------
# This is the refusal that used to be silent, and it is reached by the most natural way to invoke
# the tool: BEFORE COMMITTING, when origin/main...HEAD is empty. It resolves perfectly well — git
# diff succeeds and prints nothing — so it never reached part 2's branch, fell through to the
# coverage test, and answered "not needed" for every gate. That is the direction that skips work,
# and it cost a false "e2e not needed" claim in quince#677's PR body, on a PR whose real ordering
# defect e2e then caught.
#
# The repo is on main and clean here, so main...HEAD is empty. Asserted PER GATE rather than in
# aggregate, because 3 is the only value that skips, so 3 is the value that must be unreachable.
for g in image e2e gates-go; do
	got=$(needed "$g" 'main...HEAD')
	if [ "$got" = 2 ]; then
		ok "an empty range is could-not-determine for $g, never not-needed"
	else
		bad "an empty range answered $got for $g — 3 would silently skip it"
	fi
done
out=$( (cd "$R" && ./bin/gate-scope --list 'main...HEAD' 2>&1) || true )
case "$out" in
*"says nothing"*gates-go*gates-vault*gates-ui*gates-sh*)
	ok "--list on an empty range prints EVERY gate AND says why"
	;;
*)
	bad "--list on an empty range did not fail safe"
	printf '       %s\n' "$out" | head -n 3
	;;
esac

# --- 3. THE SAVING (two assertions, and they are the only two) ---------------------------------
git -C "$R" checkout -qb docs-only
printf 'more\n' >>"$R/docs/a.md"
git -C "$R" commit -qam docs
if [ "$(scoped 'main...HEAD')" = "gates-sh" ]; then
	ok "a docs-only change needs gates-sh and nothing else"
else
	bad "a docs-only change asked for: $(scoped 'main...HEAD')"
fi
if [ "$(needed image 'main...HEAD')" = 3 ] && [ "$(needed e2e 'main...HEAD')" = 3 ]; then
	ok "image and e2e both decline a docs-only change"
else
	bad "image/e2e did not decline a docs-only change"
fi

# --- 4. POSITIVE CONTROLS — every gate is reachable --------------------------------------------
# Without these, a gate-scope that answered "gates-sh" to everything would pass part 3.
git -C "$R" checkout -q main
for pair in 'core/a.go:gates-go' 'ui/a.ts:gates-ui' 'vault/a.py:gates-vault'; do
	f=${pair%:*}
	g=${pair#*:}
	git -C "$R" checkout -q -B "t-$g" main
	printf 'more\n' >>"$R/$f"
	git -C "$R" commit -qam "touch $f"
	if [ "$(needed "$g" 'main...HEAD')" = 0 ] && [ "$(needed image 'main...HEAD')" = 0 ]; then
		ok "a change under $f requires $g (and image)"
	else
		bad "a change under $f did not require $g"
	fi
	git -C "$R" checkout -q main
done

# --- 5. THE SHARED INPUTS REACH EVERY GATE -----------------------------------------------------
# versions.env pins every toolchain image, so a change to it can break a gate whose own tree is
# untouched. If this ever stops being true the saving is bought with a real hole.
for f in versions.env deploy/Dockerfile Makefile; do
	git -C "$R" checkout -q -B "t-shared" main
	printf 'more\n' >>"$R/$f"
	git -C "$R" commit -qam "touch $f"
	if [ "$(scoped 'main...HEAD')" = "gates-go gates-vault gates-ui gates-sh" ]; then
		ok "$f requires every gate"
	else
		bad "$f did not require every gate: $(scoped 'main...HEAD')"
	fi
	git -C "$R" checkout -q main
done

# --- 6. gates-sh IS UNCONDITIONAL --------------------------------------------------------------
git -C "$R" checkout -q -B t-sh main
printf 'more\n' >>"$R/core/a.go"
git -C "$R" commit -qam core
if [ "$(needed gates-sh 'main...HEAD')" = 0 ] && [ "$(needed gates-sh '')" = 0 ]; then
	ok "gates-sh is required by everything, including a change that misses it entirely"
else
	bad "gates-sh became conditional — it runs the suites that read the documents a docs PR edits"
fi
git -C "$R" checkout -q main

# --- 7. SKIP ONLY ON 3 -------------------------------------------------------------------------
# A caller that treats "non-zero" as skip inverts the safety rule, so the tool must not use any
# other non-zero code to mean "needed".
rc=$( (set +e; cd "$R"; ./bin/gate-scope --needed no-such-gate 'main...HEAD' >/dev/null 2>&1; echo $?) )
if [ "$rc" = 2 ]; then
	ok "an unknown gate exits 2 (could-not-determine), never 3"
else
	bad "an unknown gate exited $rc — 3 would tell a caller to skip it"
fi

# --- 8. THE MAP IS TOTAL, against THIS repository ----------------------------------------------
# The drift guard. Every tracked top-level path must be claimed by a PRODUCT gate or declared
# process-only here. A new top-level directory then fails this suite instead of being silently
# covered by gates-sh alone.
#
# This list is a DECISION, not a description: each entry is a path whose changes genuinely need no
# Go/UI/vault gate. Adding to it should be as deliberate as adding a gate.
# CLAUDE.md is canon and .claude/ is the process tree: a change to either cannot break a Go
# build, a vitest run or a mypy pass. bin/ and docs/ likewise. Each of these was checked
# against the full tracked list rather than added to make the suite green — CLAUDE.md was in fact
# added BECAUSE this assertion failed on it the first time it ran, which is the guard working.
#
# fly.toml is the SECOND entry added because this assertion failed on it (quince#494), and it is
# the first one that is not obviously process. It configures the public DEMO deployment — the app,
# region, machine size and the `--public-demo` flag fly passes to the image. It is product-adjacent
# and still belongs here, by this list's own criterion: a change to it cannot break a Go build, a
# vitest run or a mypy pass, because nothing in the tree reads it. Only fly does, at deploy time.
#
# It is deliberately NOT in product_covered. Putting it there would make an edit to it trigger an
# image rebuild and the e2e suite, which test the image — and fly.toml does not change the image.
# That would be a gate that runs without being able to fail for the right reason.
#
# WHAT IS THEREFORE UNGATED, stated because this list is where somebody would look for it: nothing
# in this repository validates fly.toml. A typo in it is found by `fly deploy`, not by CI. That is
# accepted rather than overlooked — see deploy/demo.md, which says the same thing where an operator
# will meet it.
PROCESS_ONLY='bin docs .claude .github .gitignore README.md CLAUDE.md fly.toml'
product_covered='core ui vault deploy versions.env Makefile'
uncovered=''
for top in $(git ls-files | awk -F/ '{print $1}' | sort -u); do
	found=no
	for p in $product_covered $PROCESS_ONLY; do
		[ "$top" = "$p" ] && found=yes && break
	done
	[ "$found" = yes ] || uncovered="$uncovered $top"
done
if [ -z "$uncovered" ]; then
	ok "every tracked top-level path is claimed by a product gate or declared process-only"
else
	bad "unclaimed top-level path(s) —$uncovered — would be covered by gates-sh alone, silently"
fi

# --- 9. THE MAKEFILE HONOURS IT, and refuses an empty ladder -----------------------------------
# Parts 1-8 pin the script. This pins the WIRING, which is where a correct script still produces a
# ladder that runs nothing.
# `SCOPE=` ON THE COMMAND LINE, which is the only channel that beats all the others. SCOPE reaches
# make THREE ways and this assertion has now been wrong about two of them:
#
#   environment      ci.yml's `env:` block — `SCOPE ?=` treats an exported value as already set
#   command line     `make gates SCOPE=…`, which is how ci.yml actually invokes it
#   MAKEFLAGS        a command-line override PROPAGATES TO SUB-MAKES through MAKEFLAGS, so the
#                    nested `make` this assertion runs inherits it even with the variable unset
#
# quince#193 fixed the first with `env -u SCOPE` and that is not enough: measured under a real
# `make gates SCOPE=…`, MAKEFLAGS carried the override past the unset and this assertion failed
# again. Stripping channels is a losing game — each fix covers the channel that was noticed.
#
# An explicit empty value on the command line CONSTRUCTS the no-SCOPE state instead, and outranks
# environment and MAKEFLAGS both. That is the same lesson as last time, finally applied properly:
# an assertion about a default has to build the default.
#
# The FEATURE is unaffected and the propagation is correct for it — `make gates SCOPE=X` should
# scope the whole ladder, sub-makes included. It is only wrong for a test asserting the unscoped
# case.
if make -n gates SCOPE= 2>/dev/null | grep -q 'toolchain-go'; then
	ok "make gates with no SCOPE still builds the full ladder"
else
	bad "make gates with no SCOPE no longer runs the product gates"
fi

# The property CI revealed, pinned so it is documented rather than rediscovered. An exported SCOPE
# scopes the build — which is what makes ci.yml's `env:` block work, and is also the one way a
# developer could surprise themselves. Opt-in either way; never silent, because the skip announces
# itself.
# `MAKEFLAGS=` IS THE WHOLE FIX, AND IT IS THE SAME LESSON ONE LEVEL DEEPER. This assertion is about
# the ENVIRONMENT channel, so it has to construct a state where the environment is the only channel
# — and until 2026-07-29 it did not, which made it pass locally and fail on CI for eight hours while
# `main` was red.
#
# The mechanism is quince#194's, arriving from the other side. CI runs `make gates SCOPE="$SCOPE"`,
# a COMMAND-LINE assignment, and make propagates command-line variables to every sub-make through
# MAKEFLAGS. A command-line variable outranks an environment one, so by the time this suite runs as
# a sub-make's recipe, the `SCOPE='HEAD...HEAD'` prefix below is an environment assignment being
# silently outranked by the parent's `origin/main...HEAD`. `make -n image` then sees a range that
# DOES touch the product tree, prints no SKIPPED, and the assertion reports the opposite of the
# truth: it says an exported SCOPE was ignored, when what was ignored was this line.
#
# Run from a shell the bug is invisible, because MAKEFLAGS is empty there and the prefix wins. That
# is why it survived review and why it has to be constructed rather than assumed — the third time
# this repository has been bitten by an assertion that reads a state instead of building one.
# `MAKEFLAGS=''` and not a bare `MAKEFLAGS=`: shellcheck reads the bare form followed by another
# assignment as SC1007, an accidental assignment with a stray space, and it is right to — the two
# forms are indistinguishable by eye and only one of them is ever meant.
# THE RANGE BELOW WAS `HEAD...HEAD` UNTIL quince#682, AND THAT WAS THE BUG WEARING A FIXTURE.
# These three assertions need a range for which `image` is genuinely not needed. An empty range
# used to answer that, and it answered it for the wrong reason — not "this change is docs-only"
# but "this tool cannot tell", which is now exit 2. So they were passing on the defect these very
# tests exist to catch.
#
# CONSTRUCTED, NOT HUNTED FOR. This file already says a state read is worth less than a state
# built, three times over; searching history for a docs-only commit would make the suite depend on
# what happened to land recently. `commit-tree` mints a commit identical to HEAD but for one
# docs/ file, so the range is docs-only BY CONSTRUCTION.
#
# NOTHING IN THE REPOSITORY IS TOUCHED: no ref, no index (GIT_INDEX_FILE points into $WORK), no
# working tree. It writes a blob, a tree and a commit into the object store, all unreferenced and
# collectable — the same objects `git stash` would leave behind.
fixture_blob=$(printf 'gate-scope-test fixture\n' | git hash-object -w --stdin)
GIT_INDEX_FILE=$WORK/fixture-index git read-tree HEAD
GIT_INDEX_FILE=$WORK/fixture-index git update-index --add \
	--cacheinfo "100644,$fixture_blob,docs/zz-gate-scope-fixture.md"
fixture_tree=$(GIT_INDEX_FILE=$WORK/fixture-index git write-tree)
DOCS_ONLY="HEAD...$(git commit-tree "$fixture_tree" -p HEAD -m 'gate-scope-test docs-only fixture')"

# The fixture must be non-empty and must skip image — assert it, or a broken fixture would make all
# three assertions below pass for the reason this change exists to remove.
if [ -n "$(git diff --name-only "$DOCS_ONLY")" ] &&
	[ "$(git diff --name-only "$DOCS_ONLY")" = "docs/zz-gate-scope-fixture.md" ]; then
	ok "the propagation fixture is a NON-EMPTY docs-only range, so a skip means what it says"
else
	bad "the propagation fixture is not docs-only: $(git diff --name-only "$DOCS_ONLY" | tr '\n' ' ')"
fi

if MAKEFLAGS='' SCOPE="$DOCS_ONLY" make -n image 2>/dev/null | grep -q 'SKIPPED'; then
	ok "an EXPORTED SCOPE reaches make — that is what makes ci.yml's env: block work"
else
	bad "an exported SCOPE was ignored; ci.yml's env: block would silently do nothing"
fi
# The third channel, pinned because it is the one that bit twice: a command-line override reaches
# NESTED makes through MAKEFLAGS. `gates-sh` invokes every suite as a sub-make, so this is the path
# every gate actually runs under in CI.
if MAKEFLAGS="SCOPE=$DOCS_ONLY" make -n image 2>/dev/null | grep -q 'SKIPPED'; then
	ok "SCOPE propagates to sub-makes via MAKEFLAGS — the channel env -u cannot close"
else
	bad "MAKEFLAGS did not carry SCOPE; the ladder would scope inconsistently between make levels"
fi
if make -n image SCOPE="$DOCS_ONLY" 2>/dev/null | grep -q 'SKIPPED'; then
	ok "make image honours SCOPE and announces the skip rather than doing it quietly"
else
	bad "make image did not skip a docs-only range"
fi
# And the empty range must NOT skip it, which is the whole of quince#682 seen from the Makefile.
if make -n image SCOPE='HEAD...HEAD' 2>/dev/null | grep -q 'SKIPPED'; then
	bad "make image SKIPPED on an empty range — gate-scope answered 3 for a question it cannot answer"
else
	ok "make image does NOT skip on an empty range — exit 2 is not 3, and the Makefile checks 3"
fi
# An empty ladder must be a hard failure, not a quiet pass. Driven by a stub gate-scope that prints
# nothing — the shape a missing or broken script produces.
stub=$WORK/stub
mkdir -p "$stub/bin"
printf '#!/bin/sh\nexit 0\n' >"$stub/bin/gate-scope"
chmod +x "$stub/bin/gate-scope"
cp Makefile versions.env "$stub/" 2>/dev/null || true
if (cd "$stub" && make -n gates 2>&1 | grep -q 'refusing to run an empty ladder'); then
	ok "an empty gate list is a hard failure, not a vacuous clean run"
else
	bad "an empty gate list did not stop the build — gates would depend on nothing and pass"
fi

printf '\ngate-scope-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
