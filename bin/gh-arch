#!/bin/sh
# gh-arch — run `gh` as the architect, with the credential out of argv and out of the command line.
#
# The mirror of bin/gh-bot, and it exists for the same allowlist reason: a permission rule never
# matches past a leading `VAR=value` assignment, so `GH_TOKEN=$(cat …) gh …` is unallowlistable by
# construction. Allowlist the script instead.
#
# Why a SEPARATE wrapper rather than a flag on gh-bot: the two credentials must not be reachable
# from one command. A single wrapper with `--as arch` would put both identities one typo apart, on
# a box whose whole purpose (devlog#7) is that it cannot hold the other's. Two scripts, two files,
# two boxes.
set -eu

# HOME IS NOT GUARANTEED, AND `set -u` MAKES A BARE $HOME FATAL — see bin/gh-review for the full
# note. OpenRC gives a service no HOME, so an unguarded $HOME inside an otherwise-guarded default
# kills the wrapper with `HOME: parameter not set`. Invisible from a shell, because ssh sets HOME.
_home="${HOME:-$(awk -F: -v u="$(id -u)" '$3==u{print $6; exit}' /etc/passwd 2>/dev/null || true)}"
[ -n "$_home" ] || {
	printf 'gh-arch: cannot locate a home directory — HOME is unset and uid %s has no passwd entry.\n' "$(id -u)" >&2
	printf 'gh-arch: set QUINCE_ARCH_TOKEN_FILE to the credential path explicitly.\n' >&2
	exit 1
}

TOKEN_FILE="${QUINCE_ARCH_TOKEN_FILE:-$_home/.config/quince/quince-arch.token}"

# IDENTITY BEFORE DEPENDENCIES (quince#157). The architect box must not hold the implementer
# identity (devlog#7). If one is present here, the box can author and approve — so refuse rather than
# run, and say which file to remove. This is the same assertion `preflight` makes at service start;
# making it again here means a hand-run command cannot quietly cross the boundary that the service
# refuses to cross.
#
# It runs FIRST, ahead of the `gh` check, for the reason set out at length in bin/gh-review: an
# environment refusal invites a repair, and a session repairing its way past this one ends up
# holding both identities on one box. A boundary refusal must outrank an environment refusal because
# the environment is meant to be fixed and the boundary is not. gh-review was the instance filed;
# this wrapper had the same ordering and is corrected in the same commit rather than left to be
# rediscovered from the other side of the boundary.
#
# BOTH FORMS OF THE IMPLEMENTER IDENTITY, and the App key is checked FIRST because it is the live
# one. This wrapper refused a bot token and nothing else, so once the implementer identity moved to
# an App key (`decisions/0014`) the assertion "the implementer identity is absent" was being made by
# checking for a credential that no longer carries it — and a box holding `quince-coder.pem` could
# author with gh-coder and approve with gh-review while both wrappers reported the separation
# intact. quince#203 fixed exactly this in `preflight`'s arch arm and said so; quince#204 is the
# remainder. `preflight` gates whether the box STARTS, these gate every action it takes.
CODER_KEY="${QUINCE_CODER_KEY_FILE:-$_home/.config/quince/quince-coder.pem}"
if [ -f "$CODER_KEY" ]; then
	printf 'gh-arch: an IMPLEMENTER APP KEY is present at %s.\n' "$CODER_KEY" >&2
	printf 'gh-arch: this machine can approve; holding the implementer identity too would let one box\n' >&2
	printf 'gh-arch: author and approve its own work. Remove it, or run gh-coder on the implementer box.\n' >&2
	exit 1
fi
# The bot token stays a refusal alongside it: `decisions/0014` condition 1 requires that credential
# to be left in place wherever it lives, so a box can hold it AND the App key, and both are the
# implementer identity. Refusing beside either is the only reading that stays true.
if [ -f "${QUINCE_BOT_TOKEN_FILE:-$_home/.config/quince/quince-bot.token}" ]; then
	printf 'gh-arch: a BOT TOKEN is present at %s.\n' "${QUINCE_BOT_TOKEN_FILE:-$_home/.config/quince/quince-bot.token}" >&2
	printf 'gh-arch: this machine can approve; holding the implementer identity too would let one box\n' >&2
	printf 'gh-arch: author and approve its own work. Remove it, or run gh-bot on the implementer box.\n' >&2
	exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
	printf 'gh-arch: gh is not installed\n' >&2
	exit 1
fi

if [ $# -eq 0 ]; then
	printf 'usage: gh-arch <gh arguments...>\n' >&2
	printf '  runs gh with the architect credential from %s\n' "$TOKEN_FILE" >&2
	exit 2
fi

if [ ! -f "$TOKEN_FILE" ]; then
	printf 'gh-arch: no architect credential at %s\n' "$TOKEN_FILE" >&2
	# Deliberately not a fallback: using the ambient login would approve as whoever is signed in,
	# which is the failure this whole separation exists to prevent.
	printf 'gh-arch: refusing to fall back to the ambient gh credentials.\n' >&2
	# Describe the FILE, not the world. An earlier version added "pr.0b has not been ruled, so this
	# box holds no credential yet" — true when written, false within the day, and unknowable to a
	# wrapper either way. A script can check whether a path exists; it cannot check the state of a
	# ruling, so it should not claim to.
	printf 'gh-arch: place the credential there (mode 600), or set QUINCE_ARCH_TOKEN_FILE.\n' >&2
	exit 1
fi

unset GITHUB_TOKEN
GH_TOKEN=$(cat "$TOKEN_FILE")
export GH_TOKEN


# THE LEDGER, wired here by quince#316 — this wrapper had no ledger call at all, so an act performed
# through it recorded nothing and the next tick woke the seat that performed it.
#
# WHY THAT MATTERS FOR THIS WRAPPER SPECIFICALLY. `CLAUDE.md` makes `gh-arch` a STANDING instruction
# rather than an escape hatch: *"Architect, on a refused merge: retry once; if it is refused again,
# merge through `bin/gh-arch` and say so on the PR."* So the documented remedy for an intermittent
# classifier refusal produced a merge with no row, and `event=merged` carries no actor of its own —
# it is diffed from two observations, and a diff knows what changed but not who changed it. The
# failure is silent by design, because `forge-ledger` fails open and an extra wake looks like an
# ordinary wake.
#
# MEASURED BEFORE FIXING (quince#316): at most 3 of 58 merges since 2026-07-30 could have taken this
# path, and possibly zero — the architect seat reports 24 of them first-hand with no fallback taken.
# The three are ambiguous by construction, because `gh-arch` authenticates as the architect PAT,
# which is `novkostya`, and so is the Operator merging directly (quince#47). So this is cheap
# insurance rather than a hot path, and the ruling was explicit that the SHARED-BLOCK refactor is
# NOT justified on that evidence: three copies of these four lines is accepted, and the trigger to
# revisit is a FOURTH wrapper appearing, not a count.
#
# RECORDED ONLY ON SUCCESS, and the exit status passes through unchanged — identical to `gh-coder`
# and `gh-review`, because a failed act produces no event to suppress and its row would sit
# unconsumed until it swallowed somebody else's.
_ledger="$(dirname "$0")/forge-ledger"
if [ -x "$_ledger" ] && "$_ledger" classify "$@" >/dev/null 2>&1; then
	gh "$@" && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then "$_ledger" record "$@" || :; fi
	exit "$_rc"
fi

exec gh "$@"
