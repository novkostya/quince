#!/bin/sh
# gh-bot — run `gh` as quince-bot, with the token out of argv and out of the command line.
#
# Why this exists: `Bash(gh pr *)` is allowlisted, and yet every bot-authored gh call still
# prompts, because a permission rule never matches past a leading `VAR=value` assignment — the
# same papercut .claude/README.md documents for `make image IMAGE_TAG=…`. So the documented way
# to act as the bot (`GH_TOKEN=$(cat …) gh …`) is unallowlistable by construction, and the most
# routine act in this workflow — opening a PR, filing an issue, editing a body — needs a human
# tap every time. Escalating those calls also means their results never come back to the session
# that needed them, which has already produced one stale "still open" claim.
#
# The fix is the move .claude/README.md already prescribes for the Proxmox curl entry: allowlist
# the script, not the fragile argument. The token then travels the way git's credential helper
# already carries it — read from a file at point of use, never in argv, never in a remote URL.
set -eu

TOKEN_FILE="${QUINCE_BOT_TOKEN_FILE:-$HOME/.config/quince/quince-bot.token}"

if ! command -v gh >/dev/null 2>&1; then
	printf 'gh-bot: gh is not installed\n' >&2
	exit 1
fi

if [ $# -eq 0 ]; then
	printf 'usage: gh-bot <gh arguments...>\n' >&2
	printf '  runs gh authenticated as quince-bot; token read from %s\n' "$TOKEN_FILE" >&2
	exit 2
fi

if [ ! -f "$TOKEN_FILE" ]; then
	printf 'gh-bot: no bot token at %s\n' "$TOKEN_FILE" >&2
	# Falling back to the ambient gh login would author implementer output as whoever is signed
	# in — silently breaking approver-never-author. Refusing loudly is the honest failure.
	printf 'gh-bot: refusing to fall back to the ambient gh credentials\n' >&2
	exit 1
fi

# GITHUB_TOKEN is cleared so an inherited one cannot outrank the bot's; GH_TOKEN is exported from
# the file, so the secret lives only in this process's environment — never on a command line, and
# never in a transcript.
unset GITHUB_TOKEN
GH_TOKEN=$(cat "$TOKEN_FILE")
export GH_TOKEN

exec gh "$@"
