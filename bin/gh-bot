#!/bin/sh
# gh-bot — run `gh` as quince-bot, with the token out of argv and out of the command line.
#
# Why this exists: `Bash(gh pr *)` is allowlisted, and yet every bot-authored gh call still
# prompts, because a permission rule never matches past a leading `VAR=value` assignment — the
# same papercut .claude/README.md documents for `make image IMAGE_TAG=…`. So the documented way
# to act as the bot (`GH_TOKEN=$(cat …) gh …`) is unallowlistable by construction, and the most
# routine act in this workflow — opening a PR, filing an issue, editing a body — needs a human
# tap every time. Escalating those calls also means their results never come back to the session
# that needed them, which has already produced one stale "still open" claim.
#
# The fix is the move .claude/README.md already prescribes for the Proxmox curl entry: allowlist
# the script, not the fragile argument. The token then travels the way git's credential helper
# already carries it — read from a file at point of use, never in argv, never in a remote URL.
set -eu

# INLINE `--body` IS REFUSED, and the reason is a measured leak rather than a style preference
# (quince#518).
#
# THREE REFERENCES, AND THEY ANSWER DIFFERENT QUESTIONS. quince#518 is the leak this guard exists
# because of; quince#526 established it on `bin/gh-coder` and is the one to read for what it looks
# like; quince#527 is why it is on this wrapper too rather than on that one alone. A reader who
# follows #518 alone lands on a storage discussion and has to work out why (quince#803 review).
#
# A body written as `--body "…"` is a shell string, so backticks inside it are COMMAND
# SUBSTITUTION — evaluated by the shell before this wrapper sees an argument, which is why the
# guard cannot live anywhere but the entry point. On 2026-08-02 that published a PVE host's
# block-device map to a public issue through `gh-coder`, and twice more the same session it
# silently ATE filenames out of sentences.
#
# THE SAME BUG IS IN THIS REPOSITORY'S HISTORY THROUGH THE ARCHITECT'S WRAPPER, an hour earlier: a
# review comment's backticked spans were evaluated, the shell tried to execute two committed paths,
# and the posted comment TRUNCATED mid-sentence and lost both of its numbered points. It was
# harmless for one reason only — neither path is an executable. `iostat` is. **The severity is
# decided by whether the prose happens to name something on $PATH**, which is a property of English
# rather than of care.
#
# AND IT IS THE ONE PATH THE PRIVACY GATE CANNOT COVER: `make privacy-check TEXT=<file>` needs a
# file, and `--body` has none.
#
# AHEAD OF THIS WRAPPER'S BOUNDARY REFUSAL, deliberately, and it does not weaken it. That ordering
# rule exists because a message inviting the WRONG REPAIR is how a reviewer key ends up on the
# authoring host — "install openssl" is an instruction to change the environment. This one is an
# instruction to change the INVOCATION, and the boundary refusal is still waiting on the next
# attempt. `bin/wrapper-boundary-test` passes no inline body, so every case it constructs is
# unchanged.
#
# `--body-file` and `--body-file -` both pass. Neither can substitute, and both give the sweep
# something to point at.
for _a in "$@"; do
	case "$_a" in
	--body | -b)
		cat >&2 <<'EOM'
gh-bot: REFUSING --body. Write the text to a file and pass --body-file.

  Inline --body is a shell string, so backticks in it are COMMAND SUBSTITUTION. On 2026-08-02
  that published a PVE host's device map to a public issue, and it truncated a review comment
  mid-sentence through this wrapper's sibling (quince#518, quince#527).

  It is also the one path `make privacy-check TEXT=<file>` cannot cover, because there is no
  file to sweep. Use:

      cat > "$HOME/scratch/<seat>/bodies/<name>.md" <<'EOF'
      …
      EOF
      make privacy-check TEXT="$HOME/scratch/<seat>/bodies/<name>.md"
      gh-bot <verb> --body-file "$HOME/scratch/<seat>/bodies/<name>.md"

  A quoted heredoc delimiter ('EOF', not EOF) is what stops substitution inside the file too.
EOM
		exit 2
		;;
	--body=* | -b=* | -b?*)
		echo "gh-bot: REFUSING an inline body (--body=… / -b…) — same reason as --body; use --body-file (quince#518)." >&2
		exit 2
		;;
	esac
done

# HOME IS NOT GUARANTEED, AND `set -u` MAKES A BARE $HOME FATAL. OpenRC gives a service no HOME,
# so `${VAR:-$HOME/...}` — safe-looking, because the outer expansion is guarded — dies on the
# UNGUARDED $HOME inside the default. It surfaces as `HOME: parameter not set`, which reads as a
# broken script rather than as a missing environment, and it is invisible from a shell because
# ssh and login both set HOME. Resolve it from the passwd database instead of assuming, so the
# same invocation works from a shell, a service and cron.
_home="${HOME:-$(awk -F: -v u="$(id -u)" '$3==u{print $6; exit}' /etc/passwd 2>/dev/null || true)}"
[ -n "$_home" ] || {
	printf 'gh-bot: cannot locate a home directory — HOME is unset and uid %s has no passwd entry.\n' "$(id -u)" >&2
	printf 'gh-bot: set QUINCE_BOT_TOKEN_FILE to the credential path explicitly.\n' >&2
	exit 1
}

TOKEN_FILE="${QUINCE_BOT_TOKEN_FILE:-$_home/.config/quince/quince-bot.token}"

# IDENTITY BEFORE DEPENDENCIES (quince#157), FROM THE FOURTH CORNER (quince#232).
#
# This wrapper had NO boundary check at all — not a stale one, none. It was the only forge wrapper
# that could not refuse a second identity, and the omission survived every audit that came before it
# because the other four were correct and a suite thorough in one direction reads as thorough in all
# of them. `gh-bot` authors, so the credentials it must refuse to sit beside are the APPROVING ones:
# the same pair `gh-coder` refuses, for the same reason, since both are the implementer seat.
#
# THE HOLE WAS NOT LIVE AND THAT IS NOT WHY IT IS FIXED. `quince-bot` was suspended on 2026-07-28, so
# every call here now fails at GitHub regardless of what else the box holds. But a boundary check is
# a claim about THE BOX, not about whether a credential currently authenticates — and "the credential
# happens to be dead" is the reasoning that produced quince#203 and quince#204, each a guard naming a
# mechanism that had changed underneath it. If the appeal is ever decided in the account's favour the
# hole opens with no code change and nothing pointing at it. Ruled by the architect on quince#232:
# add the checks, rather than documenting the hole (which does nothing if the account returns) or
# refusing unconditionally (which would destroy the very artifact `decisions/0014` condition 1 wants
# — a wrapper that is still runnable and still fails honestly is live, checkable evidence; a comment
# asserting it is not).
REVIEW_KEY="${QUINCE_REVIEW_KEY_FILE:-$_home/.config/quince/quince-review.pem}"
if [ -f "$REVIEW_KEY" ]; then
	printf 'gh-bot: a REVIEWER APP KEY is present at %s.\n' "$REVIEW_KEY" >&2
	printf 'gh-bot: This machine authors; holding the reviewer identity too would let one box write a\n' >&2
	printf 'gh-bot: change and approve it. Remove it, or run gh-review on the reviewer box.\n' >&2
	exit 1
fi
ARCH_TOKEN="${QUINCE_ARCH_TOKEN_FILE:-$_home/.config/quince/quince-arch.token}"
if [ -f "$ARCH_TOKEN" ]; then
	printf 'gh-bot: an ARCHITECT CREDENTIAL is present at %s.\n' "$ARCH_TOKEN" >&2
	printf 'gh-bot: That seat merges. A box that can author and merge is the whole of what the two-seat\n' >&2
	printf 'gh-bot: design exists to prevent. REMOVE IT: retired credential, no wrapper reads it (quince#676).\n' >&2
	exit 1
fi
# THE THIRD SEAT CAN APPROVE (quince#375), so it joins the two above for the same reason they are
# here. This wrapper's account is SUSPENDED and the check is added anyway — quince#232's ruling, in
# its own words: a boundary check is a claim about THE BOX, not about whether a credential currently
# authenticates. Leaving one wrapper of five ignorant of a new identity is exactly how the hole
# quince#232 closed opened in the first place, and it stayed invisible precisely because the
# neighbours were thorough.
ANALYST_KEY="${QUINCE_ANALYST_KEY_FILE:-$_home/.config/quince/quince-analyst.pem}"
if [ -f "$ANALYST_KEY" ]; then
	printf 'gh-bot: an ANALYST APP KEY is present at %s.\n' "$ANALYST_KEY" >&2
	printf 'gh-bot: That seat can cast a review verdict (quince#375). This machine authors; holding an\n' >&2
	printf 'gh-bot: identity that can approve would let one box write a change and approve it.\n' >&2
	printf 'gh-bot: Remove it, or run gh-analyst on the supervisor box.\n' >&2
	exit 1
fi

# NOT a refusal: `quince-coder.pem` may sit beside this token, and `decisions/0014` requires this
# credential to be left in place while the App key becomes the live one. Both are the IMPLEMENTER
# identity, so holding them together crosses no boundary — it is one seat with an old credential and
# a new one. Said explicitly because the two checks above make "another credential file is present"
# look like the banned thing, and a reader deleting the coder key to satisfy a rule that does not
# exist would break the box that is doing the work. `bin/gh-coder` carries the mirror of this note.


# A CREDENTIAL IS NOT A SET OF PATHNAMES (quince#385). Every check above names a FILE, and a forge
# credential in the ENVIRONMENT crosses all of them without one of them speaking — `GH_TOKEN` is
# exactly how a wrapper hands a token to `gh`, so a value already sitting there is a working
# credential belonging to somebody else.
#
# `deploy/runner/preflight`'s supervisor arm learned this by passing a box with `GH_TOKEN=ghp_…` set.
# The wrappers did not carry it, and the asymmetry ran the wrong way: `preflight` gates whether the
# box STARTS, this gates EVERY ACTION it takes.
#
# DUPLICATED RATHER THAN SOURCED, following quince#316's ruling rather than re-litigating it.
for _envvar in GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN; do
	eval "_envval=\${$_envvar:-}"
	[ -n "$_envval" ] || continue
	printf '%s: a FORGE CREDENTIAL is present in the environment: $%s.\n' "gh-bot" "$_envvar" >&2
	printf '%s: that variable is how a wrapper hands a token to gh, so a value already in it is\n' "gh-bot" >&2
	printf '%s: somebody else s working credential. Unset it, and run this on a one-identity box.\n' "gh-bot" >&2
	exit 1
done
if ! command -v gh >/dev/null 2>&1; then
	printf 'gh-bot: gh is not installed\n' >&2
	exit 1
fi

if [ $# -eq 0 ]; then
	printf 'usage: gh-bot <gh arguments...>\n' >&2
	printf '  runs gh authenticated as quince-bot; token read from %s\n' "$TOKEN_FILE" >&2
	exit 2
fi

if [ ! -f "$TOKEN_FILE" ]; then
	printf 'gh-bot: no bot token at %s\n' "$TOKEN_FILE" >&2
	# Falling back to the ambient gh login would author implementer output as whoever is signed
	# in — silently breaking approver-never-author. Refusing loudly is the honest failure.
	printf 'gh-bot: refusing to fall back to the ambient gh credentials\n' >&2
	exit 1
fi

# GITHUB_TOKEN is cleared so an inherited one cannot outrank the bot's; GH_TOKEN is exported from
# the file, so the secret lives only in this process's environment — never on a command line, and
# never in a transcript.
unset GITHUB_TOKEN
GH_TOKEN=$(cat "$TOKEN_FILE")
export GH_TOKEN

exec gh "$@"
