#!/bin/sh
# gh-coder-body-test — `gh-coder` must REFUSE inline `--body` (quince#518).
#
# WHY THIS EXISTS. On 2026-08-02 a comment written as `--body "…prose with `iostat`…"` had its
# backticks evaluated as COMMAND SUBSTITUTION by the shell. `iostat` RAN, and its output — a PVE
# host's block-device map and guest count — was published to a public issue. The same session, the
# same construct twice more silently ATE filenames out of sentences.
#
# AND IT IS THE ONE PATH THE PRIVACY GATE CANNOT COVER: `make privacy-check TEXT=<file>` needs a
# file, and `--body` has none. The single text in that session that could not be swept is the one
# that leaked — not a gate failure, an invocation that gave the gate nothing to read.
#
# THERE IS NO PATTERN REMEDY, which is why the control is a wrapper refusal and why it is worth
# pinning. The leaked strings were a hostname canon deliberately publishes in seven files (a
# pattern for it would fail `privacy-check` on `CLAUDE.md` forever), kernel-assigned device names,
# a core count and a version — unpatternable by construction.
set -eu

here=$(dirname "$0")
pass=0
fail=0

ok() { pass=$((pass + 1)); printf '  ok   %s\n' "$1"; }
no() { fail=$((fail + 1)); printf '  FAIL %s\n' "$1"; }

# Exit 2, not 1: this is DID NOT RUN, the same convention `privacy-check` and `closing-refs-check`
# use for "the thing you asked for was not attempted". A 1 would read as "the call was made and
# the forge refused it".
"$here"/gh-coder issue comment 1 --repo x/y --body "hi" >/dev/null 2>&1 && rc=0 || rc=$?
if [ "${rc:-0}" -eq 2 ]; then ok "--body is refused with exit 2"; else no "--body exit = ${rc:-0}, want 2"; fi

"$here"/gh-coder issue comment 1 --repo x/y --body=hi >/dev/null 2>&1 && rc=0 || rc=$?
if [ "${rc:-0}" -eq 2 ]; then ok "--body=… is refused too (the joined form)"; else no "--body=… exit = ${rc:-0}, want 2"; fi

"$here"/gh-coder pr create --repo x/y -b hi >/dev/null 2>&1 && rc=0 || rc=$?
if [ "${rc:-0}" -eq 2 ]; then ok "-b, the short form, is refused"; else no "-b exit = ${rc:-0}, want 2"; fi

# THE REFUSAL MUST NAME THE REPLACEMENT. A refusal that does not say what to do instead gets
# worked around, which for this one means back to inline text somewhere else.
out=$("$here"/gh-coder issue comment 1 --repo x/y --body "hi" 2>&1 || :)
case "$out" in
*--body-file*) ok "the refusal names --body-file" ;;
*) no "the refusal does not name the replacement" ;;
esac
case "$out" in
*privacy-check*) ok "the refusal names the sweep it makes possible" ;;
*) no "the refusal does not mention privacy-check" ;;
esac

# AND IT MUST NOT REFUSE THE THING IT IS RECOMMENDING. A guard that matched `--body-file` by
# prefix would refuse the only correct invocation, which is the failure mode this test exists to
# catch as much as the leak is.
tmp=$(mktemp); printf 'hi\n' > "$tmp"
out=$("$here"/gh-coder issue view 378 --repo novkostya/quince --json number 2>&1 || :)
case "$out" in
*REFUSING*) no "a normal verb was refused" ;;
*) ok "an ordinary call still passes through" ;;
esac
case $("$here"/gh-coder pr create --help 2>&1 || :) in
*"REFUSING --body"*) no "--body-file's own help was refused" ;;
*) ok "--body-file is not caught by the --body match" ;;
esac
rm -f "$tmp"

printf 'gh-coder-body-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
