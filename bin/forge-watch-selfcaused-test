#!/bin/sh
# forge-watch-selfcaused-test — an act this runner performed must not wake it, and an act it cannot
# fully account for must (quince#242, the ledger arm).
#
# WHY A SUITE AND NOT A FIXTURE, the same reason as `forge-watch-ownership-test`: the replay fixtures
# drive the PURE half — hand `step` an observation, compare events — and this decision is made one
# layer out, between the printing of events and the deciding on them, against a file that a DIFFERENT
# PROGRAM wrote. A fixture crafting a ledger by hand would pin the consumer and miss the producer,
# and the producer is where the interesting failure lives: `bin/forge-ledger` and `forge-watch` each
# spell the ledger's filename, and nothing but an end-to-end run holds them together. So every row
# here is written by the real `forge-ledger record`, never by `printf` into a path this file chose.
#
# THE PROPERTY, so the assertions can be checked against it: the filter decides what WAKES, never
# what is SEEN. Every event is printed either way; suppression is reported as a note, and only the
# exit is affected.
#
# WHAT THIS SUITE DELIBERATELY CANNOT SHOW: a real approval also moves `updatedAt`, so in the wild
# it emits `event=updated` TOO, and that line wakes the session regardless of anything here. The
# stub holds `updatedAt` still precisely to isolate the arm under test. That is not the suite
# cheating — it is the reason the ledger alone does not reduce wakes, made visible: every scenario
# below needs the other line held back by hand to demonstrate anything at all.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export XDG_STATE_HOME="$WORK/state"
export QUINCE_SESSION_ID=selfcaused-test-session
REPO=novkostya/quince

# Pinned for the same reason `forge-watch-ownership-test` pins them: `owed_role` reads which
# credential is present, and in the containerised gate none is — so the role arm would disable
# branch-ownership suppression and this suite would be measuring a different code path than it
# claims. A coder key makes the role `implementer`, which is the seat the wrappers below act as.
export QUINCE_CODER_KEY_FILE="$WORK/coder.pem"
export QUINCE_ARCH_TOKEN_FILE="$WORK/arch.token"
export QUINCE_BOT_TOKEN_FILE="$WORK/bot.token"
export QUINCE_REVIEW_KEY_FILE="$WORK/review.pem"
printf 'a credential\n' >"$QUINCE_CODER_KEY_FILE"

# One declared runner and one seat name, so `other_runner_names` is empty and branch-ownership
# suppression is a no-op. This suite is about the OTHER arm; leaving the ownership filter live would
# make every "did not wake" assertion ambiguous between the two.
FORGE_SEATS_FILE=$WORK/seats
export FORGE_SEATS_FILE
printf '# fixture seats for forge-watch-selfcaused-test\nr1\n' >"$FORGE_SEATS_FILE"

STUB_INVERSE="$PWD/bin/testdata/forge/gh-array-to-graphql.jq"
export STUB_INVERSE
[ -f "$STUB_INVERSE" ] || {
	printf 'forge-watch-selfcaused-test: missing %s — the stub cannot answer the queue fetch\n' "$STUB_INVERSE" >&2
	exit 1
}

# `updatedAt` NEVER MOVES ACROSS TURNS. See the header: holding it still is what suppresses the
# `event=updated` line so the typed event can be observed alone.
cat >"$WORK/gh" <<'STUB'
#!/bin/sh
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
case "$*" in
*"issue view"*) printf '{}\n'; exit 0 ;;
esac
state=OPEN; merged=null; reviews='[]'
case "$turn" in
2) reviews='[{"state":"APPROVED","submittedAt":"2026-07-30T11:00:00Z","author":{"login":"quince-coder"}}]' ;;
3) reviews='[{"state":"APPROVED","submittedAt":"2026-07-30T11:00:00Z","author":{"login":"quince-coder"}},
             {"state":"APPROVED","submittedAt":"2026-07-30T11:05:00Z","author":{"login":"someone-else"}}]' ;;
4) state=MERGED; merged=\"2026-07-30T11:10:00Z\" ;;
5) state=CLOSED; reviews='[{"state":"APPROVED","submittedAt":"2026-07-30T11:00:00Z","author":{"login":"quince-coder"}}]' ;;
esac
# PR 502 IS ALWAYS OPEN AND NEVER CHANGES, and it is not padding. Without it, turn 4 merges the only
# PR in the queue and the tick emits `event=queue-empty` — which is wake-worthy, and which woke the
# merged scenario for a reason that has nothing to do with suppression. A second PR keeps the queue
# non-empty so the merge can be observed alone.
cat <<ROW | jq -f "$STUB_INVERSE"
[{"number":501,"state":"$state","updatedAt":"2026-07-30T10:00:00Z","title":"t","headRefName":"r1/mine",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":$reviews,"comments":[],"commits":[],
  "mergedAt":$merged,"mergedBy":null,"mergeStateStatus":"CLEAN"},
 {"number":502,"state":"OPEN","updatedAt":"2026-07-30T10:00:00Z","title":"t","headRefName":"r1/other",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}]
ROW
STUB
chmod +x "$WORK/gh"
export STUB_WORK="$WORK"

./bin/forge-watch runner set r1 >/dev/null 2>&1 || {
	printf '  FAIL could not declare a runner name\n'
	exit 1
}
STATE=$(./bin/forge-watch runner path)/novkostya-quince.state.json
LEDGER=$(./bin/forge-ledger path)

# THE PATH AGREEMENT IS THE FIRST ASSERTION, because every other one in this file silently degrades
# to "nothing was suppressed" if the two programs disagree about where the ledger lives — and
# "nothing was suppressed" is also what a correctly-empty ledger looks like.
case "$LEDGER" in
"$(./bin/forge-watch runner path)"/*) ok "forge-ledger's path is under this runner's state dir (per-runner by construction)" ;;
*) bad "forge-ledger path '$LEDGER' is not under $(./bin/forge-watch runner path)" ;;
esac

run_watch() {
	printf '%s\n' "$1" >"$WORK/turn"
	./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues \
		--interval 1 --max-wait "$2" >"$WORK/out" 2>&1 || true
}
baseline() {
	rm -f "$STATE" "$LEDGER"
	run_watch 1 3
	grep -q 'watch-idle' "$WORK/out" || printf '  note: baseline did not settle idle\n'
}
# THE POST-CONDITION IS NOT OPTIONAL, and this suite learned why the hard way. `forge-ledger` fails
# OPEN by design: an argv it cannot attribute writes nothing and exits 0. So "no row" is what a
# BROKEN writer and a quiet correct one both look like, and the first version of this file asserted
# only that a row had been CONSUMED — which passed against a row that was never written, while the
# `2>/dev/null` DOES NOT COVER A SHELL REDIRECTION FAILURE — it silences the command, and
# `<"$LEDGER"` on an absent file is the SHELL failing before `wc` ever runs. `baseline` removes the
# ledger, so every one of these leaked a `can't open … no such file` line into the suite output.
# Same defect the loop's liveness probe had (2026-07-30 journal); guard the file, do not silence it.
# real bug (the parser stopped scanning one word before `--repo`) failed every other assertion. A
# helper that does not check its own effect makes every later assertion conditional on a silence.
record() {
	_before=$({ [ -f "$LEDGER" ] && wc -l <"$LEDGER"; } || printf 0)
	./bin/forge-ledger record pr "$1" 501 --repo "$REPO"
	_after=$({ [ -f "$LEDGER" ] && wc -l <"$LEDGER"; } || printf 0)
	[ "$_after" -eq $((_before + 1)) ] || {
		printf '  FAIL forge-ledger recorded nothing for "pr %s 501 --repo %s"\n' "$1" "$REPO"
		fail=$((fail + 1))
	}
}

# (1) THE CORE CASE: one verdict, one row, no wake.
baseline
record review
run_watch 2 4
if grep -q 'event=review pr=501 count=1' "$WORK/out"; then
	ok "the self-caused review is still PRINTED (the filter decides waking, not seeing)"
else
	bad "expected event=review pr=501 to be printed"
	sed -n '1,8p' "$WORK/out"
fi
if grep -q 'note: 1 self-caused event(s) suppressed' "$WORK/out"; then
	ok "the suppression is REPORTED, not silent"
else
	bad "no note — a suppression nobody can see is indistinguishable from a missed event"
	sed -n '1,8p' "$WORK/out"
fi
if grep -q 'watch-idle' "$WORK/out"; then
	ok "this runner's own verdict does NOT wake it"
else
	bad "woke on its own recorded verdict"
	sed -n '1,8p' "$WORK/out"
fi

# (2) CONSUME-ONCE. The row is spent by (1); nothing else may ever use it.
if [ ! -s "$LEDGER" ]; then
	ok "the row was consumed — the ledger is empty again"
else
	bad "the row survived the suppression it caused: $(cat "$LEDGER")"
fi

# (3) THE COUNT GUARD, which is the whole reason quince#242 step 1 exists. Two verdicts landed in
# one tick and only ONE of them is mine — the other seat's must still wake me. Suppressing on
# presence alone would swallow it, and a MISSED wake is the expensive direction.
baseline
record review
run_watch 3 6
if grep -q 'EXITING on the event' "$WORK/out" && grep -q 'count=2' "$WORK/out"; then
	ok "count=2 against ONE recorded verdict still WAKES — another seat's verdict is in there"
else
	bad "suppressed a two-verdict event holding only one of mine — a missed wake"
	sed -n '1,8p' "$WORK/out"
fi
if grep -q 'note: .* self-caused' "$WORK/out"; then
	bad "reported a suppression on the tick it correctly refused to suppress"
else
	ok "nothing claimed suppressed when nothing was (the note's control)"
fi

# (4) …and the ledger is UNTOUCHED when the guard refuses. A row spent on an event that still woke
# the session would be a row unavailable to the event it was actually for.
if [ "$({ [ -f "$LEDGER" ] && wc -l <"$LEDGER"; } || printf 0)" -eq 1 ]; then
	ok "the refused suppression left the row unspent"
else
	bad "the row was consumed by an event that woke anyway"
fi

# (5) BOTH verdicts accounted for: two rows, count=2, silent.
baseline
record review
record review
run_watch 3 4
# THE NOTE COUNTS EVENT LINES, NOT VERDICTS — `1`, from a line that spent TWO rows. That is the
# right unit for a note about a wake decision (one line was withheld from it), and this assertion
# expected `2` at first, which is the reading a reader might also reach. Pinned at `1` so the two
# units cannot be quietly swapped: `note: 2` here would mean two separate events were suppressed.
if grep -q 'watch-idle' "$WORK/out" && grep -q 'note: 1 self-caused' "$WORK/out"; then
	ok "count=2 against TWO recorded verdicts suppresses the line, spending both rows"
else
	bad "did not suppress a two-verdict event fully accounted for"
	sed -n '1,8p' "$WORK/out"
fi

# (6) `event=merged` takes NO count and needs none — a PR merges once, so presence is unambiguous.
baseline
record merge
run_watch 4 4
if grep -q 'event=merged pr=501' "$WORK/out" && grep -q 'watch-idle' "$WORK/out"; then
	ok "a merge this runner performed does not wake it (presence, no count)"
else
	bad "woke on its own merge"
	sed -n '1,8p' "$WORK/out"
fi

# (6b) `event=closed` IS A NEW EVENT AND THEREFORE A NEW WAY FOR quince#242's DEFECT TO ARRIVE
# (quince#390). A session that closes its own pull request must not be woken by it, and nothing gave
# the ledger a `pr close` verb until now — the same hole as (6), reached through a new EVENT rather
# than a new verb, which is how it will keep being reached.
#
# `approvals=1` travels with the event and must NOT break the match: the awk keys on
# repo+number+subject+kind and ignores every other field, so a discriminator added to the line cannot
# quietly stop suppression working. Asserted rather than assumed, because that is exactly the kind of
# coupling that breaks silently.
#
# THE EXTRA SEEDING TICK IS LOAD-BEARING. Turn 5 carries the APPROVED review so that `approvals=1` is
# non-trivial, and `baseline` settles on turn 1, which has none — so going straight from 1 to 5 emits
# an unrecorded `event=review` ALONGSIDE the close, and the runner wakes on the review while the close
# is suppressed exactly as intended. The first draft of this case did that and read as "woke on its
# own close"; the suppression note in the output said `1 self-caused event(s) suppressed` the whole
# time. Seeding turn 2 first puts the review in the previous observation, so turn 5 adds only the
# close and the assertion is about one event.
baseline
run_watch 2 4
record close
run_watch 5 4
if grep -q 'event=closed pr=501 approvals=1' "$WORK/out" && grep -q 'watch-idle' "$WORK/out"; then
	ok "a close this runner performed does not wake it, and approvals= does not break the match"
else
	bad "woke on its own close, or the event did not carry approvals="
	sed -n '1,8p' "$WORK/out"
fi

# (6c) THE NEGATIVE CONTROL FOR (6b), and the direction that matters: SOMEBODY ELSE's close must still
# wake this runner. Without it (6b) would pass against a build that suppressed every close, or that
# never emitted the event at all — and a missed wake is the expensive direction. An approved PR
# closing with nobody's name on it is precisely what quince#390 was filed for.
baseline
run_watch 2 4
run_watch 5 6
if grep -q 'event=closed pr=501 approvals=1' "$WORK/out" && grep -q 'EXITING on the event' "$WORK/out"; then
	ok "a close this runner did NOT perform wakes it — the event exists and is wake-worthy"
else
	bad "a close nobody recorded failed to wake — the event is missing or wrongly suppressed"
	sed -n '1,8p' "$WORK/out"
fi

# (7) NO LEDGER, NO SUPPRESSION — the pre-quince#242 behaviour, which is what a box with no declared
# runner and a session that has performed no acts must both still get. Fail open, everywhere.
baseline
run_watch 2 6
if grep -q 'EXITING on the event' "$WORK/out"; then
	ok "with an empty ledger every event wakes exactly as before"
else
	bad "suppressed something with no ledger to justify it"
	sed -n '1,8p' "$WORK/out"
fi

# (8) THE WRITER'S NARROWNESS, asserted rather than assumed. `pr comment` produces
# `issue-comment` and `issue comment` produces the same — both already carry `actor=` and are
# the actor arm's business; a row for either would be a second mechanism for a problem that
# has one. `view` is read-only and produces no event at all.
#
# UPDATED BY quince#307: `issue close` and `issue reopen` ARE now recorded, so this case no
# longer means "nothing about issues is recorded" — it means the vocabulary is still exactly
# the events that carry no actor. The old label said "comment, view and issue write nothing",
# which would have gone quietly false.
rm -f "$LEDGER"
./bin/forge-ledger record pr comment 501 --repo "$REPO"
./bin/forge-ledger record pr view 501 --repo "$REPO"
./bin/forge-ledger record issue view 12 --repo "$REPO"
./bin/forge-ledger record issue comment 12 --repo "$REPO"
if [ ! -s "$LEDGER" ]; then
	ok "comment and view write nothing, on EITHER subject — the vocabulary is the actorless events"
else
	bad "recorded a verb whose event already carries an actor: $(cat "$LEDGER")"
fi

# (9) FAIL OPEN ON AN UNATTRIBUTABLE ACT. `gh` would resolve a missing --repo from the checkout's
# remote; this must not guess, because a row against the wrong PR suppresses an event nobody caused.
./bin/forge-ledger record pr review 501
./bin/forge-ledger record pr review --repo "$REPO"
if [ ! -s "$LEDGER" ]; then
	ok "no --repo, or no number: no row, so the wake stands"
else
	bad "guessed a target it was not given: $(cat "$LEDGER")"
fi


# --- quince#307: the issue surface ------------------------------------------------------------
#
# (9) AN ISSUE ROW MUST NOT SUPPRESS A PR EVENT. Both
# repositories carry a PR 501 and an issue 501. A row recorded for CLOSING ISSUE 501 must not
# suppress a REVIEW on PR 501 — that would be a missed wake, the one direction this subsystem must
# never fail in.
#
# WHAT GUARANTEES IT IS THE KIND, NOT THE SUBJECT FIELD, and this comment said otherwise until it
# was measured: collapsing the subject on both sides leaves this case passing, because `review` and
# `issue-closed` are already different kinds. The subject is future-proofing for `pr close` (see
# forge-ledger's header); this case pins the PROPERTY, and no case pins the field. Said out loud
# rather than left as implied coverage. No issue stub needed: the row is written for the issue,
# the event arrives for the PR.
baseline
_before=$({ [ -f "$LEDGER" ] && wc -l <"$LEDGER"; } || printf 0)
./bin/forge-ledger record issue close 501 --repo "$REPO"
_after=$({ [ -f "$LEDGER" ] && wc -l <"$LEDGER"; } || printf 0)
if [ "$_after" -eq $((_before + 1)) ]; then
	ok "an 'issue close' is recorded (the writer's new vocabulary reaches the ledger)"
else
	bad "forge-ledger recorded nothing for 'issue close 501'"
fi
run_watch 2 6
if grep -q 'EXITING on the event' "$WORK/out"; then
	ok "a closed ISSUE 501 does not suppress a review on PR 501 (guaranteed by the kind)"
else
	bad "an issue row swallowed a PR event of the same number: a MISSED wake, which is the direction that must never fail"
	sed -n '1,8p' "$WORK/out"
fi

# (10) THE LEGACY ROW. Rows written before quince#307 have three fields and no subject. They are
# migrated as `pr`, which is what every one of them is. Ignoring them instead would leave them
# unconsumed forever, and the act each explains would wake the session anyway — silent, and
# indistinguishable from a quiet forge.
baseline
mkdir -p "$(dirname "$LEDGER")"   # baseline can leave the dir absent; without this the write fails and the case is vacuous
printf '%s 501 merged\n' "$REPO" >"$LEDGER"
run_watch 4 4
if grep -q 'event=merged pr=501' "$WORK/out" && grep -q 'watch-idle' "$WORK/out"; then
	ok "a THREE-field row written before quince#307 still suppresses (migrated as subject 'pr')"
else
	bad "a legacy row stopped being honoured — every row on every box at upgrade time is one of these"
	sed -n '1,8p' "$WORK/out"
fi


# --- THE SUPPRESSION ITSELF, which is this change's headline claim (review finding on quince#319) --
#
# The cases above test the WRITER: a row appears after `forge-ledger record issue close`. Nothing
# drove an `event=issue-closed` line through the FILTER, so deleting the reader's `issue-closed` arm
# left the suite at 16/16 — measured by the reviewer, and it is exactly the shape `CLAUDE.md` calls a
# finding rather than accepted debt: undeclared untested behaviour, and the behaviour is the point of
# the PR.
#
# A SECOND STUB rather than more turns on the first: `$WORK/gh` deliberately holds `updatedAt` still
# so typed PR events can be observed alone, and it answers `issue view` with `{}`. Teaching it issues
# would entangle two fixtures whose whole design is that each isolates one line.
cat >"$WORK/gh_issue" <<'STUB2'
#!/bin/sh
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
if [ "$1" = issue ] && [ "$2" = list ]; then printf '[]\n'; exit 0; fi
if [ "$1" = issue ] && [ "$2" = view ]; then
  st=OPEN; closed=null; up=2026-07-30T10:00:00Z
  if [ "$turn" != 1 ]; then st=CLOSED; closed=\"2026-07-30T11:00:00Z\"; up=2026-07-30T11:00:00Z; fi
  printf '{"number":900,"state":"%s","updatedAt":"%s","closedAt":%s,"stateReason":"COMPLETED","labels":[],"comments":[]}\n' "$st" "$up" "$closed"
  exit 0
fi
# One unchanging PR so the queue is never empty — `queue-empty` is wake-worthy and would decide these
# cases for a reason unrelated to suppression, the same trap PR 502 exists for above.
cat <<ROW | jq -f "$STUB_INVERSE"
[{"number":502,"state":"OPEN","updatedAt":"2026-07-30T10:00:00Z","title":"t","headRefName":"r1/other",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}]
ROW
STUB2
chmod +x "$WORK/gh_issue"

run_issue_watch() { # <turn> <max-wait>
	printf '%s\n' "$1" >"$WORK/turn"
	./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh_issue" --issue 900 \
		--interval 1 --max-wait "$2" >"$WORK/out" 2>&1 || true
}
issue_baseline() {
	rm -f "$STATE" "$LEDGER"
	run_issue_watch 1 3
}

# (11) THE ARM WORKS, AND IT IS NOT ENOUGH — both halves asserted, because the second is the finding.
#
# Closing an issue emits TWO lines. The ledger arm suppresses `issue-closed`. The backstop
# `issue-updated` carries `actor=unattributed` — `gh issue view` does not report who closed an issue —
# and unknown wakes, so the tick wakes anyway.
#
# This is `bin/forge-ledger`'s own warning arriving on a surface it did not anticipate: *"This tool
# alone does NOT reduce wakes — the act's other line still fires … it is why the ruling says both
# arms or neither."* On the PR surface the other arm is the ACTOR arm, which reads `actor=` off
# `event=updated`. On the issue surface there is no other arm, because the backstop has no actor to
# read. So the two-mechanism split that works for a PR act has no counterpart here.
#
# Asserted rather than declared, so nobody has to rediscover it: the first half pins the arm this PR
# adds, the second pins the gap it does not close. If a later change makes the tick quiet, THIS case
# fails and its author is told exactly which sentence to update.
issue_baseline
mkdir -p "$(dirname "$LEDGER")"
./bin/forge-ledger record issue close 900 --repo "$REPO"
run_issue_watch 2 5
if grep -q 'event=issue-closed issue=900' "$WORK/out"; then
	ok "the self-caused issue-closed is still PRINTED (the filter decides waking, not seeing)"
else
	bad "expected event=issue-closed issue=900 to be printed"
	sed -n '1,10p' "$WORK/out"
fi
if grep -q 'self-caused event(s) suppressed' "$WORK/out"; then
	ok "…and it is SUPPRESSED from the wake decision, and the suppression is reported"
else
	bad "the reader's issue-closed arm did not fire — the arm this PR adds is not working"
	sed -n '1,10p' "$WORK/out"
fi
if grep -q 'event=issue-updated issue=900 .*actor=unattributed' "$WORK/out" &&
	grep -q 'EXITING on the event' "$WORK/out"; then
	ok "…but the tick STILL WAKES on the unattributed backstop — the gap, pinned rather than described"
else
	bad "the backstop no longer wakes: this PR's stated limitation has changed and the text must too"
	sed -n '1,10p' "$WORK/out"
fi

# (12) THE CONTROL. Without it (11)'s middle assertion passes against a reader that suppresses EVERY
# issue-closed, including one somebody else performed on an issue this session declared — the signal
# the declared set exists for, and the direction that must never fail.
issue_baseline
run_issue_watch 2 6
if grep -q 'self-caused event(s) suppressed' "$WORK/out"; then
	bad "suppressed an issue-closed nobody recorded performing: a missed wake"
	sed -n '1,10p' "$WORK/out"
else
	ok "an issue closed with NO row is not suppressed — somebody else's close stays a signal"
fi
printf '\nforge-watch-selfcaused-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
