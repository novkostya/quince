#!/bin/sh
# wrapper-body-test — EVERY gh wrapper must REFUSE inline `--body` (quince#518, quince#527).
#
# WHY THIS EXISTS. On 2026-08-02 a comment written as `--body "…prose with `iostat`…"` had its
# backticks evaluated as COMMAND SUBSTITUTION by the shell. `iostat` RAN, and its output — a PVE
# host's block-device map and guest count — was published to a public issue. The same session, the
# same construct twice more silently ATE filenames out of sentences.
#
# AND THE SAME BUG IS IN THIS REPOSITORY'S HISTORY THROUGH THE ARCHITECT'S WRAPPER, an hour before
# that: a review comment's backticked spans were evaluated, the shell tried to execute two
# committed paths, and the posted comment TRUNCATED mid-sentence and lost both of its numbered
# points. It was harmless for one reason — neither path is an executable. `iostat` is. **Which
# wrapper leaks and which merely truncates is decided by whether the prose happens to name
# something on $PATH**, so the guard belongs on all of them or on none.
#
# AND IT IS THE ONE PATH THE PRIVACY GATE CANNOT COVER: `make privacy-check TEXT=<file>` needs a
# file, and `--body` has none. The single text in that session that could not be swept is the one
# that leaked — not a gate failure, an invocation that gave the gate nothing to read.
#
# THERE IS NO PATTERN REMEDY, which is why the control is a wrapper refusal and why it is worth
# pinning. The leaked strings were a hostname canon deliberately publishes in seven files (a
# pattern for it would fail `privacy-check` on `CLAUDE.md` forever), kernel-assigned device names,
# a core count and a version — unpatternable by construction.
#
# THIS FILE WAS `gh-coder-body-test` AND COVERED ONE WRAPPER OF FOUR. That is the shape quince#527
# was filed about: the guard landed on the wrapper where the leak happened, and the wrapper where
# the SAME BUG had already been demonstrated kept accepting inline bodies. Renamed rather than
# copied, because four near-identical suites is how one of them drifts.
#
# THE SUBJECTS ARE DISCOVERED, NOT LISTED — see WRAPPERS below. A list is what let this go stale
# once already.
set -eu

cd "$(dirname "$0")/.."
here=$PWD/bin
pass=0
fail=0

ok() { pass=$((pass + 1)); printf '  ok   %s\n' "$1"; }
no() { fail=$((fail + 1)); printf '  FAIL %s\n' "$1"; }

# EVERY WRAPPER THAT CAN POST, FOUND RATHER THAN NAMED. A hand-written list is exactly what left
# `gh-review` unguarded for a week — so this asks the tree instead: an executable `bin/gh-*` that
# is not itself a test. `bin/gh-arch` was deleted (e92bc34) and disappears from here by
# construction; a fifth wrapper added tomorrow is covered the day it lands, and fails this suite
# until its author adds the guard.
WRAPPERS=$(find bin -maxdepth 1 -name 'gh-*' -type f -perm -u+x ! -name '*-test' | sort)
[ -n "$WRAPPERS" ] || {
	printf 'wrapper-body-test: DID NOT RUN — found no gh wrappers under bin/\n' >&2
	exit 2
}
# Refuse to report a clean sweep of a set that cannot be right. Below this, the discovery is broken
# rather than the tree being small, and a suite that passes over nothing is the defect it guards.
_n=$(printf '%s\n' "$WRAPPERS" | wc -l | tr -d ' ')
[ "$_n" -ge 2 ] || {
	printf 'wrapper-body-test: DID NOT RUN — discovered only %s wrapper(s); the glob is wrong.\n' "$_n" >&2
	exit 2
}
_names=$(printf '%s\n' "$WRAPPERS" | sed 's|.*/||' | tr '\n' ' ')
printf 'wrapper-body-test: %s wrapper(s) under test — %s\n' "$_n" "${_names% }"

for w in $WRAPPERS; do
	n=$(basename "$w")

	# Exit 2, not 1: this is DID NOT RUN, the same convention `privacy-check` and
	# `closing-refs-check` use for "the thing you asked for was not attempted". A 1 would read as
	# "the call was made and the forge refused it" — and on these boxes a 1 is exactly what the
	# BOUNDARY refusal returns, so the two are distinguishable by code as well as by message.
	"$w" issue comment 1 --repo x/y --body "hi" >/dev/null 2>&1 && rc=0 || rc=$?
	if [ "${rc:-0}" -eq 2 ]; then ok "$n: --body is refused with exit 2"; else no "$n: --body exit = ${rc:-0}, want 2"; fi

	# THE ATTACHED FORMS, which is where the first version of this guard had a hole. `gh` uses
	# pflag, which accepts `--body=…` and `-b…` as well as the separated forms — so a guard
	# matching only `--body` and `-b` stops the shape you happened to write and not the one beside
	# it, which is worse than no guard because it teaches that the path is closed.
	#
	# MEASURED, both directions: `--body=x` was ALREADY refused by the `--body=*` pattern; `-bx`
	# was NOT, and is the one that got through.
	"$w" issue comment 1 --repo x/y --body=hi >/dev/null 2>&1 && rc=0 || rc=$?
	if [ "${rc:-0}" -eq 2 ]; then ok "$n: --body=… (attached long form)"; else no "$n: --body=… exit = ${rc:-0}, want 2"; fi

	"$w" pr create --repo x/y -b hi >/dev/null 2>&1 && rc=0 || rc=$?
	if [ "${rc:-0}" -eq 2 ]; then ok "$n: -b, the short form"; else no "$n: -b exit = ${rc:-0}, want 2"; fi

	"$w" issue comment 1 --repo x/y -bhi >/dev/null 2>&1 && rc=0 || rc=$?
	if [ "${rc:-0}" -eq 2 ]; then ok "$n: -b… (attached shorthand — the bypass)"; else no "$n: -b… exit = ${rc:-0}, want 2"; fi

	# THE REFUSAL MUST NAME THE REPLACEMENT. A refusal that does not say what to do instead gets
	# worked around, which for this one means back to inline text somewhere else.
	out=$("$w" issue comment 1 --repo x/y --body "hi" 2>&1 || :)
	case "$out" in
	*--body-file*) ok "$n: the refusal names --body-file" ;;
	*) no "$n: the refusal does not name the replacement" ;;
	esac
	case "$out" in
	*privacy-check*) ok "$n: the refusal names the sweep it makes possible" ;;
	*) no "$n: the refusal does not mention privacy-check" ;;
	esac

	# AND IT MUST NOT REFUSE THE THING IT IS RECOMMENDING. A guard that matched `--body-file` by
	# prefix would refuse the only correct invocation, which is the failure mode this suite exists
	# to catch as much as the leak is.
	#
	# ASSERTED ON THE MESSAGE, NOT THE EXIT CODE, and that is what makes it portable across seats:
	# on this box every wrapper but one meets its BOUNDARY refusal here and exits non-zero. What
	# must never appear is the body refusal, and that is what is checked.
	case $("$w" pr create --repo x/y --body-file /dev/null 2>&1 || :) in
	*"REFUSING --body"*) no "$n: --body-file was caught by the --body match" ;;
	*) ok "$n: --body-file is not caught by the --body match" ;;
	esac
done

# THE NEGATIVE CONTROL, on the one wrapper that can actually reach the forge from this box. Without
# it, every assertion above is satisfied by a wrapper that refuses EVERYTHING, which is a guard that
# has broken the tool it guards.
case $("$here"/gh-coder issue view 378 --repo novkostya/quince --json number 2>&1 || :) in
*REFUSING*) no "gh-coder: a normal verb was refused" ;;
*) ok "gh-coder: an ordinary call still passes through" ;;
esac

# THE BOUNDARY, chosen rather than overlooked: a combined shorthand CLUSTER carrying `b` in a
# non-leading position (`-Rb…`) still passes. Nobody writes a body that way, and covering it
# means parsing clusters — more machinery than the risk earns. Recorded so the next reader
# knows the line was drawn on purpose.

printf 'wrapper-body-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
