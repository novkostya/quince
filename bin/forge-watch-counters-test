#!/bin/sh
# forge-watch-counters-test — the loop counts its own cycles, and the count SURVIVES (quince#282 #4).
#
# WHY A SUITE AND NOT A FIXTURE. The loop fixtures assert only lines matching `^event=` — the harness
# greps for exactly that before comparing — so a `loop: N arm(s) …` report is invisible to every one
# of them. A counter with no coverage in a directory full of coverage is the shape this project keeps
# filing, so it gets a driver of its own.
#
# WHAT IT IS FOR. `status` answers "is the watch live". Nothing answered "what has this loop cost" —
# the architect seat armed 63 times and exited 53 in one session and found out only by being asked to
# reflect (quince#282). A gate that reports what it covered is this project's answer to everything
# else; the loop reported only that it woke.
#
# THE PERSISTENCE ASSERTION IS THE ONE THAT MATTERS, and it is here because the first version of the
# feature FAILED it. `watch_arm` incremented correctly and `step` erased it on the very next tick:
# step writes the OBSERVATION as the new state, and an observation has no `.arms`. That is quince#103
# exactly, one field over — the watcher record needed the same carry-forward for the same reason. It
# was found by arming a live watch and reading back `arms=unset`, NOT by reading the code, because
# the increment was correct in isolation and only its persistence was wrong.
#
# Synthetic and hermetic: its own XDG_STATE_HOME, a stub gh, no network, no credential.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export XDG_STATE_HOME="$WORK/state"
export QUINCE_SESSION_ID=counters-test-session
FORGE_SEATS_FILE="$WORK/seats"
export FORGE_SEATS_FILE
printf 'r1\n' >"$FORGE_SEATS_FILE"
REPO=novkostya/quince

# A stub that answers the queue with an empty list and the discovery scan with an empty repo, so the
# watch runs to its idle bound without ever waking. Quiet is what these assertions need: a wake would
# end the loop early and make the arm count depend on timing.
cat >"$WORK/gh" <<'STUB'
#!/bin/sh
case "$1 ${2:-}" in
"issue list") printf '[]\n'; exit 0 ;;
"issue view") printf '{}\n'; exit 0 ;;
esac
printf '{"data":{"repository":{"pullRequests":{"nodes":[]}}}}\n'
STUB
chmod +x "$WORK/gh"

./bin/forge-watch runner set r1 >/dev/null 2>&1 || {
	printf 'forge-watch-counters-test: could not declare a runner — DID NOT RUN\n' >&2
	exit 2
}
STATE="$(./bin/forge-watch runner path)/novkostya-quince.state.json"

arm_once() {
	./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues \
		--interval 1 --max-wait 2 >"$WORK/out" 2>&1 || true
}

# (1) THE COUNT SURVIVES TICKS. Three arms, each running several ticks to its idle bound. If `step`
# does not carry the counters forward, this reads 1 — which is exactly what the first version did.
arm_once
arm_once
arm_once
_arms=$(jq -r '.arms // 0' "$STATE" 2>/dev/null || printf 0)
if [ "$_arms" = 3 ]; then
	ok "three arms count three, so the counter survives the ticks between them"
else
	bad "expected arms=3, got $_arms — step is erasing the counter (quince#103's shape)"
fi

# (2) AN IDLE EXIT IS A CYCLE BUT NOT A WAKE. Counting idle exits as wakes would make a quiet hour
# look busy, which inverts the very ratio this exists to expose.
_wakes=$(jq -r '.wakes // 0' "$STATE" 2>/dev/null || printf 0)
if [ "$_wakes" = 0 ]; then
	ok "an idle exit is counted as an arm and NOT as a wake"
else
	bad "expected wakes=0 after idle-only runs, got $_wakes"
fi

# (3) IT IS REPORTED WHERE A SESSION LOOKS. A counter nothing prints is a counter nobody reads, and
# the defect this closes was precisely an unreported aggregate.
./bin/forge-watch status --repo "$REPO" >"$WORK/st" 2>&1 || true
if grep -q '^loop: 3 arm(s), 0 wake(s)' "$WORK/st"; then
	ok "status reports the cumulative figures"
else
	bad "status does not report the loop totals"
	grep -E '^loop:|^watch=' "$WORK/st" | sed 's/^/    | /'
fi
# THE NUMBER, NEVER A JUDGEMENT (ruling constraint 3). 63 arms is alarming in a quiet hour and
# unremarkable in the hour twenty PRs landed; the reader has that context and the tool does not.
if grep -qiE 'loop:.*(high|excessive|too many|consider|warning)' "$WORK/st"; then
	bad "the report editorialises — constraint 3 is the number and no threshold"
else
	ok "the report states the number and passes no judgement (constraint 3)"
fi
# AND IT SAYS WHAT IT DOES NOT COUNT (constraint 4). A figure whose basis is unstated is the defect
# one layer up from the one it fixes.
#
# THE BLIND SPOT MOVED TWICE, and this assertion is what forced the wording to move with it both
# times. It first pinned "not WHOSE wakes" — true while the suppression arms did not exist, false the
# hour they merged, so the suite failed on prose that had become a claim pointing at a closed issue.
# It then pinned "prevented … not counted", which lasted until the counter existed.
#
# The blind spot is now GONE rather than renamed: `prevented` is reported, so constraint 4 is
# satisfied by the line DEFINING its own metric instead of apologising for a missing one. That is
# what this pins — a bare number called `prevented` would be a new ambiguity, since the obvious
# reading is "events suppressed" and the figure is ticks.
#
# Pinned on the definition clause rather than the whole sentence: the claim is that the line states
# its own basis, not that it states it in one phrasing.
if grep -q 'prevented = ticks where self-caused suppression was the difference' "$WORK/st"; then
	ok "the report DEFINES its own metric rather than naming a missing one (constraint 4)"
else
	bad "the loop line reports a bare 'prevented' with no basis, or still names a retired blind spot"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
fi
# AND A ZERO IS PRINTED AS A RESULT. Nothing has been suppressed in this suite, so `0 prevented` is
# the true answer and must appear — a counter that stayed silent until it turned positive would be
# unfalsifiable, which is the shape it exists to stop the loop reporting about itself.
if grep -q '^loop: .*, 0 prevented ' "$WORK/st"; then
	ok "a zero prevented count is reported, not withheld until it is flattering"
else
	bad "the prevented figure is hidden at zero — the number cannot be falsified"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
fi

# (3b) THE SCOPE IS IN THE LINE (quince#296). A `--repo` report reads ONE state file and an `--all`
# report SUMS the forge set, and both said "for this runner" in identical words — so a summed `2/2`
# and a per-repo `2/1`, read forty minutes apart, looked like a counter going BACKWARDS, which is
# impossible by design. Both numbers were correct. The sum and the slice are both small integers that
# look like the same quantity: a plausible wrong number rather than an obviously broken one.
if grep -qE '^loop: .* for [^ ]+/[^ ]+ since' "$WORK/st"; then
	ok "a per-repo report NAMES the repo, so the figure carries its own denominator"
else
	bad "the per-repo loop line does not name its repo — it is indistinguishable from an --all sum"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
fi
# The control, and it is the assertion that would catch a scope label added to only ONE of the two
# paths — which is the same shape as the defect, one level shallower.
if grep -q '^loop: .* for this runner ' "$WORK/st"; then
	bad "the loop line still says 'for this runner', the wording that answered two questions at once"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
else
	ok "the ambiguous 'for this runner' wording is gone (the control)"
fi

# (3c) THE OTHER SIDE OF THE PAIR. The defect IS the `--all`/`--repo` pair, so a suite that labelled
# only one side would be the same shape one level shallower — which is exactly what the control above
# guards against, and it would be absurd to write that control and then test one path.
#
# `--all` reads the forge set and sums one state file per repo. Two repos, so the summed figure and
# the per-repo one are DIFFERENT numbers here: 6 arms across 2 repos against 3 for one. A fixture
# where they coincided would pass against a tool that had swapped the two labels.
FORGE_SET_FILE="$WORK/forge-set"
export FORGE_SET_FILE
printf '%s\nnovkostya/quince-devlog\n' "$REPO" >"$FORGE_SET_FILE"
cp "$STATE" "$(./bin/forge-watch runner path)/novkostya-quince-devlog.state.json"
./bin/forge-watch status --all >"$WORK/stall" 2>&1 || true
if grep -qE '^loop: .* across 2 repo\(s\) in the forge set ' "$WORK/stall"; then
	ok "an --all report says ACROSS N repos, so a sum cannot be read as a slice"
elif grep -qE '^loop: .* for [^ ]+/[^ ]+ since' "$WORK/stall"; then
	# `status --all` prints one per-repo block per repo and never sums, which is itself a correct
	# answer to quince#296 — the ambiguity was between `status --repo` and the `watch --all` EXIT.
	# Recorded as a pass with its reason rather than silently, because the assertion above is the one
	# a reader expects to fire and it does not.
	ok "status --all prints per-repo lines, each naming its repo — it never sums, so nothing is ambiguous"
else
	bad "an --all status carries a loop line that names neither a repo nor a repo count"
	grep '^loop:' "$WORK/stall" | sed 's/^/    | /'
fi

# (4) THE EXIT LINE CARRIES IT TOO, so a woken session sees the cost without asking.
if grep -q '^loop: ' "$WORK/out"; then
	ok "the watch exit line reports the totals as well as status"
else
	bad "the exit line does not carry the totals"
	tail -3 "$WORK/out" | sed 's/^/    | /'
fi

# (4b) AND THE `--all` EXIT LINE IS THE ONE THAT WAS ACTUALLY MISREAD (quince#296). (3c) established
# that `status --all` never sums, so this is the ONLY summing path in the tool — the `2/2` the
# architect compared against a per-repo `2/1`. Asserting it here rather than trusting (3c)'s elif:
# that branch passing means the ambiguity lives entirely on this line, which makes it the assertion
# that matters most, not the one that can be skipped.
#
# The two state files hold identical counts, so a SUM and a SLICE are different numbers and a tool
# that labelled the sum as a slice would fail rather than coincide.
./bin/forge-watch watch --all --gh "$WORK/gh" --no-issues --interval 1 --max-wait 3 >"$WORK/outall" 2>&1 || true
if grep -qE '^loop: .* across 2 repo\(s\) in the forge set ' "$WORK/outall"; then
	ok "the --all exit line says ACROSS N repos — the summed figure names itself as a sum"
else
	bad "the --all exit line does not declare its scope; a sum can still be read as one repo's slice"
	grep '^loop:' "$WORK/outall" | sed 's/^/    | /'
fi

# (5) SILENT BEFORE ANYTHING IS COUNTED. A box that has never armed under this build must not grow a
# `loop: 0 arm(s)` line on every status — noise that teaches the reader to skip the section.
: >"$WORK/fresh.json"
printf '{"observed":true,"prs":[]}\n' >"$WORK/fresh.json"
./bin/forge-watch status --repo "$REPO" --state "$WORK/fresh.json" >"$WORK/st0" 2>&1 || true
if grep -q '^loop: ' "$WORK/st0"; then
	bad "a state with no counters still printed a loop line"
	grep '^loop:' "$WORK/st0" | sed 's/^/    | /'
else
	ok "a state that has never been armed prints no loop line (the control)"
fi

# ---------------------------------------------------------------------------
# (6) EXIT CLASSES (quince#1265). Everything above pins `arms` and `wakes`, and the gap between them
# was the whole defect: three idle bounds and three failing exits produce the same `arms − wakes` and
# mean opposite things — the loop working versus the loop escalating.
#
# EVERY ARM AGAINST THIS STATE ENDS AT THE IDLE BOUND — the stub answers an empty queue, so nothing
# can wake — which makes `idle == arms` the invariant, and it holds however many arms the cases above
# have run by the time control reaches here.
#
# PINNED ON THE INVARIANT RATHER THAN ON A LITERAL, and the first version was the literal. It asserted
# `idle = 3` and read 4, being wrong about its own suite rather than about the tool: case (4b)'s
# `--all` arm covers this repo too. A count pinned to a moment in a suite that grows breaks on
# unrelated edits, and a test that cries wolf is one somebody eventually deletes.
#
# It is not vacuous. `arms > 0` is asserted alongside, so an unbumped counter fails rather than
# matching a zero; a bump on the wrong exit path breaks the equality; and `step` erasing it breaks it
# too — which is exactly what happened, reading 1 after three bounds, because the carry-forward at
# `bin/forge-watch:399` names its keys explicitly and did not yet name this one.
_idle=$(jq -r '.idle // 0' "$STATE" 2>/dev/null || printf 0)
_armsnow=$(jq -r '.arms // 0' "$STATE" 2>/dev/null || printf 0)
if [ "$_armsnow" -gt 0 ] && [ "$_idle" = "$_armsnow" ]; then
	ok "every arm in this suite ended at the idle bound and every one is counted (idle=$_idle=arms)"
else
	bad "idle=$_idle arms=$_armsnow — an idle exit is uncounted, counted on the wrong path, or erased by step"
fi

# (6b) AND IT IS REPORTED, not merely stored. quince-devlog#173's complaint was never that the idle
# exit did not happen — it was that the evidence "exists only in session scratch". A counter nothing
# prints reproduces that exactly.
if grep -qE '^loop: 3 arm\(s\), 0 wake\(s\), 3 idle bound\(s\), 0 failing exit\(s\), 0 prevented ' "$WORK/st"; then
	ok "the loop line reports idle bounds and failing exits as their own figures"
else
	bad "the loop line does not carry the exit classes"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
fi

# (6c) A FAILING EXIT IS `failing` AND NOT `idle`, which is the discrimination the issue asks for.
# A gh that cannot answer, with --fail-after 1, so the loop escalates on its first tick rather than
# reaching the bound. --max-wait is left long enough that an idle exit would be the WRONG answer and
# would be visible as one, rather than the two racing.
# IT MUST AUTHENTICATE AND THEN FAIL THE FETCH, which is not the same as failing everything. `watch`
# probes `api rate_limit` once at arm time and REFUSES a wrapper that cannot authenticate (quince#429)
# — so a stub that fails unconditionally never arms, and the case measures the arm-time guard instead
# of the exit class. That is what the first version of this stub did: exit 1, no arm, `failing=0`.
#
# The distinction is the point of the case. `--fail-after` is about ticks that cannot fetch on a watch
# that armed cleanly; the quince#429 refusal is about one that should never arm at all.
cat >"$WORK/gh-broken" <<'BROKEN'
#!/bin/sh
case "$1 ${2:-}" in
"api rate_limit") printf '4999\n'; exit 0 ;;
esac
printf 'stub: cannot reach the forge\n' >&2
exit 1
BROKEN
chmod +x "$WORK/gh-broken"
FAILSTATE="$WORK/failing.json"
printf '{}\n' >"$FAILSTATE"
# `|| _frc=$?` and NOT a bare invocation: this suite runs under `set -e` and exit 7 is the POINT of
# the case, so the unguarded form aborts the whole file — silently, because a suite that dies before
# its summary prints looks like a suite that ended. It did exactly that here, taking (6c) through
# (6f) with it while the twelve cases above still printed `ok`.
_frc=0
./bin/forge-watch watch --repo "$REPO" --state "$FAILSTATE" --gh "$WORK/gh-broken" --no-issues \
	--interval 1 --max-wait 60 --fail-after 1 >"$WORK/outfail" 2>&1 || _frc=$?
_f=$(jq -r '.failing // 0' "$FAILSTATE" 2>/dev/null || printf 0)
_fi=$(jq -r '.idle // 0' "$FAILSTATE" 2>/dev/null || printf 0)
if [ "$_frc" = 7 ] && [ "$_f" = 1 ] && [ "$_fi" = 0 ]; then
	ok "a failing-tick exit counts as failing and NOT as an idle bound (exit 7, failing=1, idle=0)"
else
	bad "exit=$_frc failing=$_f idle=$_fi — expected 7/1/0"
	tail -3 "$WORK/outfail" | sed 's/^/    | /'
fi

# (6d) AND THE FAILING PATH PRINTS THE LEDGER AT ALL. It printed none before quince#1265 — the one
# exit where the cumulative figures say the most was the one that reported nothing.
if grep -qE '^loop: 1 arm\(s\), 0 wake\(s\), 0 idle bound\(s\), 1 failing exit\(s\), ' "$WORK/outfail"; then
	ok "the failing exit reports the totals — previously the only exit path that printed none"
else
	bad "the failing exit still prints no loop line"
	tail -4 "$WORK/outfail" | sed 's/^/    | /'
fi

# (6e) THE LINE SAYS WHEN THE NEW FIGURES START, which is constraint 4 applied to a counter added to
# a ledger that already had history. A state file armed before this change carries `arms` and `wakes`
# with `idle` and `failing` at zero, so a reader subtracting them gets a plausible wrong number —
# quince#296's exact cost. The caveat is what stops that subtraction being made silently.
if grep -q 'so arms from before that are in neither' "$WORK/st"; then
	ok "the line declares that pre-quince#1265 arms are in neither new figure (constraint 4)"
else
	bad "the new figures are printed with no statement of when they began counting"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
fi

# (6f) AND THAT A REFUSED ARM IS IN NONE OF THEM. `watch_preflight` dies before `watch_arm`, so a
# refusal reaches no counter — stated because the retirement record that asked for this feature
# (quince-devlog#287) assumed the opposite, and a reader doing that arithmetic would be wrong.
if grep -q 'an arm refused at preflight is in none of these figures' "$WORK/st"; then
	ok "the line states that a refused arm is in no counter"
else
	bad "nothing says where a refused arm lands, and the obvious guess is wrong"
	grep '^loop:' "$WORK/st" | sed 's/^/    | /'
fi

printf '\nforge-watch-counters-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
