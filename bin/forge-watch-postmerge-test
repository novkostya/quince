#!/bin/sh
# forge-watch-postmerge-test — a post-merge housekeeping event must not wake, and a post-merge
# COMMENT must (quince#83).
#
# WHY A SUITE AS WELL AS THE TWO FIXTURES. The fixtures prove the LABEL: which events come out
# carrying `kind=post-merge`. Suppression is a different claim decided one layer out, in `watch_loop`,
# between the printing of events and the deciding on them — and the ruling's constraint 3 is worded
# as *"a post-merge comment still WAKES"*, which is a decision and not a label. A fixture asserting
# the label and a PR body claiming the behaviour is exactly the gap this project keeps filing, so the
# behaviour is driven here against the real `watch` verb.
#
# THE NEGATIVE CASE IS THE VALUABLE ONE. Suppression is a promise not to wake, so it is a chance to
# lose an event permanently, and the failure is invisible from the inside: nothing happens, which is
# also what a quiet forge looks like. A comment on a merged PR is a reviewer noting a follow-up, an
# Operator ruling in a thread, a correction — all things a session must be woken for.
#
# INDEPENDENT OF quince#242, which is constraint 4. Those arms key on the actor being this seat's
# own; this event is `unattributed` by construction. The suite pins the separation by asserting the
# post-merge note fires and the self-caused notes do NOT.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export XDG_STATE_HOME="$WORK/state"
export QUINCE_SESSION_ID=postmerge-test-session
REPO=novkostya/quince

# Pinned so the containerised gate cannot change the answer: `owed_role` reads which credential is
# present, and with none the role arm disables branch-ownership suppression — a different code path
# than this suite claims to measure. The trap `forge-watch-ownership-test` records being bitten by.
export QUINCE_CODER_KEY_FILE="$WORK/coder.pem"
export QUINCE_ARCH_TOKEN_FILE="$WORK/arch.token"
export QUINCE_BOT_TOKEN_FILE="$WORK/bot.token"
export QUINCE_REVIEW_KEY_FILE="$WORK/review.pem"
printf 'a credential\n' >"$QUINCE_CODER_KEY_FILE"

FORGE_SEATS_FILE=$WORK/seats
export FORGE_SEATS_FILE
printf '# fixture seats for forge-watch-postmerge-test\nr1\n' >"$FORGE_SEATS_FILE"

STUB_INVERSE="$PWD/bin/testdata/forge/gh-array-to-graphql.jq"
export STUB_INVERSE
[ -f "$STUB_INVERSE" ] || {
	printf 'forge-watch-postmerge-test: missing %s — DID NOT RUN\n' "$STUB_INVERSE" >&2
	exit 2
}

# Turn 1 baselines a PR that is ALREADY MERGED — which is the precondition, not a shortcut: the
# label needs `MERGED` at the PREVIOUS observation, so a fixture that merged during the tick under
# test would be measuring a different thing. Turn 2 moves `updatedAt` with nothing new in activity
# (the branch deletion). Turn 3 moves it with a COMMENT.
cat >"$WORK/gh" <<'STUB'
#!/bin/sh
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
case "$1 ${2:-}" in
"issue list") printf '[]\n'; exit 0 ;;
"issue view") printf '{}\n'; exit 0 ;;
esac
up=2026-07-30T07:10:00Z
comments='[]'
case "$turn" in
2) up=2026-07-30T07:15:00Z ;;
3) up=2026-07-30T07:20:00Z
   comments='[{"createdAt":"2026-07-30T07:20:00Z","author":{"login":"novkostya"}}]' ;;
esac
cat <<ROW | jq -f "$STUB_INVERSE"
[{"number":801,"state":"MERGED","updatedAt":"$up","title":"t","headRefName":"r1/landed",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":$comments,"commits":[],
  "mergedAt":"2026-07-30T07:10:00Z","mergedBy":{"login":"app/quince-review"},"mergeStateStatus":"UNKNOWN"},
 {"number":802,"state":"OPEN","updatedAt":"2026-07-30T07:00:00Z","title":"t","headRefName":"r1/open",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}]
ROW
STUB
chmod +x "$WORK/gh"
export STUB_WORK="$WORK"

./bin/forge-watch runner set r1 >/dev/null 2>&1 || {
	printf '  FAIL could not declare a runner name\n'
	exit 1
}
STATE=$(./bin/forge-watch runner path)/novkostya-quince.state.json

run_watch() {
	printf '%s\n' "$1" >"$WORK/turn"
	./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues \
		--interval 1 --max-wait "$2" >"$WORK/out" 2>&1 || true
}
baseline() {
	rm -f "$STATE"
	run_watch 1 3
}
woke() { grep -q 'EXITING on the event' "$WORK/out"; }

# (1) THE HOUSEKEEPING EVENT: printed, labelled, and NOT woken on.
baseline
run_watch 2 5
if grep -q 'event=updated pr=801 .*kind=post-merge' "$WORK/out"; then
	ok "the post-merge update is PRINTED and labelled (the filter decides waking, not seeing)"
else
	bad "no kind=post-merge event — the rest of this suite proves nothing"
	sed -n '1,8p' "$WORK/out"
fi
if woke; then
	bad "woke on post-merge housekeeping — the churn quince#83 was filed about"
	sed -n '1,8p' "$WORK/out"
else
	ok "a post-merge update does NOT wake the session"
fi
if grep -q 'note: 1 post-merge event(s) suppressed' "$WORK/out"; then
	ok "the suppression is COUNTED and reported (constraint 2)"
else
	bad "suppressed silently — a watch that stopped delivering looks like a quiet forge"
	sed -n '1,8p' "$WORK/out"
fi

# (2) CONSTRAINT 4: this is NOT the quince#242 machinery, and the notes must not be confused. If a
# self-caused note fired here, the two figures would be measuring each other.
if grep -qE 'note: .*(self-caused|caused by this seat)' "$WORK/out"; then
	bad "a quince#242 note fired on an unattributed event — the two mechanisms are conflated"
	grep '^note:' "$WORK/out" | sed 's/^/    | /'
else
	ok "no self-caused note fires — post-merge is its own mechanism (constraint 4)"
fi

# (3) THE CASE SUPPRESSION MUST NOT EAT. A comment on a merged PR is a reviewer noting a follow-up or
# an Operator ruling in a thread. The third clause is what protects it — the comment is newer than
# the previous updatedAt, so the event is attributed and never carries the label.
baseline
run_watch 3 6
if woke; then
	ok "a post-merge COMMENT still WAKES (constraint 3 — the lost-signal guard)"
else
	bad "suppressed a comment on a merged PR — a ruling in a thread would be invisible"
	sed -n '1,8p' "$WORK/out"
fi
if grep -q 'event=updated pr=801 .*actor=novkostya kind=comment' "$WORK/out"; then
	ok "…and it is attributed to the commenter rather than labelled post-merge"
else
	bad "the comment did not produce an attributed event"
	sed -n '1,8p' "$WORK/out"
fi
if grep -q 'note: .*post-merge event(s) suppressed' "$WORK/out"; then
	bad "reported a post-merge suppression on the tick that correctly suppressed nothing"
	grep '^note:' "$WORK/out" | sed 's/^/    | /'
else
	ok "nothing claimed suppressed when nothing was (the note's control)"
fi

printf '\nforge-watch-postmerge-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
