#!/bin/sh
# scratch-reap-test — the reaper's REFUSALS, which are the half that matters.
#
# A reaper that deletes correctly and refuses incorrectly loses work; a reaper that refuses
# correctly and deletes nothing merely wastes disk. So every case here except one is a KEEP, and the
# single delete case exists to prove the refusals are not vacuous — a reaper that never deletes
# passes every safety test ever written.
#
# Synthetic and hermetic: a local bare repo stands in for the forge, so there is no network, no
# credential, and the "branch gone from origin" condition is exercised for real rather than mocked.
set -eu

cd "$(dirname "$0")/.."
REAP=$PWD/bin/scratch-reap
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

# A bare repo playing the forge, with a `main` everything is measured against.
git init -q --bare "$WORK/origin.git"
# The bare repo's HEAD must be `main` BEFORE anything clones it. Git's default initial branch is
# version- and config-dependent — `master` on the runner, `main` on the author's machine — so
# without this every clone comes up with "remote HEAD refers to nonexistent ref" and no checkout,
# and the suite passes only where the author happened to run it. `symbolic-ref` rather than
# `init -b main`, which needs git 2.28+.
git -C "$WORK/origin.git" symbolic-ref HEAD refs/heads/main
git clone -q "$WORK/origin.git" "$WORK/seed" 2>/dev/null
printf 'x\n' >"$WORK/seed/f"
git -C "$WORK/seed" add f
git -C "$WORK/seed" commit -qm init
git -C "$WORK/seed" branch -M main
git -C "$WORK/seed" push -q origin main

ROOT=$WORK/scratch
mkdir -p "$ROOT"

clone_at() {
	git clone -q "$WORK/origin.git" "$ROOT/$1"
	git -C "$ROOT/$1" checkout -qb "$2" 2>/dev/null || true
}

# (1) MERGED AND DELETED — the only case that should be reaped.
clone_at finished r1/done
git -C "$ROOT/finished" reset -q --hard origin/main

# (2) UNCOMMITTED CHANGES — work that exists nowhere else.
clone_at dirty r1/dirty
printf 'scratch\n' >>"$ROOT/dirty/f"

# (3) COMMITS NOT IN main — pushed or not, they are not in the trunk.
clone_at ahead r1/ahead
printf 'new\n' >>"$ROOT/ahead/f"
git -C "$ROOT/ahead" commit -qam "work"

# (4) BRANCH STILL ON ORIGIN — somebody may be reviewing it.
clone_at open r1/open
git -C "$ROOT/open" reset -q --hard origin/main
git -C "$ROOT/open" push -q origin r1/open

# (5) NOT A CLONE AT ALL.
mkdir -p "$ROOT/notaclone"
printf 'notes\n' >"$ROOT/notaclone/notes.md"


# (6) REBASE-MERGED — THE CASE THE SUITE DID NOT HAVE, AND THE ONE THE REAPER MEETS IN REALITY
# (quince#823). Case (1) resets to `origin/main`, so its branch is a fast-forward and the old
# reachability test answered it correctly; that is why this suite was green while the tool reaped
# 0 of 126 clones on the runner box and 0 of 150 on the architect box.
#
# Canon mandates rebase-and-merge, which REWRITES the commit: the object on `main` carries the same
# diff under a different sha. `rev-list --count origin/main..<branch>` counts that as outstanding
# work forever. Simulated here the way the forge does it — the same patch committed onto main under
# a different message, and the branch never pushed, standing in for `--delete-branch`.
clone_at rebased r1/rebased
printf 'landed\n' >>"$ROOT/rebased/f"
git -C "$ROOT/rebased" commit -qam "the work, as the author wrote it"
git -C "$WORK/seed" pull -q origin main
printf 'landed\n' >>"$WORK/seed/f"
git -C "$WORK/seed" commit -qam "the work, as the forge rewrote it"
git -C "$WORK/seed" push -q origin main


# (7) UNJUDGEABLE — a DETACHED HEAD, and the case that guards the counter this change adds
# (quince#1247 review). `gh pr checkout` leaves a clone detached once the PR's branch is deleted, so
# this is the ordinary shape on the seat that clones most: 244 of 459 there.
#
# THE COUNTER HAD NO TEST AND THE REVIEWER PROVED IT — folding `unjudged` back into `kept` and
# deleting the field from both summary lines left the suite green at 13. A change that adds an output
# field and rewrites two summaries added no case, and the thing left unguarded was the claim it
# exists to make: `kept` means the reaper LOOKED AND DECIDED NO; `unjudged` means it COULD NOT
# ANSWER. Collapsing them is quince#41's shape, which is what the ruling asked for the number to
# prevent.
clone_at detached r1/detached
git -C "$ROOT/detached" checkout -q --detach HEAD


# (7) PARKED ON THE DEFAULT BRANCH — the quince#1248 class, and the one this suite could not see.
#
# Rule 3 asks whether the branch is GONE from origin, and the default branch never is. So a clean
# clone sitting on `main` with nothing of its own was kept forever, with the reason "main still
# exists on origin; somebody may be reviewing it" — true, and about nothing. Two ordinary routes
# make one: a session that checks out `main` to start the next unit and never branches, and a clone
# made for a read that never left `main`.
clone_at onmain main
git -C "$ROOT/onmain" reset -q --hard origin/main

# (8) THE CONTROL THAT MATTERS MOST: on the default branch AND ahead of it.
#
# The carve-out must not become "clones on main are always reapable". Rule 2 still owns this — the
# commit's patch is not in origin/main, so the clone holds work that exists nowhere else, which is
# the one thing the reaper must never delete. If this is ever reaped, the fix has eaten the safety
# rule rather than the dead rule.
clone_at onmain_ahead main
printf 'unpushed\n' >>"$ROOT/onmain_ahead/f"
git -C "$ROOT/onmain_ahead" -c user.email=t@t -c user.name=t commit -qam 'work that is nowhere else'


out=$WORK/out
"$REAP" --root "$ROOT" >"$out" 2>&1 || true

# if/else rather than `A && B || C`: `ok` ends in an arithmetic assignment, and the day one of
# those evaluates to 0 the `||` fires and the suite reports a failure it did not have (SC2015).
assert_line() {
	if grep -q "$1" "$out"; then ok "$2"; else bad "$3"; fi
}
assert_line 'would reap finished' "a merged-and-deleted clone is reaped" "did not offer to reap the finished clone"
assert_line 'KEEP   dirty' "uncommitted changes are KEPT" "would have deleted uncommitted work"
assert_line 'KEEP   ahead' "commits not in main are KEPT" "would have deleted unmerged commits"
assert_line 'would reap rebased' "a REBASE-MERGED clone is reaped — same patch, different sha" "kept a clone whose work is on main under a rewritten sha; this is quince#823, the defect that held 9.7 GB"
assert_line 'KEEP   open' "a branch still on origin is KEPT" "would have deleted a live branch"
assert_line 'skip   notaclone' "a non-clone is skipped and counted separately" "mishandled a non-clone"

assert_line '?      detached' "a detached HEAD is UNJUDGED, not kept" "a clone the reaper cannot judge was reported as a decision"

# quince#1248 — the default-branch class. The reap line must also say WHY in this case's own terms:
# "gone from origin" is false here and would be a true-sounding reason for the wrong rule.
assert_line 'would reap onmain' "a clone parked on the DEFAULT BRANCH is reaped — rule 3 could never fire on it" "kept a clean clone on main forever; rule 3 asks whether the branch is gone and main never is (quince#1248)"
assert_line 'reap onmain — main is the default branch and this clone is not ahead' "…and says which rule reaped it, not the branch-is-gone one" "reaped the default-branch clone under a reason that is false for it"
assert_line 'KEEP   onmain_ahead' "a clone on the default branch that IS ahead is KEPT" "the default-branch carve-out ate rule 2 — this clone holds work that exists nowhere else"

# ASSERT THE NUMBERS, NOT THE WORD (quince#1247 review). A test matching /unjudged/ passes against a
# summary that always prints `0 unjudged`, which is the same vacuous-green this suite exists to
# refuse. Both figures are pinned: one unjudgeable clone, and `kept` UNCHANGED at three — the dirty
# one, the ahead one and the still-open branch. If the counter were folded back into `kept` this
# would read `4 kept, 0 unjudged` and fail on both halves.
assert_line '1 unjudged' "the summary counts the unjudgeable clone separately" "the unjudged count is missing or zero — folding it into kept is the defect this guards"
assert_line '4 kept' "…and kept is unchanged, so the unjudgeable clone did not land in it" "the unjudgeable clone was counted as kept"

# Report-only must not touch anything.
if [ -d "$ROOT/finished" ]; then
	ok "report-only deleted nothing"
else
	bad "report-only DELETED — the default must be inert"
fi

# And --prune must actually act, or every refusal above is vacuous.
# `rebased` is in the removed set too, and naming it here is what makes this assertion cover the
# quince#823 case at the ACTING end rather than only in the report — a reaper that prints "would
# reap" and then declines to delete would pass every line above it.
"$REAP" --root "$ROOT" --prune >"$out.p" 2>&1 || true
if [ ! -d "$ROOT/finished" ] && [ ! -d "$ROOT/rebased" ] && [ ! -d "$ROOT/onmain" ] &&
	[ -d "$ROOT/dirty" ] && [ -d "$ROOT/ahead" ] && [ -d "$ROOT/open" ] && [ -d "$ROOT/onmain_ahead" ]; then
	ok "--prune removes exactly the three finished clones and nothing else"
else
	bad "--prune removed the wrong set"
	cat "$out.p"
fi
[ "$fail" -eq 0 ]

# ---------------------------------------------------------------------------------------------
# A ROOT ONE LEVEL TOO SHALLOW IS A REFUSAL, NOT A CLEAN SWEEP — quince#823.
#
# THE MEASURED FAILURE: `--root /root/scratch` on the runner box printed `0 would be reaped, 0 kept,
# 26 not clones` and exited 0, over 10.3 GB in 119 clones. The reaper judges IMMEDIATE CHILDREN, and
# on a shared box that level holds RUNNER DIRECTORIES — so every entry is honestly "not a git clone"
# and the whole answer is vacuous. It is also the DOCUMENTED fallback for a session with no runner
# declared, which is what makes it worth a refusal rather than a caveat.
#
# THREE CASES, because the predicate has to be narrow. "No clones here" is an ordinary state — a
# fresh runner root, or one holding only scratch files — and refusing on it would make the tool cry
# during normal use, which is worse than not guarding at all.
NEST=$WORK/nested
mkdir -p "$NEST/r9"
git clone -q "$WORK/origin.git" "$NEST/r9/quince"

nout=$WORK/nested.out
"$REAP" --root "$NEST" >"$nout" 2>&1 && nrc=0 || nrc=$?

if [ "$nrc" -eq 2 ]; then
	ok "a root whose children hold the clones REFUSES with exit 2"
else
	bad "a root one level too shallow exited $nrc, not 2 — it reported a sweep it never made"
	cat "$nout"
fi
# The message has to name the way out, or a refusal is just a different silence.
if grep -q 'one level too shallow' "$nout" && grep -q -- '--root' "$nout"; then
	ok "the refusal says why and names the correct invocation"
else
	bad "the refusal does not tell the reader what to do instead"
	cat "$nout"
fi
# `DID NOT RUN` is the phrase every other gate in this repo uses for exit 2, and a session greps for
# it rather than for this tool's wording.
if grep -q 'DID NOT RUN' "$nout"; then
	ok "the refusal uses the repo's DID NOT RUN vocabulary"
else
	bad "exit 2 without saying DID NOT RUN — the phrase the other gates share"
fi

# NARROWNESS CONTROL 1: an empty root is still exit 0. Nothing to do is not the same as could not
# look, and conflating them is the failure this whole block exists to prevent, inverted.
EMPTY=$WORK/emptyroot
mkdir -p "$EMPTY"
"$REAP" --root "$EMPTY" >"$WORK/empty.out" 2>&1 && erc=0 || erc=$?
if [ "$erc" -eq 0 ]; then
	ok "an empty root is still exit 0 — nothing to do is not a refusal"
else
	bad "an empty root exited $erc; the guard is too wide and will fire during normal use"
	cat "$WORK/empty.out"
fi

# NARROWNESS CONTROL 2: a root holding files and directories but NO nested clone is also exit 0.
# This is the case that separates "the clones are one level down" from "there are no clones".
FLAT=$WORK/flatroot
mkdir -p "$FLAT/notes" "$FLAT/empty-dir"
printf 'body\n' >"$FLAT/pr-body.md"
"$REAP" --root "$FLAT" >"$WORK/flat.out" 2>&1 && frc=0 || frc=$?
if [ "$frc" -eq 0 ]; then
	ok "a root with stray files and no nested clone is exit 0"
else
	bad "a root with no clones anywhere exited $frc — the guard fires on an ordinary scratch root"
	cat "$WORK/flat.out"
fi


# ---------------------------------------------------------------------------------------------
# A REPOSITORY WHOSE DEFAULT BRANCH IS NOT `main` — quince#1297.
#
# THE DEFECT. The ahead-comparison hardcoded `origin/main`, so on such a repository `git cherry`
# failed on a ref that does not exist, every clone was reported UNKNOWN, and nothing downstream ran
# — including quince#1248's default-branch check, whose whole point was to read the name rather than
# assume it. The careful read was unreachable in exactly the case it existed for.
#
# THE BEHAVIOUR WAS SAFE AND THE REASON WAS NOT. UNKNOWN means kept, so nothing was ever deleted
# wrongly; but the reason a reader saw was "could not compare against origin/main", which names a
# branch that repository does not have. A keep whose reason is not the true one is what quince#1248
# was filed about, one rule over.
#
# THIS SUITE COULD NOT SEE IT because its origin is `main`, like every repository this project
# works on day to day. A second origin is the whole cost of covering it.
#
# IT ALSO PINS TWO THINGS quince#1284 HAD TO DECLARE UNTESTED, and that is the point of doing it
# here rather than separately: on a `main` origin `origin/$default_branch` and `origin/main` are the
# same string, so no assertion could tell the fixed form from the broken one.
printf '\n'
MORIGIN=$WORK/master-origin.git
git init -q --bare "$MORIGIN"
git -C "$MORIGIN" symbolic-ref HEAD refs/heads/master
git clone -q "$MORIGIN" "$WORK/mseed" 2>/dev/null
git -C "$WORK/mseed" checkout -qb master 2>/dev/null || true
printf 'x\n' >"$WORK/mseed/f"
git -C "$WORK/mseed" add f
git -C "$WORK/mseed" -c user.email=t@t -c user.name=t commit -qm init
git -C "$WORK/mseed" push -q origin master

MROOT=$WORK/mscratch
mkdir -p "$MROOT"
git clone -q "$MORIGIN" "$MROOT/onmaster"
git clone -q "$MORIGIN" "$MROOT/ahead-on-master"
printf 'y\n' >>"$MROOT/ahead-on-master/f"
git -C "$MROOT/ahead-on-master" -c user.email=t@t -c user.name=t commit -qam 'work that is nowhere else'

mout=$WORK/master.out
"$REAP" --root "$MROOT" >"$mout" 2>&1 || true

if grep -q 'would reap onmaster' "$mout"; then
	ok "a default-branch clone is reaped on a master-default repository"
else
	bad "the reaper did nothing on a master-default repository — the ahead-comparison assumed origin/main"
	cat "$mout"
fi
# THE MESSAGE MUST NAME THE BRANCH THE CODE READ. quince#1284 fixed this and could not test it,
# because on a `main` origin the fixed and broken forms produce identical output.
if grep -q 'not ahead of origin/master' "$mout"; then
	ok "…and the reason names origin/master, not a hardcoded origin/main"
else
	bad "the reap reason named the wrong branch — it hardcodes origin/main somewhere"
	grep 'onmaster' "$mout" | sed 's/^/    | /'
fi
if grep -q 'KEEP   ahead-on-master' "$mout" && grep -q 'not in origin/master' "$mout"; then
	ok "…and rule 2 still keeps unlanded work, comparing against origin/master"
else
	bad "rule 2 mis-handled a master-default clone holding work that exists nowhere else"
	cat "$mout"
fi
# THE NEGATIVE CONTROL: nothing may be UNJUDGED here. That count was 1-of-1 before this change and
# is the signature of the tool declining to look at all.
if grep -q '0 unjudged' "$mout"; then
	ok "…and NOTHING is unjudged — the tool can actually look at this repository now"
else
	bad "a master-default clone is still UNKNOWN — the comparison did not learn the default branch"
	grep 'unjudged' "$mout" | sed 's/^/    | /'
fi

printf '\nscratch-reap-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
