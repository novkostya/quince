#!/bin/sh
# gh-review — run `gh` as the reviewer identity: a GitHub App, not a person.
#
# The first wrapper whose identity is not a user account, and since quince#676 the architect seat's
# ONLY one. It arrived third: bin/gh-bot ran as the implementer, bin/gh-arch as the architect — and
# quince#47 is the finding that the second of those is indistinguishable from the Operator, because
# they are the same login. That wrapper is now deleted, which is this one's own argument carried to
# its conclusion rather than a separate decision. A reader of a
# ruling cannot tell a subordinate's verdict from its principal's, and on quince#115 that stopped
# being a record-keeping annoyance and became a refusal: GitHub would not let the architect review
# a PR the Operator authored, since it was the same account.
#
# An App fixes that structurally rather than by convention. Verdicts render as `quince-review[bot]`,
# which is not a name anybody can mistake for a human, and the credential is a short-lived
# installation token minted from a private key rather than a long-lived PAT.
#
# Same allowlist reason as the other two: a permission rule never matches past a leading
# `VAR=value`, so `GH_TOKEN=$(…) gh …` is unallowlistable by construction. Allowlist the script.
set -eu

# INLINE `--body` IS REFUSED, and the reason is a measured leak rather than a style preference
# (quince#518).
#
# THREE REFERENCES, AND THEY ANSWER DIFFERENT QUESTIONS. quince#518 is the leak this guard exists
# because of; quince#526 established it on `bin/gh-coder` and is the one to read for what it looks
# like; quince#527 is why it is on this wrapper too rather than on that one alone. A reader who
# follows #518 alone lands on a storage discussion and has to work out why (quince#803 review).
#
# A body written as `--body "…"` is a shell string, so backticks inside it are COMMAND
# SUBSTITUTION — evaluated by the shell before this wrapper sees an argument, which is why the
# guard cannot live anywhere but the entry point. On 2026-08-02 that published a PVE host's
# block-device map to a public issue through `gh-coder`, and twice more the same session it
# silently ATE filenames out of sentences.
#
# THE SAME BUG IS IN THIS REPOSITORY'S HISTORY THROUGH THE ARCHITECT'S WRAPPER, an hour earlier: a
# review comment's backticked spans were evaluated, the shell tried to execute two committed paths,
# and the posted comment TRUNCATED mid-sentence and lost both of its numbered points. It was
# harmless for one reason only — neither path is an executable. `iostat` is. **The severity is
# decided by whether the prose happens to name something on $PATH**, which is a property of English
# rather than of care.
#
# AND IT IS THE ONE PATH THE PRIVACY GATE CANNOT COVER: `make privacy-check TEXT=<file>` needs a
# file, and `--body` has none.
#
# AHEAD OF THIS WRAPPER'S BOUNDARY REFUSAL, deliberately, and it does not weaken it. That ordering
# rule exists because a message inviting the WRONG REPAIR is how a reviewer key ends up on the
# authoring host — "install openssl" is an instruction to change the environment. This one is an
# instruction to change the INVOCATION, and the boundary refusal is still waiting on the next
# attempt. `bin/wrapper-boundary-test` passes no inline body, so every case it constructs is
# unchanged.
#
# `--body-file` and `--body-file -` both pass. Neither can substitute, and both give the sweep
# something to point at.
for _a in "$@"; do
	case "$_a" in
	--body | -b)
		cat >&2 <<'EOM'
gh-review: REFUSING --body. Write the text to a file and pass --body-file.

  Inline --body is a shell string, so backticks in it are COMMAND SUBSTITUTION. On 2026-08-02
  that published a PVE host's device map to a public issue, and it truncated a review comment
  mid-sentence through this wrapper's sibling (quince#518, quince#527).

  It is also the one path `make privacy-check TEXT=<file>` cannot cover, because there is no
  file to sweep. Use:

      cat > "$HOME/scratch/<seat>/bodies/<name>.md" <<'EOF'
      …
      EOF
      make privacy-check TEXT="$HOME/scratch/<seat>/bodies/<name>.md"
      gh-review <verb> --body-file "$HOME/scratch/<seat>/bodies/<name>.md"

  A quoted heredoc delimiter ('EOF', not EOF) is what stops substitution inside the file too.
EOM
		exit 2
		;;
	--body=* | -b=* | -b?*)
		echo "gh-review: REFUSING an inline body (--body=… / -b…) — same reason as --body; use --body-file (quince#518)." >&2
		exit 2
		;;
	esac
done

# HOME IS NOT GUARANTEED, AND `set -u` MAKES A BARE $HOME FATAL. This is the wrapper that found it:
# `preflight`'s reviewer-mint assertion invokes this script, `preflight` runs from OpenRC, and
# OpenRC gives a service no HOME — so `${VAR:-$HOME/...}` died on the UNGUARDED $HOME inside the
# default, even though the outer expansion is guarded. It surfaced at boot as
#
#     bin/gh-review: line 19: HOME: parameter not set
#
# which reads as a broken script rather than a missing environment, and it took the arch box down
# after a reboot. Invisible from a shell, because ssh and login both set HOME — so every
# interactive test of this wrapper passed while the service could not start.
#
# Resolve from the passwd database rather than assuming a path: the same invocation then works
# from a shell, from a service and from cron, and a box whose root home is not /root still works.
_home="${HOME:-$(awk -F: -v u="$(id -u)" '$3==u{print $6; exit}' /etc/passwd 2>/dev/null || true)}"
[ -n "$_home" ] || {
	printf 'gh-review: cannot locate a home directory — HOME is unset and uid %s has no passwd entry.\n' "$(id -u)" >&2
	printf 'gh-review: set QUINCE_REVIEW_KEY_FILE and QUINCE_REVIEW_APP_ID_FILE explicitly.\n' >&2
	exit 1
}

KEY_FILE="${QUINCE_REVIEW_KEY_FILE:-$_home/.config/quince/quince-review.pem}"
APP_ID_FILE="${QUINCE_REVIEW_APP_ID_FILE:-$_home/.config/quince/quince-review.app-id}"
API="${QUINCE_GITHUB_API:-https://api.github.com}"
AH="Accept: application/vnd.github+json"

die() {
	printf 'gh-review: %s\n' "$1" >&2
	shift
	for line in "$@"; do printf 'gh-review: %s\n' "$line" >&2; done
	exit 1
}

# IDENTITY BEFORE DEPENDENCIES, and the order is the whole point (quince#157).
#
# The reviewer box must not hold the implementer identity (devlog#7). Asserted here as well as in
# preflight, so a hand-run command cannot quietly cross a boundary the service refuses to cross.
#
# This block used to sit BELOW the dependency loop, and on the implementer host — which has a bot
# token and no `openssl` — the first refusal to fire was "openssl is not installed". That message is
# not merely less useful; it invites the WRONG REPAIR. A session told a package is missing installs
# it, meets the key check next, places an App key to satisfy it, and has now put the reviewer
# credential on the authoring host. `approver ≠ author` would then be defeated by a session doing
# exactly what the error told it to do.
#
# A boundary refusal must outrank an environment refusal, because the environment can be fixed and
# the boundary must not be. It needs nothing from the dependency loop — `$_home` is already
# resolved and `[ -f ]` is a shell builtin — so ordering it first costs nothing.
# BOTH FORMS OF THE IMPLEMENTER IDENTITY, and the App key is checked FIRST because it is the live
# one. This wrapper refused a bot token and nothing else, so once the implementer identity moved to
# an App key (`decisions/0014`) the assertion "the implementer identity is absent" was being made by
# checking for a credential that no longer carries it — and a box holding `quince-coder.pem` could
# author with gh-coder and approve with this wrapper while nothing anywhere refused. That is the
# whole of what the two-seat design exists to produce, defeated by a file the guard did not know to
# look for. quince#203 fixed it in `preflight`'s arch arm; quince#204 is the remainder, and the more
# load-bearing half: `preflight` gates whether the box STARTS, this gates every verdict it casts.
CODER_KEY="${QUINCE_CODER_KEY_FILE:-$_home/.config/quince/quince-coder.pem}"
if [ -f "$CODER_KEY" ]; then
	die "an IMPLEMENTER APP KEY is present at $CODER_KEY." \
		"This machine can approve; holding the implementer identity too would let one box author" \
		"and approve its own work. Remove it, or run gh-coder on the implementer box."
fi
# THE THIRD SEAT AUTHORS TOO, AND THIS WRAPPER DID NOT KNOW IT EXISTED (quince#375). The analyst App
# holds `contents: write` + `pull_requests: write`, so `quince-analyst.pem` is an AUTHORING credential
# — and this check's question is not "is the implementer here" but "can this box author", which is
# why the two are not the same rule. A box holding the reviewer key and the analyst key can open a
# pull request as the analyst and approve it as the architect, and until this line nothing refused.
#
# It is quince#204's finding from the other end: there, a rule naming one MECHANISM went false when
# the mechanism moved; here, a rule naming two IDENTITIES goes false when a third appears. The
# defence is the same and so is the reason it was invisible — every existing check was correct.
ANALYST_KEY="${QUINCE_ANALYST_KEY_FILE:-$_home/.config/quince/quince-analyst.pem}"
if [ -f "$ANALYST_KEY" ]; then
	die "an ANALYST APP KEY is present at $ANALYST_KEY." \
		"That seat AUTHORS pull requests (quince#375). This machine can approve; holding an authoring" \
		"identity too would let one box open a change and cast the verdict on it." \
		"Remove it, or run gh-analyst on the supervisor box."
fi
# The bot token stays a refusal alongside it: `decisions/0014` condition 1 requires that credential
# to be left in place wherever it lives, so a box can hold it AND the App key, and both are the
# implementer identity. Refusing beside either is the only reading that stays true.
BOT_TOKEN="${QUINCE_BOT_TOKEN_FILE:-$_home/.config/quince/quince-bot.token}"
if [ -f "$BOT_TOKEN" ]; then
	die "a BOT TOKEN is present at $BOT_TOKEN." \
		"This machine can approve; holding the implementer identity too would let one box author" \
		"and approve its own work. Remove it, or run gh-bot on the implementer box."
fi


# A CREDENTIAL IS NOT A SET OF PATHNAMES (quince#385). Every check above names a FILE, and a forge
# credential in the ENVIRONMENT crosses all of them without one of them speaking — `GH_TOKEN` is
# exactly how this wrapper hands a token to `gh` fifty lines below, so a value already sitting there
# is a working credential belonging to somebody else.
#
# `deploy/runner/preflight`'s supervisor arm learned this by passing a box with `GH_TOKEN=ghp_…` set,
# and states the rule in as many words. The wrappers did not carry it — and the asymmetry ran the
# wrong way, because `preflight` gates whether the box STARTS while this gates EVERY ACTION it takes.
#
# DUPLICATED RATHER THAN SOURCED, following quince#316's ruling rather than re-litigating it: a
# shared block would put a load-time file dependency on the security path of a credential wrapper,
# where a missing or tampered file is a new failure mode. `bin/wrapper-boundary-test` carries the
# detector that fails when a wrapper is added without this, which is the same trade that ruling made.
for _envvar in GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN; do
	eval "_envval=\${$_envvar:-}"
	[ -n "$_envval" ] || continue
	die "a FORGE CREDENTIAL is present in the environment: \$$_envvar." \
		"That variable is how this wrapper hands a token to gh, so a value already in it is somebody" \
		"else's working credential and would be used ahead of this seat's identity." \
		"Unset it, and run this wrapper on a box that holds one identity."
done
if [ $# -eq 0 ]; then
	printf 'usage: gh-review <gh arguments...>\n' >&2
	printf '  runs gh as the quince-review App, minting a fresh installation token per call\n' >&2
	printf '  key %s\n  app id %s\n' "$KEY_FILE" "$APP_ID_FILE" >&2
	exit 2
fi

# A VERDICT NEVER GOES THROUGH THE PORCELAIN (quince#110, ruled 2026-07-30).
#
# `gh pr review` has no `--commit-id`, and the REST endpoint it calls documents the default:
# "The SHA of the commit that needs a review. … Defaults to the most recent commit in the pull
# request when you do not specify a value." So every verdict this project has ever cast was bound to
# WHATEVER HEAD EXISTED AT THE INSTANT OF SUBMISSION, not to what the reviewer read.
#
# The race is invisible from the reviewer's side: the diff view stays rendered from the commit you
# opened, so you approve a page showing A while the verdict attaches to B. Measured on quince#183 —
# author amended at 22:00:08Z, the approval registered at 22:00:25Z against a commit seventeen
# seconds old that the reviewer had never seen.
#
# MEASURED FOR THIS CHANGE, on a throwaway PR that was closed and whose branch was deleted:
#   - the API accepts an explicit NON-HEAD commit_id and records it, with no error;
#   - an EXPLICITLY SET commit_id SURVIVES `gh pr update-branch --rebase`, where an auto-defaulted
#     one is re-pointed to the new head. That second result is why this closes two defects rather
#     than one: the merging seat's own rebase can no longer silently move what a verdict covers.
#
# IT IS A DECLARATION, NOT A COMPARE-AND-SWAP. The docs describe no error when commit_id is not head,
# and the probe found none. So this does not refuse a mis-timed approval — it records honestly what
# was approved, which is the property `/architect` §4's staleness check needs in order to mean
# anything. Before this, that check compared commit_id against the head it had been defaulted from.
#
# THE OID IS REQUIRED AND THERE IS NO DEFAULT, deliberately. Resolving head here would pass a
# commit_id that is once again "whatever is head now", narrowing the window rather than closing it —
# the shape the ruling declined as item 3, "strictly worse … dead weight beside (1)".
#
# PARSED AND REFUSED HERE, ABOVE THE DEPENDENCY LOOP AND THE MINT, for two reasons. A missing oid is
# a usage error and needs no network round-trip to detect — and putting it below the mint would make
# the refusal unreachable to any hermetic suite, since reaching it would require a live key. The
# ordering also matches quince#157: a refusal that must not be repaired away speaks before one that
# invites installing a package.
_gr_verdict=no
case "${1:-}/${2:-}" in
pr/review) _gr_verdict=yes ;;
esac
if [ "$_gr_verdict" = yes ]; then
	_gr_commit="" _gr_pr="" _gr_event="" _gr_body="" _gr_repo="${QUINCE_REPO:-}"
	shift 2
	while [ $# -gt 0 ]; do
		case "$1" in
		--commit-id) _gr_commit="${2:?--commit-id needs an oid}"; shift 2 ;;
		-a | --approve) _gr_event=APPROVE; shift ;;
		-r | --request-changes) _gr_event=REQUEST_CHANGES; shift ;;
		-c | --comment) _gr_event=COMMENT; shift ;;
		-b | --body) _gr_body="${2:?--body needs a value}"; shift 2 ;;
		-F | --body-file) _gr_body=$(cat "${2:?--body-file needs a path}"); shift 2 ;;
		-R | --repo) _gr_repo="${2:?--repo needs owner/name}"; shift 2 ;;
		-*)
			die "unrecognised flag '$1' on the verdict path." \
				"Verdicts go through the REST API here rather than \`gh pr review\`, so this accepts" \
				"that command's flags and no others. If gh grows one this needs, add it here." ;;
		*) _gr_pr="$1"; shift ;;
		esac
	done
	[ -n "$_gr_pr" ] || die "no pull request number." \
		"usage: gh-review pr review <n> --repo owner/name --approve --commit-id <oid> [--body-file <f>]"
	[ -n "$_gr_repo" ] || die "no repository." "Pass --repo owner/name, or set QUINCE_REPO."
	[ -n "$_gr_event" ] || die "no verdict." "One of --approve, --request-changes, --comment is required."
	[ -n "$_gr_commit" ] || die \
		"REFUSING to cast a verdict without --commit-id (quince#110)." \
		"Without it GitHub binds the review to whatever head exists at the instant of submission —" \
		"not to what you read — and the diff view does not change under you, so nothing says so." \
		"Pass the FULL 40-char oid you actually reviewed:" \
		"  gh-review pr review $_gr_pr --repo $_gr_repo --approve --commit-id <oid> --body-file <f>" \
		"Read it BEFORE you review: gh pr view $_gr_pr --json headRefOid -q .headRefOid" \
		"There is no default on purpose — resolving head here would re-create the race it closes."
	# AND THE SHAPE, NOT ONLY THE PRESENCE (quince-devlog#204). The check above refuses a MISSING oid
	# and accepts a malformed one, so an abbreviation reached the API and came back as a remote
	# `Unprocessable Entity` — three of them in one session, each costing a round trip to learn that
	# the local string was wrong. The refusal is free and local; the acceptance is not.
	#
	# WHY AN ABBREVIATION IS THE CASE THAT MATTERS rather than a typo: GitHub serves an arbitrary FULL
	# oid and refuses a short one (quince#243), and `git log --oneline` hands you a short one. So the
	# wrong value is the one the tools produce by default, and it is wrong in a way that looks right —
	# quince#1093 is the same edge from the fetching side, where an abbreviated oid cannot be fetched
	# once the head has moved.
	#
	# `${#var}` and a `case` glob rather than a `grep` pipeline: both are shell builtins, so this adds
	# no subprocess to the verdict path, and a pipeline here would report the exit code of its last
	# stage rather than of the test.
	#
	# Case-insensitive on purpose. Git writes lowercase and the API accepts either; refusing an
	# uppercase oid would be this wrapper inventing a rule the forge does not have, on the one path
	# where a spurious refusal blocks a verdict that is otherwise correct.
	case "$_gr_commit" in
	*[!0-9a-fA-F]*) die \
		"REFUSING --commit-id '$_gr_commit': it is not a hexadecimal object id." \
		"A verdict binds to the commit named here, so a value the API cannot resolve is refused" \
		"locally rather than sent — the remote answer is an Unprocessable Entity that says nothing" \
		"about which argument was wrong (quince-devlog#204)." \
		"Read it: gh pr view $_gr_pr --json headRefOid -q .headRefOid" ;;
	esac
	if [ "${#_gr_commit}" -ne 40 ]; then
		die "REFUSING --commit-id '$_gr_commit': it is ${#_gr_commit} characters and an oid is 40." \
			"GitHub serves an arbitrary FULL oid and refuses an abbreviation (quince#243), so a short" \
			"one fails at the API — and an abbreviation is what \`git log --oneline\` and the forge's" \
			"own web UI hand you, which is why this is the likely mistake rather than an exotic one." \
			"Take the full one: gh pr view $_gr_pr --json headRefOid -q .headRefOid" \
			"or, locally: git rev-parse <ref>"
	fi
	# An empty `body` field is not the same as an absent one, so it is only sent when non-empty.
	set -- api -X POST "repos/$_gr_repo/pulls/$_gr_pr/reviews" \
		-f "event=$_gr_event" -f "commit_id=$_gr_commit"
	[ -z "$_gr_body" ] || set -- "$@" -f "body=$_gr_body"
fi

for tool in gh openssl curl jq; do
	command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed" \
		"this wrapper needs gh, openssl, curl and jq. On Alpine: apk add openssl curl jq." \
		"openssl in particular is NOT in a minimal Alpine image and RS256 signing cannot proceed without it."
done

[ -f "$KEY_FILE" ] || die "no App private key at $KEY_FILE" \
	"Refusing to fall back to the ambient gh credentials: doing so would cast a verdict as whoever" \
	"is signed in, which is the failure this separation exists to prevent." \
	"Generate a key from the App's settings page and place it there, mode 600."
[ -f "$APP_ID_FILE" ] || die "no App id at $APP_ID_FILE" \
	"The id is not a secret — it is on the App's settings page — but it is environment-specific," \
	"so it is configuration and not a constant in a public repository."

APP_ID=$(cat "$APP_ID_FILE")

# --- mint a JWT, then exchange it for an installation token ----------------------------------
# NOT CACHED, deliberately. An installation token lives one hour, so a cache would be a second
# secret at rest with a lifetime this wrapper would have to manage, plus an invalidation bug
# waiting to happen. The cost is two HTTPS round-trips per call. If that ever bites, cache it —
# but measure the latency first rather than assuming it, and say where the cached token lives.
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
# 60s of backdate absorbs clock skew between this box and GitHub; 9 minutes of life is well inside
# the 10-minute maximum GitHub accepts for an App JWT.
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$APP_ID" | b64url)
signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -binary -sign "$KEY_FILE" | b64url)
jwt="$header.$payload.$signature"

# app_api calls the App API and CLASSIFIES a failure rather than asserting a cause (quince#1133).
#
# THE HINT USED TO BE UNCONDITIONAL, AND IT NAMED THE ONE CAUSE THAT MAKES A SESSION STOP. A
# transient GitHub 504 printed *"the key does not match app id N, or the key has been revoked"*,
# and canon tells a session that cannot mint to STOP, because it cannot author. So a retryable blip
# was routed into a hard stop — while GitHub's own body said *"please try resubmitting your
# request."* Measured 2026-08-17: the immediate retry of the identical command succeeded.
#
# `forge-watch` CONSUMES THIS PROGRAMMATICALLY, which is the second cost and the one with no human
# in the loop to disbelieve the prose: the same string reached it as `issue-fetch-failed`, and an
# issue a session had DECLARED dropped out of the watch set for that tick.
#
# `-w '\n%{http_code}'` IS WHAT MAKES CLASSIFICATION POSSIBLE, and the status is READ rather than
# inferred. `--fail-with-body` sets a non-zero exit for every failure alike, so the exit code
# discriminates nothing, and the prose in the body is not a signal to parse — that is the derived
# signal this project already has an issue open about. curl reports `000` when it never got an HTTP
# response at all, which is what keeps a transport failure distinct from a 5xx.
#
# NO AUTOMATIC RETRY, DELIBERATELY. A wrapper that silently retries hides the rate of forge
# flakiness from the only sessions positioned to notice it. Naming the cause correctly is the fix;
# deciding to retry is the seat's.
app_api() {
	_what=$1
	shift
	_resp=$(curl -sS --fail-with-body -w '\n%{http_code}' -H "Authorization: Bearer $jwt" \
		-H "$AH" "$@" 2>&1) && _rc=0 || _rc=$?
	# The status is the LAST line and the body is everything before it, on both paths — `-w` writes
	# after the body, and after curl's own error line when there is no body at all.
	_status=$(printf '%s' "$_resp" | tail -n 1)
	_body=$(printf '%s' "$_resp" | sed '$d')
	if [ "$_rc" -eq 0 ]; then
		printf '%s' "$_body"
		return 0
	fi
	case "$_status" in
	401 | 403) die "$_what" "$(printf '%s' "$_body" | head -n 3)" \
		"HTTP $_status — GitHub rejected the credential itself." \
		"Most likely: the key does not match app id $APP_ID, or the key has been revoked." ;;
	5??) die "$_what" "$(printf '%s' "$_body" | head -n 3)" \
		"HTTP $_status — GitHub did not answer. This is TRANSIENT: retry the same command." \
		"The credential was NOT rejected, and this is not a reason to stop." ;;
	000) die "$_what" "$(printf '%s' "$_body" | head -n 3)" \
		"No HTTP response — the request never reached GitHub (DNS, TLS, or the network)." \
		"This is TRANSIENT: retry. The credential was NOT rejected." ;;
	*) die "$_what" "$(printf '%s' "$_body" | head -n 3)" \
		"HTTP $_status. This wrapper does not know what that means here, and will not guess." ;;
	esac
}

installations=$(app_api "could not list installations" "$API/app/installations")

count=$(printf '%s' "$installations" | jq -r 'if type=="array" then length else 0 end')
case "$count" in
0) die "app id $APP_ID has no installations" \
	"The App exists but is installed nowhere, so it can reach no repository. Install it on the" \
	"account and select the repositories in .claude/forge-set." ;;
1) : ;;
*) # Picking .[0] would work today and silently pick the wrong one later. A wrapper that guesses
	# which identity it is acting as is the thing this file exists to prevent.
	#
	# The guard is on the OVERRIDE being absent, not on the count. An earlier version died
	# unconditionally here while its own message said to set QUINCE_REVIEW_INSTALLATION_ID — an
	# error naming a remedy the code could not honour, because the `install_id=` line below was
	# unreachable from this branch. Caught in review of the PR that introduced this file.
	[ -n "${QUINCE_REVIEW_INSTALLATION_ID:-}" ] || die \
		"app id $APP_ID has $count installations; refusing to guess which one to act as." \
		"Set QUINCE_REVIEW_INSTALLATION_ID to the one this box should use." ;;
esac

install_id="${QUINCE_REVIEW_INSTALLATION_ID:-$(printf '%s' "$installations" | jq -r '.[0].id')}"

token=$(app_api "could not mint an installation token for installation $install_id" \
	-X POST "$API/app/installations/$install_id/access_tokens")

GH_TOKEN=$(printf '%s' "$token" | jq -r '.token // empty')
[ -n "$GH_TOKEN" ] || die "installation $install_id returned no token" \
	"Refusing to continue: an empty token would fall through to the ambient credentials."

unset GITHUB_TOKEN
export GH_TOKEN

# SELF-CAUSED LEDGER (quince#242). Two verbs — `pr review` and `pr merge` — produce forge events
# that carry NO actor, because `forge-watch` computes them by diffing observations. Recording them
# as this runner performs them is what lets its own watch tell them from another seat's.
#
# THE `exec` IS KEPT FOR EVERYTHING ELSE, and that is the whole reason `classify` exists as a
# separate verb: this is a CREDENTIAL wrapper, so the blast radius of a behaviour change here is
# every forge call the session makes. Only the two recordable verbs take the fork-and-wait path.
#
# RECORDED ONLY ON SUCCESS. A `gh pr review` that failed produces no event to suppress, so its row
# would sit unconsumed until it swallowed the NEXT verdict on that PR — somebody else's, which is a
# MISSED wake and the one direction this subsystem must not fail in. The exit status is passed
# through unchanged either way; the ledger never affects what the caller sees.
_ledger="$(dirname "$0")/forge-ledger"

# THE VERDICT PATH RECORDS BY HAND, because `classify` reads argv and argv is now `api -X POST …`,
# which classifies as nothing (quince#110). Suppression is keyed on repo+number+subject+kind and this
# act is still a review — so without this an architect approving through the fixed path would be woken
# by its own verdict: quince#242's defect arriving through a changed CALL SHAPE rather than a new verb.
if [ "$_gr_verdict" = yes ]; then
	gh "$@" && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ] && [ -x "$_ledger" ]; then
		"$_ledger" record pr review "$_gr_pr" --repo "$_gr_repo" || :
	fi
	exit "$_rc"
fi

if [ -x "$_ledger" ] && "$_ledger" classify "$@" >/dev/null 2>&1; then
	gh "$@" && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then "$_ledger" record "$@" || :; fi
	exit "$_rc"
fi

exec gh "$@"
