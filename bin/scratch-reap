#!/bin/sh
# scratch-reap — delete the per-unit clones that are provably finished, and NOTHING else.
#
# WHY THIS EXISTS. Canon says "fresh clone per unit of work … into a scratch dir" and nothing ever
# removes one. Measured on the runner: 33 clones in two days, 503 MB, none pruned — and the reason
# nobody wrote a reaper is visible in the same sentence. `<scratch>` is a placeholder. There was no
# named place to reap, so there was nothing to point a reaper at.
#
# THE SAFETY RULE IS THE WHOLE DESIGN, and it is quince-devlog#45's non-negotiable one layer down:
# **a container must never hold work that exists nowhere else.** A clone is deleted only when all
# three hold, and any one of them failing leaves it alone:
#
#   1. the working tree is CLEAN            — nothing uncommitted
#   2. every commit is IN main BY PATCH     — so the work exists in the repository, not just here
#   3. its branch is GONE from origin        — so nobody is still reviewing it
#
# (2) IS A PATCH-ID QUESTION AND NOT A REACHABILITY ONE, which is the whole of quince#823. It was
# `rev-list --count origin/main..<branch>`, and that is wrong for EVERY merge strategy this project
# permits. §6 mandates rebase-and-merge and allows squash; both REWRITE the commit, so the object on
# `main` has a different sha and the local commit is not an ancestor of anything. The count is
# therefore non-zero for a branch whose work landed hours ago, and the clone is kept forever.
#
# THE COST WAS MEASURED ON BOTH BOXES BEFORE IT WAS UNDERSTOOD: 70 of 126 clones on the runner —
# 9.7 GB — were kept with their branch gone from origin AND their change on `main`. On the architect
# box the dominant reason differed (detached HEAD, 58%), and this criterion was present there too.
# Two independent measurements, converging on one criterion.
#
# `git cherry origin/main <branch>` asks the question that was meant: it prints `-` for a commit
# whose PATCH is already upstream and `+` for one that is not, so a rebased commit matches its
# rewritten twin. Measured on three real merged branches (quince#1231, #1233, #1236) and one
# unmerged: `rev-list` said 2, 2, 1 commits ahead where `cherry` said all `-`; the unmerged branch
# reported `+` from both. Same answer where it mattered, opposite answer where it was broken.
#
# WHAT IT STILL WILL NOT REAP, and this is a limit rather than an oversight: a SQUASH of several
# commits. `cherry` compares patch-ids one commit at a time, and a squashed commit's patch is the
# SUM of the branch's — matching nothing individually. Those clones stay, correctly under this
# tool's own rule, since it cannot prove the work exists elsewhere. Rebase is the documented
# default, so this is the exception rather than the common case, and it fails in the safe direction.
#
# "Is it pushed" is still the wrong question, for the reason it always was: a merged branch is
# deleted, so `@{u}` no longer resolves and an unpushed check would report everything as unpushed.
#
# IT REPORTS WHAT IT SKIPPED AND WHY. A reaper that silently declines is the same defect class as a
# check that cannot fail: the disk stays full and nobody knows which clone is holding it, so the
# next person deletes by hand and by eye, which is how work gets lost.
#
# REPORT-ONLY BY DEFAULT. `--prune` is what deletes. Refusing to act without being asked is cheap
# here and the failure mode on the other side is unrecoverable.
set -eu

usage() {
	cat <<'EOF'
usage: scratch-reap [--prune] [--root <dir>] [--quiet]

  Delete per-unit clones that are provably finished. Report-only unless --prune.

  --root <dir>  where the clones live. Defaults to $HOME/scratch/<runner> when a runner name is
                declared (forge-watch runner set), else $HOME/scratch — so one runner never reaps
                another's trees.
  --prune       actually delete. Without it, nothing is removed and every decision is printed.
  --quiet       print only what would be, or was, deleted.

  A clone is deleted only when ALL of: clean tree · every commit patch already in origin/main ·
  branch gone from origin. Anything else is kept, with the reason.

  exit 0 nothing to do or done · 1 usage/refusal · 2 DID NOT RUN — judged no clones at all while
         runner roots sit one level down, so the root is too shallow to see anything
EOF
}

PRUNE=no
QUIET=no
ROOT=''
while [ $# -gt 0 ]; do
	case "$1" in
	--prune) PRUNE=yes; shift ;;
	--quiet) QUIET=yes; shift ;;
	--root) [ $# -ge 2 ] || { usage >&2; exit 1; }; ROOT=$2; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) usage >&2; printf '\nscratch-reap: unknown option: %s\n' "$1" >&2; exit 1 ;;
	esac
done

if [ -z "$ROOT" ]; then
	_home=${HOME:-$(awk -F: -v u="$(id -u)" '$3==u{print $6; exit}' /etc/passwd 2>/dev/null || true)}
	[ -n "$_home" ] || {
		printf 'scratch-reap: cannot locate a home directory — pass --root explicitly.\n' >&2
		exit 1
	}
	# Scoped to THIS runner when one is declared (quince#111). Without it a reaper on a shared box
	# would walk into another session's trees, and the three conditions are about whether work is
	# safe to delete — not about whose it is.
	_rn=$("$(dirname "$0")/forge-watch" runner get 2>/dev/null || true)
	if [ -n "$_rn" ]; then
		ROOT="$_home/scratch/$_rn"
	else
		ROOT="$_home/scratch"
	fi
fi

say() { [ "$QUIET" = yes ] || printf '%s\n' "$*"; }

if [ ! -d "$ROOT" ]; then
	say "scratch-reap: no scratch root at $ROOT — nothing to do."
	exit 0
fi

say "scratch-reap: root=$ROOT mode=$([ "$PRUNE" = yes ] && printf prune || printf report-only)"

reaped=0
kept=0
skipped=0

for d in "$ROOT"/*; do
	[ -e "$d" ] || continue
	name=$(basename "$d")
	if [ ! -d "$d/.git" ]; then
		# Not a clone. Left alone and COUNTED, because a root full of stray files is a different
		# problem from a root full of finished clones and the two should not be reported as one.
		skipped=$((skipped + 1))
		say "  skip   $name — not a git clone"
		continue
	fi

	# The remote is asked once per clone. That is a network call apiece and it is the price of not
	# guessing: "the branch is gone" is a fact about the forge and cannot be read locally.
	if ! git -C "$d" fetch --quiet --prune origin 2>/dev/null; then
		kept=$((kept + 1))
		say "  KEEP   $name — could not reach origin, so whether its branch is gone is UNKNOWN"
		continue
	fi

	branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '')
	if [ -z "$branch" ] || [ "$branch" = HEAD ]; then
		kept=$((kept + 1))
		say "  KEEP   $name — detached or unreadable HEAD; not something to judge automatically"
		continue
	fi

	if [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]; then
		kept=$((kept + 1))
		say "  KEEP   $name — uncommitted changes on $branch"
		continue
	fi

	# PATCH-ID, NOT REACHABILITY (quince#823). `git cherry` prints `-` for a commit whose patch is
	# already upstream and `+` for one that is not, so a rebase-merged commit is recognised despite
	# its sha having changed. `rev-list --count origin/main..<branch>` counted every such commit as
	# outstanding, which kept 70 of 126 finished clones on one box and 9.7 GB with them.
	#
	# A FAILED COMPARISON IS A KEEP, never a zero. `grep -c` prints 0 and exits 1 when nothing
	# matches, which is the answer we want for a fully-landed branch — so the two cases have to be
	# told apart by whether `cherry` itself succeeded, not by the count.
	if ! cherry=$(git -C "$d" cherry origin/main "$branch" 2>/dev/null); then
		kept=$((kept + 1))
		say "  KEEP   $name — could not compare $branch against origin/main, so whether its work landed is UNKNOWN"
		continue
	fi
	ahead=$(printf '%s\n' "$cherry" | grep -c '^+' || true)
	case "$ahead" in '' | *[!0-9]*) ahead=1 ;; esac
	if [ "$ahead" -ne 0 ]; then
		kept=$((kept + 1))
		say "  KEEP   $name — $ahead commit(s) on $branch whose patch is not in origin/main"
		continue
	fi

	if git -C "$d" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
		kept=$((kept + 1))
		say "  KEEP   $name — $branch still exists on origin; somebody may be reviewing it"
		continue
	fi

	if [ "$PRUNE" = yes ]; then
		rm -rf "$d"
		reaped=$((reaped + 1))
		printf '  REAPED %s — %s is gone from origin and every commit has its patch in main\n' "$name" "$branch"
	else
		reaped=$((reaped + 1))
		printf '  would reap %s — %s is gone from origin and every commit has its patch in main\n' "$name" "$branch"
	fi
done

say ''

# JUDGING NOTHING IS NOT A CLEAN RESULT WHEN THE CLONES ARE ONE LEVEL DOWN (quince#823).
#
# THE MEASURED FAILURE: `bin/scratch-reap --root /root/scratch` printed
# `0 would be reaped, 0 kept, 26 not clones` and exited 0, over 10.3 GB in 119 clones. It judges
# IMMEDIATE CHILDREN, and on a shared box `$HOME/scratch/` holds RUNNER DIRECTORIES — so every entry
# is correctly "not a git clone" and the whole answer is vacuous.
#
# IT IS THE DOCUMENTED FALLBACK THAT LANDS THERE, which is what makes it worth refusing over. `--help`
# says the root is `$HOME/scratch` when no runner is declared, so an undeclared session gets a
# guaranteed silent no-op — a reaper reporting a clean sweep of a disk it never looked at. That is
# `exit 0 can be true and still wrong`, and quince#41's answer is the one this repo uses everywhere
# else: refuse, with the head named, rather than exit 0 having swept nothing.
#
# THE PREDICATE IS DELIBERATELY NARROW, because "no clones here" is a perfectly ordinary state — a
# fresh runner root, or one holding only scratch files. What is NOT ordinary is no clones HERE while
# a child directory contains one, which is the root-of-roots shape and nothing else. A root that is
# simply empty of clones still exits 0.
if [ "$((reaped + kept))" -eq 0 ]; then
	_nested=''
	for d in "$ROOT"/*; do
		[ -d "$d" ] || continue
		for c in "$d"/*; do
			[ -d "$c/.git" ] || continue
			_nested="$_nested $(basename "$d")"
			break
		done
	done
	if [ -n "$_nested" ]; then
		printf 'scratch-reap: DID NOT RUN — judged 0 clones in %s, but these children hold clones:%s\n' \
			"$ROOT" "$_nested" >&2
		printf 'scratch-reap: this root is one level too shallow. It judges immediate children, and\n' >&2
		printf 'scratch-reap: those are runner roots. Point it at one — --root %s/<runner> — or\n' "$ROOT" >&2
		printf 'scratch-reap: declare a runner (forge-watch runner set <name>) and pass no --root.\n' >&2
		printf 'scratch-reap: refusing rather than reporting a clean sweep of a disk it never read.\n' >&2
		exit 2
	fi
fi

if [ "$PRUNE" = yes ]; then
	printf 'scratch-reap: %s reaped, %s kept, %s not clones\n' "$reaped" "$kept" "$skipped"
else
	printf 'scratch-reap: %s would be reaped, %s kept, %s not clones — pass --prune to act\n' \
		"$reaped" "$kept" "$skipped"
fi
