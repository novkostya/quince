#!/bin/sh
# closing-refs-check — find closing keywords that will auto-close an issue on merge.
#
# THE DEFECT (quince#282). A closing keyword beside a BARE `#N` links the PR as closing that issue,
# and GitHub's parser is NOT negation-aware — so writing "does not close" a bare reference closes it.
# Four instances in one night, each written by somebody who knew about the trap:
#
#   1. a PR body disclaiming the close, closing it
#   2. the body of the PR FIXING that, by the author of the diagnosis, two hours later
#   3. the COMMIT MESSAGE of the commit that removed it from that body
#   4. a claim to the reviewer that a PR would not auto-close its issue, made after reading one surface
#
# The escalation is the finding: each time the knowledge was aimed at the surface that had bitten
# last. The trap is not the keyword list — it is that REPRODUCING the offending text is itself an
# instance, which is why every example in this file is backticked or repo-qualified.
#
# WHY A GATE AND NOT A PARAGRAPH. `/report` §2b said all of this in prose, and that prose was wrong
# THREE TIMES in the ninety minutes after it was written — wrong range, wrong surfaces, wrong pattern.
# Every one was found by RUNNING it and none by reading it. So the why stays in the skill and the
# always lives here (ruled on quince#293).
#
# TWO SURFACES, and `closingIssuesReferences` sees only one:
#
#   the PR body            → what the API field reflects
#   the COMMIT MESSAGES    → also close issues on merge, and with `--rebase` every message is in scope
#
# Measured on quince#291: body repo-qualified, commit message bare, the field read `[]` throughout,
# and the issue closed on merge. Both seats had concluded from that field that the link was gone.
#
# Three exit codes, the same contract as `privacy-check` (quince#41), because "found one" and
# "could not look" are different facts and a caller that conflates them is the bug:
#
#   0  looked, found nothing        — and the output says what was scanned
#   1  looked, found something      — with source, line and the matched text
#   2  DID NOT LOOK                 — bad arguments, unreadable or empty text, no usable matcher
set -eu

ME=$(basename "$0")

usage() {
	cat >&2 <<EOF
usage: $ME [--ref <range>] [--text <file>]

  --ref <range>   scan the COMMIT MESSAGES of <range>. Two-dot is used; see below.
  --text <file>   scan <file> verbatim — the PR body. May be /dev/stdin.

  At least one is required: with neither there is nothing to look at, and a gate that
  reports clean over nothing is the defect this contract exists to prevent.

exit: 0 nothing found · 1 found · 2 DID NOT LOOK
EOF
}

cannot_run() {
	printf '%s: DID NOT LOOK — %s\n' "$ME" "$1" >&2
	printf '%s: this is NOT a clean result. Nothing was checked.\n' "$ME" >&2
	exit 2
}

say() { printf '%s: %s\n' "$ME" "$*"; }

REF=''
TEXT=''
while [ $# -gt 0 ]; do
	case "$1" in
	--ref)
		[ $# -ge 2 ] || cannot_run "--ref needs a range"
		REF=$2
		shift 2
		;;
	--text)
		[ $# -ge 2 ] || cannot_run "--text needs a file"
		TEXT=$2
		shift 2
		;;
	-h | --help)
		usage
		exit 2
		;;
	*) cannot_run "unknown argument $1" ;;
	esac
done
[ -n "$REF" ] || [ -n "$TEXT" ] || cannot_run "neither --ref nor --text given, so there is nothing to scan"

# THE PATTERN, and both halves of it were wrong in the prose version before being measured.
#
# `[^A-Za-z0-9_-]` before the hash is what SKIPS THE SAFE FORMS. A repo-qualified reference does not
# auto-close — measured on a live open PR — and it is blocked by the alphanumeric immediately before
# the hash, the same trick `bin/pr-title-refs` uses. Without this the gate flags every qualified
# citation in a file, and a check that fires on safe text is one people learn to skim.
#
# DO NOT "IMPROVE" IT TO `(^|[^A-Za-z0-9_-])` to also catch a line starting with the reference.
# BusyBox `grep -E` — which is `/bin/grep` on these boxes — treats a MID-PATTERN `^` as a zero-width
# assertion that succeeds anywhere, so the alternation matches the empty string and the guard is
# silently disabled. Measured: `printf 'abc\n' | grep -cE 'a(^|x)bc'` returns 1 on BusyBox. The
# careful-looking version is the one that does nothing.
KW='(close[sd]?|fix(e[sd])?|resolve[sd]?)[^.]{0,20}[^A-Za-z0-9_-]#[0-9]+'

GREP=${CLOSING_REFS_GREP:-grep}
command -v "$GREP" >/dev/null 2>&1 || cannot_run "matcher $GREP not found"
# Prove the matcher can COMPILE the pattern before trusting a no-match answer. A regex this shell
# accepts and that grep rejects would otherwise read as clean forever (quince#41's shape).
printf '' | "$GREP" -qiE "$KW" 2>/dev/null || [ $? -eq 1 ] ||
	cannot_run "matcher $GREP cannot compile the closing-keyword pattern"

FOUND=0
SCANNED=''

# CODE SPANS ARE STRIPPED BEFORE MATCHING, and only from `--text` (quince#294 review).
#
# The first version advised "backtick it" and then FLAGGED backticked text — advice the tool refuses,
# which is worse than either half alone. And it contradicted this gate's own measured table, where
# backticked-inline and fenced are both `no`. Every future PR discussing this trap will quote it, and
# `/report` tells authors to backtick when they do, so the gate would have fired on every
# correctly-written one. My own words, from the qualified-reference case: *a check that fires on safe
# text is one people learn to skim.*
#
# LINE NUMBERS ARE PRESERVED by blanking rather than deleting, so a reported line still points at the
# right place in the original file.
#
# NOT APPLIED TO COMMIT MESSAGES, deliberately. The backtick measurement was taken on a PR BODY, which
# GitHub renders as markdown. Whether the auto-close parser honours backticks in a raw commit message
# is UNMEASURED — so commit messages keep the literal match and over-fire, which is the safe
# direction: a false hit there costs one reading, a missed one closes an issue.
#
# INDENTED (four-space) code blocks are NOT stripped either, for the same reason in miniature: telling
# them from list continuations needs a real markdown parse, and not stripping them over-fires.
strip_code() { # <file> -> stdout, same line count, code content blanked
	awk '
		/^[[:space:]]*```/ { infence = !infence; print ""; next }
		infence            { print ""; next }
		{ line = $0; gsub(/`[^`]*`/, "", line); print line }
	' "$1"
}

if [ -n "$REF" ]; then
	git rev-parse --git-dir >/dev/null 2>&1 || cannot_run "--ref given but this is not a git repository"
	# TWO DOTS, ALWAYS, and a three-dot range is NORMALISED rather than obeyed.
	#
	# `A...B` means "since the merge base" for `git diff` and the SYMMETRIC DIFFERENCE for `git log` —
	# same notation, different meaning, and `/report` tells the reader to copy the privacy sweep's
	# three-dot shape. Obeying it here reports commits already on the target branch: measured on this
	# gate's own branch, `...` found a hit in an ALREADY-MERGED commit while `..` correctly found none.
	# Under `strict: true` every branch is routinely behind, so that is the steady state rather than an
	# edge case, and a check that cries wolf on somebody else's merged work is one nobody reads.
	_r=$(printf '%s' "$REF" | sed 's/\.\.\./../')
	[ "$_r" = "$REF" ] || say "note: --ref $REF normalised to $_r — git log's three-dot form is the symmetric difference and would report merged commits"
	git rev-parse --verify --quiet "${_r%%..*}" >/dev/null 2>&1 ||
		cannot_run "cannot resolve the left side of $_r"
	_msgs=$(mktemp)
	git log --format=%B "$_r" >"$_msgs" 2>/dev/null || {
		rm -f "$_msgs"
		cannot_run "git log $_r failed — the range does not resolve"
	}
	if "$GREP" -inE "$KW" "$_msgs" >/dev/null 2>&1; then
		printf '%s: CLOSING REFERENCE in a commit message (%s)\n' "$ME" "$_r" >&2
		"$GREP" -inE "$KW" "$_msgs" | sed "s/^/    /" >&2
		FOUND=1
	fi
	rm -f "$_msgs"
	SCANNED="${SCANNED}commit-messages "
fi

if [ -n "$TEXT" ]; then
	[ -r "$TEXT" ] || cannot_run "--text $TEXT is not readable"
	# An EMPTY text file is not a clean sweep, it is a sweep of nothing — and the way a body file
	# becomes empty is a failed write, so the gate degrades exactly when something already went wrong.
	# Same reasoning, same wording, as quince#237 fixed in `privacy-check`.
	[ -s "$TEXT" ] || cannot_run "--text $TEXT is EMPTY — refusing to report clean over nothing"
	# Matched against the code-stripped copy, then the ORIGINAL line is printed for the reader — the
	# stripped one would show a hole where the code span was and read as a tool bug.
	_stripped=$(mktemp)
	strip_code "$TEXT" >"$_stripped"
	_hits=$("$GREP" -inE "$KW" "$_stripped" | cut -d: -f1 || true)
	if [ -n "$_hits" ]; then
		printf '%s: CLOSING REFERENCE in %s\n' "$ME" "$TEXT" >&2
		for _ln in $_hits; do
			printf '    %s:%s\n' "$_ln" "$(sed -n "${_ln}p" "$TEXT")" >&2
		done
		FOUND=1
	fi
	rm -f "$_stripped"
	SCANNED="${SCANNED}text "
fi

if [ "$FOUND" -eq 1 ]; then
	printf '%s: whatever is listed above, you either meant it or you did not — decide deliberately.\n' "$ME" >&2
	printf '%s: to reference without closing, use a repo-qualified form, or put it in backticks (body only — a commit message is matched literally).\n' "$ME" >&2
	exit 1
fi

# Say WHAT was scanned, not only that it was clean. A short list is a signal: `0` answers "did
# anything match", and only the list answers "was anything looked at" (quince#41).
say "clean — no bare closing reference in ${SCANNED%% }"
