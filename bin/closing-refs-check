#!/bin/sh
# closing-refs-check — find closing keywords that will auto-close an issue on merge.
#
# THE DEFECT (quince#282). A closing keyword beside a BARE `#N` links the PR as closing that issue,
# and GitHub's parser is NOT negation-aware — so writing "does not close" a bare reference closes it.
# Four instances in one night, each written by somebody who knew about the trap:
#
#   1. a PR body disclaiming the close, closing it
#   2. the body of the PR FIXING that, by the author of the diagnosis, two hours later
#   3. the COMMIT MESSAGE of the commit that removed it from that body
#   4. a claim to the reviewer that a PR would not auto-close its issue, made after reading one surface
#
# The escalation is the finding: each time the knowledge was aimed at the surface that had bitten
# last. The trap is not the keyword list — it is that REPRODUCING the offending text is itself an
# instance, which is why every example in this file is backticked or repo-qualified.
#
# WHY A GATE AND NOT A PARAGRAPH. `/report` §2b said all of this in prose, and that prose was wrong
# THREE TIMES in the ninety minutes after it was written — wrong range, wrong surfaces, wrong pattern.
# Every one was found by RUNNING it and none by reading it. So the why stays in the skill and the
# always lives here (ruled on quince#293).
#
# TWO SURFACES, AND EXACTLY TWO, and `closingIssuesReferences` sees only one:
#
#   the PR body            → what the API field reflects
#   the COMMIT MESSAGES    → also close issues on merge, and with `--rebase` every message is in scope
#
# Measured on quince#291: body repo-qualified, commit message bare, the field read `[]` throughout,
# and the issue closed on merge. Both seats had concluded from that field that the link was gone.
#
# AN ISSUE COMMENT IS NOT ONE OF THEM, and pointing this gate at one is a false positive by
# construction. GitHub interprets a closing keyword in a pull request DESCRIPTION or in a commit
# message; a comment on an issue closes nothing. So ordinary prose there is safe and this gate will
# flag it anyway — measured by doing it, within an hour of making the gate stricter. Written down
# because that is the natural habit after a gate gets stricter: sweep everything with it. A check
# that fires on safe text is one people learn to skim, which this file already says twice.
#
# AND ONLY WHEN THE PR TARGETS THE DEFAULT BRANCH — looked up live, and it qualifies every claim
# above: the keywords "are interpreted only when the pull request targets the repository's default
# branch. If the pull request targets any other branch, then these keywords are ignored, no links
# are created, and merging the PR has no effect on the issues." Every PR here targets `main`, so the
# advice this gate prints is unconditional IN PRACTICE — a property of current practice rather than
# of the tool, and exactly the kind of sentence this project has watched go stale.
#
# Three exit codes, the same contract as `privacy-check` (quince#41), because "found one" and
# "could not look" are different facts and a caller that conflates them is the bug:
#
#   0  looked, found nothing        — and the output says what was scanned
#   1  looked, found something      — with source, line and the matched text
#   2  DID NOT LOOK                 — bad arguments, unreadable or empty text, no usable matcher
set -eu

ME=$(basename "$0")

usage() {
	cat >&2 <<EOF
usage: $ME [--ref <range>] [--text <file>]

  --ref <range>   scan the COMMIT MESSAGES of <range>. Two-dot is used; see below.
  --text <file>   scan <file> verbatim — the PR body. May be /dev/stdin.

  At least one is required: with neither there is nothing to look at, and a gate that
  reports clean over nothing is the defect this contract exists to prevent.

exit: 0 nothing found · 1 found · 2 DID NOT LOOK
EOF
}

cannot_run() {
	printf '%s: DID NOT LOOK — %s\n' "$ME" "$1" >&2
	printf '%s: this is NOT a clean result. Nothing was checked.\n' "$ME" >&2
	exit 2
}

say() { printf '%s: %s\n' "$ME" "$*"; }

REF=''
TEXT=''
while [ $# -gt 0 ]; do
	case "$1" in
	--ref)
		[ $# -ge 2 ] || cannot_run "--ref needs a range"
		REF=$2
		shift 2
		;;
	--text)
		[ $# -ge 2 ] || cannot_run "--text needs a file"
		TEXT=$2
		shift 2
		;;
	-h | --help)
		usage
		exit 2
		;;
	*) cannot_run "unknown argument $1" ;;
	esac
done
[ -n "$REF" ] || [ -n "$TEXT" ] || cannot_run "neither --ref nor --text given, so there is nothing to scan"

# THE PATTERN, and both halves of it were wrong in the prose version before being measured.
#
# `[^A-Za-z0-9_-]` before the hash is what SKIPS THE SAFE FORMS. A repo-qualified reference does not
# auto-close — measured on a live open PR — and it is blocked by the alphanumeric immediately before
# the hash, the same trick `bin/pr-title-refs` uses. Without this the gate flags every qualified
# citation in a file, and a check that fires on safe text is one people learn to skim.
#
# DO NOT "IMPROVE" IT TO `(^|[^A-Za-z0-9_-])` to also catch a line starting with the reference.
# BusyBox `grep -E` — which is `/bin/grep` on these boxes — treats a MID-PATTERN `^` as a zero-width
# assertion that succeeds anywhere, so the alternation matches the empty string and the guard is
# silently disabled. Measured: `printf 'abc\n' | grep -cE 'a(^|x)bc'` returns 1 on BusyBox. The
# careful-looking version is the one that does nothing.
KW='(close[sd]?|fix(e[sd])?|resolve[sd]?)[^.]{0,20}[^A-Za-z0-9_-]#[0-9]+'

# THE URL FORM (quince#701), which the pattern above cannot see because there is no token to see.
#
# GitHub resolves a closing keyword followed by an ISSUE URL exactly as it resolves a bare reference.
# Measured rather than read off the docs: quince#700's body carried a keyword and a markdown link to
# quince#683's issue URL, and quince#683 went CLOSED/COMPLETED the moment that PR merged — read back
# off `closingIssuesReferences`, the field GitHub populates.
#
# `grep -c github.com bin/closing-refs-check` was 0 before this line. So the gate matched the
# reference TOKEN and never the LINK, and the two forms it appeared to catch —
# `<keyword> [<repo>#N](<url>)` and `<keyword> [#N](<url>)` — were caught only because a human
# happened to put a reference in the link LABEL. Relabel it and the gate went silent while the URL
# still closed: coverage by coincidence.
#
# `/pull/` IS MATCHED PRECAUTIONARILY, AND THAT IS NOT THE SAME AS MEASURED. The `/issues/` half is
# measured — quince#700's body, quince#683 closed, read off `closingIssuesReferences`. The `/pull/`
# half is not, and the first version of this comment asserted that GitHub "accepts either", which
# was written from memory in a project whose hard rule is that interface facts are looked up live.
#
# What the live lookup says: a keyword referencing another pull request does link them, and merging
# the referencing PR closes the referenced one — but that is documented for a *comment* reference,
# and NO URL-based closing syntax is documented at all. Both doc pages list exactly `#N` and
# `owner/repo#N`.
#
# So the honest statement is: the URL form works — this gate exists because it was seen working —
# and it is UNDOCUMENTED, which means the fixtures here are the only authority for it and it may
# change without notice. Matching `/pull/` costs one reading when it over-fires, and the alternative
# is missing a form nobody can look up. Kept on that basis rather than on a claim about binding.
#
# THE WINDOW IS `.{0,40}` RATHER THAN `[^.]{0,20}`, and the difference is deliberate twice over. A
# URL contains dots, and so do this project's own link labels (`qn.6e`), so the sentence-bounding
# class the token pattern uses would stop at the first one and miss the ordinary case. And the wider
# window over-fires in the direction this file already argues for: GitHub's parser is not
# negation-aware, so `does not fix <url>` DOES close — a line that reads as a disclaimer is exactly
# the instance this gate was built from, and flagging it is right rather than noisy.
KWURL='(close[sd]?|fix(e[sd])?|resolve[sd]?).{0,40}https?://(www\.)?github\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/(issues|pull)/[0-9]+'

# One pattern from here on, so a surface cannot be taught one form and not the other — the shape
# quince#784 landed for the same reason in the job engine, and the reason the token form and the URL
# form are not two independent greps threaded through four call sites.
CLOSING="($KW|$KWURL)"

# THE SECOND DIRECTION (quince#315): a closing keyword whose reference CANNOT BIND.
#
# GitHub resolves exactly `#N`, `GH-N` and `owner/repo#N`. This project's citation convention is
# `quince#N` / `quince-devlog#N` — no slash, so not a repo reference, and not bare. The keyword
# parses, binds to nothing, and produces no error, no warning, and an empty
# `closingIssuesReferences` indistinguishable from a PR that never claimed to close anything.
#
# MEASURED BEFORE BUILDING, as the ruling asked. Across merged PRs, 39 of 98 in `quince` carry a
# bound reference and 0 of 32 in `quince-devlog` do — so auto-close HAS worked here and the answer
# to "has it ever" is yes. The boundary is sharp: quince#288, merged 10:00 on 2026-07-30, is the
# LAST PR to bind, and every PR from #289 onward binds nothing. That is 38 minutes BEFORE this very
# gate merged (quince#293, 11:59), so the gate is not the cause — hand adoption of the qualified
# convention is, and the gate then made it permanent.
#
# Two correct decisions producing a silent failure between them, which is why neither side's author
# saw it, and why this direction is the durable half: if the convention changes again, the
# qualified-closing-line rule becomes obsolete and this check still catches the next version.
#
# awk RATHER THAN A SECOND grep PATTERN. The discriminator is "the qualifier contains no slash", and
# expressing absence in a BusyBox ERE that must also avoid a mid-pattern `^` (see the warning above)
# produced a pattern I could not convince myself was right by reading. awk splits the qualifier and
# tests it, which is checkable by eye.
inert_hits() { # <file> -> `<line>:<text>` for each CLOSING LINE whose reference binds to nothing
	awk '
		{
			# LINE-INITIAL ONLY, and the existing suite is why. The first version matched the keyword
			# anywhere and flagged `Refs quince#282, and quince#291 closed quince#290 on merge.` — prose
			# NARRATING a close, which binds to nothing and is exactly what the author wants. That is the
			# "a check that fires on safe text is one people learn to skim" failure this file already
			# warns about, arriving in the direction added second.
			#
			# The bare-reference check above over-fires on the same prose DELIBERATELY, and the asymmetry
			# is the point: a bare `#N` in prose really does close something, so a false hit there costs
			# one reading and a miss costs an issue. An INERT reference in prose does nothing at all, so
			# there is nothing to warn about — the defect only exists when the author MEANT to close.
			# Intent is not in the text, but the ruling names the surface: a closing LINE. So that is
			# what this matches, allowing a list bullet and bold markers.
			if (match($0, /^[ \t]*([-*+][ \t]*)?[*_]{0,2}([Cc][Ll][Oo][Ss][Ee][SsDd]?|[Ff][Ii][Xx]([Ee][SsDd])?|[Rr][Ee][Ss][Oo][Ll][Vv][Ee][SsDd]?)[*_]{0,2}[ \t]/)) {
				# A LINE CARRYING AN ISSUE URL IS NOT BOUND TO NOTHING — it binds, and this check used to
				# say the opposite about it (quince#701). `<keyword> [<repo>#N](<url>)` has a shorthand
				# token in the LABEL, which is what this function tests, and a URL in the target, which
				# is what GitHub acts on. It reported "the keyword parsed and resolved to NOTHING" about
				# a reference that demonstrably closed quince#683.
				#
				# WRONG IN THE DIRECTION THAT COSTS SOMETHING, which is why it is fixed here rather than
				# left as noise: a session that wants to reference WITHOUT closing reads "bound to
				# nothing", believes the merge is safe, and the issue closes anyway. The pattern above
				# now reports these lines as the closing references they are.
				if ($0 ~ /https?:\/\/(www\.)?github\.com\/[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+\/(issues|pull)\/[0-9]+/) next
				win = substr($0, RSTART + RLENGTH, 20)
				if (match(win, /[A-Za-z][A-Za-z0-9_-]*#[0-9]+/)) {
					tok = substr(win, RSTART, RLENGTH)
					# `owner/repo#N` binds and is correct. The slash can only be BEFORE the matched token,
					# so look at the character preceding it rather than inside it.
					pre = (RSTART > 1) ? substr(win, RSTART - 1, 1) : " "
					if (pre != "/") printf "%d:%s\n", NR, $0
				}
			}
		}
	' "$1"
}

GREP=${CLOSING_REFS_GREP:-grep}
command -v "$GREP" >/dev/null 2>&1 || cannot_run "matcher $GREP not found"
# Prove the matcher can COMPILE the pattern before trusting a no-match answer. A regex this shell
# accepts and that grep rejects would otherwise read as clean forever (quince#41's shape).
printf '' | "$GREP" -qiE "$CLOSING" 2>/dev/null || [ $? -eq 1 ] ||
	cannot_run "matcher $GREP cannot compile the closing-keyword pattern"

FOUND=0
INERT=0
SCANNED=''

# CODE SPANS ARE STRIPPED BEFORE MATCHING, and only from `--text` (quince#294 review).
#
# The first version advised "backtick it" and then FLAGGED backticked text — advice the tool refuses,
# which is worse than either half alone. And it contradicted this gate's own measured table, where
# backticked-inline and fenced are both `no`. Every future PR discussing this trap will quote it, and
# `/report` tells authors to backtick when they do, so the gate would have fired on every
# correctly-written one. My own words, from the qualified-reference case: *a check that fires on safe
# text is one people learn to skim.*
#
# LINE NUMBERS ARE PRESERVED by blanking rather than deleting, so a reported line still points at the
# right place in the original file.
#
# NOT APPLIED TO COMMIT MESSAGES, deliberately. The backtick measurement was taken on a PR BODY, which
# GitHub renders as markdown. Whether the auto-close parser honours backticks in a raw commit message
# is UNMEASURED — so commit messages keep the literal match and over-fire, which is the safe
# direction: a false hit there costs one reading, a missed one closes an issue.
#
# INDENTED (four-space) code blocks are NOT stripped either, for the same reason in miniature: telling
# them from list continuations needs a real markdown parse, and not stripping them over-fires.
strip_code() { # <file> -> stdout, same line count, code content blanked
	awk '
		/^[[:space:]]*```/ { infence = !infence; print ""; next }
		infence            { print ""; next }
		{ line = $0; gsub(/`[^`]*`/, "", line); print line }
	' "$1"
}

if [ -n "$REF" ]; then
	git rev-parse --git-dir >/dev/null 2>&1 || cannot_run "--ref given but this is not a git repository"
	# TWO DOTS, ALWAYS, and a three-dot range is NORMALISED rather than obeyed.
	#
	# `A...B` means "since the merge base" for `git diff` and the SYMMETRIC DIFFERENCE for `git log` —
	# same notation, different meaning, and `/report` tells the reader to copy the privacy sweep's
	# three-dot shape. Obeying it here reports commits already on the target branch: measured on this
	# gate's own branch, `...` found a hit in an ALREADY-MERGED commit while `..` correctly found none.
	# Under `strict: true` every branch is routinely behind, so that is the steady state rather than an
	# edge case, and a check that cries wolf on somebody else's merged work is one nobody reads.
	_r=$(printf '%s' "$REF" | sed 's/\.\.\./../')
	[ "$_r" = "$REF" ] || say "note: --ref $REF normalised to $_r — git log's three-dot form is the symmetric difference and would report merged commits"
	git rev-parse --verify --quiet "${_r%%..*}" >/dev/null 2>&1 ||
		cannot_run "cannot resolve the left side of $_r"
	_msgs=$(mktemp)
	git log --format=%B "$_r" >"$_msgs" 2>/dev/null || {
		rm -f "$_msgs"
		cannot_run "git log $_r failed — the range does not resolve"
	}
	if "$GREP" -inE "$CLOSING" "$_msgs" >/dev/null 2>&1; then
		printf '%s: CLOSING REFERENCE in a commit message (%s)\n' "$ME" "$_r" >&2
		"$GREP" -inE "$CLOSING" "$_msgs" | sed "s/^/    /" >&2
		FOUND=1
	fi
	_inert=$(inert_hits "$_msgs")
	if [ -n "$_inert" ]; then
		printf '%s: CLOSING KEYWORD BOUND TO NOTHING in a commit message (%s)\n' "$ME" "$_r" >&2
		printf '%s\n' "$_inert" | sed "s/^/    /" >&2
		INERT=1
	fi
	rm -f "$_msgs"
	SCANNED="${SCANNED}commit-messages "
fi

if [ -n "$TEXT" ]; then
	[ -r "$TEXT" ] || cannot_run "--text $TEXT is not readable"
	# An EMPTY text file is not a clean sweep, it is a sweep of nothing — and the way a body file
	# becomes empty is a failed write, so the gate degrades exactly when something already went wrong.
	# Same reasoning, same wording, as quince#237 fixed in `privacy-check`.
	[ -s "$TEXT" ] || cannot_run "--text $TEXT is EMPTY — refusing to report clean over nothing"
	# Matched against the code-stripped copy, then the ORIGINAL line is printed for the reader — the
	# stripped one would show a hole where the code span was and read as a tool bug.
	_stripped=$(mktemp)
	strip_code "$TEXT" >"$_stripped"
	_hits=$("$GREP" -inE "$CLOSING" "$_stripped" | cut -d: -f1 || true)
	if [ -n "$_hits" ]; then
		printf '%s: CLOSING REFERENCE in %s\n' "$ME" "$TEXT" >&2
		for _ln in $_hits; do
			printf '    %s:%s\n' "$_ln" "$(sed -n "${_ln}p" "$TEXT")" >&2
		done
		FOUND=1
	fi
	_inert=$(inert_hits "$_stripped")
	if [ -n "$_inert" ]; then
		printf '%s: CLOSING KEYWORD BOUND TO NOTHING in %s\n' "$ME" "$TEXT" >&2
		printf '%s\n' "$_inert" | sed "s/^/    /" >&2
		INERT=1
	fi
	rm -f "$_stripped"
	SCANNED="${SCANNED}text "
fi

if [ "$INERT" -eq 1 ]; then
	printf '%s: the keyword parsed and resolved to NOTHING. GitHub binds only #N, GH-N and\n' "$ME" >&2
	printf '%s: owner/repo#N — a repo shorthand without the owner is none of them. Write\n' "$ME" >&2
	printf '%s: "Closes novkostya/quince#N" on the closing line; prose citations are unchanged.\n' "$ME" >&2
	printf '%s: A keyword that silently binds to nothing leaves the issue open after its work\n' "$ME" >&2
	printf '%s: merges, which reads as a stall and gets the work re-taken (quince#315).\n' "$ME" >&2
fi

if [ "$FOUND" -eq 1 ] || [ "$INERT" -eq 1 ]; then
	printf '%s: whatever is listed above, you either meant it or you did not — decide deliberately.\n' "$ME" >&2
	printf '%s: to reference without closing, use a repo-qualified form, or put it in backticks (body only — a commit message is matched literally).\n' "$ME" >&2
	exit 1
fi

# Say WHAT was scanned, not only that it was clean. A short list is a signal: `0` answers "did
# anything match", and only the list answers "was anything looked at" (quince#41).
say "clean — no bare closing reference, and none bound to nothing, in ${SCANNED%% }"
