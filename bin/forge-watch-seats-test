#!/bin/sh
# forge-watch-seats-test — a seat is a NAME PATTERN, not a committed list (quince#330), and a seat
# declared on the OTHER box must be attributable on this one (quince#265, the property that survives).
#
# WHAT THE LIST COST, and it is why the list is gone. `.claude/seats` was an enumeration of something
# a regex describes completely — `r1 r2 r3 …`, `arch1` — so every new seat needed a PR, and the PR
# adding `r5` and `r6` was closed rather than merged because `r7` would need the next one.
#
# WORSE, THE GUARD DID NOT RUN WHERE IT MATTERED. `FORGE_SEATS_FILE` defaulted to a path relative to
# the CURRENT DIRECTORY, and the launchpad — the checkout a session starts in — is behind `main` and
# has no `.claude/seats` at all. An absent file meant allow-everything, so the SAME `runner set r9`
# was refused from a work clone and accepted from the launchpad. Two live seats declared themselves
# through that hole before anyone noticed (quince#330). Assertion (5) is that defect, and the old
# suite could not have caught it: every case pinned `FORGE_SEATS_FILE` explicitly, so no case ever
# exercised the default that was broken.
#
# WHAT THE PATTERN COSTS INSTEAD, accepted in the ruling: a TYPO is now a seat. `r66` for `r6` matches.
# The list would have refused it — but only where the guard ran, which was not the launchpad.
#
# AND THE RISK IT CARRIES is a prefix that is NOT a seat being read as one, which the enumeration made
# impossible by construction. That is what (1) and (4) pin, and they are the assertions to keep if any
# other here is ever dropped.
#
# WHAT WAS BROKEN, and it is worse than it sounds. `wake_filter` decides ownership by prefix-matching
# a branch against declared runner names, and it read only the LOCAL registry — while the branch
# namespace is GLOBAL. So `arch1/…` is correctly prefixed under the convention and still
# unattributable on the implementer box, because `arch1` was declared on the other one. It then fails
# OPEN and wakes every watch here.
#
# Measured 2026-07-30, and the two boxes are not symmetric:
#
#   implementer box   declares r1 r2 r3 r4   suppresses 5 PRs
#   architect box     declares arch1 only    suppresses 0 — `other_runner_names` returns EMPTY, so
#                                            the filter is a documented no-op there and has never
#                                            suppressed anything
#
# THE NEGATIVE CONTROL IS THE RETROSPECTIVE PROOF. Assertion (4) removes `arch1` from the list and
# watches the same PR wake — which is the pre-#265 behaviour exactly. Without it, (3) would pass
# against a tool that suppressed on some other ground, and this suite would be asserting that a
# branch is quiet rather than that the LIST is what quietened it.
#
# THE REFUSAL IS THE ANTI-DRIFT HALF (assertions 1-2, 5-6). A committed list nobody is forced to
# update is the drift class quince#200 and quince#256 both exist to close, so the list is
# authoritative rather than advisory: `runner set` refuses a name absent from it. Assertion 6 pins the
# additive boundary — no list, no refusal — because a stranger's clone must not be blocked by a file
# they have no reason to have, which is the resurrection test in `CLAUDE.md`.
#
# Synthetic and hermetic: a stub `gh` returning a fixed queue, no network, no credential.
set -eu

cd "$(dirname "$0")/.."
pass=0
fail=0
ok() {
	printf '  ok   %s\n' "$*"
	pass=$((pass + 1))
}
bad() {
	printf '  FAIL %s\n' "$*"
	fail=$((fail + 1))
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
export QUINCE_SESSION_ID=seats-test-session
REPO=novkostya/quince

# A stub forge with two PRs: mine, and one on a branch belonging to a seat that is declared ONLY in
# the committed list. `$WORK/turn` is the clock — 1 baseline, 2 moves the other seat's PR.
cat >"$WORK/gh" <<'STUB'
#!/bin/sh
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
case "$*" in
*"issue view"*) printf '{}\n'; exit 0 ;;
esac
base=2026-07-29T10:00:00Z
mine=$base; theirs=$base
case "$turn" in
2) theirs=2026-07-29T11:00:00Z ;;
esac
row() {
cat <<ROW
 {"number":$1,"state":"OPEN","updatedAt":"$2","title":"t","headRefName":"$3",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}
ROW
}
{
printf '['
row 101 "$mine"   "r1/my-work"
printf ','
row 909 "$theirs" "arch1/canon-thing"
printf ']\n'
} | jq -f "$STUB_INVERSE"
STUB
chmod +x "$WORK/gh"
export STUB_WORK="$WORK"
STUB_INVERSE="$PWD/bin/testdata/forge/gh-array-to-graphql.jq"
export STUB_INVERSE
[ -f "$STUB_INVERSE" ] || {
	printf 'forge-watch-seats-test: missing %s — the stub cannot answer the queue fetch\n' "$STUB_INVERSE" >&2
	exit 1
}

# --- The refusal (quince#265's anti-drift half) ------------------------------------------------
#
# Each of these gets a FRESH state home, because `runner set` is once-per-session and a name that
# stuck from an earlier assertion would make the next one pass without deciding anything.

fresh() { # <state-dir-suffix>
	XDG_STATE_HOME="$WORK/state-$1"
	export XDG_STATE_HOME
	rm -rf "$XDG_STATE_HOME"
}

# THIS SUITE IS ABOUT THE IMPLEMENTER SEAT, AND NOW HAS TO SAY SO (quince#292). The suppression it
# asserts is role-dependent: an ARCHITECT seat suppresses nothing — reviewing other runners' branches
# is the entire job — and a box that cannot identify its role fails OPEN. `owed_role` decides from
# which credential is present, so in the containerised gate, where none is, assertion (3) inverted and
# `arch1/…` woke the watch.
#
# THE IRONY IS WORTH THE LINE: this is quince#265's suite, and quince#265's fix is what created
# quince#292 by populating the suppression set on a seat where suppression is wrong. Its own
# containerised run is what caught the follow-on. Pinning all four paths also stops the suite reading
# this box's real credential store, which would make its result depend on which seat ran it.
export QUINCE_CODER_KEY_FILE="$WORK/coder.pem"
export QUINCE_ARCH_TOKEN_FILE="$WORK/arch.token"
export QUINCE_BOT_TOKEN_FILE="$WORK/bot.token"
export QUINCE_REVIEW_KEY_FILE="$WORK/review.pem"
printf 'a credential\n' >"$QUINCE_CODER_KEY_FILE"

# (1) A NAME THAT IS NOT A SEAT IS REFUSED — the risk the pattern carries and the list did not.
#
# BARE `analyst` IS IN THIS LIST AND NOT THE NEXT ONE, WHICH IS THE POINT OF THE ORDINAL (quince#375).
# The third seat joined the alternation because it now owns branches, and the obvious spelling of its
# name is a bare word — which is precisely the *"a prefix that is NOT a seat being read as one"* risk
# this assertion exists for. `analyst` is a plausible topic prefix; `analyst1` is not. It sits beside
# `r` and `arch`, which are refused for exactly the same reason and always have been.
for _bad in journal feature main r arch analyst xr1 ''; do
	fresh "refuse-${_bad:-empty}"
	if ./bin/forge-watch runner set "$_bad" >"$WORK/o" 2>&1; then
		bad "runner set accepted \"$_bad\", which is not a seat name"
	else
		ok "runner set refuses \"${_bad:-(empty)}\""
	fi
done

# (2) A SEAT NAME IS ACCEPTED — the control for (1). Without it, a `runner set` broken outright
# would satisfy every case above.
for _good in r1 r7 r66 arch1 arch2 analyst1 analyst2; do
	fresh "accept-$_good"
	if ./bin/forge-watch runner set "$_good" >"$WORK/o" 2>&1; then
		ok "runner set accepts \"$_good\""
	else
		bad "runner set refused \"$_good\", which matches the seat pattern"
		sed -n '1,3p' "$WORK/o"
	fi
done

# (3) THE PROPERTY THAT SURVIVES FROM quince#265: `arch1` is in no local registry on this box, and a
# branch it owns is still attributed — now by shape rather than by appearing in a file.
fresh attribute
./bin/forge-watch runner set r1 >/dev/null 2>&1 || bad "could not declare r1"
printf 1 >"$WORK/turn"
./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues --interval 1 --max-wait 3 >/dev/null 2>&1 || true
printf 2 >"$WORK/turn"
./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh" --no-issues --interval 1 --max-wait 5 >"$WORK/o" 2>&1 || true
if grep -q 'EXITING on the event' "$WORK/o"; then
	bad "woke on arch1/canon-thing — another seat's branch was not attributed"
	sed -n '1,6p' "$WORK/o"
else
	ok "a branch owned by arch1 does NOT wake this seat, with no list and no local registry entry"
fi

# (4) THE NEGATIVE CONTROL. A branch whose prefix is NOT a seat name must still wake — this is the
# case the enumeration made impossible and the pattern makes possible, so it is the one that matters.
fresh nonseat
./bin/forge-watch runner set r1 >/dev/null 2>&1 || bad "could not declare r1"
cat >"$WORK/gh2" <<'STUB2'
#!/bin/sh
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
t=2026-07-29T10:00:00Z
[ "$turn" = 1 ] || t=2026-07-29T11:00:00Z
cat <<ROW | jq -f "$STUB_INVERSE"
[{"number":101,"state":"OPEN","updatedAt":"2026-07-29T10:00:00Z","title":"t","headRefName":"r1/my-work",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"},
 {"number":909,"state":"OPEN","updatedAt":"$t","title":"t","headRefName":"journal/some-entry",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}]
ROW
STUB2
chmod +x "$WORK/gh2"
printf 1 >"$WORK/turn"
./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh2" --no-issues --interval 1 --max-wait 3 >/dev/null 2>&1 || true
printf 2 >"$WORK/turn"
./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh2" --no-issues --interval 1 --max-wait 5 >"$WORK/o" 2>&1 || true
if grep -q 'EXITING on the event' "$WORK/o"; then
	ok "a branch prefixed \`journal/\` is NOT a seat's, and still wakes"
else
	bad "suppressed journal/some-entry — a topic prefix was read as a seat, which is this change's risk"
	sed -n '1,6p' "$WORK/o"
fi

# (5) THE quince#330 DEFECT ITSELF: the answer must not depend on the working directory. The old
# guard read a cwd-relative file, so it refused from a work clone and accepted from the launchpad —
# and no case in the old suite could see that, because every one pinned FORGE_SEATS_FILE explicitly.
_cwd_ok=1
for _d in "$PWD" /tmp; do
	fresh "cwd-$(printf '%s' "$_d" | tr -c 'A-Za-z0-9' '_')"
	if (cd "$_d" && XDG_STATE_HOME="$XDG_STATE_HOME" "$OLDPWD/bin/forge-watch" runner set journal >/dev/null 2>&1); then
		bad "runner set accepted \"journal\" when run from $_d — the guard is cwd-dependent again"
		_cwd_ok=0
	fi
done
[ "$_cwd_ok" = 1 ] && ok "the refusal is identical from every working directory (no file is read)"

# (6) THE THIRD SEAT, IN BOTH DIRECTIONS (quince#375) -------------------------------------------
#
# (3) proves an `arch1/…` branch is attributed here with no local registry entry. The analyst seat has
# the same shape and a worse exposure: it lives on a THIRD box, so nothing on this one can ever have
# it in a registry, and quince#375 gave it `pull_requests: write` — so it opens PRs, and every one of
# them is an event on a branch this box must decide about.
#
# THE PAIR IS THE ASSERTION, NOT EITHER HALF. `analyst1/…` must be silent and `analyst/…` must WAKE.
# Alone, the first would pass against a pattern that swallowed any `analyst`-ish prefix — which is the
# bare-word form this change deliberately refuses — and the second would pass against a tool that
# suppressed nothing. Together they pin the ordinal, which is the only real decision in this change.
# The branch under test is read from a FILE by the stub, exactly as `turn` already is, rather than
# baked in by a second heredoc per case. One stub, two cases, and the only thing that differs between
# them is the one string this assertion is about.
cat >"$WORK/gh3" <<'STUB3'
#!/bin/sh
turn=$(cat "$STUB_WORK/turn" 2>/dev/null || printf 1)
ref=$(cat "$STUB_WORK/ref")
t=2026-07-29T10:00:00Z
[ "$turn" = 1 ] || t=2026-07-29T11:00:00Z
cat <<ROW | jq -f "$STUB_INVERSE"
[{"number":101,"state":"OPEN","updatedAt":"2026-07-29T10:00:00Z","title":"t","headRefName":"r1/my-work",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"},
 {"number":910,"state":"OPEN","updatedAt":"$t","title":"t","headRefName":"$ref",
  "closingIssuesReferences":[],"statusCheckRollup":[],"reviews":[],"comments":[],"commits":[],
  "mergedAt":null,"mergedBy":null,"mergeStateStatus":"CLEAN"}]
ROW
STUB3
chmod +x "$WORK/gh3"

for _case in "analyst1/scoping-thing:quiet" "analyst/scoping-thing:wake"; do
	_ref=${_case%%:*}
	_want=${_case#*:}
	fresh "third-seat-$_want"
	./bin/forge-watch runner set r1 >/dev/null 2>&1 || bad "could not declare r1"
	printf '%s' "$_ref" >"$WORK/ref"
	printf 1 >"$WORK/turn"
	./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh3" --no-issues --interval 1 --max-wait 3 >/dev/null 2>&1 || true
	printf 2 >"$WORK/turn"
	./bin/forge-watch watch --repo "$REPO" --gh "$WORK/gh3" --no-issues --interval 1 --max-wait 5 >"$WORK/o" 2>&1 || true
	if grep -q 'EXITING on the event' "$WORK/o"; then
		if [ "$_want" = wake ]; then
			ok "\`$_ref\` is NOT a seat name — the bare word still wakes, which is why the ordinal is required"
		else
			bad "woke on $_ref — the third seat's branch was not attributed"
			sed -n '1,6p' "$WORK/o"
		fi
	else
		if [ "$_want" = quiet ]; then
			ok "a branch owned by analyst1 does NOT wake this seat, from a box that can never have it in a registry"
		else
			bad "suppressed $_ref — a bare topic prefix was read as a seat, which this change's ordinal exists to prevent"
			sed -n '1,6p' "$WORK/o"
		fi
	fi
done

printf "\nforge-watch-seats-test: %d passed, %d failed\n" "$pass" "$fail"
[ "$fail" -eq 0 ]
