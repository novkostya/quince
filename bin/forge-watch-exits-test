#!/bin/sh
# forge-watch-exits-test — every exit the tool can return must be named where sessions read.
#
# quince#75: `bin/forge-watch watch` exits 1 when it REFUSES to arm — "a watch is ALREADY LIVE …
# refusing to arm a second one", which is quince#50's fix working. The skills enumerated the exits
# as 0, 6 and 7 and said "every exit is a re-arm". Followed literally on exit 1 that is
# refuse → re-arm → refuse → re-arm, unbounded, with NO watch running throughout. The architect hit
# it and escaped by noticing, which is not a mechanism.
#
# Adding "1" to the list would have fixed the instance and left the class: the next exit the tool
# learns, or the next document that copies an old enumeration, reproduces it. So this asserts the
# relationship instead of the fact, in three directions:
#
#   1. DERIVED  — the designed exits are extracted from bin/forge-watch itself, from the two
#      functions whose returns become process exits plus die(). A new code appears here without
#      anybody updating this file.
#   2. MEASURED — each is driven for real and its code observed, so the table cannot describe a
#      tool that does not behave that way.
#   3. DOCUMENTED — every derived code must be named in every document that enumerates exits.
#      That is the check quince#75 needed: a doc which lists some of them fails.
#
# It deliberately does NOT check the prose is *correct* — no test can — only that no exit is
# missing. "Every exit is a re-arm" was a false sentence about a complete-looking list; this stops
# the list being incomplete, and a reviewer still has to read the sentence.
set -eu

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH='' cd -- "$HERE/.." && pwd)
# Overridable so the NEGATIVE CONTROL is reproducible by a reviewer rather than a thing the author
# did once by hand and reported — the same hook, for the same reason, as PR_TITLE_REFS_BIN. Point it
# at an older copy of the tool and the source-analysis sections below must FAIL; `$HERE` stays this
# suite's own directory, so the document paths and the wrapper-existence check still resolve against
# the real tree. Copying the SUITE to a temp dir instead breaks those and produces failures that look
# like findings — measured while building quince#238's control.
FW="${FORGE_WATCH_BIN:-$HERE/forge-watch}"
[ -x "$FW" ] || { printf 'forge-watch-exits-test: %s is not executable\n' "$FW" >&2; exit 2; }

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
pass=0
fail=0

ok() {
	printf 'ok   %s\n' "$1"
	pass=$((pass + 1))
}
bad() {
	printf 'FAIL %s\n' "$1"
	[ -n "${2:-}" ] && printf '%s\n' "$2" | sed 's/^/    | /'
	fail=$((fail + 1))
}

# The documents that enumerate exits. A document is listed here because sessions act on it; if a new
# one starts enumerating exits it belongs on this list, and until it does this suite cannot see it.
# That limit is real and is stated rather than hidden.
#
# THE TOOL'S OWN `--help` IS ONE OF THEM, and it was the one this list did not have. Measured
# 2026-07-29: `usage()` enumerated five `status` exits and said "FIVE cases, never fewer" — while
# `watch_report` had returned a sixth, `orphaned` (10), since quince#111. Every file on the list
# above named 10 correctly and this suite passed, because the enumeration a user actually reads was
# not on the list. A gate over the derived documents that skips the ONE document generated from the
# code is the narrowest possible blind spot, and it sat exactly where the answer was wrong.
USAGE_TXT="$TMP/usage.txt"
"$FW" --help >"$USAGE_TXT" 2>&1 || true
DOCS="$ROOT/.claude/skills/architect/SKILL.md
$ROOT/.claude/skills/kickoff/SKILL.md
$ROOT/.claude/loop-protocol.md
$USAGE_TXT"

# --- 1. DERIVED ------------------------------------------------------------------------------
# watch_report's returns become `status`'s exit via `exit $?`; watch_loop's become `watch`'s the
# same way; die() is every refusal and every usage error in the tool.
derived=$(
	{
		awk '/^watch_report\(\)/,/^}/' "$FW" | grep -oE 'return [0-9]+'
		awk '/^watch_loop\(\)/,/^}/' "$FW" | grep -oE 'return [0-9]+'
		awk '/^die\(\)/,/^}/' "$FW" | grep -oE 'exit [0-9]+'
	} | grep -oE '[0-9]+' | sort -un | tr '\n' ' '
)
derived=$(printf '%s' "$derived" | sed 's/[[:space:]]*$//')
if [ -n "$derived" ]; then
	ok "derived the designed exits from bin/forge-watch: $derived"
else
	bad "could not derive any exit codes from bin/forge-watch — the extraction broke, and a suite that derives nothing would pass everything"
fi

# --- 2. MEASURED -----------------------------------------------------------------------------
# Driving the tool into each state, so the derived table cannot describe behaviour the tool does
# not have. A pid that is certainly alive: this shell. A pid that is certainly not: one past the max.
measure() { # <label> <want> <command...>
	_ml=$1 _mw=$2
	shift 2
	"$@" >/dev/null 2>&1 && _mg=0 || _mg=$?
	if [ "$_mg" -eq "$_mw" ]; then
		ok "measured $_ml → exit $_mg"
	else
		bad "measured $_ml → exit $_mg, expected $_mw"
	fi
}

now=$("$FW" --version >/dev/null 2>&1 || date -u +%Y-%m-%dT%H:%M:%SZ)
live_state="$TMP/live.json"
printf '{"watch":{"pid":%s,"last_watcher_tick":"%s","interval_s":60}}' "$$" "$now" >"$live_state"
dead_state="$TMP/dead.json"
printf '{"watch":{"pid":4194303,"last_watcher_tick":"%s","interval_s":60}}' "$now" >"$dead_state"
wedged_state="$TMP/wedged.json"
printf '{"watch":{"pid":%s,"last_watcher_tick":"2020-01-01T00:00:00Z","interval_s":60}}' "$$" >"$wedged_state"
absent_state="$TMP/absent.json" # never created

measure "status on a live watch"   0 "$FW" status --repo x/y --state "$live_state"
measure "status on a dead watch"   3 "$FW" status --repo x/y --state "$dead_state"
measure "status on an absent watch" 4 "$FW" status --repo x/y --state "$absent_state"
measure "status on a wedged watch" 5 "$FW" status --repo x/y --state "$wedged_state"

# `starting` and `orphaned` were DERIVED and DOCUMENTED here but never MEASURED — four of the six
# `status` answers were driven and two were taken on trust, which is the asymmetry that let the
# usage text describe five answers while the tool returned six. Both are cheap to drive.
#
# starting: armed, first tick not finished. `last_watcher_tick` null is the fact that DEFINES it,
# and it must sit inside `starting_bound_s` of `armed_at` or it degrades to dead/never_ticked.
starting_state="$TMP/starting.json"
printf '{"watch":{"pid":%s,"last_watcher_tick":null,"armed_at":"%s","starting_bound_s":600,"interval_s":60}}' \
	"$$" "$now" >"$starting_state"
measure "status on a starting watch" 9 "$FW" status --repo x/y --state "$starting_state"

# orphaned: the watcher runs, the session that armed it does not. Reached through `pid_alive(owner)
# == no`, which needs no procfs — the start-time comparison is only for the harder case of a pid
# that EXISTS and might be a different process. So this measurement runs everywhere, unlike the
# composition suite's orphan phase, and that is worth having: it means the class is driven on hosts
# where the integration test can only skip it.
orphan_state="$TMP/orphan.json"
printf '{"watch":{"pid":%s,"last_watcher_tick":"%s","interval_s":60,"owner_pid":4194303,"owner_pid_start":"1"}}' \
	"$$" "$now" >"$orphan_state"
measure "status on an orphaned watch" 10 "$FW" status --repo x/y --state "$orphan_state"

# The refusals — quince#75's subject. These are NOT re-arms: obeying "every exit is a re-arm" here
# loops forever with no watch running.
measure "watch REFUSING beside a live watch"   1 "$FW" watch --repo x/y --state "$live_state" --gh /bin/true
measure "watch REFUSING beside a wedged watch" 1 "$FW" watch --repo x/y --state "$wedged_state" --gh /bin/true
measure "an unknown option"                    1 "$FW" watch --no-such-flag
# The --issue refusals. The second is a REGRESSION GUARD, not a tidiness: the single-repo path
# originally had no check at all, so `--repo A --issue B#9` declared nothing and said nothing — and,
# the worse half, one unmatched spec replaced an EXISTING declaration with an empty one, byte-identical
# to `--no-issues`. Silent in exactly the way this feature exists to stop. Found in review of quince#87.
measure "watch REFUSING a bare --issue under --all"        1 "$FW" watch --all --issue 9 --gh /bin/true
measure "watch REFUSING a cross-repo --issue under --repo" 1 "$FW" watch --repo x/y --issue a/b#9 --gh /bin/true

# --- 3. DOCUMENTED ---------------------------------------------------------------------------
# Every derived code must be named in every document that enumerates exits. Naming means the digit
# appears; this cannot check that what is said about it is true, and does not pretend to.
for _doc in $DOCS; do
	# The generated one is labelled by what a reader would run, not by its mktemp path — a failure
	# naming /var/folders/… tells nobody which document to go and fix.
	if [ "$_doc" = "$USAGE_TXT" ]; then _name='bin/forge-watch --help'; else _name=${_doc#"$ROOT"/}; fi
	if [ ! -f "$_doc" ]; then
		bad "$_name does not exist — the doc list is stale, which is the drift this suite exists to catch"
		continue
	fi
	_missing=''
	for _code in $derived; do
		# The digit must appear IN AN EXIT CONTEXT, not merely somewhere in the file. The first
		# version matched the digit as a standalone token anywhere and PASSED on the very documents
		# quince#75 was filed about — 0, 1, 3, 5, 6 and 7 all occur in ordinary prose here as issue
		# numbers, counts and line references. A doc-consistency check that cannot fail on the broken
		# docs is the vacuous pass this repository keeps removing, and it took writing it to see it.
		#
		# Three accepted forms, each arrived at by a wrong version first:
		#
		#   1. code within 48 chars after exit-vocabulary on one line. `.{0,48}` and NOT
		#      `[^0-9]{0,48}` — "exits 0 live / 3 dead / 4 absent" means reaching `3` crosses `0`,
		#      and excluding digits from the gap reported 3, 4 and 5 missing from a line naming all
		#      four. Caught by reading WHICH codes it claimed were absent rather than trusting that
		#      it had started failing.
		#   2. a bolded code on a line with exit-vocabulary, for enumerations too long for (1).
		#   3. a table row keyed by the code, `| **1** | …`, optionally indented — the tables put the
		#      code in the first cell with "exit" only in the header, where (1) cannot see it.
		#
		# A code split across a line wrap from its exit-vocabulary matches none of these, and that is
		# deliberate: it is the one shape where a reader skimming for "which exits are listed" can
		# miss one, which is how this bug happened.
		if ! grep -qiE "(exit|code)s?.{0,48}(^|[^0-9])${_code}([^0-9]|$)" "$_doc" &&
			! grep -qiE "(exit|code)s?.*\*\*${_code}\*\*" "$_doc" &&
			! grep -qE "^[[:space:]]*\|[[:space:]]*\*\*${_code}\*\*[[:space:]]*\|" "$_doc"; then
			_missing="$_missing $_code"
		fi
	done
	if [ -z "$_missing" ]; then
		ok "$_name names every derived exit ($derived)"
	else
		bad "$_name does not name exit(s):$_missing" \
			"quince#75: a document that enumerates SOME of the exits is how 'every exit is a re-arm' became advice to loop forever on a refusal."
	fi
done

# --- 4. HANDLED ------------------------------------------------------------------------------
# Every class `watch_report` can return must have its OWN arm in `owed_decide`. Same shape as
# section 3 — an enumeration that has to stay total — aimed at a CONSUMER IN CODE rather than at a
# document, and it exists because section 3 structurally could not see this one (quince#195).
#
# `orphaned` got its own exit code in quince#167 so that it could be NAMED, and `owed`'s message
# switch was never extended. It fell to the catch-all and told sessions "the watch class could not be
# read (10)". The decision stayed right — `owed_decide` treats everything but live/starting as owed,
# so the fail-safe held — which is precisely why nothing caught it: the exit code was correct and
# only the sentence was wrong.
#
# quince#183 had landed hours earlier for this exact shape (a class added, an enumeration not
# updated) and its fix put `bin/forge-watch --help` on the DOCS list above. That gate reads documents
# for exit VOCABULARY; `owed_decide` enumerates the same classes as a shell `case` over class
# numbers, with no such vocabulary anywhere near it, so it was invisible. Fixing the instance without
# this section leaves the class open for a third time.
#
# It asserts an arm EXISTS, not that its text is right — the same limit section 3 states about prose,
# and for the same reason. `owed-an-orphaned-watch-names-its-remedy.json` is what pins the wording.
report_codes=$(
	awk '/^watch_report\(\)/,/^}/' "$FW" | grep -oE 'return [0-9]+' | grep -oE '[0-9]+' | sort -un
)
# The message arms only. Anchored on a leading digit so the tally line inside the same function —
# `case "$_od_cls" in 0 | 9) ;; *) _od=8 ;; esac`, which begins with `case` — cannot contribute arms
# it does not have; and the catch-all `*)` is never mistaken for coverage of a named class.
owed_arms=$(
	awk '/^owed_decide\(\)/,/^}/' "$FW" | grep -oE '^[[:space:]]*[0-9]+\)' | grep -oE '[0-9]+' | sort -un
)
if [ -z "$report_codes" ] || [ -z "$owed_arms" ]; then
	# A suite that derives nothing passes everything — the failure section 1 already guards against,
	# restated here because this is a second, independent extraction.
	bad "could not derive watch_report's classes or owed_decide's arms — the extraction broke" \
		"classes: $(printf '%s' "$report_codes" | tr '\n' ' ') / arms: $(printf '%s' "$owed_arms" | tr '\n' ' ')"
else
	_unhandled=''
	for _code in $report_codes; do
		printf '%s\n' "$owed_arms" | grep -qx "$_code" || _unhandled="$_unhandled $_code"
	done
	if [ -z "$_unhandled" ]; then
		ok "owed_decide has an explicit arm for every class watch_report returns ($(printf '%s' "$report_codes" | tr '\n' ' '))"
	else
		bad "owed_decide has NO arm for watch_report class(es):$_unhandled" \
			"quince#195: an unhandled class falls to the catch-all and is reported as 'the watch class could not be read' — which describes a failure to determine state, when the state was determined perfectly. The verdict stays correct and only the remedy is lost, so nothing else fails."
	fi
fi

# ---------------------------------------------------------------------------------------------
# owed_role must know the LIVE credentials, not the retired ones (quince#238)
# ---------------------------------------------------------------------------------------------
# The third instance of this file's theme, and the most expensive: an enumeration that has to stay
# total, aimed at a set that CHANGES UNDERNEATH IT. `owed_role` decides which seat a box is by which
# credential file it holds. `decisions/0014` moved the implementer identity to the `quince-coder`
# App and `quince-bot` was suspended, and `owed_role` was never told — so on the implementer box
# every arm missed, the role resolved to `none`, and the `Stop` hook's `none` branch FAILS OPEN by
# design. The guard against ending a session with an open PR and no watch was dead on the one seat
# that opens pull requests, across 24 measured firings.
#
# It is a static check for the same reason the two sections above are: driving `owed_role` for real
# means holding a credential and reaching the forge, so a suite that tried would skip on CI and pass
# by omission — quince#41's shape, in the gate meant to catch a gate that had stopped checking.
#
# WHY THESE ASSERTIONS AND NOT "every wrapper appears here". `gh-bot` is deliberately retained as an
# unmodified record (`decisions/0014` condition 1) while no longer being anything a session should be
# told to run, so a blanket rule would demand it and be wrong.
#
# THIS PARAGRAPH USED TO EXCLUDE `gh-review` TOO — *"the reviewer, and not a watch role at all"* —
# and that was exactly backwards. The review key IS the architect box's live credential, the way the
# coder key is the implementer's, and `owed_role` did not know it: the arch box's role rested
# entirely on the LEGACY PAT, which the function's own comment already called luck rather than
# coverage. A tidy-up of that PAT would have returned `none` there and taken the `Stop` hook's
# assertion with it. The symmetry is asserted below now, because the reasoning that excluded it read
# as sound and was wrong for a whole seat.
role_body=$(awk '/^owed_role\(\)/,/^}/' "$FW")
if [ -z "$role_body" ]; then
	bad "could not extract owed_role's body — the extraction broke" \
		"Without it the two assertions below are vacuous, which is the failure mode they exist to catch."
else
	# 1. THE REGRESSION. The live implementer credential must be one of the things it branches on.
	if printf '%s' "$role_body" | grep -q 'QUINCE_CODER_KEY_FILE'; then
		ok "owed_role branches on the LIVE implementer credential (quince-coder App key)"
	else
		bad "owed_role does not mention QUINCE_CODER_KEY_FILE — the implementer box will resolve to role=none" \
			"quince#238: role=none makes the Stop hook fail open on the seat that opens PRs, and it does so in a shape that reads as normal — on a box with genuinely no credential, 'whether a watch is owed was NOT checked' is the expected output."
	fi

	# 1b. THE SAME ASSERTION FOR THE OTHER SEAT, and it is not symmetry for its own sake: without it
	# the architect box's role depends on the legacy PAT alone, and this file's own subject is
	# enumerations that stay total while the set changes underneath them.
	if printf '%s' "$role_body" | grep -q 'QUINCE_REVIEW_KEY_FILE'; then
		ok "owed_role branches on the LIVE architect credential (quince-review App key)"
	else
		bad "owed_role does not mention QUINCE_REVIEW_KEY_FILE — the arch box's role rests on the legacy PAT alone" \
			"Retiring that PAT resolves the architect seat to role=none, which disarms the Stop hook's assertion there exactly as quince#238 did on the implementer seat."
	fi

	# 2. NO ARM MAY HAND BACK A WRAPPER FOR A RETIRED IDENTITY. The remedy this function prints is a
	# command the reader runs; naming `gh-bot` hands them one that cannot authenticate, which looks
	# like a broken hook rather than a dead account — strictly worse than printing no remedy.
	if printf '%s' "$role_body" | grep -q 'bin/gh-bot'; then
		bad "owed_role hands back bin/gh-bot, whose account is suspended" \
			"quince#238: a role's third field is a command the session is told to run. Pointing it at a suspended identity means the remedy fails when followed, and the reader debugs the watch instead of the credential."
	else
		ok "no owed_role arm hands back a wrapper for a retired identity"
	fi

	# 2b. FIELD 2 IS THE **READ** WRAPPER, AND IT IS DRIVEN RATHER THAN GREPPED (quince#303).
	#
	# quince#299 made the architect arm return `bin/gh-review` on the argument that the App is what
	# casts verdicts — true, and about the wrong field. Every consumer of field 2 is a READ: `owed`'s
	# forge query, its fetch default, and the watch command the `Stop` hook prints. So the change put
	# a **watch loop** onto a wrapper that mints a fresh installation token per call and caches
	# nothing, which `bin/gh-review` itself flags: *"if that ever bites, cache it."*
	#
	# THE SECTION HEADER ABOVE SAYS THIS CANNOT BE DRIVEN — *"driving `owed_role` for real means
	# holding a credential and reaching the forge"* — AND THAT IS FALSE FOR THIS PATH. `owed_role`
	# performs `[ -f ]` tests and nothing else, and `owed --hook` fails open by design, so pointing
	# the four credential variables at temp files exercises the real arm with no forge and no secret.
	# The checks above are still right to be static; this one never had to be, and the reason it was
	# is an assumption nobody re-measured.
	_er_w=$(mktemp -d)
	printf 'a credential\n' >"$_er_w/rev"
	printf 'a credential\n' >"$_er_w/pat"
	printf 'r1\n' >"$_er_w/seats"
	# A DECLARED RUNNER FIRST, or the hook fails open one step EARLIER — on "no runner name" — and
	# names no wrapper at all. Both assertions then compare against an empty string and fail for a
	# reason that has nothing to do with the field under test. Caught by writing them.
	XDG_STATE_HOME="$_er_w/state" QUINCE_SESSION_ID=exits-test-role \
		FORGE_SEATS_FILE="$_er_w/seats" "$FW" runner set r1 >/dev/null 2>&1 || true
	hook_wrapper() { # <review-key-path> <arch-token-path> -> the wrapper(s) the Stop hook names
		XDG_STATE_HOME="$_er_w/state" QUINCE_SESSION_ID=exits-test-role \
			QUINCE_CODER_KEY_FILE="$_er_w/absent" QUINCE_BOT_TOKEN_FILE="$_er_w/absent" \
			QUINCE_REVIEW_KEY_FILE="$1" QUINCE_ARCH_TOKEN_FILE="$2" \
			"$FW" owed --hook 2>&1 | grep -oE 'bin/gh-[a-z]+' | sort -u | tr '\n' ' '
	}
	_er_both=$(hook_wrapper "$_er_w/rev" "$_er_w/pat")
	_er_apponly=$(hook_wrapper "$_er_w/rev" "$_er_w/absent")
	rm -rf "$_er_w"

	# The arch box holds BOTH today, and must read through the CACHED wrapper.
	case "$_er_both" in
	*gh-arch*) ok "architect holding both credentials reads through the cached wrapper (quince#303)" ;;
	*) bad "the Stop hook hands the arch box '$_er_both' while the PAT is present" \
		"quince#303: a tick is one pr list per repo plus one issue view per declared issue, and an uncached App wrapper measured ~1.84 s per call — most of a 90 s interval spent minting one-hour tokens it then discards." ;;
	esac

	# With the PAT retired it must FALL BACK, not refuse: correct-but-slow beats broken, and the fix
	# for the slow case is a token cache — "a second secret at rest", a decision nobody has made.
	case "$_er_apponly" in
	*gh-review*) ok "…and falls back to the App wrapper once the PAT is gone, rather than refusing" ;;
	*) bad "a box holding only the review key gets '$_er_apponly' — no usable read wrapper" \
		"Retiring the PAT must degrade to correct-but-slow, never to a wrapper for a credential that is not there." ;;
	esac

	# 3. Every wrapper it DOES name must actually be there. Cheap, and it is the assertion that keeps
	# the two above from being satisfied by a typo.
	_missing=''
	for _w in $(printf '%s' "$role_body" | grep -oE '%s/bin/[a-z-]+' | sed 's|%s/||' | sort -u); do
		[ -x "$HERE/../$_w" ] || _missing="$_missing $_w"
	done
	if [ -z "$_missing" ]; then
		ok "every wrapper owed_role names exists and is executable"
	else
		bad "owed_role names wrapper(s) that are not executable here:$_missing" \
			"The role's third field is handed to the session as a command to run."
	fi
fi

printf '\nforge-watch-exits-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ] || exit 1
