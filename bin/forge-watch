#!/bin/sh
# forge-watch — turn forge state into events, so a rung advances without a human relaying
# "review posted" across the gap. Spec: docs/specs/rung-loop/rung-loop.md.
#
# The whole design is one split: a PURE step() and a thin fetch. Every monitor bug this project
# produced was untestable because the thing deciding what to emit was welded to the thing polling
# GitHub — so the deciding half takes an observation as JSON and returns events, and the fixtures
# drive it with no network at all.
#
#   forge-watch step --state F --observation F   # pure; what the fixtures exercise
#   forge-watch tick --state F                   # fetch, then step
#   forge-watch replay <fixture>...              # run fixtures, compare against expect_events
set -eu

usage() {
	cat <<'EOF'
usage: forge-watch <verb>

  step   --state <file> --observation <file>   emit events for one observation (pure, no network)
  tick   [--repo owner/name | --all] [--state <file>] [--gh <cmd>] [--watcher-pid <n>]
         [--interval <s>] [--set-file <f>]     fetch the queue, then step
  watch  [--repo owner/name | --all] [--state <file>] [--gh <cmd>] [--interval <s>]
         [--max-wait <s>] [--fail-after <n>] [--set-file <f>]
                                               tick until there is something to say, THEN EXIT
  status [--repo owner/name | --all] [--state <file>] [--now <iso>] [--set-file <f>]
                                               live | dead | absent — and which, and what to do
  stop   [--repo owner/name] [--state <file>]  verify the recorded pid is still OUR watcher, then
                                               signal it — refuses rather than guessing
  replay <fixture.json>...                     drive step/watch_report from fixtures; non-zero on mismatch

  `watch` OWNS THE LOOP, and the reason it is a verb is the whole of quince#62: a session that
  assembles the loop itself writes `while :; do tick; sleep 60; done`, which is correct-looking,
  reports healthy from every angle, and CAN NEVER WAKE ANYTHING. An agent session is woken by a
  background task COMPLETING, so a loop with no exit condition delivers nothing it detects — fresh
  heartbeat, state updating, `status=live`, session deaf for fifty minutes. The rule, stated once
  here so a reader who hand-rolls anyway knows the constraint: **the loop must exit when it finds
  something; a loop that cannot exit cannot wake you.**

  Run it as a BACKGROUND task, never in the foreground: in the foreground it blocks the session it
  is supposed to wake.

  `watch` exit codes: 0 an event (the wake — the events are on stdout) · 6 the --max-wait bound
  with nothing seen (`event=watch-idle`) · 7 --fail-after consecutive failing ticks. It refuses to
  arm beside a `live` watch and refuses to arm beside a `wedged` one (run `stop` first) — the four
  answers of `status` are enforced here rather than left to a paragraph someone remembers. A refusal
  exits 1, as every refusal in this tool does; `dead` and `absent` proceed and say which they were.

  Every tick's output is printed whether or not it wakes anybody; the filter decides what WAKES,
  never what is SEEN. Two kinds of line do not wake:
    - the baseline. `first-observation` (and the `queue-empty` that accompanies it) is the
      observation that establishes the baseline, not a change from it — exiting on it would make
      arming a watch a busy loop of arm-exit-arm.
    - `fetch-failed`, until --fail-after of them in a row (default 3). One failed fetch is a missed
      tick, not news; a run of them is. Meanwhile the heartbeat does not advance across a failing
      tick, so such a watcher ages into `wedged` and says so there too.

  `--max-wait` (default 1200s) makes TERMINATION the heartbeat: the loop exits idle, the session
  wakes, re-arms, and the only channel involved is the one measured to work. It does not replace the
  `ScheduleWakeup` fallback the skills arm — that fallback stays, and it is belt to this braces.

  `watch` does NOT suppress events caused by the session running it — roughly a third of an
  architect's wakes are its own approvals and merges (quince#62). Said out loud rather than fixed,
  because a suppression rule is a claim about what cannot matter, and this tool has already been
  wrong about that once: `actor=` is on the event, and the woken session can read it.

  --all reads the watch set from .claude/forge-set (or --set-file / FORGE_SET_FILE): one owner/name
  per line, `#` comments. It HARD-FAILS when that file is missing, empty or malformed — it never
  falls back to one repository, because a watch set that quietly shrinks is how a monitor reports
  both queues clear while covering one of them. Under --all every event carries `repo=`, since PR
  numbers collide across repositories by construction.

  State lives at $FORGE_STATE_DIR, else $XDG_STATE_HOME/quince/forge-watch, else
  ~/.local/state/quince/forge-watch — one file per repo, at a path that OUTLIVES THE SESSION. A
  session scratchpad is the wrong home for it: the failure this state exists to survive is the
  session process restarting, which is exactly when a scratchpad-scoped file is not there.

  `status` exit codes: 0 live · 3 dead (nothing running — re-arm from the state, do NOT reseed) ·
  4 absent (cold start) · 5 wedged (a process is still running and has stopped ticking — `stop` it,
  then re-arm). Four cases, never fewer: collapsing dead into absent turns a restarted watch into a
  fresh one that has "seen nothing changed" since a beginning it invented, and collapsing wedged into
  dead tells the reader to start a second watcher beside a live one.

  On `wedged`, use `stop` rather than `kill`. The pid is only known to be OUR watcher while its
  heartbeat is fresh, and `wedged` is defined by that heartbeat being stale — so a bare kill on a
  recycled pid signals a bystander. Demonstrated in review: with a foreign pid in the state, an
  earlier version of this tool told the reader to kill init, in the imperative.

  A watcher passes --watcher-pid and --interval so its cadence is on disk; a tick that was due and
  did not happen then emits `event=tick-overdue` instead of being absorbed.

  --gh defaults to FORGE_GH, else plain `gh`. The runner passes gh-bot; the arch box passes
  gh-arch. The tool does not pick an identity for you — a monitor that hard-coded one could not
  run on the box that most needs it.

events: first-observation · queue-empty · updated · opened · review · checks · mergeability ·
        merged · tick-overdue · fetch-failed · queue-truncated · watch-idle · watch-failing

  `updated` is the BACKSTOP: any change to a PR's updatedAt emits it, whether or not a typed
  event also fired. The typed events classify; the backstop guarantees nothing is invisible.

  `stalled` is specified (docs/specs/rung-loop/rung-loop.md story 6) and NOT implemented — it
  needs a wall clock, which the pure half deliberately does not have. It was advertised here
  while unimplemented; a tool that lists an event it cannot emit is making the same kind of
  claim this tool exists to stop, so it is off the list until it can be produced.
EOF
}

die() {
	printf 'forge-watch: %s\n' "$*" >&2
	exit 1
}

# ---------------------------------------------------------------------------
# step — the whole decision, and the only part with interesting behaviour.
#
# Rules earned by defects (spec §4), each of which was a real miss:
#   - a state that has never observed anything is NOT an empty queue. The sentinel discharges as
#     its own event, so "I never looked" can never read as "nothing happened".
#   - queue-empty is an EVENT. Silence is not a report.
#   - the queue is compared wholesale each tick, so a PR opened after arming is seen. Binding a
#     list at arm time is how one was missed.
#   - check conclusions are watched beside reviews: a red PR is unreviewable, and that is progress
#     information, not noise.
#   - every event carries the observation that produced it, never a bare "something changed".
#
# And the rule that arrived later, from the deadlock of 2026-07-26 (quince#43): an ENUMERATED event
# model is a claim about what can matter, and this one was wrong four times over on a single
# transition — changes-requested → fixed → awaiting re-review. A push is not an event; green checks
# were deliberately not an event; a comment is not an event; and reviewDecision does not move across
# a fix, so no review fires either. Two agents sat on opposite sides of that transition for over two
# hours, each waiting for the other, both watches reporting healthy.
#
# So `updated` is unconditional: every change to a PR's updatedAt emits it, and it emits ALONGSIDE
# whatever typed event also fired rather than only when the classifier came up empty. A backstop
# that trusts the classifier is not a backstop — it inherits exactly the blindness it exists to
# cover. The typed events stay, for classification.
#
#   - and it names WHO, not only WHEN. `updatedAt` is a timestamp; a session that read one and
#     assumed the latest activity was its own reported "nothing owed from me" with three items
#     owed. Attribution is computed from activity strictly NEWER than the previous observation —
#     the only activity that could explain this update — and when nothing explains it the event
#     says `actor=unattributed` rather than naming the most recent bystander.
#   - mergeability is watched, because blind spot five is not covered by the backstop at all: a PR
#     that goes BEHIND or DIRTY because something ELSE merged has had nothing happen to it, so its
#     own updatedAt does not move. The architect's own merges silently invalidate every other open
#     PR, and no amount of watching the invalidated PR's timestamp would show it.
# ---------------------------------------------------------------------------
step() {
	_prev=$1
	_obs=$2

	_was_observed=$(jq -r '.observed // false' "$_prev" 2>/dev/null || echo false)
	_now=$(jq -c '.' "$_obs")

	_now_prs=$(printf '%s' "$_now" | jq -c '.prs // []')

	if [ "$_was_observed" != true ]; then
		# A first tick reports ITSELF and nothing else. Diffing against a state that never existed
		# turns every pre-existing PR into "opened", every old merge into "merged", and every past
		# verdict into a fresh review — which is what the live run did on its first tick: sixty
		# events for things that finished hours ago. Claiming history as news is the same defect as
		# claiming silence as calm, so the first observation records the queue and emits only the
		# sentinel (plus queue-empty, which describes the queue rather than a change in it).
		printf 'event=first-observation count=%s\n' "$(printf '%s' "$_now_prs" | jq 'map(select(.state != "MERGED")) | length')"
		if [ "$(printf '%s' "$_now_prs" | jq 'map(select(.state != "MERGED")) | length == 0')" = true ]; then
			printf 'event=queue-empty\n'
		fi
		printf '%s' "$_now" | jq -c '. + {observed: true}' >"$_prev.new" && mv "$_prev.new" "$_prev"
		return 0
	fi

	_prev_prs=$(jq -c '.prs // []' "$_prev")
	_first=''

	# updated: THE BACKSTOP. Any movement of updatedAt, on a PR that existed in the previous
	# observation, with the actor that can account for it.
	#
	# Only PRs present in BOTH observations qualify: a PR absent before has no previous timestamp to
	# have moved, and `opened` already carries it. Emitting both would report a beginning as a change.
	#
	# Attribution considers only activity strictly newer than the PREVIOUS updatedAt, because that is
	# the only activity capable of explaining the move. Anything older is a bystander, and naming a
	# bystander is worse than saying nothing: it is a wrong answer that looks like an answer. A label
	# change, a title edit or a base change moves updatedAt and appears in no activity list, so those
	# legitimately land on `unattributed` — the tool says it cannot tell, which is the true statement.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| select($o != null)
		| select($p.updatedAt != $o.updatedAt)
		| ([($p.activity // [])[] | select(.at > $o.updatedAt)] | sort_by(.at) | last) as $a
		| (if $a == null then "actor=unattributed" else "actor=\($a.actor) kind=\($a.kind)" end) as $who
		| "event=updated pr=\($p.number) at=\($p.updatedAt) \($who)"'

	# mergeability: a transition INTO a state that cannot merge. Two narrowings, both deliberate:
	#   - UNKNOWN is not a state, it is the absence of an answer (GitHub computes mergeability lazily
	#     and the first request for a PR routinely returns it). Reporting UNKNOWN → BEHIND is real;
	#     reporting anything → UNKNOWN would be reporting our own ignorance as the PR's condition.
	#   - BLOCKED and UNSTABLE are the ordinary condition of an open PR awaiting review or checks, so
	#     they are not reported: an event every open PR emits on arrival is wallpaper.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| select($o != null)
		| select($p.state == "OPEN")
		| ($p.merge_state // "UNKNOWN") as $ms
		| select($ms == "BEHIND" or $ms == "DIRTY")
		| select($ms != ($o.merge_state // "UNKNOWN"))
		| "event=mergeability pr=\($p.number) status=\($ms)"'

	# opened: in the new observation, absent from the old.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		[.[] | select(.number as $n | ($old | map(.number) | index($n)) | not)] | .[]
		| "event=opened pr=\(.number)"'

	# merged / closed: present before, now MERGED or gone.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		[.[] | select(.state == "MERGED")
		     | select(.number as $n | ($old | map(select(.state == "MERGED") | .number) | index($n)) | not)]
		| .[] | "event=merged pr=\(.number)"'

	# reviews: a verdict that was not there before. The verdict travels with the event, because
	# "there is a review" is not the information a caller needs.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| ($p.reviews // []) as $new | (($o.reviews // [])) as $was
		| select(($new | length) > ($was | length))
		| "event=review pr=\($p.number) verdict=\($new | last | .state)"'

	# checks: a FAILURE that was not there before, named. Two deliberate narrowings, both from what
	# the fixtures encode:
	#   - a newly-opened PR emits `opened` and nothing else. Its checks are initial state, not a
	#     transition; reporting them as changes would make every new PR arrive as a burst.
	#   - SUCCESS is not a CHECKS event. The original note here read "red is what changes who must
	#     act", and that reasoning was half wrong in a way worth preserving: it is true while a PR
	#     awaits its FIRST review and false the moment it awaits a RE-review, because after a
	#     changes-requested fix, green is exactly what changes who must act. The same signal means
	#     different things depending on whose turn it is, and this classifier has no notion of turns.
	#     It still does not — the fix is not to teach it, it is that the push preceding those checks
	#     moves updatedAt, so `updated` carries the transition and the narrowing here costs nothing.
	#     Red stays typed because a red PR is unreviewable, and that was the miss (#16 sat red while a
	#     reviews-only watcher reported silence).
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| select($o != null)
		| ($p.checks // [])[] as $c
		| select($c.conclusion == "FAILURE")
		| select((($o.checks // []) | map(select(.name == $c.name) | .conclusion) | first) != $c.conclusion)
		| "event=checks pr=\($p.number) conclusion=\($c.conclusion) name=\($c.name)"'

	# queue-empty: emitted when the queue IS empty — on the first observation, or on the
	# transition into empty. Not emitted every tick, which would be noise rather than signal.
	_was_empty=$(printf '%s' "$_prev_prs" | jq 'map(select(.state != "MERGED")) | length == 0')
	_is_empty=$(printf '%s' "$_now_prs" | jq 'map(select(.state != "MERGED")) | length == 0')
	if [ "$_is_empty" = true ] && { [ -n "$_first" ] || [ "$_was_empty" = false ]; }; then
		printf 'event=queue-empty\n'
	fi

	# The state stores the last KNOWN mergeability, not the last one observed — and the distinction is
	# a defect that was caught in review. The reporting pass treats UNKNOWN as "no answer", correctly,
	# and the first version then wrote that non-answer into state as though it were a state. So a PR
	# already BEHIND that saw one UNKNOWN tick and came back BEHIND emitted a SECOND
	# `mergeability status=BEHIND` for a condition that never changed — reachable rather than
	# theoretical, because the recompute that returns UNKNOWN is triggered by the base moving, and the
	# base moving is what makes a PR BEHIND in the first place. Two merges into an open queue produce
	# it. Overwriting knowledge with an absence is how a recompute flap becomes an event, and a
	# transition re-announced every tick is the wallpaper this tool has already been fixed for once.
	printf '%s' "$_now" | jq -c --argjson old "$_prev_prs" '
		. + {observed: true, prs: [
			.prs[] as $p
			| if ($p.merge_state // "UNKNOWN") != "UNKNOWN" then $p
			  else (($old | map(select(.number == $p.number)) | first | .merge_state) // null) as $k
			       | if $k == null then $p else $p + {merge_state: $k} end
			  end ]}' >"$_prev.new" && mv "$_prev.new" "$_prev"
}

# ---------------------------------------------------------------------------
# Where the state lives — and why not in the session's scratchpad.
#
# The first version of the restart requirement was defended by a check that could only pass: the
# architect's state lived under /tmp/…/<session-id>/scratchpad/, which is SESSION-scoped, and the
# failure being defended against — a host-client reconnect restarting the session process — produces
# a new session with a new scratchpad. The re-arm step would have looked in an empty room, found
# nothing, and concluded there was nothing to re-arm. A check that cannot fail is not a check.
#
# So: a path that outlives the process. Session scratchpads are for artefacts nobody needs tomorrow;
# watch state is the exact opposite of that.
# ---------------------------------------------------------------------------
state_dir() {
	printf '%s' "${FORGE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/quince/forge-watch}"
}

state_path_for() {
	# owner/name -> owner-name.state.json, so one file per watched repo and no nesting to create.
	printf '%s/%s.state.json' "$(state_dir)" "$(printf '%s' "$1" | tr '/' '-')"
}

# ---------------------------------------------------------------------------
# The declared forge set — the watch set is read from a versioned file, and NEVER defaulted.
#
# "Watch both repos" was the instruction for a day. It was already wrong-in-waiting: it goes stale the
# moment a third repository matters, and the failure mode of a stale watch set is the one this project
# keeps paying for — a watch that reported both queues clear while covering one of them
# (quince-devlog#3). So the set is declared in `.claude/forge-set`, and a missing, empty or malformed
# declaration is a HARD FAILURE rather than a fallback to one repository. Falling back would produce
# exactly the historic bug, and produce it silently, which is worse than not running at all.
#
# A malformed line fails too, naming the line number. Skipping it would be a silent cap: the set would
# then be quietly smaller than the file says, which is the same lie one indentation level down.
# ---------------------------------------------------------------------------
FORGE_SET_FILE=${FORGE_SET_FILE:-.claude/forge-set}

forge_set() {
	_f=$1
	[ -f "$_f" ] || die "no forge set at $_f — declare the repositories to watch, one owner/name per line.
    This is deliberately not defaulted: a watch set that falls back to one repository is how a
    monitor reports both queues clear while covering one of them (quince-devlog#3)."
	_out=$(sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$_f" | grep -v '^$' || true)
	[ -n "$_out" ] || die "the forge set at $_f is empty — nothing would be watched, and the watch would say nothing about it"
	_bad=$(printf '%s\n' "$_out" | grep -vE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$' || true)
	[ -z "$_bad" ] || die "$_f: not owner/name: $(printf '%s' "$_bad" | tr '\n' ' ')"
	printf '%s\n' "$_out"
}

# Every event from a multi-repo run carries the repository it came from. Without it, `event=opened
# pr=20` from two repositories is one ambiguous line — and PR numbers collide across repositories by
# construction, so the ambiguity is guaranteed rather than unlucky. `fetch-failed` and
# `queue-truncated` already name their repo, so the tag is added only where it is missing.
tag_repo() {
	_r=$1
	while IFS= read -r _line; do
		case "$_line" in
		*repo=*) printf '%s\n' "$_line" ;;
		*) printf '%s repo=%s\n' "$_line" "$_r" ;;
		esac
	done
}

# ---------------------------------------------------------------------------
# watch_report — the PURE half of liveness: (state, now, pid_alive) -> one classification line, plus
# a tick-overdue event when one was due and did not happen.
#
# Pure for the same reason step() is: every liveness bug this project has had was untestable because
# the deciding half was welded to the probing half. `pid_alive` is passed IN — the caller does the
# impure poking at the process table.
#
# The three cases exist because collapsing two of them is the defect:
#   absent — no state at all. Cold start; seed the sentinel and let the first tick say so.
#   dead   — state on disk, nothing watching it. RE-ARM FROM IT. Do not reseed: the next tick diffs
#            against the stored observation, which is what produces the events that accrued while
#            nothing was watching. Collapsing this into `absent` is how a restarted watch silently
#            becomes a fresh one that has "seen nothing changed" since a beginning it invented.
#   live   — state and a watcher. Nothing to do.
#
# FOUR cases, not three, and the fourth was a review finding against this file's own stated principle
# ("exit codes so a caller that ignores stdout cannot mistake one for another"). `dead` originally
# covered both a watcher that is GONE and one that is RUNNING BUT WEDGED, behind one exit code and one
# identical note telling the reader to re-arm. Those need OPPOSITE remedies:
#
#   no_process / no_watcher_record → nothing is running. Re-arm from this state.
#   stale_heartbeat                → a process IS running, by definition. `stop` it, then re-arm —
#                                    via the verb, never a bare kill; see proc_start for why.
#
# Following the old instruction in the wedged case started a second watcher beside a live one, on one
# state file, with no lock anywhere (quince#50) — so the duplicate was not an unlucky race, it was the
# designed path, reached by doing what the tool said. `wedged` is now its own class with its own exit
# code (5) and its own note naming the pid. This is corollary (b) of the project's claim rule — don't
# collapse two conditions into one message — one level up from where it usually bites.
#
# The reasons, and what each proves:
#   no_watcher_record — state exists but no watcher ever armed against it (a hand-run tick). A file's
#                       existence proves nothing.
#   no_process        — the recorded pid is gone.
#   stale_heartbeat   — the pid exists and the ticks stopped. A process's existence proves nothing,
#                       which is why the heartbeat exists beside the pid check.
#
# TWO instruments, and neither is sufficient alone — which is worth stating because the first version
# of this leaned on one and was wrong:
#   - The HEARTBEAT cannot see a watcher that died a moment ago: its last tick is by definition recent,
#     so a fresh session would read `live`, do nothing, and nothing would ever tick again. That is the
#     failure this whole verb exists to catch.
#   - The PID cannot see a wedged watcher, and cannot be trusted to identify one either. The first
#     version confirmed the pid by grepping /proc/<pid>/cmdline for "forge-watch" — and promptly
#     reported `pid_verified=yes` for the shell that had just RUN forge-watch, because its own command
#     line contained the string. A check whose positive answer can be produced by the act of asking is
#     not a check. The grep is gone: pid reuse with a FRESH heartbeat is impossible (an impostor does
#     not write our heartbeat), so the heartbeat covers what the grep pretended to.
# So: `live` requires the pid to exist AND the heartbeat to be fresh. Either failing is `dead`.
# ---------------------------------------------------------------------------
STALE_TICKS=${FORGE_STALE_TICKS:-3}

watch_report() {
	_st=$1
	_now=$2
	_alive=$3 # yes or no — the caller does the impure poking at the process table

	if [ ! -f "$_st" ]; then
		printf 'watch=absent state=%s\n' "$_st"
		printf 'note: cold start. Seed it and tick; the first tick emits first-observation.\n'
		return 4
	fi

	jq -r --arg now "$_now" --arg alive "$_alive" --arg st "$_st" \
		--argjson stale "$STALE_TICKS" '
		($now | fromdate) as $t
		| (.watch // null) as $w
		| if $w == null or ($w.pid // null) == null then
			"watch=dead state=\($st) reason=no_watcher_record last_tick=\(.last_tick // "never")",
			"note: RE-ARM from this state — do not reseed it. The next tick diffs against the stored observation and emits what accrued."
		  else
			(($w.interval_s // 60)) as $iv
			| (($w.last_watcher_tick // null)) as $lw
			| (if $lw == null then null else ($t - ($lw | fromdate)) end) as $age
			| (if $alive == "no" then "no_process"
			   elif ($age == null or $age > ($iv * $stale)) then "stale_heartbeat"
			   else null end) as $why
			| "state=\($st) pid=\($w.pid) interval=\($iv)s last_watcher_tick=\($lw // "never")\(if $age == null then "" else " age=\($age | floor)s" end)" as $facts
			| if $why == "stale_heartbeat" then
				"watch=wedged \($facts) reason=stale_heartbeat",
				"note: pid \($w.pid) is running and has stopped ticking. Run `forge-watch stop` — it verifies the pid is still OUR watcher before signalling, and refuses if it was recycled. Then re-arm from this state; do not reseed it."
			  elif $why != null then
				"watch=dead \($facts) reason=\($why)",
				"note: RE-ARM from this state — do not reseed it. The next tick diffs against the stored observation and emits what accrued."
			  else
				"watch=live \($facts)",
				"note: nothing to do."
			  end
		  end,
		# A tick that was due and did not happen is REPORTED, not absorbed — silence must stay
		# distinguishable from not-looking, and the whole reason this file exists on disk is that the
		# cadence above it died once without saying so. Reported only when a WHOLE interval was
		# skipped, so ordinary jitter is not dressed up as a miss.
		( .watch as $w2
		  | select($w2 != null and ($w2.due // null) != null)
		  | ($t - ($w2.due | fromdate)) as $late
		  | select($late > ($w2.interval_s // 60))
		  | "event=tick-overdue due=\($w2.due) late=\($late | floor)s interval=\($w2.interval_s // 60)s" )
		' "$_st" || die "could not read watch state: $_st"

	# The exit code carries the class, so a caller that ignores stdout still cannot mistake dead for
	# live: 0 live, 3 dead, 4 absent.
	_cls=$(jq -r --arg now "$_now" --arg alive "$_alive" --argjson stale "$STALE_TICKS" '
		($now | fromdate) as $t | (.watch // null) as $w
		| if $w == null or ($w.pid // null) == null then "dead"
		  elif $alive == "no" then "dead"
		  elif (($w.last_watcher_tick // null) == null
		        or ($t - ($w.last_watcher_tick | fromdate)) > (($w.interval_s // 60) * $stale)) then "wedged"
		  else "live" end' "$_st")
	case "$_cls" in
	live) return 0 ;;
	dead) return 3 ;;
	wedged) return 5 ;;
	esac
}

# pid_alive — the impure probe, and deliberately only that: does this pid exist. It does NOT try to
# confirm the process is forge-watch (see watch_report's note — the version that grepped
# /proc/<pid>/cmdline reported success for the shell that had just run forge-watch). The state file is
# per-user under $HOME, so the watcher is the same user by construction and `kill -0` answers about
# existence rather than permission.
pid_alive() {
	if kill -0 "$1" 2>/dev/null; then printf 'yes\n'; else printf 'no\n'; fi
}

# proc_start — the process's start time, which is what turns a pid into an identity.
#
# A pid alone is not an identity, and the comment on pid_alive above got this half right and half
# wrong: it argued that pid reuse with a FRESH heartbeat is impossible, which is true — and then the
# `wedged` class, added later, is DEFINED by the heartbeat being stale. So in the one state where this
# tool issues an imperative to signal a process, the only thing tying that pid to our watcher was
# missing. Demonstrated in review by writing a foreign pid into the state: the tool said "pid 1 IS
# STILL RUNNING … STOP IT FIRST". It told the reader to kill init, in the imperative, with a plausible
# explanation attached.
#
# Start time closes it: a recycled pid necessarily started AFTER the one we recorded, so an unequal
# value means "not our process" without needing to identify what it is instead.
#
# `/proc/<pid>/stat` field 22, parsed after the LAST ')' because `comm` is parenthesised and may itself
# contain spaces or parens — indexing from the left shifts on any process named unhelpfully. `ps -o
# lstart=` is the portable alternative and is not available here (BusyBox rejects `-p`), so where
# procfs cannot answer, the answer is empty and the caller REFUSES. Never a kill on an unverified pid.
proc_start() {
	[ -r "/proc/$1/stat" ] || return 0
	sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'
}

now_iso() { jq -rn 'now | todate'; }

# ---------------------------------------------------------------------------
# replay — the fixtures ARE the test. Each carries the events it must produce, so a change in
# behaviour fails here rather than in someone's memory of what the monitor used to do.
#
# Four shapes, one harness. A `before`/`after` PAIR is one transition, which is what most defects are.
# A `"kind": "sequence"` fixture is an initial state plus N observations replayed in order through the
# SAME state file — the only way to pin what the state itself remembers between ticks, which a pair
# cannot reach: a pair whose `before` already contains the carried-forward value is asserting the
# behaviour it was supposed to test. A `"kind": "watch"` fixture drives watch_report from a state file,
# a frozen `now` and a pid_alive answer — because the liveness classifier is exactly as prone to
# reporting-what-it-never-checked as the event half, and a restart path with no fixture is a promise.
# A `"kind": "loop"` fixture drives the `watch` VERB itself against a stub `gh` and asserts what the
# loop did: silence left it running, an event ended it, and the exit class says which. That one needs
# a subprocess and a clock, which is why it is the only shape here that is not pure — and it exists
# because the deaf watcher of quince#62 satisfied every pure fixture in this directory.
# ---------------------------------------------------------------------------
compare_events() {
	# $1 fixture label, $2 got, $3 want — returns non-zero on mismatch and prints both.
	if [ "$2" = "$3" ]; then
		printf 'ok    %s\n' "$1"
		return 0
	fi
	printf 'FAIL  %s\n' "$1"
	printf '  want:\n%s\n  got:\n%s\n' "$(printf '%s' "$3" | sed 's/^/    /')" \
		"$(printf '%s' "$2" | sed 's/^/    /')"
	return 1
}

loop_run() {
	# The hang guard, in a function so the guarded and unguarded forms are one argv rather than two
	# copies that can drift.
	_b=$1
	shift
	if command -v timeout >/dev/null 2>&1; then
		timeout "$_b" "$@"
	else
		"$@"
	fi
}

replay() {
	_fail=0
	for _f in "$@"; do
		_tmp=$(mktemp -d)
		_kind=$(jq -r '.kind // "pair"' "$_f")
		if [ "$_kind" = sequence ]; then
			jq -c '.initial' "$_f" >"$_tmp/state"
			_n=$(jq '.steps | length' "$_f")
			_i=0
			while [ "$_i" -lt "$_n" ]; do
				jq -c --argjson i "$_i" '.steps[$i].observation' "$_f" >"$_tmp/obs"
				_got=$(step "$_tmp/state" "$_tmp/obs" | sort)
				_want=$(jq -r --argjson i "$_i" '.steps[$i].expect_events[]' "$_f" | sort)
				compare_events "$(basename "$_f") [tick $_i: $(jq -r --argjson i "$_i" '.steps[$i].label // "-"' "$_f")]" \
					"$_got" "$_want" || _fail=1
				_i=$((_i + 1))
			done
			rm -rf "$_tmp"
			continue
		fi
		if [ "$_kind" = loop ]; then
			# The loop is impure by nature — it sleeps and it fetches — so its fixture drives the REAL
			# verb as a subprocess against a stub `gh`, and asserts what the loop DID: the events it
			# printed, and the exit class it ended on.
			#
			# It asserts TERMINATION, and deliberately asserts nothing about watch health. Every health
			# signal was green throughout the fifty minutes of quince#62 — fresh heartbeat, state
			# rewritten every 60 s, `status` reporting `live` — so a fixture that asserts health cannot
			# tell a working watch from the deaf one. Only two questions distinguish them: does silence
			# leave the loop running, and does an event end it.
			_np=$(jq '.payloads | length' "$_f")
			_pi=0
			while [ "$_pi" -lt "$_np" ]; do
				jq -c --argjson i "$_pi" '.payloads[$i]' "$_f" >"$_tmp/payload.$_pi"
				_pi=$((_pi + 1))
			done
			cat >"$_tmp/gh" <<EOF
#!/bin/sh
# stub gh for a loop fixture: the Nth call answers with the Nth recorded payload, and the LAST
# payload repeats forever — so "nothing changed" is the steady state, which is what a watch must
# keep running through.
c=\$(cat "$_tmp/calls" 2>/dev/null || echo 0)
c=\$((c + 1))
printf '%s\n' "\$c" >"$_tmp/calls"
i=\$((c - 1))
[ "\$i" -lt $_np ] || i=\$(($_np - 1))
cat "$_tmp/payload.\$i"
EOF
			chmod +x "$_tmp/gh"
			command -v timeout >/dev/null 2>&1 ||
				printf 'note  %s: timeout(1) is not installed — the loop runs UNGUARDED here, so a\n      non-terminating regression HANGS instead of failing. Said out loud because a guard\n      nobody was told is missing is worse than no guard.\n' "$(basename "$_f")"
			_out=$(loop_run "$(jq -r '.timeout_s // 120' "$_f")" \
				"$0" watch --repo "$(jq -r '.repo // "novkostya/quince"' "$_f")" \
				--state "$_tmp/state" --gh "$_tmp/gh" \
				--interval "$(jq -r '.interval // 2' "$_f")" \
				--max-wait "$(jq -r '.max_wait // 60' "$_f")" \
				--fail-after "$(jq -r '.fail_after // 3' "$_f")" 2>&1) && _rc=0 || _rc=$?
			# `elapsed` and `ticks` are wall-clock facts about the box, not about the behaviour, so they
			# are normalised rather than asserted — a fixture that pinned them would fail on a loaded
			# machine and teach everyone to ignore it. The EXIT CLASS is asserted, as a line, because it
			# is the part a caller reads when it ignores stdout.
			_got=$(printf '%s\n' "$_out" | grep '^event=' |
				sed 's/elapsed=[0-9]*s/elapsed=Ns/; s/ticks=[0-9]*/ticks=N/' || true)
			_got=$(printf '%s\nexit=%s\n' "$_got" "$_rc" | grep -v '^$' | sort)
			_want=$(jq -r '.expect_events[], "exit=\(.expect_exit)"' "$_f" | sort)
			compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
			rm -rf "$_tmp"
			continue
		fi
		if [ "$_kind" = watch ]; then
			if [ "$(jq -r 'has("state")' "$_f")" = true ]; then
				jq -c '.state' "$_f" >"$_tmp/state"
			fi
			_got=$(watch_report "$_tmp/state" "$(jq -r '.now' "$_f")" "$(jq -r '.pid_alive // "yes"' "$_f")" || true)
			# The state path is a mktemp path here and a real one in production, so the fixtures write
			# `state=STATE` and the harness normalises. The path is still asserted to be REPORTED —
			# a report that omitted which file it read would be the weaker claim.
			_got=$(printf '%s\n' "$_got" | sed "s|state=$_tmp/state|state=STATE|" | sort)
			_want=$(jq -r '.expect[]' "$_f" | sort)
			compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
			rm -rf "$_tmp"
			continue
		fi
		jq -c '.before' "$_f" >"$_tmp/state"
		jq -c '.after' "$_f" >"$_tmp/obs"
		_got=$(step "$_tmp/state" "$_tmp/obs" | sort)
		_want=$(jq -r '.expect_events[]' "$_f" | sort)
		compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
		rm -rf "$_tmp"
	done
	[ "$_fail" -eq 0 ] || die "fixtures failed"
	printf 'forge-watch: fixtures pass\n'
}

# ---------------------------------------------------------------------------
# tick — the thin half: fetch, hand the observation to step. Uses gh-bot so the token stays out of
# argv and the call is allowlistable.
# ---------------------------------------------------------------------------
FETCH_LIMIT=${FORGE_LIMIT:-20}

tick() {
	_state=$1
	_repo=$2
	_gh=$3
	_wpid=$4     # the WATCHER loop's pid, or '' for a hand-run tick
	_interval=$5 # seconds between watcher ticks, for the heartbeat and the overdue check
	command -v jq >/dev/null 2>&1 || die "jq is required"

	# A tick that was due and did not happen is reported BEFORE anything else, because it is the one
	# fact about this tick that the events themselves cannot carry: they will arrive looking perfectly
	# healthy, all at once, hours late. Only the watcher's own ticks are judged — a hand-run tick has
	# no cadence to be late for.
	if [ -n "$_wpid" ] && [ -f "$_state" ]; then
		watch_report "$_state" "$(now_iso)" yes 2>/dev/null | grep '^event=' || true
	fi

	# The fetch is captured to a file and checked ON ITS OWN, because piping it straight into jq
	# hands us JQ's exit status: a missing `gh` wrapper produced no output, jq accepted the empty
	# input, and the tool emitted `first-observation count=` on every tick, forever, while looking
	# healthy. `set -o pipefail` would be the obvious fix and is not POSIX sh, so the pipeline is
	# split instead. A loop wired to the old version would have slept indefinitely — corollary (d)
	# of this project's own rule, inside the tool built to enforce it.
	# Sorted by ACTIVITY, not by PR age. The default order is newest-first by number, so a window
	# of 20 on a repo with 30 PRs is mostly ancient closed rows — the events here are about open
	# work and merges, and spending the whole budget on history means recent activity can fall out
	# of view while the window looks full.
	#
	# The field list is wider than the events strictly need, and the cost was measured rather than
	# guessed: 92 KB → 229 KB per tick for a 20-PR window on this repo (2026-07-26). `comments` and
	# `commits` carry bodies and messages that are thrown away by the shaping below — `gh pr list`
	# cannot select subfields — and they are fetched anyway because they are the only way to answer
	# WHO moved a PR. FORGE_LIMIT is the knob if that ever stops being a good trade.
	_raw=$(mktemp)
	if ! "$_gh" pr list -R "$_repo" --state all --limit "$FETCH_LIMIT" \
		--search "sort:updated-desc" \
		--json number,state,updatedAt,statusCheckRollup,reviews,comments,commits,mergedAt,mergedBy,mergeStateStatus >"$_raw" 2>"$_raw.err"; then
		# A `reason=` with nothing after it reads as "there was no reason" rather than "the tool could
		# not tell" — a wrapper that fails silently produces exactly that, and it was doing so.
		_why=$(head -1 "$_raw.err" 2>/dev/null | tr ' ' '_' | cut -c1-60)
		printf 'event=fetch-failed repo=%s reason=%s\n' "$_repo" "${_why:-no_stderr_from_gh}"
		rm -f "$_raw" "$_raw.err"
		return 1
	fi
	# A payload that does not parse, or is not an array, is a failed fetch wearing a success exit
	# code. Assert the shape before treating it as an observation.
	if ! jq -e 'type == "array"' "$_raw" >/dev/null 2>&1; then
		printf 'event=fetch-failed repo=%s reason=payload_not_an_array\n' "$_repo"
		rm -f "$_raw" "$_raw.err"
		return 1
	fi

	# No silent caps — but a warning that fires every tick is wallpaper, and a consumer learns to
	# ignore it, which re-creates the silent cap through boredom. The first version compared the raw
	# row count to the limit, which is true forever in any repo with twenty closed PRs.
	#
	# Truncation only matters when it can HIDE something this tool reports on: open work, or a
	# recent change. Sorted by activity, that is precisely the case where the oldest row in the
	# window is still OPEN — anything beyond it is both older and unseen, so an open PR could be out
	# there unwatched. When the window ends on settled history, nothing relevant is behind it.
	if [ "$(jq 'length' "$_raw")" -ge "$FETCH_LIMIT" ] &&
		[ "$(jq -r '.[-1].state' "$_raw")" = OPEN ]; then
		printf 'event=queue-truncated limit=%s repo=%s oldest_in_window_still_open=%s\n' \
			"$FETCH_LIMIT" "$_repo" "$(jq -r '.[-1].number' "$_raw")"
	fi

	# `activity` is the attribution channel: every dated act this payload can see, flattened, so the
	# PURE half decides who moved a PR. Shaping the answer here instead would put the WHEN-is-not-WHO
	# logic on the untestable side of the split, which is where the last four monitor bugs lived.
	# A login that GitHub does not resolve (a commit author who is not a GitHub user) becomes
	# `unknown` — distinct from `unattributed`, which means no act explains the update at all.
	_obs=$(mktemp)
	jq -c '{observed: true, prs: [.[] | {number, state, updatedAt,
		merge_state: (.mergeStateStatus // "UNKNOWN"),
		checks: [(.statusCheckRollup // [])[] | {name, conclusion}],
		reviews: [(.reviews // [])[] | {state}],
		activity: (
			  [(.comments // [])[] | {at: .createdAt,    actor: (.author.login // "unknown"), kind: "comment"}]
			+ [(.reviews  // [])[] | {at: .submittedAt,  actor: (.author.login // "unknown"), kind: "review"}]
			+ [(.commits  // [])[] | {at: .committedDate, actor: (((.authors // [])[0]).login // "unknown"), kind: "commit"}]
			+ (if .mergedAt then [{at: .mergedAt, actor: (.mergedBy.login // "unknown"), kind: "merge"}] else [] end)
		)}]}' "$_raw" >"$_obs" ||
		die "could not shape the observation for $_repo"

	[ -f "$_state" ] || printf '{"observed":false}\n' >"$_state"
	step "$_state" "$_obs"

	# The heartbeat is written AFTER step(), so a tick that died mid-step does not leave a timestamp
	# claiming it finished. `last_tick` records any tick; the watcher's own cadence is recorded
	# separately, so a hand-run tick can never make a dead watcher look alive — which it would, if one
	# field served both, and that field is precisely what a supervisor consults.
	#
	# No hostname is recorded, deliberately: the state file is per-box already, and a hostname is an
	# Operator-private fact that would then live in a file somebody pastes into an issue.
	_ts=$(now_iso)
	if [ -n "$_wpid" ]; then
		# pid_start is recorded beside the pid so that a later `stop` can prove the pid still belongs to
		# this process rather than to whatever the kernel recycled it onto. Recorded even when procfs
		# cannot answer (empty), because "we never knew" and "it changed" are different refusals.
		jq -c --arg ts "$_ts" --argjson pid "$_wpid" --argjson iv "$_interval" \
			--arg start "$(proc_start "$_wpid")" '
			.last_tick = $ts
			| .watch = {pid: $pid, pid_start: (if $start == "" then null else $start end),
			            interval_s: $iv, last_watcher_tick: $ts,
			            due: (($ts | fromdate) + $iv | todate)}' "$_state" >"$_state.new" &&
			mv "$_state.new" "$_state"
	else
		jq -c --arg ts "$_ts" '.last_tick = $ts' "$_state" >"$_state.new" && mv "$_state.new" "$_state"
	fi
	rm -f "$_obs" "$_raw" "$_raw.err"
}

# tick_all — one tick across the DECLARED set. Extracted from the `tick` verb so that `watch` runs
# exactly the same code path the verb does; a loop with its own private copy of the multi-repo fan-out
# would be a second implementation of the thing whose failures this file catalogues.
tick_all() {
	_agh=$1
	_awpid=$2
	_aiv=$3
	_set=$(forge_set "$FORGE_SET_FILE")
	_arc=0
	_aevt=$(mktemp)
	for _r in $_set; do
		_st=$(state_path_for "$_r")
		mkdir -p "$(dirname "$_st")"
		# NOT `tick … | tag_repo`: a pipeline's exit status is the LAST command's, so piping into
		# the tagger would discard tick's failure and a total fetch failure would exit 0 — measured,
		# not theorised. This is the same trap `tick` itself documents for `set -o pipefail` (not
		# POSIX sh), one level up, and the same fix: split the pipeline and check the half that can
		# fail. A watcher wired to the piped version would have read "all repos failed" as a healthy
		# tick, which is corollary (a) — silence is not a result — in the tool built to enforce it.
		if tick "$_st" "$_r" "$_agh" "$_awpid" "$_aiv" >"$_aevt"; then :; else _arc=1; fi
		tag_repo "$_r" <"$_aevt"
	done
	rm -f "$_aevt"
	# One repository failing does not silence the others, and does not read as success either: the
	# fetch-failed event names the repo, and the exit code carries the failure out of the loop.
	return "$_arc"
}

require_gh() {
	# The identity is the caller's choice, never the tool's: the reviewer loop runs on the architect
	# box, which by construction holds no bot token, so a hard-coded gh-bot could not run on the box
	# that most needs this. Default is plain `gh`, which is also what a stranger's clone has.
	command -v "$1" >/dev/null 2>&1 || [ -x "$1" ] ||
		die "gh command not found: $1 (set --gh or FORGE_GH)"
}

# ---------------------------------------------------------------------------
# watch — the loop, and the whole point of it is that IT ENDS.
#
# quince#62: the first architect session under the rewritten protocol armed
#
#     sh -c 'while :; do forge-watch tick --all …; sleep 60; done'
#
# and went deaf for fifty minutes while every instrument agreed it was healthy — heartbeat fresh,
# both state files rewritten every 60 s, `status --all` reporting `live`. A session is woken by a
# background task COMPLETING; a loop with no exit condition completes never, so nothing it detects
# can ever be delivered. It had degraded, silently, to the twenty-minute poll this whole unit
# existed to remove, wearing the new mechanism's clothes.
#
# Documenting the requirement was necessary and not sufficient: the next session reads the same
# text and makes the same plausible choice, because `while :; do … done` is what a watching loop
# looks like everywhere else. So the loop stops being something a session assembles. The correct
# shape is the only shape, and hand-rolling is no longer the path of least resistance.
#
# What wakes, and what does not:
#   - any event, including `tick-overdue` and `queue-empty` as a TRANSITION, ends the loop;
#   - the baseline does not. `first-observation` is the observation that establishes the baseline,
#     not a change from it, and the `queue-empty` printed beside it describes the same baseline.
#     Waking on those would make arming a watch a busy loop: arm, exit, arm, exit;
#   - `fetch-failed` does not, until --fail-after in a row. A single failed fetch is a missed tick,
#     and this tool already has an idiom for those. A run of them is a watch that is not watching,
#     and the exit says so. Nothing is swallowed either way: every tick's output is printed.
#
# `--max-wait` exists because termination is now the ONLY thing that wakes a session, and the
# fallback that was supposed to cover the gaps between watches — `ScheduleWakeup` — has three
# measured armings on the architect box and zero measured deliveries (quince#62). So the loop
# provides its own floor: it exits idle at the bound, through the channel that is measured to work.
# The skills still arm the fallback; this is not a replacement for it, and neither is treated as
# cover for the other.
# ---------------------------------------------------------------------------
wake_worthy() {
	# $1 is a file holding ONE tick's output; prints the lines that justify waking a session.
	# Two passes over the same file, because the baseline decision for a `queue-empty` line depends
	# on whether its repository also emitted `first-observation` on this tick — and under --all the
	# lines of several repositories are interleaved, so `repo=` is the only thing that pairs them.
	awk '
		function repo(l,   i, n, a) {
			n = split(l, a, " ")
			for (i = 1; i <= n; i++)
				if (a[i] ~ /^repo=/) return a[i]
			return ""
		}
		NR == FNR { if ($0 ~ /^event=first-observation/) base[repo($0)] = 1; next }
		/^event=first-observation/ { next }
		/^event=fetch-failed/ { next }
		/^event=queue-empty/ { if (base[repo($0)]) next }
		/^event=/ { print }
	' "$1" "$1"
}

watch_preflight() {
	# The four answers of `status`, enforced instead of recited. `live` and `wedged` REFUSE — the
	# first because two watchers on one state file is a race that presents as missing events
	# (quince#50), the second because "wedged" means a process is still running by definition, so
	# arming beside it is starting the second watcher rather than replacing the first. `dead` and
	# `absent` proceed, and the tool SAYS WHICH: re-arming from a dead state must not reseed it, and
	# the session is expected to report that it found one.
	_ps=$1
	_pr=$2
	_pa=no
	if [ -f "$_ps" ]; then
		_pp=$(jq -r '.watch.pid // empty' "$_ps" 2>/dev/null || true)
		[ -n "$_pp" ] && _pa=$(pid_alive "$_pp")
	fi
	_prep=$(watch_report "$_ps" "$(now_iso)" "$_pa") && _pcls=0 || _pcls=$?
	printf 'forge-watch: %s\n' "$_pr"
	printf '%s\n' "$_prep"
	case "$_pcls" in
	0) die "a watch is ALREADY LIVE for $_pr — refusing to arm a second one. Two watchers on one
    state file is a race that presents as missing events (quince#50). If you meant to replace it,
    \`forge-watch stop --repo $_pr\` first." ;;
	5) die "the watch for $_pr is WEDGED — a process is still running and has stopped ticking.
    Run \`forge-watch stop --repo $_pr\` (it verifies the pid is still ours and refuses if it was
    recycled), then arm again. Do not kill the pid by hand." ;;
	3) printf 'forge-watch: re-arming from a DEAD watch — not reseeded, so the next tick emits what accrued while nothing was watching.\n' ;;
	4) printf 'forge-watch: cold start — the first tick establishes the baseline and does not wake anybody.\n' ;;
	esac
}

watch_loop() {
	_wall=$1
	_wrepo=$2
	_wstate=$3
	_wgh=$4
	_wiv=$5
	_wmax=$6
	_wfail=$7

	_wstart=$(date +%s)
	_wfails=0
	_wticks=0
	_wevt=$(mktemp)
	while :; do
		if [ "$_wall" = yes ]; then
			tick_all "$_wgh" "$$" "$_wiv" >"$_wevt" && _wrc=0 || _wrc=$?
		else
			tick "$_wstate" "$_wrepo" "$_wgh" "$$" "$_wiv" >"$_wevt" && _wrc=0 || _wrc=$?
		fi
		_wticks=$((_wticks + 1))
		# Printed before anything is decided: the filter below chooses what WAKES a session, never
		# what a session may see. A watcher that hid its own failing ticks would be the silence this
		# tool exists to make impossible.
		cat "$_wevt"
		_wwake=$(wake_worthy "$_wevt")
		if [ -n "$_wwake" ]; then
			printf 'forge-watch: watch EXITING on the event(s) above (tick %s) — handle them, then ARM AGAIN. A watch that exited is a watch that is not watching.\n' "$_wticks"
			rm -f "$_wevt"
			return 0
		fi
		if [ "$_wrc" != 0 ]; then
			_wfails=$((_wfails + 1))
			if [ "$_wfails" -ge "$_wfail" ]; then
				printf 'event=watch-failing consecutive=%s limit=%s\n' "$_wfails" "$_wfail"
				printf 'forge-watch: watch EXITING — %s ticks in a row could not fetch. The events above name the reason; fix it and arm again.\n' "$_wfails"
				rm -f "$_wevt"
				return 7
			fi
		else
			_wfails=0
		fi
		_welapsed=$(($(date +%s) - _wstart))
		if [ "$_welapsed" -ge "$_wmax" ]; then
			printf 'event=watch-idle elapsed=%ss ticks=%s\n' "$_welapsed" "$_wticks"
			printf 'forge-watch: watch EXITING on the idle bound — nothing happened, which is a report and not a silence. ARM AGAIN.\n'
			rm -f "$_wevt"
			return 6
		fi
		sleep "$_wiv"
	done
}

case "${1:-}" in
step)
	shift
	_s='' _o=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--observation)
			_o=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[ -n "$_s" ] && [ -n "$_o" ] || die "step needs --state and --observation"
	[ -f "$_s" ] || printf '{"observed":false}\n' >"$_s"
	step "$_s" "$_o"
	;;
tick)
	shift
	_s='' _repo=novkostya/quince _ghcmd="${FORGE_GH:-gh}" _wpid='' _iv=60 _all=no
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		--all)
			_all=yes
			shift
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--gh)
			_ghcmd=$2
			shift 2
			;;
		--watcher-pid)
			_wpid=$2
			shift 2
			;;
		--interval)
			_iv=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	if [ "$_all" = yes ]; then
		[ -z "$_s" ] || die "--all derives one state file per repo; --state names a single one"
		require_gh "$_ghcmd"
		tick_all "$_ghcmd" "$_wpid" "$_iv"
		exit $?
	fi
	# --state is now optional: without it the path is derived from --repo, at a location that outlives
	# the session. It stays available because the fixtures and any second opinion need to point the
	# tool at a scratch file.
	[ -n "$_s" ] || _s=$(state_path_for "$_repo")
	mkdir -p "$(dirname "$_s")"
	case "$_wpid" in
	'') : ;;
	*[!0-9]*) die "--watcher-pid must be a pid: $_wpid" ;;
	esac
	case "$_iv" in *[!0-9]*) die "--interval must be seconds: $_iv" ;; esac
	require_gh "$_ghcmd"
	tick "$_s" "$_repo" "$_ghcmd" "$_wpid" "$_iv"
	;;
watch)
	shift
	_s='' _repo=novkostya/quince _ghcmd="${FORGE_GH:-gh}" _iv=60 _all=no _max=1200 _fail=3
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		--all)
			_all=yes
			shift
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--gh)
			_ghcmd=$2
			shift 2
			;;
		--interval)
			_iv=$2
			shift 2
			;;
		--max-wait)
			_max=$2
			shift 2
			;;
		--fail-after)
			_fail=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	case "$_iv" in *[!0-9]* | '') die "--interval must be seconds: $_iv" ;; esac
	case "$_max" in *[!0-9]* | '') die "--max-wait must be seconds: $_max" ;; esac
	case "$_fail" in *[!0-9]* | '') die "--fail-after must be a count: $_fail" ;; esac
	# A zero interval is a busy loop against the forge, and a zero fail-after would exit before the
	# first tick could fail. Refused rather than clamped: a silent clamp is a cap nobody was told about.
	[ "$_iv" -ge 1 ] || die "--interval must be at least 1 second (got $_iv)"
	[ "$_fail" -ge 1 ] || die "--fail-after must be at least 1 (got $_fail)"
	require_gh "$_ghcmd"
	if [ "$_all" = yes ]; then
		[ -z "$_s" ] || die "--all derives one state file per repo; --state names a single one"
		# The set is read BEFORE the preflight so a malformed declaration fails here rather than
		# after the first repo has been reported healthy.
		for _r in $(forge_set "$FORGE_SET_FILE"); do
			watch_preflight "$(state_path_for "$_r")" "$_r"
		done
	else
		[ -n "$_s" ] || _s=$(state_path_for "$_repo")
		mkdir -p "$(dirname "$_s")"
		watch_preflight "$_s" "$_repo"
	fi
	watch_loop "$_all" "$_repo" "$_s" "$_ghcmd" "$_iv" "$_max" "$_fail"
	exit $?
	;;
status)
	shift
	_s='' _repo=novkostya/quince _now='' _all=no
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		--all)
			_all=yes
			shift
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--now)
			_now=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[ -n "$_now" ] || _now=$(now_iso)
	report_one() {
		_rs=$1
		_rr=$2
		_ra=no
		if [ -f "$_rs" ]; then
			_rp=$(jq -r '.watch.pid // empty' "$_rs" 2>/dev/null || true)
			[ -n "$_rp" ] && _ra=$(pid_alive "$_rp")
		fi
		printf 'forge-watch: repo=%s\n' "$_rr"
		watch_report "$_rs" "$_now" "$_ra"
	}
	if [ "$_all" = yes ]; then
		[ -z "$_s" ] || die "--all derives one state file per repo; --state names a single one"
		_set=$(forge_set "$FORGE_SET_FILE")
		# The WORST class is reported, not the first or the last: a session that re-armed one repo and
		# left another dead would otherwise read the reassuring line and stop.
		#
		# Ranking, worst first — wedged(5), dead(3), absent(4), live(0). Wedged outranks dead because it
		# is dead PLUS a live process that must be stopped before re-arming; dead outranks absent because
		# it is the one carrying accrued events on disk that a reseed would throw away. The per-repo
		# lines are all printed regardless, so the exit code narrows nothing — it only refuses to let the
		# best case speak for the set.
		_worst=0
		for _r in $_set; do
			report_one "$(state_path_for "$_r")" "$_r" || _c=$?
			_c=${_c:-0}
			case "$_c" in
			5) _worst=5 ;;
			3) [ "$_worst" = 5 ] || _worst=3 ;;
			4) case "$_worst" in 5 | 3) : ;; *) _worst=4 ;; esac ;;
			esac
			_c=0
		done
		exit "$_worst"
	fi
	[ -n "$_s" ] || _s=$(state_path_for "$_repo")
	report_one "$_s" "$_repo"
	;;
stop)
	# Verify-then-signal, in ONE place. The previous arrangement was a `status` that printed "STOP IT
	# FIRST" and a human or agent running `kill` afterwards — two steps joined by a sentence in a skill,
	# which is precisely the shape this whole unit exists to remove. An agent following that sentence
	# literally, on a box where the pid had been recycled, had no defence at all.
	#
	# Every branch that cannot PROVE the pid is our watcher refuses. `kill` returning success proves a
	# process died, not that the right one did.
	#
	# THE LIMIT OF THIS CHECK, stated because a claim that does not state its own limit is the thing
	# this file keeps being fixed for: verify-then-signal is two syscalls with a gap between them. If
	# the watcher exits after the start-time check and the kernel reuses its pid before the `kill`, the
	# signal lands on a bystander anyway. That race cannot be closed from userspace.
	#
	# What the verb buys is the size of the window, and the difference is not marginal: the old
	# arrangement was `status` printing "stop that pid" and an agent typing `kill` afterwards — a window
	# of however long a session takes to read a sentence and act, seconds to minutes, and the review
	# that produced this fix demonstrated a session using exactly that window to kill init. Here it is
	# microseconds between two syscalls, in one place, behind a refusal. Unbounded to syscall-scale.
	shift
	_s='' _repo=novkostya/quince
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[ -n "$_s" ] || _s=$(state_path_for "$_repo")
	[ -f "$_s" ] || die "no watch state at $_s — nothing recorded to stop"
	_pid=$(jq -r '.watch.pid // empty' "$_s" 2>/dev/null || true)
	[ -n "$_pid" ] || die "no watcher pid recorded in $_s — nothing to stop"
	_was=$(jq -r '.watch.pid_start // empty' "$_s" 2>/dev/null || true)
	if [ "$(pid_alive "$_pid")" = no ]; then
		printf 'forge-watch: pid %s is already gone — nothing to stop. Re-arm from the state.\n' "$_pid"
		exit 0
	fi
	if [ -z "$_was" ]; then
		die "pid $_pid is running, but this state records no start time for it (armed by an older
    version, or procfs was unreadable at arm time). REFUSING to signal: a pid without a recorded
    start time cannot be shown to be our watcher rather than whatever reused its number. Identify
    it by hand before killing anything."
	fi
	_now_start=$(proc_start "$_pid")
	if [ -z "$_now_start" ]; then
		die "cannot read the start time of pid $_pid (no procfs, or not permitted). REFUSING to
    signal an unverified pid."
	fi
	if [ "$_now_start" != "$_was" ]; then
		die "pid $_pid HAS BEEN RECYCLED — recorded start $_was, actual $_now_start. That pid now
    belongs to something else. REFUSING to signal it; the watcher itself is gone, so treat this
    as \`dead\` and re-arm from the state."
	fi
	kill "$_pid" 2>/dev/null || die "pid $_pid verified as our watcher, but the signal failed"
	printf 'forge-watch: stopped watcher pid=%s repo=%s (start time %s matched)\n' "$_pid" "$_repo" "$_was"
	;;
replay)
	shift
	[ $# -gt 0 ] || die "replay needs at least one fixture"
	replay "$@"
	;;
'' | -h | --help | help) usage ;;
*)
	usage >&2
	die "unknown verb: $1"
	;;
esac
