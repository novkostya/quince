#!/bin/sh
# forge-watch — turn forge state into events, so a rung advances without a human relaying
# "review posted" across the gap. Spec: docs/specs/rung-loop/rung-loop.md.
#
# The whole design is one split: a PURE step() and a thin fetch. Every monitor bug this project
# produced was untestable because the thing deciding what to emit was welded to the thing polling
# GitHub — so the deciding half takes an observation as JSON and returns events, and the fixtures
# drive it with no network at all.
#
#   forge-watch step --state F --observation F   # pure; what the fixtures exercise
#   forge-watch tick --state F                   # fetch, then step
#   forge-watch replay <fixture>...              # run fixtures, compare against expect_events
set -eu

usage() {
	cat <<'EOF'
usage: forge-watch <verb>

  step   --state <file> --observation <file>   emit events for one observation (pure, no network)
  tick   [--repo owner/name | --all] [--state <file>] [--gh <cmd>] [--watcher-pid <n>]
         [--interval <s>] [--set-file <f>] [--issue <n>|<owner/name#n>] [--no-issues]
                                               fetch the queue, then step
  watch  [--repo owner/name | --all] [--state <file>] [--gh <cmd>] [--interval <s>]
         [--max-wait <s>] [--fail-after <n>] [--set-file <f>]
         [--issue <n>|<owner/name#n>] [--no-issues]
                                               tick until there is something to say, THEN EXIT
  status [--repo owner/name | --all] [--state <file>] [--now <iso>] [--set-file <f>]
                                               live | starting | dead | absent | wedged — which, and what to do
  stop   [--repo owner/name] [--state <file>]  verify the recorded pid is still OUR watcher, then
                                               signal it — refuses rather than guessing
  owed   [--author <login|@me> | --all] [--gh <cmd>] [--set-file <f>] [--hook]
                                               is a live watch owed here? (--author: open PRs you
                                               authored · --all: the declared set, unconditionally)
  replay <fixture.json>...                     drive step/watch_report from fixtures; non-zero on mismatch

  `watch` OWNS THE LOOP, and the reason it is a verb is the whole of quince#62: a session that
  assembles the loop itself writes `while :; do tick; sleep 60; done`, which is correct-looking,
  reports healthy from every angle, and CAN NEVER WAKE ANYTHING. An agent session is woken by a
  background task COMPLETING, so a loop with no exit condition delivers nothing it detects — fresh
  heartbeat, state updating, `status=live`, session deaf for fifty minutes. The rule, stated once
  here so a reader who hand-rolls anyway knows the constraint: **the loop must exit when it finds
  something; a loop that cannot exit cannot wake you.**

  Run it as a BACKGROUND task, never in the foreground: in the foreground it blocks the session it
  is supposed to wake.

  `watch` exit codes: 0 an event (the wake — the events are on stdout) · 6 the --max-wait bound
  with nothing seen (`event=watch-idle`) · 7 --fail-after consecutive failing ticks. It refuses to
  arm beside a `live` watch, a `starting` one, and a `wedged` one (run `stop` first) — the five
  answers of `status` are enforced here rather than left to a paragraph someone remembers. A refusal
  exits 1, as every refusal in this tool does; `dead` and `absent` proceed and say which they were.

  Every tick's output is printed whether or not it wakes anybody; the filter decides what WAKES,
  never what is SEEN. Two kinds of line do not wake:
    - the baseline. `first-observation` (and the `queue-empty` that accompanies it) is the
      observation that establishes the baseline, not a change from it — exiting on it would make
      arming a watch a busy loop of arm-exit-arm.
    - `fetch-failed`, until --fail-after of them in a row (default 3). One failed fetch is a missed
      tick, not news; a run of them is. Meanwhile the heartbeat does not advance across a failing
      tick, so such a watcher ages into `wedged` and says so there too.

  `--max-wait` (default 1200s) makes TERMINATION the heartbeat: the loop exits idle, the session
  wakes, re-arms, and the only channel involved is the one measured to work. It does not replace the
  `ScheduleWakeup` fallback the skills arm — that fallback stays, and it is belt to this braces.

  `watch` does NOT suppress events caused by the session running it — roughly a third of an
  architect's wakes are its own approvals and merges (quince#62). Said out loud rather than fixed,
  because a suppression rule is a claim about what cannot matter, and this tool has already been
  wrong about that once: `actor=` is on the event, and the woken session can read it.

  --all reads the watch set from .claude/forge-set (or --set-file / FORGE_SET_FILE): one owner/name
  per line, `#` comments. It HARD-FAILS when that file is missing, empty or malformed — it never
  falls back to one repository, because a watch set that quietly shrinks is how a monitor reports
  both queues clear while covering one of them. Under --all every event carries `repo=`, since PR
  numbers collide across repositories by construction.

  State lives at $FORGE_STATE_DIR, else $XDG_STATE_HOME/quince/forge-watch, else
  ~/.local/state/quince/forge-watch — one file per repo, at a path that OUTLIVES THE SESSION. A
  session scratchpad is the wrong home for it: the failure this state exists to survive is the
  session process restarting, which is exactly when a scratchpad-scoped file is not there.

  `status` exit codes: 0 live · 3 dead (nothing running — re-arm from the state, do NOT reseed) ·
  4 absent (cold start) · 5 wedged (a process is still running and has stopped ticking — `stop` it,
  then re-arm) · 9 starting (armed, first tick not finished — nothing is owed and nothing is wrong;
  do NOT arm a second one). FIVE cases, never fewer: collapsing dead into absent turns a restarted
  watch into a fresh one that has "seen nothing changed" since a beginning it invented, collapsing
  wedged into dead tells the reader to start a second watcher beside a live one, and collapsing
  STARTING into dead is how a freshly-armed watch got reported as owed — which sent the `owed` Stop
  hook, whose remedy for `dead` is "arm another one", into quince#50's race by obeying it (quince#95).

  `starting` is BOUNDED at one interval from arming, and the bound is not decoration: an unbounded
  `starting` is a state that cannot fail, reporting healthy while nothing is watched — quince#62
  rebuilt in a new place, passing every check. Past the bound it degrades to `dead` with
  `reason=never_ticked`. `watch` refuses at arm time when --interval is below the floor a first tick
  needs, so the bound cannot expire under a healthy watcher (see first_tick_floor).

  On `wedged`, use `stop` rather than `kill`. The pid is only known to be OUR watcher while its
  heartbeat is fresh, and `wedged` is defined by that heartbeat being stale — so a bare kill on a
  recycled pid signals a bystander. Demonstrated in review: with a foreign pid in the state, an
  earlier version of this tool told the reader to kill init, in the imperative.

  A watcher passes --watcher-pid and --interval so its cadence is on disk; a tick that was due and
  did not happen then emits `event=tick-overdue` instead of being absorbed.

  --gh defaults to FORGE_GH, else plain `gh`. The runner passes gh-bot; the arch box passes
  gh-arch. The tool does not pick an identity for you — a monitor that hard-coded one could not
  run on the box that most needs it.

  `owed` answers the OTHER half of quince#62. `watch` fixes a loop built wrong; it does nothing for a
  session that builds no loop — and that is what happened an hour later on the implementer side: no
  watcher, no state, no fallback, a turn ended with *"the ball is back with the reviewer"* four
  minutes before the verdict landed. A rule telling a session to arm a watch is satisfied by a session
  that does not, and nothing observed the difference. So something other than the session asks.

  --author <login|@me> is the implementer half: every repository where that login has an open PR,
  asked of the forge rather than of the declared set, because a PR in an undeclared repository still
  obligates whoever opened it. --all is the architect half: the declared set, since a reviewer's
  obligation cannot be derived from authorship. Neither is defaulted.

  ONLY THE IMPLEMENTER HALF IS ABOUT THE QUEUE (quince#71). --author's set is what that login
  AUTHORED, so an empty queue genuinely means nothing is owed. --all returns THE WHOLE DECLARED SET
  UNCONDITIONALLY, with no queue query at all, because a reviewer's set is what ARRIVES: an empty
  queue is not a finish, since the work is done when nothing further is coming and that is not
  knowable from inside the session. The two answers therefore carry different REASONS — `declared`
  versus `open PRs` — and that is not cosmetic: printing "open PRs" for a reviewer resting on an
  empty queue would be a false justification bolted to a true verdict, which is harder to catch than
  either error alone.

  Measured on both sides before it was ruled. TWICE an architect overrode the gate, armed against its
  "nothing owed", and a PR arrived within ~15 minutes (quince#69, quince#73). ONCE an architect
  OBEYED it, stopped on an empty queue, and went dark — the gate silent throughout, because by its
  own definition nothing was owed. Two overrides that were right and one obedience that was wrong is
  a gate wrong in one direction only.

  A consequence worth knowing: --all no longer touches the forge. Whether a live watch exists over a
  declared set is answerable from local state, so the hook's reviewer path cannot be wedged by an
  unreachable forge. The refusal that used to guard it — "a queue that could not be read is not a
  queue that is empty" — was right for the question it answered, and the question changed.

  --hook speaks the Claude Code Stop-hook protocol (JSON in on stdin, JSON out on stdout) and is
  wired in .claude/settings.json. It BLOCKS ONCE with the exact command to run, and on the second
  attempt it stops blocking and tells the HUMAN instead: a hook that always blocks is a session that
  can never end, and the goal is not to make stopping impossible — only to make an unwatched stop
  impossible to do SILENTLY. If it cannot check (no credential, forge unreachable) it fails OPEN and
  says so, because "I could not look" and "nothing is owed" must not print the same.

  `owed` exit codes: 0 nothing owed · 8 a watch is owed and is not live.

  --issue DECLARES what this session is blocked on, and it is the escalation channel (quince#80).
  This tool watched PULL REQUESTS only, and the channel that carries AUTHORITY in this project is an
  issue: an Operator ruling is a comment on one. So a ruling could land and reach nothing, and the
  measured case is exactly that — the architect's blocked list was quince#70/#71/#72/#75/#78/#80, most
  of which have no PR at all, and the only reason a ruling on it was ever seen was "a hand re-read I'd
  committed to when filing the issue". That is a human-remembers mitigation at the head of the
  escalation channel. Labelling rulings was rejected on the same grounds: it moves the remembering to
  whoever WRITES the ruling, which is the worst place for it.

  The declaration is SELF-DESCRIBING, exactly as the implementer's PR set already is: a session
  watches the PRs it opened, and now also the issues it SAID it was waiting for. `--issue` replaces
  the declared set, `--no-issues` clears it, and passing neither keeps what is on disk — so a re-arm
  does not have to restate it, which is the one thing a re-arm must never depend on remembering.
  Under --all an issue must be given as `owner/name#n`: a bare number would silently attach to every
  repository in the set, and issue numbers collide across repositories exactly as PR numbers do.

  Declared issues are fetched ONE BY ONE, not filtered out of a windowed list. A window would drop a
  declared issue that had gone quiet enough to fall off the end and report nothing about it — a silent
  cap on the one channel that carries rulings. The cost is one `gh` call per declared issue per tick,
  and NO calls at all when nothing is declared.

  What a declaration OUTLIVES, and what that costs: it lives in the state file, which outlives the
  session by design, so a retiring session leaves its declaration behind. That is deliberate and the
  alternative is worse — a declaration that died with the session would have to be restated on every
  re-arm, and forgetting it is silent. So instead `status` PRINTS the declared set with its age, and a
  successor either re-declares or clears it. A stale declaration is then a visible watch on something
  nobody is waiting for, rather than an invisible one.

  A CLOSE wakes a session that declared the issue: a closed blocker is precisely the news a blocked
  session is waiting for. (Issue tidying is the argument against, and it does not apply to an issue
  somebody has explicitly declared they are stuck on.)

  UNDECLARING AN ISSUE DOES NOT FORGET IT. Its record stays in the state, so RE-DECLARING it later
  diffs against the old baseline and reports everything that accrued while it was undeclared. That is
  deliberate and it is the same shape as re-arming a `dead` watch — which also refuses to reseed,
  precisely so the gap is reported rather than invented away. No stale events result from the record
  merely sitting there: the diff iterates the OBSERVATION, so an issue nobody is fetching produces
  nothing. Stated here because it is a decision, and an undocumented decision is indistinguishable
  from an accident (raised in review of quince#87).

events: first-observation · queue-empty · updated · opened · review · checks · mergeability ·
        merged · tick-overdue · fetch-failed · queue-truncated · watch-idle · watch-failing ·
        issue-first-observation · issue-updated · issue-comment · issue-closed · issue-reopened ·
        issue-fetch-failed

  The issue events mirror the PR ones and for the same reasons. `issue-updated` is the BACKSTOP —
  any movement of an issue's updatedAt, with the actor that can account for it — so a label change, a
  title edit or a body edit is reported as `actor=unattributed` rather than not at all. `issue-comment`
  is the typed event that matters, because a ruling IS a comment. `issue-closed` carries no actor:
  `gh issue view` does not report who closed an issue, and naming the most recent commenter instead
  would be a bystander presented as an answer.

  `issue-first-observation` is per-ISSUE, not per-tick, and that is what makes ADDING one issue to a
  declared set safe: the new issue establishes its own baseline and wakes nobody, while the issues
  already in the set keep their history. A per-tick baseline would have blinded the whole set every
  time one was added.

  `updated` is the BACKSTOP: any change to a PR's updatedAt emits it, whether or not a typed
  event also fired. The typed events classify; the backstop guarantees nothing is invisible.

  A CONSUMER MUST NOT RELY ON EITHER ORDERING. The typed event and the `updated` backstop describe
  the SAME ACT, and they arrive either in one tick or a tick apart. Neither is canonical and neither
  is guaranteed to be first. This is a property of THE FORGE rather than of this tool — **GitHub's
  PR fields do not move atomically**, so `reviews` can carry a verdict before the PR's own
  `updatedAt` has moved, or after it. Anything that reads two of them and infers an order is reading
  a race (quince#72).

  Measured on BOTH boxes, same method, 2026-07-27 — and the numbers DISAGREE BY A FACTOR OF FOUR,
  which is the strongest part of the evidence:

      runner box      12 deliveries — 11 in one tick,  1 split      (~8% split)   @ 12:00Z
      architect box   13 deliveries —  9 in one tick,  4 split      (~31% split)  @ 12:08Z

  THE ARCHITECT FIGURE MOVED WHILE THIS PARAGRAPH WAS BEING REVIEWED — 8-of-12 at 12:00Z, 9-of-13
  eight minutes later — because reviewing this change was itself a review delivery, and it landed
  same-tick. **A number that drifts while you are reading it is a better argument than the 4× spread
  is.** Both are timestamped rather than dated, because `2026-07-27` is a day and this moved inside
  one.

  A BIAS PRESENT IN BOTH, and in neither's favour: these count deliveries a watcher was ALIVE TO
  OBSERVE. Both boxes had unwatched windows today, so both denominators are of observed acts, not of
  acts.

  Both figures are here because either one alone is a lie by omission. The first version of this
  paragraph carried the runner's 11-of-12 as though it were THE rate and gave the other box a
  qualitative phrase; a consumer would have read ~8%, planned for it, and been wrong by 4× on the
  box where a reviewer's own code runs. That is quince#69's lesson — **a measurement carries the box
  it was taken on** — committed a second time by the session that had just written it into a journal
  entry, and caught in review by the box whose number was missing.

  So: **the spread is the finding, not either ratio.** Same tool, same configuration, same day, same
  sample size, 4× apart means the pairing is not a property you can characterise and plan around at
  all. Do not average these. Do not treat either as a rate. **Why they differ is NOT established**
  and is discussed on quince#72; nothing here depends on the answer.

  The lower figure is also the more dangerous one, which is why it must not stand alone: a consumer
  that tried this on the runner would see one tick every time across a dozen attempts, conclude the
  pairing is dependable, and be wrong roughly one review in twelve — frequent enough to matter,
  rare enough to survive testing.

  There is deliberately NO de-duplication. Recognising "I have already seen this act" needs state
  carried across ticks — more machinery, and a new place to be wrong — to save ONE EXTRA WAKE per
  split act. The guarantee that matters, that nothing is invisible, held under both orderings, so
  the churn is accepted and named rather than engineered away.

  Except for one state, which is why `mergeability` exists and why it reports `CLEAN` as well as
  `BEHIND`/`DIRTY`: when a PR is APPROVED and its CI then completes, NOTHING HAPPENS TO THE PR — the
  approval was the last mover, and check completion does not touch `updatedAt` (measured on quince#66:
  frozen across fourteen samples while two checks finished). So the backstop cannot see the moment a
  PR becomes landable, and that is the state a PR spends most of its waiting in. quince#63 sat
  mergeable and unmerged for sixteen minutes behind a live, quiet watch (quince#65).

  `stalled` is specified (docs/specs/rung-loop/rung-loop.md story 6) and NOT implemented — it
  needs a wall clock, which the pure half deliberately does not have. It was advertised here
  while unimplemented; a tool that lists an event it cannot emit is making the same kind of
  claim this tool exists to stop, so it is off the list until it can be produced.
EOF
}

die() {
	printf 'forge-watch: %s\n' "$*" >&2
	exit 1
}

# ---------------------------------------------------------------------------
# step — the whole decision, and the only part with interesting behaviour.
#
# Rules earned by defects (spec §4), each of which was a real miss:
#   - a state that has never observed anything is NOT an empty queue. The sentinel discharges as
#     its own event, so "I never looked" can never read as "nothing happened".
#   - queue-empty is an EVENT. Silence is not a report.
#   - the queue is compared wholesale each tick, so a PR opened after arming is seen. Binding a
#     list at arm time is how one was missed.
#   - check conclusions are watched beside reviews: a red PR is unreviewable, and that is progress
#     information, not noise.
#   - every event carries the observation that produced it, never a bare "something changed".
#
# And the rule that arrived later, from the deadlock of 2026-07-26 (quince#43): an ENUMERATED event
# model is a claim about what can matter, and this one was wrong four times over on a single
# transition — changes-requested → fixed → awaiting re-review. A push is not an event; green checks
# were deliberately not an event; a comment is not an event; and reviewDecision does not move across
# a fix, so no review fires either. Two agents sat on opposite sides of that transition for over two
# hours, each waiting for the other, both watches reporting healthy.
#
# So `updated` is unconditional: every change to a PR's updatedAt emits it, and it emits ALONGSIDE
# whatever typed event also fired rather than only when the classifier came up empty. A backstop
# that trusts the classifier is not a backstop — it inherits exactly the blindness it exists to
# cover. The typed events stay, for classification.
#
#   - and it names WHO, not only WHEN. `updatedAt` is a timestamp; a session that read one and
#     assumed the latest activity was its own reported "nothing owed from me" with three items
#     owed. Attribution is computed from activity strictly NEWER than the previous observation —
#     the only activity that could explain this update — and when nothing explains it the event
#     says `actor=unattributed` rather than naming the most recent bystander.
#   - mergeability is watched, because blind spot five is not covered by the backstop at all: a PR
#     that goes BEHIND or DIRTY because something ELSE merged has had nothing happen to it, so its
#     own updatedAt does not move. The architect's own merges silently invalidate every other open
#     PR, and no amount of watching the invalidated PR's timestamp would show it.
# ---------------------------------------------------------------------------
step() {
	_prev=$1
	_obs=$2

	_was_observed=$(jq -r '.observed // false' "$_prev" 2>/dev/null || echo false)
	_now=$(jq -c '.' "$_obs")

	# The DECLARATION is state, not observation: the caller says what it is blocked on, and the tick
	# fetches those issues because the state told it to. So it is carried forward across every write
	# here rather than arriving in the payload — an observation that carried its own declaration
	# could quietly change what is watched, which is the failure mode `.claude/forge-set` exists to
	# prevent one level up.
	_prev_decl=$(jq -c 'if (.issues // null) == null then null else (.issues | del(.items)) end' "$_prev" 2>/dev/null || printf 'null')
	[ -n "$_prev_decl" ] || _prev_decl=null
	_prev_iss=$(jq -c '.issues.items // []' "$_prev" 2>/dev/null || printf '[]')
	[ -n "$_prev_iss" ] || _prev_iss='[]'

	# The WATCHER RECORD is state in exactly the same sense, and it had no carry-forward (quince#103).
	# step() writes the observation plus `{observed: true}`, so every write dropped `.watch` — and the
	# watcher survived only because tick()'s watcher branch rewrites its own record immediately after.
	# A HAND-RUN tick has no such branch, so it erased the record of a watcher it has no business
	# touching.
	#
	# The comment on tick()'s write says a hand-run tick "can never make a dead watcher look alive".
	# That was true and it is the direction that does not matter: the broken direction is the mirror —
	# a hand tick made a LIVE watcher look dead, which is worse, because `watch_preflight`'s refusal
	# reads this record. Erase it and the refusal does not fire, so the next arm puts a second watcher
	# on one state file: quince#50's race, reached THROUGH the guard rather than around it. And the
	# ordering ruled on quince#100 puts a foreground tick immediately before every arm, which is what
	# turned a latent bug into the standard turn shape.
	#
	# It also laundered forensics, which is permanent where the race is transient: `reason=no_process`
	# with a pid says a watcher died, `reason=no_watcher_record` says nothing was ever armed, and
	# /architect §0 asks a session to report which. A hand tick silently converted the informative
	# answer into the uninformative one.
	_prev_watch=$(jq -c '.watch // null' "$_prev" 2>/dev/null || printf 'null')
	[ -n "$_prev_watch" ] || _prev_watch=null

	_now_prs=$(printf '%s' "$_now" | jq -c '.prs // []')

	if [ "$_was_observed" != true ]; then
		# A first tick reports ITSELF and nothing else. Diffing against a state that never existed
		# turns every pre-existing PR into "opened", every old merge into "merged", and every past
		# verdict into a fresh review — which is what the live run did on its first tick: sixty
		# events for things that finished hours ago. Claiming history as news is the same defect as
		# claiming silence as calm, so the first observation records the queue and emits only the
		# sentinel (plus queue-empty, which describes the queue rather than a change in it).
		printf 'event=first-observation count=%s\n' "$(printf '%s' "$_now_prs" | jq 'map(select(.state != "MERGED")) | length')"
		if [ "$(printf '%s' "$_now_prs" | jq 'map(select(.state != "MERGED")) | length == 0')" = true ]; then
			printf 'event=queue-empty\n'
		fi
		printf '%s' "$_now" | jq -c --argjson decl "$_prev_decl" --argjson previtems "$_prev_iss" \
			--argjson watch "$_prev_watch" '
			. + {observed: true}
			| if $watch == null then . else .watch = $watch end
			| if $decl == null then . else
				(.issues.items // []) as $ni
				| ([$ni[].number]) as $seen
			| .issues = ($decl + {items: ($ni + ($previtems | map(select(. as $p | ($seen | index($p.number)) | not))))})
			  end' \
			>"$_prev.new" && mv "$_prev.new" "$_prev"
		return 0
	fi

	_prev_prs=$(jq -c '.prs // []' "$_prev")
	_first=''

	# updated: THE BACKSTOP. Any movement of updatedAt, on a PR that existed in the previous
	# observation, with the actor that can account for it.
	#
	# Only PRs present in BOTH observations qualify: a PR absent before has no previous timestamp to
	# have moved, and `opened` already carries it. Emitting both would report a beginning as a change.
	#
	# Attribution considers only activity strictly newer than the PREVIOUS updatedAt, because that is
	# the only activity capable of explaining the move. Anything older is a bystander, and naming a
	# bystander is worse than saying nothing: it is a wrong answer that looks like an answer. A label
	# change, a title edit or a base change moves updatedAt and appears in no activity list, so those
	# legitimately land on `unattributed` — the tool says it cannot tell, which is the true statement.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| select($o != null)
		| select($p.updatedAt != $o.updatedAt)
		| ([($p.activity // [])[] | select(.at > $o.updatedAt)] | sort_by(.at) | last) as $a
		| (if $a == null then "actor=unattributed" else "actor=\($a.actor) kind=\($a.kind)" end) as $who
		| "event=updated pr=\($p.number) at=\($p.updatedAt) \($who)"'

	# mergeability: a transition into a state whose LANDABILITY changed — in either direction. The
	# narrowings that remain are deliberate:
	#   - UNKNOWN is not a state, it is the absence of an answer (GitHub computes mergeability lazily
	#     and the first request for a PR routinely returns it). Reporting UNKNOWN → BEHIND is real;
	#     reporting anything → UNKNOWN would be reporting our own ignorance as the PR's condition.
	#   - BLOCKED and UNSTABLE are the ordinary condition of an open PR awaiting review or checks, so
	#     they are not reported: an event every open PR emits on arrival is wallpaper.
	#
	# CLEAN was added by quince#65, and the reason is worth keeping because it is the sixth blind spot
	# and it hid in a JUSTIFICATION rather than in code. quince#63 was APPROVED with CI still running,
	# went green, became landable, and sat unmerged for sixteen minutes with a live watch running quiet.
	# Measured on quince#66 while it happened: `updatedAt` frozen at 21:07:11Z across fourteen samples
	# while `image` and then `e2e` both completed. So the `updated` BACKSTOP — the thing built so that
	# nothing is invisible — structurally cannot cover a PR parked on CI: nothing happens TO the PR,
	# which is exactly why its timestamp does not move.
	#
	# The `checks` classifier could not cover it either, and the note there said why it did not need to:
	# "the push preceding those checks moves updatedAt, so `updated` carries the transition". True for
	# changes-requested → fix → green, where a push exists. FALSE for approved → CI completes, where the
	# last mover was the approval and it happened BEFORE the checks finished. A narrowing is a claim
	# about what cannot matter, and this one was right about the case it was written for and silent
	# about the one nobody tried.
	#
	# The fix is NOT to emit on green. "Green" is not "someone must act": every PR here goes green
	# minutes after opening while still awaiting its first review, so that event would be the wallpaper
	# this classifier already rejected once — and which of the two it means depends on whose turn it is,
	# which this classifier still has no notion of. CLEAN is the only value in the payload that means
	# NOTHING IS BLOCKING THE MERGE: not behind, not failing, not missing an approval. It fires once, at
	# the moment the ball becomes the merger's, and being a transition it cannot spin — an implementer
	# whose own PR goes CLEAN is woken once and cannot merge it, which would be intolerable on any
	# every-tick shape.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| select($o != null)
		| select($p.state == "OPEN")
		| ($p.merge_state // "UNKNOWN") as $ms
		| select($ms == "BEHIND" or $ms == "DIRTY" or $ms == "CLEAN")
		| select($ms != ($o.merge_state // "UNKNOWN"))
		| "event=mergeability pr=\($p.number) status=\($ms)"'

	# opened: in the new observation, absent from the old.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		[.[] | select(.number as $n | ($old | map(.number) | index($n)) | not)] | .[]
		| "event=opened pr=\(.number)"'

	# merged / closed: present before, now MERGED or gone.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		[.[] | select(.state == "MERGED")
		     | select(.number as $n | ($old | map(select(.state == "MERGED") | .number) | index($n)) | not)]
		| .[] | "event=merged pr=\(.number)"'

	# reviews: a verdict that was not there before. The verdict travels with the event, because
	# "there is a review" is not the information a caller needs.
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| ($p.reviews // []) as $new | (($o.reviews // [])) as $was
		| select(($new | length) > ($was | length))
		| "event=review pr=\($p.number) verdict=\($new | last | .state)"'

	# checks: a FAILURE that was not there before, named. Two deliberate narrowings, both from what
	# the fixtures encode:
	#   - a newly-opened PR emits `opened` and nothing else. Its checks are initial state, not a
	#     transition; reporting them as changes would make every new PR arrive as a burst.
	#   - SUCCESS is not a CHECKS event. The original note here read "red is what changes who must
	#     act", and that reasoning was half wrong in a way worth preserving: it is true while a PR
	#     awaits its FIRST review and false the moment it awaits a RE-review, because after a
	#     changes-requested fix, green is exactly what changes who must act. The same signal means
	#     different things depending on whose turn it is, and this classifier has no notion of turns.
	#     It still does not — the fix is not to teach it, it is that the push preceding those checks
	#     moves updatedAt, so `updated` carries the transition. **That justification was incomplete,
	#     and quince#65 is what it cost:** it holds where a push exists (fix → re-review) and fails
	#     where none does (APPROVED, then CI finishes) — the state a PR spends most of its waiting in.
	#     The answer is still not to emit on green, which every PR reaches while awaiting first review;
	#     it is that `mergeability` now reports the transition into CLEAN, which is the one value that
	#     means nothing is blocking the merge. See the note there.
	#     Red stays typed because a red PR is unreviewable, and that was the miss (#16 sat red while a
	#     reviews-only watcher reported silence).
	printf '%s' "$_now_prs" | jq -r --argjson old "$_prev_prs" '
		.[] as $p
		| ($old | map(select(.number == $p.number)) | first) as $o
		| select($o != null)
		| ($p.checks // [])[] as $c
		| select($c.conclusion == "FAILURE")
		| select((($o.checks // []) | map(select(.name == $c.name) | .conclusion) | first) != $c.conclusion)
		| "event=checks pr=\($p.number) conclusion=\($c.conclusion) name=\($c.name)"'

	# ---- the issue channel (quince#80) -------------------------------------------------------
	# The DECLARED set: issues this session said it is blocked on. Same diff discipline as the PR
	# half, and the reason it exists at all is that the channel carrying AUTHORITY here is an issue
	# comment, which this tool could not see.
	#
	# The baseline is PER-ISSUE. An issue in the observation and absent from the previous one has no
	# previous timestamp to have moved, so it emits its own baseline and nothing else — which is what
	# lets a session ADD an issue to its declared set without blinding itself to the ones already
	# there. A per-tick baseline (the PR half's shape) would do exactly that, because a declaration
	# changes mid-watch by design and a queue does not.
	printf '%s' "$_now" | jq -r --argjson old "$_prev_iss" '
		(.issues.items // [])[] as $i
		| ($old | map(select(.number == $i.number)) | first) as $o
		| select($o == null)
		| "event=issue-first-observation issue=\($i.number) state=\($i.state) via=\($i.via // "declared")"'

	# issue-updated: THE BACKSTOP, identical in role to `updated` on the PR half. A label change, a
	# title edit or a body edit moves updatedAt and appears in no activity list, so those land on
	# `unattributed` — the tool saying it cannot tell, which is the true statement and not the same
	# as naming the last bystander who commented.
	printf '%s' "$_now" | jq -r --argjson old "$_prev_iss" '
		(.issues.items // [])[] as $i
		| ($old | map(select(.number == $i.number)) | first) as $o
		| select($o != null)
		| select($i.updatedAt != $o.updatedAt)
		| ([($i.activity // [])[] | select(.at > $o.updatedAt)] | sort_by(.at) | last) as $a
		| (if $a == null then "actor=unattributed" else "actor=\($a.actor) kind=\($a.kind)" end) as $who
		| "event=issue-updated issue=\($i.number) at=\($i.updatedAt) \($who) via=\($i.via // "declared")"'

	# issue-comment: the typed event this whole channel was built for. A ruling IS a comment, so the
	# event names the issue, when, and WHO — a blocked session needs to know a ruling landed, not
	# that something about an issue changed.
	#
	# `count=` is how many arrived since the last observation; `at=` and `actor=` describe the NEWEST
	# of them. Without the count, a session woken by three rulings reads the event as one and acts on
	# the last — confident about a thread it has only partly seen, which is the same class of wrong as
	# `updated` naming a bystander. Added on review of quince#87.
	#
	# The trigger is a count INCREASE, so a delete-plus-add inside one interval emits no typed event.
	# Reasoned rather than missed: `issue-updated` still fires, because updatedAt moved, and that is
	# exactly what a backstop is for. Matching comments by identity to catch it would add carried
	# state to the half of this tool that has been wrong most often.
	printf '%s' "$_now" | jq -r --argjson old "$_prev_iss" '
		(.issues.items // [])[] as $i
		| ($old | map(select(.number == $i.number)) | first) as $o
		| select($o != null)
		| [($i.activity // [])[] | select(.kind == "comment")] as $new
		| [($o.activity // [])[] | select(.kind == "comment")] as $was
		| select(($new | length) > ($was | length))
		| ($new | sort_by(.at) | last) as $c
		| "event=issue-comment issue=\($i.number) count=\(($new | length) - ($was | length)) at=\($c.at) actor=\($c.actor) via=\($i.via // "declared")"'

	# issue-closed / issue-reopened: a CLOSE wakes a session that DECLARED the issue, because a
	# closed blocker is exactly the news it is blocked waiting for. It does NOT wake for an issue that
	# is merely REFERENCED by an open PR — that is the tidying case the ruling worried about, and
	# nobody is blocked on it. `via=` is what carries that distinction to `wake_worthy`; the line is
	# still PRINTED either way, because the filter decides what wakes and never what is seen.
	#
	# No actor: `gh issue view` does not report who closed an issue, and this tool has already been
	# fixed once for naming a bystander in place of an answer.
	printf '%s' "$_now" | jq -r --argjson old "$_prev_iss" '
		(.issues.items // [])[] as $i
		| ($old | map(select(.number == $i.number)) | first) as $o
		| select($o != null)
		| select($i.state != $o.state)
		| ($i.via // "declared") as $via
		| if $i.state == "CLOSED" then
			"event=issue-closed issue=\($i.number) at=\($i.closed_at // "unknown")\(if ($i.state_reason // "") == "" then "" else " reason=\($i.state_reason)" end) via=\($via)"
		  else "event=issue-reopened issue=\($i.number) via=\($via)" end'

	# queue-empty: emitted when the queue IS empty — on the first observation, or on the
	# transition into empty. Not emitted every tick, which would be noise rather than signal.
	_was_empty=$(printf '%s' "$_prev_prs" | jq 'map(select(.state != "MERGED")) | length == 0')
	_is_empty=$(printf '%s' "$_now_prs" | jq 'map(select(.state != "MERGED")) | length == 0')
	if [ "$_is_empty" = true ] && { [ -n "$_first" ] || [ "$_was_empty" = false ]; }; then
		printf 'event=queue-empty\n'
	fi

	# The state stores the last KNOWN mergeability, not the last one observed — and the distinction is
	# a defect that was caught in review. The reporting pass treats UNKNOWN as "no answer", correctly,
	# and the first version then wrote that non-answer into state as though it were a state. So a PR
	# already BEHIND that saw one UNKNOWN tick and came back BEHIND emitted a SECOND
	# `mergeability status=BEHIND` for a condition that never changed — reachable rather than
	# theoretical, because the recompute that returns UNKNOWN is triggered by the base moving, and the
	# base moving is what makes a PR BEHIND in the first place. Two merges into an open queue produce
	# it. Overwriting knowledge with an absence is how a recompute flap becomes an event, and a
	# transition re-announced every tick is the wallpaper this tool has already been fixed for once.
	printf '%s' "$_now" | jq -c --argjson old "$_prev_prs" --argjson decl "$_prev_decl" \
		--argjson previtems "$_prev_iss" --argjson watch "$_prev_watch" '
		. + {observed: true, prs: [
			.prs[] as $p
			| if ($p.merge_state // "UNKNOWN") != "UNKNOWN" then $p
			  else (($old | map(select(.number == $p.number)) | first | .merge_state) // null) as $k
			       | if $k == null then $p else $p + {merge_state: $k} end
			  end ]}
		# An issue MISSING from this observation keeps its previous record, and the reason is a
		# defect caught before it shipped: a failed `gh issue view` produces an observation with no
		# entry for that issue, and overwriting the stored items with it would throw away the
		# baseline. The next successful tick would then emit `issue-first-observation` and SWALLOW
		# the comment that landed during the outage — a ruling lost to a transient fetch error, on
		# the channel this whole feature exists to make reliable. Absence is reported by
		# `issue-fetch-failed`; it is never allowed to mean "nothing there".
		| if $watch == null then . else .watch = $watch end
		| if $decl == null then . else
			(.issues.items // []) as $ni
			| ([$ni[].number]) as $seen
			| .issues = ($decl + {items: ($ni + ($previtems | map(select(. as $p | ($seen | index($p.number)) | not))))})
		  end' \
		>"$_prev.new" && mv "$_prev.new" "$_prev"
}

# ---------------------------------------------------------------------------
# Where the state lives — and why not in the session's scratchpad.
#
# The first version of the restart requirement was defended by a check that could only pass: the
# architect's state lived under /tmp/…/<session-id>/scratchpad/, which is SESSION-scoped, and the
# failure being defended against — a host-client reconnect restarting the session process — produces
# a new session with a new scratchpad. The re-arm step would have looked in an empty room, found
# nothing, and concluded there was nothing to re-arm. A check that cannot fail is not a check.
#
# So: a path that outlives the process. Session scratchpads are for artefacts nobody needs tomorrow;
# watch state is the exact opposite of that.
# ---------------------------------------------------------------------------
state_dir() {
	printf '%s' "${FORGE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/quince/forge-watch}"
}

state_path_for() {
	# owner/name -> owner-name.state.json, so one file per watched repo and no nesting to create.
	printf '%s/%s.state.json' "$(state_dir)" "$(printf '%s' "$1" | tr '/' '-')"
}

# ---------------------------------------------------------------------------
# The declared forge set — the watch set is read from a versioned file, and NEVER defaulted.
#
# "Watch both repos" was the instruction for a day. It was already wrong-in-waiting: it goes stale the
# moment a third repository matters, and the failure mode of a stale watch set is the one this project
# keeps paying for — a watch that reported both queues clear while covering one of them
# (quince-devlog#3). So the set is declared in `.claude/forge-set`, and a missing, empty or malformed
# declaration is a HARD FAILURE rather than a fallback to one repository. Falling back would produce
# exactly the historic bug, and produce it silently, which is worse than not running at all.
#
# A malformed line fails too, naming the line number. Skipping it would be a silent cap: the set would
# then be quietly smaller than the file says, which is the same lie one indentation level down.
# ---------------------------------------------------------------------------
FORGE_SET_FILE=${FORGE_SET_FILE:-.claude/forge-set}

forge_set() {
	_f=$1
	[ -f "$_f" ] || die "no forge set at $_f — declare the repositories to watch, one owner/name per line.
    This is deliberately not defaulted: a watch set that falls back to one repository is how a
    monitor reports both queues clear while covering one of them (quince-devlog#3)."
	_out=$(sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$_f" | grep -v '^$' || true)
	[ -n "$_out" ] || die "the forge set at $_f is empty — nothing would be watched, and the watch would say nothing about it"
	_bad=$(printf '%s\n' "$_out" | grep -vE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$' || true)
	[ -z "$_bad" ] || die "$_f: not owner/name: $(printf '%s' "$_bad" | tr '\n' ' ')"
	printf '%s\n' "$_out"
}

# Every event from a multi-repo run carries the repository it came from. Without it, `event=opened
# pr=20` from two repositories is one ambiguous line — and PR numbers collide across repositories by
# construction, so the ambiguity is guaranteed rather than unlucky. `fetch-failed` and
# `queue-truncated` already name their repo, so the tag is added only where it is missing.
tag_repo() {
	_r=$1
	while IFS= read -r _line; do
		case "$_line" in
		*repo=*) printf '%s\n' "$_line" ;;
		*) printf '%s repo=%s\n' "$_line" "$_r" ;;
		esac
	done
}

# ---------------------------------------------------------------------------
# watch_report — the PURE half of liveness: (state, now, pid_alive) -> one classification line, plus
# a tick-overdue event when one was due and did not happen.
#
# Pure for the same reason step() is: every liveness bug this project has had was untestable because
# the deciding half was welded to the probing half. `pid_alive` is passed IN — the caller does the
# impure poking at the process table.
#
# The three cases exist because collapsing two of them is the defect:
#   absent — no state at all. Cold start; seed the sentinel and let the first tick say so.
#   dead   — state on disk, nothing watching it. RE-ARM FROM IT. Do not reseed: the next tick diffs
#            against the stored observation, which is what produces the events that accrued while
#            nothing was watching. Collapsing this into `absent` is how a restarted watch silently
#            becomes a fresh one that has "seen nothing changed" since a beginning it invented.
#   live   — state and a watcher. Nothing to do.
#
# FIVE cases now, and the fifth is `starting` — armed, first tick not yet finished. Added by Operator
# ruling on quince#95, for the same reason `wedged` was added below: the classes that get collapsed
# are the ones whose REMEDIES are opposite. `dead` says "arm one"; `starting` says "wait, and do not
# arm a second one". Collapsed, the `owed` Stop hook read `dead` on a watch that had just been armed
# correctly and handed the session the command to start a SECOND watcher on one state file —
# quince#50's race, reached by OBEYING a guard. Measured at one false block in two on the architect box.
#
# A qualifier on `dead` was the alternative and was ruled against: it fixes the human-readable line and
# leaves the EXIT CODE — the thing `owed` actually reads — still saying dead. A fix invisible to the
# consumer that needed it.
#
# `starting` is BOUNDED at one interval from `armed_at`, degrading to `dead` with `reason=never_ticked`.
# Unbounded, it would be a state that cannot fail, reporting healthy while nothing is watched —
# quince#62 rebuilt somewhere new, passing every check on the way.
#
# FOUR cases before that, and the fourth was a review finding against this file's own stated principle
# ("exit codes so a caller that ignores stdout cannot mistake one for another"). `dead` originally
# covered both a watcher that is GONE and one that is RUNNING BUT WEDGED, behind one exit code and one
# identical note telling the reader to re-arm. Those need OPPOSITE remedies:
#
#   no_process / no_watcher_record → nothing is running. Re-arm from this state.
#   stale_heartbeat                → a process IS running, by definition. `stop` it, then re-arm —
#                                    via the verb, never a bare kill; see proc_start for why.
#
# Following the old instruction in the wedged case started a second watcher beside a live one, on one
# state file, with no lock anywhere (quince#50) — so the duplicate was not an unlucky race, it was the
# designed path, reached by doing what the tool said. `wedged` is now its own class with its own exit
# code (5) and its own note naming the pid. This is corollary (b) of the project's claim rule — don't
# collapse two conditions into one message — one level up from where it usually bites.
#
# The reasons, and what each proves:
#   no_watcher_record — state exists but no watcher ever armed against it (a hand-run tick). A file's
#                       existence proves nothing.
#   no_process        — the recorded pid is gone.
#   stale_heartbeat   — the pid exists and the ticks stopped. A process's existence proves nothing,
#                       which is why the heartbeat exists beside the pid check.
#
# TWO instruments, and neither is sufficient alone — which is worth stating because the first version
# of this leaned on one and was wrong:
#   - The HEARTBEAT cannot see a watcher that died a moment ago: its last tick is by definition recent,
#     so a fresh session would read `live`, do nothing, and nothing would ever tick again. That is the
#     failure this whole verb exists to catch.
#   - The PID cannot see a wedged watcher, and cannot be trusted to identify one either. The first
#     version confirmed the pid by grepping /proc/<pid>/cmdline for "forge-watch" — and promptly
#     reported `pid_verified=yes` for the shell that had just RUN forge-watch, because its own command
#     line contained the string. A check whose positive answer can be produced by the act of asking is
#     not a check. The grep is gone: pid reuse with a FRESH heartbeat is impossible (an impostor does
#     not write our heartbeat), so the heartbeat covers what the grep pretended to.
# So: `live` requires the pid to exist AND the heartbeat to be fresh. Either failing is `dead`.
# ---------------------------------------------------------------------------
STALE_TICKS=${FORGE_STALE_TICKS:-3}

watch_report() {
	_st=$1
	_now=$2
	_alive=$3 # yes or no — the caller does the impure poking at the process table

	if [ ! -f "$_st" ]; then
		printf 'watch=absent state=%s\n' "$_st"
		printf 'note: cold start. Seed it and tick; the first tick emits first-observation.\n'
		return 4
	fi

	jq -r --arg now "$_now" --arg alive "$_alive" --arg st "$_st" \
		--argjson stale "$STALE_TICKS" '
		($now | fromdate) as $t
		| (.watch // null) as $w
		| if $w == null or ($w.pid // null) == null then
			"watch=dead state=\($st) reason=no_watcher_record last_tick=\(.last_tick // "never")",
			"note: RE-ARM from this state — do not reseed it. The next tick diffs against the stored observation and emits what accrued."
		  else
			(($w.interval_s // 60)) as $iv
			| (($w.last_watcher_tick // null)) as $lw
			| (($w.armed_at // null)) as $am
			| (($w.starting_bound_s // $iv)) as $sb
			| (if $lw == null then null else ($t - ($lw | fromdate)) end) as $age
			| (if $am == null then null else ($t - ($am | fromdate)) end) as $since_arm
			# ORDER IS LOAD-BEARING, and these two arms must never swap. stale_heartbeat fires on
			# $age == null — the NULL arm, which needs no elapsed time at all — and a freshly-armed
			# watcher has last_watcher_tick null by construction, because that is the fact that
			# DEFINES starting. So the record watch_arm writes on purpose sits squarely inside wedged
			# unless starting is evaluated FIRST. Measured against the pre-change tool, this exact
			# record classified wedged reason=stale_heartbeat, with a note saying to run
			# forge-watch stop — i.e. every freshly-armed watcher would instruct its session to kill
			# it: the worst face of quince#95 shipped as the fix for quince#95, prevented only by this
			# ordering. Pinned by watch-starting-is-neither-dead-nor-wedged.json.
			| (if $alive == "no" then "no_process"
			   elif ($lw == null and $am != null and $since_arm <= $sb) then "starting"
			   elif ($lw == null and $am != null) then "never_ticked"
			   elif ($age == null or $age > ($iv * $stale)) then "stale_heartbeat"
			   else null end) as $why
			| "state=\($st) pid=\($w.pid) interval=\($iv)s last_watcher_tick=\($lw // "never")\(if $age == null then "" else " age=\($age | floor)s" end)" as $facts
			| if $why == "starting" then
				"watch=starting \($facts) armed_at=\($am) since_arm=\($since_arm | floor)s bound=\($sb)s",
				"note: armed and has NOT completed its first tick yet. This is not dead and nothing is owed — do not arm a second one. It becomes dead if it has not ticked within \($sb)s of arming (quince#95)."
			  elif $why == "never_ticked" then
				"watch=dead \($facts) reason=never_ticked armed_at=\($am) since_arm=\($since_arm | floor)s bound=\($sb)s",
				"note: armed \($since_arm | floor)s ago and STILL has not completed a first tick, which is past its \($sb)s bound. `starting` is bounded precisely so this cannot sit healthy forever (quince#62). Run `forge-watch stop`, then re-arm."
			  elif $why == "stale_heartbeat" then
				"watch=wedged \($facts) reason=stale_heartbeat",
				"note: pid \($w.pid) is running and has stopped ticking. Run `forge-watch stop` — it verifies the pid is still OUR watcher before signalling, and refuses if it was recycled. Then re-arm from this state; do not reseed it."
			  elif $why != null then
				"watch=dead \($facts) reason=\($why)",
				"note: RE-ARM from this state — do not reseed it. The next tick diffs against the stored observation and emits what accrued."
			  else
				"watch=live \($facts)",
				"note: nothing to do."
			  end
		  end,
		# A tick that was due and did not happen is REPORTED, not absorbed — silence must stay
		# distinguishable from not-looking, and the whole reason this file exists on disk is that the
		# cadence above it died once without saying so. Reported only when a WHOLE interval was
		# skipped, so ordinary jitter is not dressed up as a miss.
		( .watch as $w2
		  | select($w2 != null and ($w2.due // null) != null)
		  | ($t - ($w2.due | fromdate)) as $late
		  | select($late > ($w2.interval_s // 60))
		  | "event=tick-overdue due=\($w2.due) late=\($late | floor)s interval=\($w2.interval_s // 60)s" )
		' "$_st" || die "could not read watch state: $_st"

	# The declared blocking set, and its AGE — printed only when there is one, so a state file that
	# never declared anything reports exactly what it used to.
	#
	# The age is the whole point (quince#80's first open question: what happens to a declaration when
	# a session retires). The declaration lives in a state file that outlives the session, so a
	# successor inherits it. Making it die with the session was the alternative and it is worse: it
	# would have to be restated on every re-arm, and a re-arm that forgets is silent. So it survives
	# and it is DISPLAYED — "watching #71, declared 6 hours ago" is a question a successor can answer;
	# an invisible inherited watch is not.
	jq -r --arg now "$_now" '
		select(((.issues.declared // []) | length) > 0)
		| ($now | fromdate) as $t
		| "declared_issues=" + ((.issues.declared | map("#" + tostring)) | join(","))
		  + (if (.issues.declared_at // null) == null then ""
		     else " declared_at=\(.issues.declared_at) age=\(($t - (.issues.declared_at | fromdate)) | floor)s" end)
		' "$_st" 2>/dev/null || true

	# The exit code carries the class, so a caller that ignores stdout still cannot mistake dead for
	# live: 0 live, 3 dead, 4 absent, 5 wedged, 9 starting.
	_cls=$(jq -r --arg now "$_now" --arg alive "$_alive" --argjson stale "$STALE_TICKS" '
		($now | fromdate) as $t | (.watch // null) as $w
		| if $w == null or ($w.pid // null) == null then "dead"
		  elif $alive == "no" then "dead"
		  elif (($w.last_watcher_tick // null) == null and ($w.armed_at // null) != null
		        and ($t - ($w.armed_at | fromdate))
		            <= ($w.starting_bound_s // $w.interval_s // 60)) then "starting"
		  elif (($w.last_watcher_tick // null) == null and ($w.armed_at // null) != null) then "dead"
		  elif (($w.last_watcher_tick // null) == null
		        or ($t - ($w.last_watcher_tick | fromdate)) > (($w.interval_s // 60) * $stale)) then "wedged"
		  else "live" end' "$_st")
	case "$_cls" in
	live) return 0 ;;
	# `starting` is a CLASS and not a qualifier on `dead`, by Operator ruling on quince#95: a qualifier
	# would fix the human-readable line and leave the exit code — which is what `owed`'s Stop hook
	# actually reads — still saying `dead`. That is a fix invisible to the consumer that needed it.
	# 9 because 0/1/3/4/5/6/7 are taken by watch_report, watch_loop and die(), 8 is `owed`'s, and 2 is
	# what an underlying jq failure aborts with.
	starting) return 9 ;;
	dead) return 3 ;;
	wedged) return 5 ;;
	esac
}

# pid_alive — the impure probe, and deliberately only that: does this pid exist. It does NOT try to
# confirm the process is forge-watch (see watch_report's note — the version that grepped
# /proc/<pid>/cmdline reported success for the shell that had just run forge-watch). The state file is
# per-user under $HOME, so the watcher is the same user by construction and `kill -0` answers about
# existence rather than permission.
pid_alive() {
	if kill -0 "$1" 2>/dev/null; then printf 'yes\n'; else printf 'no\n'; fi
}

# proc_start — the process's start time, which is what turns a pid into an identity.
#
# A pid alone is not an identity, and the comment on pid_alive above got this half right and half
# wrong: it argued that pid reuse with a FRESH heartbeat is impossible, which is true — and then the
# `wedged` class, added later, is DEFINED by the heartbeat being stale. So in the one state where this
# tool issues an imperative to signal a process, the only thing tying that pid to our watcher was
# missing. Demonstrated in review by writing a foreign pid into the state: the tool said "pid 1 IS
# STILL RUNNING … STOP IT FIRST". It told the reader to kill init, in the imperative, with a plausible
# explanation attached.
#
# Start time closes it: a recycled pid necessarily started AFTER the one we recorded, so an unequal
# value means "not our process" without needing to identify what it is instead.
#
# `/proc/<pid>/stat` field 22, parsed after the LAST ')' because `comm` is parenthesised and may itself
# contain spaces or parens — indexing from the left shifts on any process named unhelpfully. `ps -o
# lstart=` is the portable alternative and is not available here (BusyBox rejects `-p`), so where
# procfs cannot answer, the answer is empty and the caller REFUSES. Never a kill on an unverified pid.
proc_start() {
	[ -r "/proc/$1/stat" ] || return 0
	sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'
}

now_iso() { jq -rn 'now | todate'; }

# ---------------------------------------------------------------------------
# replay — the fixtures ARE the test. Each carries the events it must produce, so a change in
# behaviour fails here rather than in someone's memory of what the monitor used to do.
#
# Four shapes, one harness. A `before`/`after` PAIR is one transition, which is what most defects are.
# A `"kind": "sequence"` fixture is an initial state plus N observations replayed in order through the
# SAME state file — the only way to pin what the state itself remembers between ticks, which a pair
# cannot reach: a pair whose `before` already contains the carried-forward value is asserting the
# behaviour it was supposed to test. A `"kind": "watch"` fixture drives watch_report from a state file,
# a frozen `now` and a pid_alive answer — because the liveness classifier is exactly as prone to
# reporting-what-it-never-checked as the event half, and a restart path with no fixture is a promise.
# A `"kind": "loop"` fixture drives the `watch` VERB itself against a stub `gh` and asserts what the
# loop did: silence left it running, an event ended it, and the exit class says which. That one needs
# a subprocess and a clock, which is why it is the only shape here that is not pure — and it exists
# because the deaf watcher of quince#62 satisfied every pure fixture in this directory.
# ---------------------------------------------------------------------------
compare_events() {
	# $1 fixture label, $2 got, $3 want — returns non-zero on mismatch and prints both.
	if [ "$2" = "$3" ]; then
		printf 'ok    %s\n' "$1"
		return 0
	fi
	printf 'FAIL  %s\n' "$1"
	printf '  want:\n%s\n  got:\n%s\n' "$(printf '%s' "$3" | sed 's/^/    /')" \
		"$(printf '%s' "$2" | sed 's/^/    /')"
	return 1
}

# compare_state — assert what the state file REMEMBERS, which no fixture kind could do before
# (quince#103). Every shape here asserted `event=` lines only, so a defect that corrupts state while
# emitting the right events was invisible to the whole suite — and quince#103 is exactly that defect:
# step() dropped `.watch` on every write and not one of the 38 fixtures could see it, because the
# events were all correct. A suite that can only watch the output of a state machine cannot test the
# state.
#
# $1 fixture label, $2 the state file, $3 newline-separated jq predicates. Each must evaluate TRUE.
# Empty predicate list is a no-op and prints nothing, so existing fixtures are untouched.
#
# `jq -e` is the assertion: it exits non-zero when the result is false or null. A predicate that is
# malformed exits 3 and is reported as a FAILURE rather than skipped — a fixture whose assertion
# cannot parse must not read as a pass, which is the vacuous-pass shape this file keeps removing.
compare_state() {
	_cs_label=$1
	_cs_file=$2
	_cs_preds=$3
	[ -n "$_cs_preds" ] || return 0
	_cs_fail=0
	# Newline-separated, and IFS is set for the read loop only; a predicate may contain spaces.
	printf '%s\n' "$_cs_preds" | while IFS= read -r _cs_p; do
		[ -n "$_cs_p" ] || continue
		if jq -e "$_cs_p" "$_cs_file" >/dev/null 2>&1; then
			printf 'ok    %s state: %s\n' "$_cs_label" "$_cs_p"
		else
			printf 'FAIL  %s state: %s\n' "$_cs_label" "$_cs_p"
			printf '  state was:\n%s\n' "$(jq -S '.' "$_cs_file" 2>/dev/null | sed 's/^/    /')"
			printf 'x' >>"$_cs_file.statefail"
		fi
	done
	# The loop above runs in a subshell (it is the right-hand side of a pipe), so its exit status
	# cannot travel out — the marker file is how the verdict crosses that boundary. Stated because a
	# `| while ...; done` whose `_cs_fail=1` silently fails to propagate is the classic form of this
	# bug, and writing it that way first is how this comment exists.
	if [ -f "$_cs_file.statefail" ]; then
		rm -f "$_cs_file.statefail"
		_cs_fail=1
	fi
	return "$_cs_fail"
}

loop_run() {
	# The hang guard, in a function so the guarded and unguarded forms are one argv rather than two
	# copies that can drift.
	_b=$1
	shift
	if command -v timeout >/dev/null 2>&1; then
		timeout "$_b" "$@"
	else
		"$@"
	fi
}

replay() {
	_fail=0
	# COUNTED, not merely reported. A bare `fixtures pass` cannot tell a full suite from a shrunken
	# one: remove the ten `watch-*.json` loop fixtures and the remaining eighteen still print pass.
	# That is quince#41's vacuous success one level down — and the fixtures most likely to be
	# dropped under time pressure are exactly those loop ones, since they are the only shape here
	# that spends real seconds in sleeps. The number in the success line is what makes a shrink
	# visible in a CI log and in the evidence a PR pastes.
	_ran=0
	for _f in "$@"; do
		_ran=$((_ran + 1))
		_tmp=$(mktemp -d)
		_kind=$(jq -r '.kind // "pair"' "$_f")
		if [ "$_kind" = sequence ]; then
			jq -c '.initial' "$_f" >"$_tmp/state"
			_n=$(jq '.steps | length' "$_f")
			_i=0
			while [ "$_i" -lt "$_n" ]; do
				jq -c --argjson i "$_i" '.steps[$i].observation' "$_f" >"$_tmp/obs"
				_got=$(step "$_tmp/state" "$_tmp/obs" | sort)
				_want=$(jq -r --argjson i "$_i" '.steps[$i].expect_events[]' "$_f" | sort)
				compare_events "$(basename "$_f") [tick $_i: $(jq -r --argjson i "$_i" '.steps[$i].label // "-"' "$_f")]" \
					"$_got" "$_want" || _fail=1
				compare_state "$(basename "$_f") [tick $_i]" "$_tmp/state" \
					"$(jq -r --argjson i "$_i" '.steps[$i].expect_state // [] | .[]' "$_f")" || _fail=1
				_i=$((_i + 1))
			done
			rm -rf "$_tmp"
			continue
		fi
		if [ "$_kind" = hint ]; then
			# The arming command the gate hands a session. Fixtured because the first version printed
			# the implementer's `--repo` form to BOTH halves, and the architect copying it would have
			# armed a watch smaller than its declared set — a hint that must be copied verbatim is a
			# claim, and this directory holds claims to the same standard as the code.
			_got=$(jq -r '.cases[] | @tsv' "$_f" | while IFS="$(printf '\t')" read -r _c_role _c_gh _c_repo; do
				owed_arm_hint "$_c_role" "$_c_gh" "$_c_repo"
			done | sort -u)
			_want=$(jq -r '.expect[]' "$_f" | sort -u)
			compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
			rm -rf "$_tmp"
			continue
		fi
		if [ "$_kind" = owed ]; then
			# The PURE half of the arming gate: given which repositories have open PRs and what class
			# their watches are in, is a watch owed and what does the session have to do about it. The
			# forge query and the process table are the impure halves and are not here — same split as
			# step() and watch_report(), for the same reason.
			jq -r '.table[] | "\(.[0]) \(.[1])"' "$_f" >"$_tmp/table"
			_got=$(owed_decide "$_tmp/table" "$(jq -r '.mode // "author"' "$_f")") && _rc=0 || _rc=$?
			_got=$(printf '%s\nexit=%s\n' "$_got" "$_rc" | grep -v '^$' | sort)
			_want=$(jq -r '.expect[], "exit=\(.expect_exit)"' "$_f" | sort)
			compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
			rm -rf "$_tmp"
			continue
		fi
		if [ "$_kind" = loop ]; then
			# The loop is impure by nature — it sleeps and it fetches — so its fixture drives the REAL
			# verb as a subprocess against a stub `gh`, and asserts what the loop DID: the events it
			# printed, and the exit class it ended on.
			#
			# It asserts TERMINATION, and deliberately asserts nothing about watch health. Every health
			# signal was green throughout the fifty minutes of quince#62 — fresh heartbeat, state
			# rewritten every 60 s, `status` reporting `live` — so a fixture that asserts health cannot
			# tell a working watch from the deaf one. Only two questions distinguish them: does silence
			# leave the loop running, and does an event end it.
			# An `initial` state, when the fixture carries one, is what makes a RE-ARM expressible: the
			# interesting first tick is the one that diffs against a watch that stopped.
			if [ "$(jq -r 'has("initial")' "$_f")" = true ]; then
				jq -c '.initial' "$_f" >"$_tmp/state"
			fi
			_np=$(jq '.payloads | length' "$_f")
			_pi=0
			while [ "$_pi" -lt "$_np" ]; do
				jq -c --argjson i "$_pi" '.payloads[$i]' "$_f" >"$_tmp/payload.pr.$_pi"
				_pi=$((_pi + 1))
			done
			# The issue payloads, and why the stub had to grow a second queue at all. It answered the
			# Nth CALL with the Nth payload regardless of what was asked, which was right while a tick
			# made exactly one `gh pr list`. A tick that also reads declared issues makes two KINDS of
			# call, so a single queue hands a `pr list` an issue object — and the tool correctly
			# rejects it as `payload_not_an_array`, meaning no loop fixture could ever reach the issue
			# path. That is the gap quince#87 declared as owed rather than papered over; this closes
			# it. Dispatching on argv is also more honest than counting: the stub now answers the
			# question it was actually asked.
			_ni=$(jq '.issue_payloads // [] | length' "$_f")
			_pi=0
			while [ "$_pi" -lt "$_ni" ]; do
				jq -c --argjson i "$_pi" '.issue_payloads[$i]' "$_f" >"$_tmp/payload.issue.$_pi"
				_pi=$((_pi + 1))
			done
			cat >"$_tmp/gh" <<EOF
#!/bin/sh
# stub gh for a loop fixture: the Nth call OF EACH KIND answers with the Nth recorded payload of that
# kind, and the LAST payload of a kind repeats forever — so "nothing changed" is the steady state,
# which is what a watch must keep running through. Two queues, because a tick that watches issues
# makes two kinds of call and a single queue would feed one kind's payload to the other.
case "\$1" in
issue) k=issue; n=$_ni ;;
*) k=pr; n=$_np ;;
esac
[ "\$n" -gt 0 ] || { printf 'stub: no %s payloads in this fixture\n' "\$k" >&2; exit 1; }
c=\$(cat "$_tmp/calls.\$k" 2>/dev/null || echo 0)
c=\$((c + 1))
printf '%s\n' "\$c" >"$_tmp/calls.\$k"
i=\$((c - 1))
[ "\$i" -lt "\$n" ] || i=\$((n - 1))
cat "$_tmp/payload.\$k.\$i"
EOF
			chmod +x "$_tmp/gh"
			command -v timeout >/dev/null 2>&1 ||
				printf 'note  %s: timeout(1) is not installed — the loop runs UNGUARDED here, so a\n      non-terminating regression HANGS instead of failing. Said out loud because a guard\n      nobody was told is missing is worse than no guard.\n' "$(basename "$_f")"
			_out=$(loop_run "$(jq -r '.timeout_s // 120' "$_f")" \
				"$0" watch --repo "$(jq -r '.repo // "novkostya/quince"' "$_f")" \
				--state "$_tmp/state" --gh "$_tmp/gh" \
				--interval "$(jq -r '.interval // 2' "$_f")" \
				--max-wait "$(jq -r '.max_wait // 60' "$_f")" \
				--fail-after "$(jq -r '.fail_after // 3' "$_f")" 2>&1) && _rc=0 || _rc=$?
			# `elapsed` and `ticks` are wall-clock facts about the box, not about the behaviour, so they
			# are normalised rather than asserted — a fixture that pinned them would fail on a loaded
			# machine and teach everyone to ignore it. The EXIT CLASS is asserted, as a line, because it
			# is the part a caller reads when it ignores stdout.
			_got=$(printf '%s\n' "$_out" | grep '^event=' |
				sed 's/elapsed=[0-9]*s/elapsed=Ns/; s/ticks=[0-9]*/ticks=N/; s/late=[0-9]*s/late=Ns/' || true)
			_got=$(printf '%s\nexit=%s\n' "$_got" "$_rc" | grep -v '^$' | sort)
			_want=$(jq -r '.expect_events[], "exit=\(.expect_exit)"' "$_f" | sort)
			compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
			rm -rf "$_tmp"
			continue
		fi
		if [ "$_kind" = watch ]; then
			if [ "$(jq -r 'has("state")' "$_f")" = true ]; then
				jq -c '.state' "$_f" >"$_tmp/state"
			fi
			_got=$(watch_report "$_tmp/state" "$(jq -r '.now' "$_f")" "$(jq -r '.pid_alive // "yes"' "$_f")" || true)
			# The state path is a mktemp path here and a real one in production, so the fixtures write
			# `state=STATE` and the harness normalises. The path is still asserted to be REPORTED —
			# a report that omitted which file it read would be the weaker claim.
			_got=$(printf '%s\n' "$_got" | sed "s|state=$_tmp/state|state=STATE|" | sort)
			_want=$(jq -r '.expect[]' "$_f" | sort)
			compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
			rm -rf "$_tmp"
			continue
		fi
		jq -c '.before' "$_f" >"$_tmp/state"
		jq -c '.after' "$_f" >"$_tmp/obs"
		_got=$(step "$_tmp/state" "$_tmp/obs" | sort)
		_want=$(jq -r '.expect_events[]' "$_f" | sort)
		compare_events "$(basename "$_f")" "$_got" "$_want" || _fail=1
		rm -rf "$_tmp"
	done
	[ "$_fail" -eq 0 ] || die "fixtures failed"
	# No `[ "$_ran" -gt 0 ]` guard here: it would be unreachable. The dispatcher already refuses an
	# empty argument list (exit 1), and a glob that matches nothing arrives as its own literal, which
	# increments the counter and then dies in jq (exit 2) — both measured. A guard that cannot fire
	# reads as a safety net in review while asserting nothing, which is this file's own subject.
	printf 'forge-watch: %d fixtures pass\n' "$_ran"
}

# ---------------------------------------------------------------------------
# The declared blocking set — what a session SAID it is waiting for (quince#80).
#
# `.claude/forge-set` is the reviewer's watch set and is versioned, because a reviewer's obligation
# cannot be derived from anything it did. This is the opposite case: an issue a session declared it
# is blocked on is as self-describing as the PRs it opened, so it belongs in the session's own state
# rather than in a file everyone shares. Putting it in the versioned set would make "I am stuck on
# #71" a PR against a shared file, which is absurd for something that is true for an hour.
#
# `replace` replaces, `clear` empties, `none` leaves what is on disk alone. That third case is the one
# that matters: a re-arm restates neither the repo set nor the declaration, so the declaration cannot
# be lost by forgetting to repeat it — and forgetting to repeat something is the failure mode with
# four measured instances in this project already (quince#43's forgotten re-arms).
declare_issues() {
	_di_mode=$1
	_di_specs=$2
	_di_repo=$3
	_di_state=$4
	[ "$_di_mode" = none ] && return 0
	[ -f "$_di_state" ] || printf '{"observed":false}\n' >"$_di_state"
	_di_list=''
	if [ "$_di_mode" = replace ]; then
		for _di_s in $_di_specs; do
			case "$_di_s" in
			*/*'#'*)
				_di_r=${_di_s%%#*}
				_di_n=${_di_s##*#}
				;;
			*'#'*) die "--issue: $_di_s is not owner/name#number" ;;
			*)
				_di_r=$_di_repo
				_di_n=$_di_s
				;;
			esac
			case "$_di_n" in '' | *[!0-9]*) die "--issue takes a number or owner/name#number: $_di_s" ;; esac
			[ "$_di_r" = "$_di_repo" ] || continue
			_di_list="$_di_list $_di_n"
		done
	fi
	# declared_at is recorded so `status` can print the AGE of a declaration. A declaration outlives
	# the session that made it (the state file is deliberately long-lived), so the only defence
	# against a successor inheriting a watch on something nobody is waiting for is that the staleness
	# is visible. A timestamp is what makes it visible.
	jq -c --arg at "$(now_iso)" --argjson d "$(printf '%s' "$_di_list" | tr ' ' '\n' | grep -v '^$' | jq -R 'tonumber' | jq -sc '.')" \
		'.issues = ((.issues // {}) + {declared: $d, declared_at: (if ($d | length) == 0 then null else $at end)})' \
		"$_di_state" >"$_di_state.new" && mv "$_di_state.new" "$_di_state"
}

# issue_specs_ok — refuse a bare issue number under --all, BEFORE anything is written.
#
# Under --all a bare `--issue 71` has no repository, and the only two things it could mean are "the
# first repo in the set" and "every repo in the set". Both are guesses, and issue numbers collide
# across repositories exactly as PR numbers do — novkostya/quince#71 and novkostya/quince-devlog#71
# are unrelated and both exist. Picking either would produce a watch on an issue nobody declared,
# reporting comments from a thread nobody is blocked on, which is worse than not watching at all.
# So it refuses, in the same spirit as `.claude/forge-set` refusing to default.
issue_specs_ok() {
	_iso_all=$1
	_iso_repo=$3
	for _iso_s in $2; do
		if [ "$_iso_all" = yes ]; then
			case "$_iso_s" in
			*/*'#'*) : ;;
			*) die "--issue $_iso_s is ambiguous under --all: issue numbers collide across repositories.
    Give it as owner/name#number, e.g. --issue novkostya/quince#$_iso_s" ;;
			esac
			continue
		fi
		# The SINGLE-REPO path, and the case that was silent (review of quince#87). `declare_issues`
		# filters specs by repository with a bare `continue`, which is load-bearing and correct under
		# --all — every repo there is handed the WHOLE spec list and must keep only its own — and is a
		# silent no-op when it is the only filter. So `--repo novkostya/quince --issue
		# novkostya/quince-devlog#26` declared nothing and said nothing, and worse: one unmatched spec
		# replaced an existing declaration with an empty one, byte-identical to `--no-issues`.
		#
		# Not a contrived case. This is a two-repo project, `/kickoff` documents the bare-number
		# single-repo form as the implementer's shape, and an implementer blocked on a devlog issue is
		# ordinary. It is also exactly the failure this feature exists to remove, one level in: a
		# declaration that reaches nothing, with no way to tell from the outside.
		case "$_iso_s" in
		*/*'#'*)
			[ "${_iso_s%%#*}" = "$_iso_repo" ] ||
				die "--issue $_iso_s names ${_iso_s%%#*}, but --repo is $_iso_repo — nothing would watch it,
    and the watch would say nothing about that. Watch the other repository with its own \`watch
    --repo ${_iso_s%%#*}\`, or use --all and declare against the whole set."
			;;
		esac
	done
}

# declare_all — apply one declaration across the declared repo set. A spec naming a repository that
# is not in the set is a NO-OP by construction (declare_issues filters on the repo), which would be
# a silent miss — so it is checked here and refused, because "I declared #80 and heard nothing" must
# not have a quiet explanation.
declare_all() {
	_da_mode=$1
	_da_specs=$2
	[ "$_da_mode" = none ] && return 0
	_da_set=$(forge_set "$FORGE_SET_FILE")
	for _da_s in $_da_specs; do
		_da_r=${_da_s%%#*}
		printf '%s\n' "$_da_set" | grep -qx "$_da_r" ||
			die "--issue $_da_s names $_da_r, which is not in the watch set ($FORGE_SET_FILE).
    Nothing would watch it, and the watch would say nothing about that."
	done
	for _da_r in $_da_set; do
		_da_st=$(state_path_for "$_da_r")
		mkdir -p "$(dirname "$_da_st")"
		declare_issues "$_da_mode" "$_da_specs" "$_da_r" "$_da_st"
	done
}

# fetch_issues — ONE `gh issue view` per declared issue, into the observation.
#
# Not `gh issue list` with a window: a declared issue that had gone quiet enough to fall off the end
# of a window would then be reported on by silence, and this is the channel that carries rulings.
# "No silent caps" is a hard rule and a windowed fetch here is exactly one. The cost is bounded by
# the declaration, which a session writes deliberately and can see in `status`.
#
# A failure to read a declared issue is an EVENT, never an omission: `issue-fetch-failed` names the
# issue and the reason, and returns non-zero so the tick counts as failing — three in a row and the
# watch exits saying so, rather than watching an issue it cannot actually read.
fetch_issues() {
	_fi_state=$1
	_fi_repo=$2
	_fi_gh=$3
	_fi_out=$4 # a file to append the shaped issue objects to, one JSON object per line
	_fi_refs=$5 # issues DERIVED from open PRs (quince#80 half two); may be empty
	_fi_rc=0
	_fi_decl=$(jq -r '.issues.declared // [] | .[]' "$_fi_state" 2>/dev/null || true)
	# The union, deduped: an issue that is BOTH declared and referenced is fetched once and carries
	# both sources. Deduping matters more than it looks — the ordinary case is a session declaring the
	# issue its own PR is for, which is exactly the overlap, and fetching it twice would emit every
	# event about it twice.
	_fi_all=$(printf '%s\n%s\n' "$_fi_decl" "$_fi_refs" | grep -v '^$' | sort -n -u || true)
	[ -n "$_fi_all" ] || return 0
	_fi_raw=$(mktemp)
	for _fi_n in $_fi_all; do
		# `via=` answers "why am I watching this", which the derived half makes a real question: the
		# session never declared these, so an event about one is otherwise unexplained. It is also what
		# lets a CLOSE wake on a declared issue and not on a merely-referenced one, without inventing a
		# second event name for the same fact.
		if printf '%s\n' "$_fi_decl" | grep -qx "$_fi_n"; then _fi_d=yes; else _fi_d=no; fi
		if printf '%s\n' "$_fi_refs" | grep -qx "$_fi_n"; then _fi_r=yes; else _fi_r=no; fi
		case "$_fi_d$_fi_r" in
		yesyes) _fi_via=declared,referenced ;;
		yesno) _fi_via=declared ;;
		*) _fi_via=referenced ;;
		esac
		# A failed read FAILS THE TICK only for a DECLARED issue, and the distinction is the second
		# lesson of the cross-repo incident above. A declaration is a request: the session named that
		# issue, so being unable to read it is a real failure and three in a row must exit the watch.
		# A reference is an INFERENCE this tool made from a PR title — if it is unreadable, the
		# inference was wrong, and failing the tick would let one bad guess kill the watch after three
		# ticks. That is the tool punishing the session for its own mistake. Reported either way, with
		# `via=` saying which, so a wrong inference is visible rather than swallowed; but only the
		# request counts against --fail-after.
		if ! "$_fi_gh" issue view "$_fi_n" -R "$_fi_repo" \
			--json number,state,updatedAt,closedAt,stateReason,labels,comments >"$_fi_raw" 2>"$_fi_raw.err"; then
			_fi_why=$(head -1 "$_fi_raw.err" 2>/dev/null | tr ' ' '_' | cut -c1-60)
			printf 'event=issue-fetch-failed repo=%s issue=%s reason=%s via=%s\n' \
				"$_fi_repo" "$_fi_n" "${_fi_why:-no_stderr_from_gh}" "$_fi_via"
			[ "$_fi_d" = no ] || _fi_rc=1
			continue
		fi
		if ! jq -e 'type == "object" and has("number")' "$_fi_raw" >/dev/null 2>&1; then
			printf 'event=issue-fetch-failed repo=%s issue=%s reason=payload_not_an_issue via=%s\n' \
				"$_fi_repo" "$_fi_n" "$_fi_via"
			[ "$_fi_d" = no ] || _fi_rc=1
			continue
		fi
		jq -c --arg via "$_fi_via" '{number, state, updatedAt, via: $via,
			closed_at: .closedAt, state_reason: (.stateReason // ""),
			labels: [(.labels // [])[] | .name],
			activity: [(.comments // [])[] | {at: .createdAt, actor: (.author.login // "unknown"), kind: "comment"}]}' \
			"$_fi_raw" >>"$_fi_out"
	done
	rm -f "$_fi_raw" "$_fi_raw.err"
	return "$_fi_rc"
}

# ---------------------------------------------------------------------------
# tick — the thin half: fetch, hand the observation to step. Uses gh-bot so the token stays out of
# argv and the call is allowlistable.
# ---------------------------------------------------------------------------
FETCH_LIMIT=${FORGE_LIMIT:-20}

tick() {
	_state=$1
	_repo=$2
	_gh=$3
	_wpid=$4     # the WATCHER loop's pid, or '' for a hand-run tick
	_interval=$5 # seconds between watcher ticks, for the heartbeat and the overdue check
	command -v jq >/dev/null 2>&1 || die "jq is required"

	# A tick that was due and did not happen is reported BEFORE anything else, because it is the one
	# fact about this tick that the events themselves cannot carry: they will arrive looking perfectly
	# healthy, all at once, hours late. Only the watcher's own ticks are judged — a hand-run tick has
	# no cadence to be late for.
	if [ -n "$_wpid" ] && [ -f "$_state" ]; then
		watch_report "$_state" "$(now_iso)" yes 2>/dev/null | grep '^event=' || true
	fi

	# The fetch is captured to a file and checked ON ITS OWN, because piping it straight into jq
	# hands us JQ's exit status: a missing `gh` wrapper produced no output, jq accepted the empty
	# input, and the tool emitted `first-observation count=` on every tick, forever, while looking
	# healthy. `set -o pipefail` would be the obvious fix and is not POSIX sh, so the pipeline is
	# split instead. A loop wired to the old version would have slept indefinitely — corollary (d)
	# of this project's own rule, inside the tool built to enforce it.
	# Sorted by ACTIVITY, not by PR age. The default order is newest-first by number, so a window
	# of 20 on a repo with 30 PRs is mostly ancient closed rows — the events here are about open
	# work and merges, and spending the whole budget on history means recent activity can fall out
	# of view while the window looks full.
	#
	# The field list is wider than the events strictly need, and the cost was measured rather than
	# guessed: 92 KB → 229 KB per tick for a 20-PR window on this repo (2026-07-26). `comments` and
	# `commits` carry bodies and messages that are thrown away by the shaping below — `gh pr list`
	# cannot select subfields — and they are fetched anyway because they are the only way to answer
	# WHO moved a PR. FORGE_LIMIT is the knob if that ever stops being a good trade.
	_raw=$(mktemp)
	if ! "$_gh" pr list -R "$_repo" --state all --limit "$FETCH_LIMIT" \
		--search "sort:updated-desc" \
		--json number,state,updatedAt,title,closingIssuesReferences,statusCheckRollup,reviews,comments,commits,mergedAt,mergedBy,mergeStateStatus >"$_raw" 2>"$_raw.err"; then
		# A `reason=` with nothing after it reads as "there was no reason" rather than "the tool could
		# not tell" — a wrapper that fails silently produces exactly that, and it was doing so.
		_why=$(head -1 "$_raw.err" 2>/dev/null | tr ' ' '_' | cut -c1-60)
		printf 'event=fetch-failed repo=%s reason=%s\n' "$_repo" "${_why:-no_stderr_from_gh}"
		rm -f "$_raw" "$_raw.err"
		return 1
	fi
	# A payload that does not parse, or is not an array, is a failed fetch wearing a success exit
	# code. Assert the shape before treating it as an observation.
	if ! jq -e 'type == "array"' "$_raw" >/dev/null 2>&1; then
		printf 'event=fetch-failed repo=%s reason=payload_not_an_array\n' "$_repo"
		rm -f "$_raw" "$_raw.err"
		return 1
	fi

	# No silent caps — but a warning that fires every tick is wallpaper, and a consumer learns to
	# ignore it, which re-creates the silent cap through boredom. The first version compared the raw
	# row count to the limit, which is true forever in any repo with twenty closed PRs.
	#
	# Truncation only matters when it can HIDE something this tool reports on: open work, or a
	# recent change. Sorted by activity, that is precisely the case where the oldest row in the
	# window is still OPEN — anything beyond it is both older and unseen, so an open PR could be out
	# there unwatched. When the window ends on settled history, nothing relevant is behind it.
	if [ "$(jq 'length' "$_raw")" -ge "$FETCH_LIMIT" ] &&
		[ "$(jq -r '.[-1].state' "$_raw")" = OPEN ]; then
		printf 'event=queue-truncated limit=%s repo=%s oldest_in_window_still_open=%s\n' \
			"$FETCH_LIMIT" "$_repo" "$(jq -r '.[-1].number' "$_raw")"
	fi

	# `activity` is the attribution channel: every dated act this payload can see, flattened, so the
	# PURE half decides who moved a PR. Shaping the answer here instead would put the WHEN-is-not-WHO
	# logic on the untestable side of the split, which is where the last four monitor bugs lived.
	# A login that GitHub does not resolve (a commit author who is not a GitHub user) becomes
	# `unknown` — distinct from `unattributed`, which means no act explains the update at all.
	_obs=$(mktemp)
	jq -c '{observed: true, prs: [.[] | {number, state, updatedAt,
		merge_state: (.mergeStateStatus // "UNKNOWN"),
		checks: [(.statusCheckRollup // [])[] | {name, conclusion}],
		reviews: [(.reviews // [])[] | {state}],
		activity: (
			  [(.comments // [])[] | {at: .createdAt,    actor: (.author.login // "unknown"), kind: "comment"}]
			+ [(.reviews  // [])[] | {at: .submittedAt,  actor: (.author.login // "unknown"), kind: "review"}]
			+ [(.commits  // [])[] | {at: .committedDate, actor: (((.authors // [])[0]).login // "unknown"), kind: "commit"}]
			+ (if .mergedAt then [{at: .mergedAt, actor: (.mergedBy.login // "unknown"), kind: "merge"}] else [] end)
		)}]}' "$_raw" >"$_obs" ||
		die "could not shape the observation for $_repo"

	[ -f "$_state" ] || printf '{"observed":false}\n' >"$_state"

	# The declared issues, folded into the same observation so the PURE half sees one payload and
	# the diff of both channels happens in the half the fixtures can drive. A failing issue fetch
	# does not abort the tick — the PR events for this tick are still real and still owed to the
	# session — but it does make the tick FAIL, so a run of them exits the watch rather than
	# producing a watch that reports on a queue and silently reads nothing on the channel that
	# carries rulings.
	# The DERIVED half of quince#80: issues referenced by OPEN PRs, automatic, no declaration. It
	# costs no extra `gh` call — `title` and `closingIssuesReferences` ride along on the queue fetch.
	#
	# The signal is the UNION of GitHub's link data and a `#N` scan of the TITLE, and that is measured
	# rather than tidy. Over 25 PRs in this repository (2026-07-27):
	#
	#   closingIssuesReferences alone  9/25  ·  title #N alone  22/25  ·  union  23/25
	#
	# (`gh pr list -R novkostya/quince --state all --limit 25`, 2026-07-27T09:57Z. The first version of
	# this comment said 10/25 — counted by eye, corrected in review of the journal entry carrying the
	# same figure, and recomputed in jq. The ratio is the weaker half of the argument anyway.)
	#
	# The decisive case is quince#87 ITSELF — the PR that built half one of this ruling. Its body says
	# "Closes half one of #80", which GitHub does not parse as a closing keyword, so its link data is
	# EMPTY while its title carries `(#80)`. A derived half resting on link data alone would have
	# missed the very PR written to fix this issue.
	#
	# The BODY is deliberately NOT scanned. quince#87's body cites eleven issue numbers, nearly all as
	# history — watching every issue a PR mentions is the wallpaper this tool has rejected twice
	# already (SUCCESS checks, BLOCKED/UNSTABLE mergeability), and wallpaper on the escalation channel
	# is worse than anywhere else.
	#
	# OPEN PRs only, which is the point: the derived set tracks what is being worked on now. A merged
	# PR's issues leave it, and their stored records survive under the same carry-forward that covers a
	# failed fetch — so re-referencing one later diffs against its old baseline instead of
	# re-announcing it, consistent with what undeclaring already does.
	# The `#N` scan requires the `#` NOT to be preceded by a word character, and that narrowing is a
	# defect this tool found IN ITSELF, in production, on the branch that added it. A devlog PR titled
	# "… a declaration now reaches it (quince#87)" made a naive `#[0-9]+` scan derive
	# quince-devlog#87 — a CROSS-REPO reference resolved against the wrong repository, which is
	# devlog#18's exact class reproduced mechanically. It surfaced as
	# `issue-fetch-failed … reason=GraphQL:_Could_not_resolve_to_an_issue…`: the tool answering
	# correctly about a question it should never have asked. `quince#87` is quince's, not ours, and a
	# repo-qualified reference is precisely the one a per-repo fetch must NOT claim.
	#
	# The class is EXACTLY the word characters, and the first version added `/` and `-` to it — which
	# is what the comment above already claimed it did not. Review caught the discrepancy and the fix
	# went the way the comment was written, because the two extra characters bought nothing and cost
	# something. Every qualified form is blocked by the ALPHANUMERIC immediately before the `#`
	# (`quince#87`, `quince-devlog#87`, `novkostya/quince#5`, `v1.2#3`), so `/` and `-` guarded only
	# `docs/#5` and `#12-#13` — and on the second they SILENTLY DROPPED the second reference, which is
	# the no-silent-caps rule broken on the escalation channel by a character class. Measured both ways
	# before changing it: `fixes #12-#13` went [12] → [12,13], every block above stayed blocked, and
	# the one behaviour widened is `docs/#5`, which now yields 5. Stated rather than discovered later:
	# that form is not repo-qualified, so claiming it is defensible, and it is the whole price.
	_refs=$(jq -r '[.[] | select(.state == "OPEN")
		| [(.closingIssuesReferences // [])[] | .number]
		  + [(.title // "") | scan("(?:^|[^A-Za-z0-9_])#([0-9]+)") | .[0] | tonumber]]
		| flatten | unique | .[]' "$_raw" 2>/dev/null || true)

	_iss=$(mktemp)
	_irc=0
	fetch_issues "$_state" "$_repo" "$_gh" "$_iss" "$_refs" || _irc=1
	if [ -s "$_iss" ]; then
		jq -c --slurpfile items "$_iss" '.issues = {items: $items}' "$_obs" >"$_obs.new" &&
			mv "$_obs.new" "$_obs"
	fi
	rm -f "$_iss"

	step "$_state" "$_obs"

	# The heartbeat is written AFTER step(), so a tick that died mid-step does not leave a timestamp
	# claiming it finished. `last_tick` records any tick; the watcher's own cadence is recorded
	# separately, so a hand-run tick can never make a dead watcher look alive — which it would, if one
	# field served both, and that field is precisely what a supervisor consults.
	#
	# BOTH directions now hold, and only one of them used to (quince#103). This comment asserted the
	# safe direction and was true; the direction it did not mention was broken, because step() dropped
	# `.watch` on every write and only the branch below rewrote it. So a hand-run tick could not make a
	# dead watcher look alive, and DID make a live watcher look dead. step() carries `.watch` forward
	# now, so the else branch below genuinely "writes only .last_tick" — until this fix that sentence
	# described the intent while the record had already been thrown away upstream.
	#
	# No hostname is recorded, deliberately: the state file is per-box already, and a hostname is an
	# Operator-private fact that would then live in a file somebody pastes into an issue.
	_ts=$(now_iso)
	if [ -n "$_wpid" ]; then
		# pid_start is recorded beside the pid so that a later `stop` can prove the pid still belongs to
		# this process rather than to whatever the kernel recycled it onto. Recorded even when procfs
		# cannot answer (empty), because "we never knew" and "it changed" are different refusals.
		jq -c --arg ts "$_ts" --argjson pid "$_wpid" --argjson iv "$_interval" \
			--arg start "$(proc_start "$_wpid")" '
			.last_tick = $ts
			| .watch = {pid: $pid, pid_start: (if $start == "" then null else $start end),
			            interval_s: $iv, last_watcher_tick: $ts,
			            due: (($ts | fromdate) + $iv | todate)}' "$_state" >"$_state.new" &&
			mv "$_state.new" "$_state"
	else
		jq -c --arg ts "$_ts" '.last_tick = $ts' "$_state" >"$_state.new" && mv "$_state.new" "$_state"
	fi
	rm -f "$_obs" "$_raw" "$_raw.err"
}

# tick_all — one tick across the DECLARED set. Extracted from the `tick` verb so that `watch` runs
# exactly the same code path the verb does; a loop with its own private copy of the multi-repo fan-out
# would be a second implementation of the thing whose failures this file catalogues.
tick_all() {
	_agh=$1
	_awpid=$2
	_aiv=$3
	_set=$(forge_set "$FORGE_SET_FILE")
	_arc=0
	_aevt=$(mktemp)
	for _r in $_set; do
		_st=$(state_path_for "$_r")
		mkdir -p "$(dirname "$_st")"
		# NOT `tick … | tag_repo`: a pipeline's exit status is the LAST command's, so piping into
		# the tagger would discard tick's failure and a total fetch failure would exit 0 — measured,
		# not theorised. This is the same trap `tick` itself documents for `set -o pipefail` (not
		# POSIX sh), one level up, and the same fix: split the pipeline and check the half that can
		# fail. A watcher wired to the piped version would have read "all repos failed" as a healthy
		# tick, which is corollary (a) — silence is not a result — in the tool built to enforce it.
		if tick "$_st" "$_r" "$_agh" "$_awpid" "$_aiv" >"$_aevt"; then :; else _arc=1; fi
		tag_repo "$_r" <"$_aevt"
	done
	rm -f "$_aevt"
	# One repository failing does not silence the others, and does not read as success either: the
	# fetch-failed event names the repo, and the exit code carries the failure out of the loop.
	return "$_arc"
}

require_gh() {
	# The identity is the caller's choice, never the tool's: the reviewer loop runs on the architect
	# box, which by construction holds no bot token, so a hard-coded gh-bot could not run on the box
	# that most needs this. Default is plain `gh`, which is also what a stranger's clone has.
	command -v "$1" >/dev/null 2>&1 || [ -x "$1" ] ||
		die "gh command not found: $1 (set --gh or FORGE_GH)"
}

# ---------------------------------------------------------------------------
# watch — the loop, and the whole point of it is that IT ENDS.
#
# quince#62: the first architect session under the rewritten protocol armed
#
#     sh -c 'while :; do forge-watch tick --all …; sleep 60; done'
#
# and went deaf for fifty minutes while every instrument agreed it was healthy — heartbeat fresh,
# both state files rewritten every 60 s, `status --all` reporting `live`. A session is woken by a
# background task COMPLETING; a loop with no exit condition completes never, so nothing it detects
# can ever be delivered. It had degraded, silently, to the twenty-minute poll this whole unit
# existed to remove, wearing the new mechanism's clothes.
#
# Documenting the requirement was necessary and not sufficient: the next session reads the same
# text and makes the same plausible choice, because `while :; do … done` is what a watching loop
# looks like everywhere else. So the loop stops being something a session assembles. The correct
# shape is the only shape, and hand-rolling is no longer the path of least resistance.
#
# What wakes, and what does not:
#   - any event, including `tick-overdue` and `queue-empty` as a TRANSITION, ends the loop;
#   - the baseline does not. `first-observation` is the observation that establishes the baseline,
#     not a change from it, and the `queue-empty` printed beside it describes the same baseline.
#     Waking on those would make arming a watch a busy loop: arm, exit, arm, exit;
#   - `fetch-failed` does not, until --fail-after in a row. A single failed fetch is a missed tick,
#     and this tool already has an idiom for those. A run of them is a watch that is not watching,
#     and the exit says so. Nothing is swallowed either way: every tick's output is printed.
#
# `--max-wait` exists because termination is now the ONLY thing that wakes a session, and the
# fallback that was supposed to cover the gaps between watches — `ScheduleWakeup` — has three
# measured armings on the architect box and zero measured deliveries (quince#62). So the loop
# provides its own floor: it exits idle at the bound, through the channel that is measured to work.
# The skills still arm the fallback; this is not a replacement for it, and neither is treated as
# cover for the other.
# ---------------------------------------------------------------------------
wake_worthy() {
	# $1 is a file holding ONE tick's output, $2 is "first" for the first tick of this watch; prints
	# the lines that justify waking a session.
	#
	# Two passes over the same file, because the baseline decision for a `queue-empty` line depends
	# on whether its repository also emitted `first-observation` on this tick — and under --all the
	# lines of several repositories are interleaved, so `repo=` is the only thing that pairs them.
	#
	# `tick-overdue` on the FIRST tick is dropped, and that is a finding from arming this verb for
	# real rather than a tidiness. Re-arming from a `dead` watch ALWAYS produces one: the previous
	# watcher stopped ticking, so its `due` is by definition in the past. Waking on it means every
	# re-arm-from-dead immediately exits again, reporting as news the very gap that `watch_preflight`
	# announced one line earlier — a description of the watch that ENDED, not of anything that
	# happened while this one was watching. A later one is a different claim (the loop was starved
	# while running) and still wakes.
	_ww_first=${2:-later}
	awk -v first="$_ww_first" '
		first == "first" && /^event=tick-overdue/ { next }
		function repo(l,   i, n, a) {
			n = split(l, a, " ")
			for (i = 1; i <= n; i++)
				if (a[i] ~ /^repo=/) return a[i]
			return ""
		}
		NR == FNR { if ($0 ~ /^event=first-observation/) base[repo($0)] = 1; next }
		/^event=first-observation/ { next }
		/^event=fetch-failed/ { next }
		# The issue channel baseline, per-issue. Same reason as first-observation: a newly declared
		# issue establishes what it looks like, which is not a change from anything.
		/^event=issue-first-observation/ { next }
		# A failed issue read does not wake on its own, for the same reason a failed PR fetch does
		# not: one is a missed read, a run of them is a watch that is not watching, and --fail-after
		# is what tells the two apart. It is PRINTED either way.
		/^event=issue-fetch-failed/ { next }
		# A close/reopen on a MERELY-REFERENCED issue does not wake: nobody declared it, so nobody is
		# blocked on it, and tidying an issue an open PR happens to name is the noise the ruling
		# flagged. A close on a DECLARED issue does wake — that is the blocker clearing. Printed
		# either way; this filter has never decided what is SEEN.
		/^event=issue-(closed|reopened)/ { if ($0 ~ /via=referenced/) next }
		/^event=queue-empty/ { if (base[repo($0)]) next }
		/^event=/ { print }
	' "$1" "$1"
}

watch_preflight() {
	# The five answers of `status`, enforced instead of recited. `live`, `starting` and `wedged` REFUSE — the
	# first because two watchers on one state file is a race that presents as missing events
	# (quince#50), the second because "wedged" means a process is still running by definition, so
	# arming beside it is starting the second watcher rather than replacing the first. `dead` and
	# `absent` proceed, and the tool SAYS WHICH: re-arming from a dead state must not reseed it, and
	# the session is expected to report that it found one.
	_ps=$1
	_pr=$2
	_pa=no
	if [ -f "$_ps" ]; then
		_pp=$(jq -r '.watch.pid // empty' "$_ps" 2>/dev/null || true)
		[ -n "$_pp" ] && _pa=$(pid_alive "$_pp")
	fi
	_prep=$(watch_report "$_ps" "$(now_iso)" "$_pa") && _pcls=0 || _pcls=$?
	printf 'forge-watch: %s\n' "$_pr"
	# The classification, without watch_report's `event=` lines: the first tick re-emits `tick-overdue`
	# a moment later from the same state, and printing it twice would make one missed tick look like
	# two. The classification is what this step is for.
	printf '%s\n' "$_prep" | grep -v '^event=' || true
	case "$_pcls" in
	0) die "a watch is ALREADY LIVE for $_pr — refusing to arm a second one. Two watchers on one
    state file is a race that presents as missing events (quince#50). If you meant to replace it,
    \`forge-watch stop --repo $_pr\` first." ;;
	5) die "the watch for $_pr is WEDGED — a process is still running and has stopped ticking.
    Run \`forge-watch stop --repo $_pr\` (it verifies the pid is still ours and refuses if it was
    recycled), then arm again. Do not kill the pid by hand." ;;
	# `starting` refuses for the same reason `live` does — a process IS running — but it needs its own
	# arm because the remedy differs: there is nothing to stop and nothing to fix, only to wait
	# (quince#95). Without this arm it would fall through to the `esac` and arm a second watcher beside
	# a healthy one, which is the exact race this class was added to stop a hook from causing.
	9) die "a watch for $_pr is STARTING — armed, and its first tick has not finished yet. Refusing to
    arm a second one beside it. Nothing is wrong and nothing is owed: wait for the tick, or run
    \`forge-watch status --repo $_pr\` to watch it become live." ;;
	3) printf 'forge-watch: re-arming from a DEAD watch — not reseeded, so the next tick emits what accrued while nothing was watching.\n' ;;
	4) printf 'forge-watch: cold start — the first tick establishes the baseline and does not wake anybody.\n' ;;
	esac
}

# first_tick_floor — the smallest --interval that can plausibly contain a first tick, given how many
# issues that tick will fetch.
#
# WHY THIS EXISTS AT ALL. `starting` (quince#95) is bounded, and the natural bound is `armed_at +
# interval`. That bound is only sound while an interval is longer than a first tick, and `--interval`
# is a flag, so it need not be: `--interval 15` against a 20-issue declared set is a first tick that
# CANNOT finish inside its own bound, and `starting` would expire under a watcher that is fine —
# this issue rebuilt inside its own fix, and worse, because it would be correct on every box using
# defaults and wrong only on the one that tuned the interval down.
#
# WHY A LOWER BOUND AND NOT A REFUSAL, having built the refusal first. I proposed refusing an
# interval below this floor on quince#95, and the architect preferred it weakly. Writing it falsified
# it: the refusal makes legitimate configurations impossible, and the first casualty was this repo's
# OWN fixture suite, which drives `watch` at `--interval 2` (replay, :1053) precisely because
# fixtures must not sleep. A guard that forbids the test harness is a guard whose premise — that a
# short interval means a mistake — is wrong.
#
# `max(interval, floor)` is correct where the refusal was merely safe. At `--interval 2` with nothing
# declared the bound becomes 5 s, so a first tick that really takes 4 s still lands inside it, and a
# watcher that never ticks still degrades at 5 s. Nothing is forbidden and nothing is unbounded.
#
# THE CONSTANTS, and why they are allowed to be constants here when the BOUND deliberately is not.
# Measured on the runner box, 2026-07-27, against the real forge — a first tick is one `gh pr list`
# plus one `gh issue view` per declared or derived issue (quince#89):
#
#   0 declared →  4 s      20 declared → 17 s        3 repeats at 20: 16, 17, 18 s  (~12 % spread)
#   5 declared →  7 s                                3 repeats at  0:  4,  4,  4 s
#  10 declared → 10 s      ≈ 4 s + 0.65 s per issue
#
# `5 + N` is deliberately above that line — ~1.4× the worst observed at N=20 — because this is a
# FLOOR and not an estimate. A bound built from these numbers would rot silently as latency changed;
# a floor built from them fails in the safe direction when it is wrong, which is the whole reason the
# bound is `interval` and only the floor is arithmetic.
first_tick_floor() {
	# $1: how many issues the first tick will fetch.
	printf '%s\n' $((5 + $1))
}

# watch_arm — write the arm-time record, so `starting` is distinguishable from `dead`.
#
# The heartbeat still lands after step(), exactly as before and as quince#95's ruling requires: this
# does not move that write. It ADDS `armed_at` and the pid at arm time, which is the fact that was
# missing — until the first tick completed, `.watch.pid` still named the PREVIOUS watcher, so
# `watch_report` saw a dead predecessor and every consumer of its exit code was told `dead`. Both
# consumers read the same field (`watch_report` for `status`, `owed_classify` at the hook), so one
# write at the right moment corrects both.
watch_arm() {
	_as=$1
	_aiv=$2
	_ar=$3
	[ -f "$_as" ] || printf '{}\n' >"$_as"
	# What the first tick will fetch: the declared set plus whatever references are already on record.
	# The genuinely-derived set is not knowable until the PR list comes back, so prior items are the
	# proxy — an under-count makes the floor more permissive, never less, which is the direction a
	# floor may be wrong in.
	_an=$(jq -r '((.issues.declared // []) + ((.issues.items // []) | map(.number))) | unique | length' "$_as" 2>/dev/null || printf '0')
	case "$_an" in '' | *[!0-9]*) _an=0 ;; esac
	_afloor=$(first_tick_floor "$_an")
	# The bound is COMPUTED HERE and stored, rather than recomputed by watch_report. watch_report is
	# pure by design — (state, now, pid_alive) and nothing else — and the issue count it would need is
	# a property of the tick that is about to run, not of the state it is reading. Storing it also
	# means `status` reports the bound a watcher was actually armed with, rather than one re-derived
	# from a declared set that may have changed underneath it.
	_abound=$_aiv
	[ "$_abound" -ge "$_afloor" ] || _abound=$_afloor
	_ats=$(now_iso)
	# `due` is CARRIED FORWARD from the generation being replaced, not reset. It is what
	# `tick-overdue` is computed from, so wiping it here would silently delete the gap that accrued
	# while nothing was watching — the exact property "re-arm from a dead watch, do NOT reseed it"
	# exists to preserve, and the one quince#104 fixed once already in step(). Caught by
	# watch-rearm-does-not-wake-on-its-own-gap.json, which is why that fixture is worth its runtime.
	#
	# `last_watcher_tick` DOES reset to null: that is the fact `starting` is defined by, and it is
	# this generation's, not the dead one's.
	# `interval_s` is carried forward TOO, whenever a `due` is, and that is not an oversight. While a
	# `due` from the previous generation is still on the record, the record describes THAT
	# generation's cadence — `tick-overdue` prints `due=` and `interval=` together, and pairing a due
	# computed at 60 s with the new watcher's 2 s is a line that cannot be true of any one watcher.
	# The first tick of this generation overwrites both with its own. The bound this generation runs
	# under is unaffected, because it is stored explicitly as `starting_bound_s` rather than re-derived
	# from whichever interval happens to be on the record.
	jq -c --arg ts "$_ats" --argjson pid "$$" --argjson iv "$_aiv" --argjson bd "$_abound" \
		--arg start "$(proc_start "$$")" '
		((.watch // {}) | .due // null) as $prev_due
		| ((.watch // {}) | .interval_s // null) as $prev_iv
		| .watch = {pid: $pid, pid_start: (if $start == "" then null else $start end),
		            interval_s: (if $prev_due == null then $iv else ($prev_iv // $iv) end),
		            armed_at: $ts, starting_bound_s: $bd,
		            last_watcher_tick: null, due: $prev_due}' \
		"$_as" >"$_as.new" && mv "$_as.new" "$_as"
}

watch_loop() {
	_wall=$1
	_wrepo=$2
	_wstate=$3
	_wgh=$4
	_wiv=$5
	_wmax=$6
	_wfail=$7

	_wstart=$(date +%s)
	_wfails=0
	_wticks=0
	_wevt=$(mktemp)
	while :; do
		if [ "$_wall" = yes ]; then
			tick_all "$_wgh" "$$" "$_wiv" >"$_wevt" && _wrc=0 || _wrc=$?
		else
			tick "$_wstate" "$_wrepo" "$_wgh" "$$" "$_wiv" >"$_wevt" && _wrc=0 || _wrc=$?
		fi
		_wticks=$((_wticks + 1))
		# Printed before anything is decided: the filter below chooses what WAKES a session, never
		# what a session may see. A watcher that hid its own failing ticks would be the silence this
		# tool exists to make impossible.
		cat "$_wevt"
		if [ "$_wticks" -eq 1 ]; then _wfirst=first; else _wfirst=later; fi
		_wwake=$(wake_worthy "$_wevt" "$_wfirst")
		if [ -n "$_wwake" ]; then
			printf 'forge-watch: watch EXITING on the event(s) above (tick %s) — handle them, then ARM AGAIN. A watch that exited is a watch that is not watching.\n' "$_wticks"
			rm -f "$_wevt"
			return 0
		fi
		if [ "$_wrc" != 0 ]; then
			_wfails=$((_wfails + 1))
			if [ "$_wfails" -ge "$_wfail" ]; then
				printf 'event=watch-failing consecutive=%s limit=%s\n' "$_wfails" "$_wfail"
				printf 'forge-watch: watch EXITING — %s ticks in a row could not fetch. The events above name the reason; fix it and arm again.\n' "$_wfails"
				rm -f "$_wevt"
				return 7
			fi
		else
			_wfails=0
		fi
		_welapsed=$(($(date +%s) - _wstart))
		if [ "$_welapsed" -ge "$_wmax" ]; then
			printf 'event=watch-idle elapsed=%ss ticks=%s\n' "$_welapsed" "$_wticks"
			printf 'forge-watch: watch EXITING on the idle bound — nothing happened, which is a report and not a silence. ARM AGAIN.\n'
			rm -f "$_wevt"
			return 6
		fi
		sleep "$_wiv"
	done
}

# ---------------------------------------------------------------------------
# owed — the OTHER half of quince#62, and the harder one.
#
# `watch` fixes a loop that was built wrong. It does nothing at all for the failure measured on the
# implementer side an hour later: a session that built no loop. No watcher, no state file, no fallback
# — it ended a turn with *"the ball is back with the reviewer"*, four minutes before the verdict it was
# waiting for landed, and nothing anywhere could have told it. The skill it was following names that
# stop as illegitimate in its own text, in a section rewritten to prevent exactly it.
#
# The pattern this repository keeps rediscovering: **a rule that tells a session to do something is
# satisfied by a session that does not do it, and nothing observes the difference.** So the fix cannot
# be another sentence. Something other than the session has to notice.
#
# Two shapes were considered and rejected, both on structure rather than taste:
#
#   - "opening a PR arms the watch as a side effect" CANNOT WORK, and fails in the exact shape of the
#     bug above. A session is woken by a background task that the SESSION launched completing; a
#     process forked by a `gh pr create` wrapper is not tracked by anything, so its exit notifies
#     nobody. It would be armed, heartbeating, `status=live`, and deaf.
#   - "a channel that does not depend on the recipient having armed anything" is right, and it is the
#     runner dispatcher already specified in docs/specs/rung-loop (a supervised tick starting one
#     FRESH session per event). It needs the runner unit, so it is named rather than built here.
#
# What is left is to make the ABSENCE detectable, and to aim that at the only actor who can fix it.
# `owed` is the predicate; the session's harness runs it when a turn ends (.claude/settings.json).
# It blocks ONCE — a Stop hook that always blocks is a session that can never end — and on the second
# attempt it warns the human instead. That is deliberate: the point is not to make stopping impossible,
# it is to make an unwatched stop impossible to do SILENTLY.
#
# Exit codes: 0 nothing owed · 8 a watch is owed and is not live.
# ---------------------------------------------------------------------------
owed_decide() {
	# $1: a file of "<repo> <class>" lines, class being `status`'s exit code. $2: the role's mode,
	# `author` or `all`. PURE — no forge, no process table, no clock — for the same reason step() and
	# watch_report() are: the deciding half is the half that has been wrong, and it can only be
	# fixtured if it does not fetch.
	#
	# The two halves owe a watch for DIFFERENT REASONS, and after quince#71 the line says which.
	# For the implementer the reason is that it has open PRs — a fact about the queue, which is why
	# `--author` asks the forge. For the reviewer the reason is that the repository is in the declared
	# set at all, and the queue is irrelevant: **an empty queue is not a legitimate finish**, because a
	# reviewer's work is not done when the queue is empty but when nothing further is coming, and that
	# is not knowable from inside. Printing "open PRs" for a reviewer whose queue is empty would be a
	# false reason bolted to a true verdict, which is worse than either mistake alone.
	_od=0
	_od_mode=${2:-author}
	if [ "$_od_mode" = all ]; then _od_why='declared'; else _od_why='open PRs'; fi
	while read -r _od_repo _od_cls; do
		[ -n "$_od_repo" ] || continue
		case "$_od_cls" in
		0) printf 'ok    %s — %s, and a live watch\n' "$_od_repo" "$_od_why" ;;
		# `starting` is NOT owed, and this line is the reason the class exists at all (quince#95). A
		# session that armed a watch and ended its turn inside the first tick has done nothing wrong;
		# blocking it here is what handed a correct-looking instruction to arm a SECOND watcher onto
		# one state file — quince#50's race, reached by obeying a guard rather than by ignoring one.
		9) printf 'ok    %s — %s, and a watch that is starting (armed, first tick not finished)\n' "$_od_repo" "$_od_why" ;;
		3) printf 'OWED  %s — %s, watch=dead. Re-arm from that state; do NOT reseed it.\n' "$_od_repo" "$_od_why" ;;
		4) printf 'OWED  %s — %s, and no watch has ever been armed here.\n' "$_od_repo" "$_od_why" ;;
		5) printf 'OWED  %s — %s, watch=wedged. Run "forge-watch stop --repo %s" first, then arm.\n' "$_od_repo" "$_od_why" "$_od_repo" ;;
		*) printf 'OWED  %s — %s, and the watch class could not be read (%s).\n' "$_od_repo" "$_od_why" "$_od_cls" ;;
		esac
		case "$_od_cls" in 0 | 9) ;; *) _od=8 ;; esac
	done <"$1"
	return "$_od"
}

owed_classify() {
	# The impure half: for each repo on stdin, ask the process table and the clock, and print the
	# table owed_decide() consumes.
	while read -r _oc_repo; do
		[ -n "$_oc_repo" ] || continue
		_oc_st=$(state_path_for "$_oc_repo")
		_oc_alive=no
		if [ -f "$_oc_st" ]; then
			_oc_pid=$(jq -r '.watch.pid // empty' "$_oc_st" 2>/dev/null || true)
			[ -n "$_oc_pid" ] && _oc_alive=$(pid_alive "$_oc_pid")
		fi
		watch_report "$_oc_st" "$(now_iso)" "$_oc_alive" >/dev/null 2>&1 && _oc_cls=0 || _oc_cls=$?
		printf '%s %s\n' "$_oc_repo" "$_oc_cls"
	done
}

owed_repos() {
	# Which repositories obligate a watch right now. The two halves of the loop answer this
	# differently, and the difference is the one in .claude/forge-set's own header: the implementer
	# watches what it OPENED, so its set is self-describing and needs no file; the architect reviews
	# other people's work, so authorship cannot derive its set and the declared file is the answer.
	_or_gh=$1
	_or_mode=$2
	_or_author=$3
	_or_tmp=$(mktemp)
	if [ "$_or_mode" = author ]; then
		# Asked of the forge as a whole rather than of the declared set: a PR opened in a repository
		# nobody declared still obligates the session that opened it, and reading the set here would
		# quietly excuse exactly that case.
		if ! "$_or_gh" search prs --author "$_or_author" --state open --limit 50 \
			--json repository >"$_or_tmp" 2>"$_or_tmp.err"; then
			_or_why=$(head -1 "$_or_tmp.err" 2>/dev/null | cut -c1-120)
			rm -f "$_or_tmp" "$_or_tmp.err"
			die "could not ask the forge which PRs $_or_author has open: ${_or_why:-no_stderr_from_gh}
    REFUSING to answer. \"I could not look\" and \"nothing is owed\" are different sentences, and
    this tool exists because they were once printed identically."
		fi
		jq -r '.[].repository.nameWithOwner' "$_or_tmp" | sort -u
	else
		# THE WHOLE DECLARED SET, unconditionally — no queue query at all (quince#71).
		#
		# This used to list open PRs per repo and return only the non-empty ones, which made `owed
		# --all` accurate about the PRESENT and wrong as a FINISH CONDITION. It was faithful to
		# `/architect` §7, and §7 was the thing that was wrong: **an empty queue is not a legitimate
		# finish for a reviewer.** An implementer's set is what it authored and cannot change without
		# it; a reviewer's set is what ARRIVES, and nothing inside the session can know that nothing
		# further is coming.
		#
		# It was measured on both sides before it was ruled. Twice an architect overrode the gate,
		# armed against its "nothing owed", and a PR arrived within ~15 minutes (quince#69, quince#73).
		# Once an architect OBEYED it, stopped on an empty queue, and went dark with no watch — the gate
		# silent throughout, because by its own definition nothing was owed. Two overrides that were
		# right and one obedience that was wrong is a gate that is wrong in one direction only.
		#
		# It also removes a forge call from the hook's path, and that is not merely a saving: the
		# question "is a watch live on my declared set" is answerable entirely from local state, so
		# `owed --all` can no longer be wedged by an unreachable forge. The refusal it used to need —
		# "a queue that could not be read is not a queue that is empty" — is gone because the queue is
		# no longer read. That refusal was right for the question it was answering; the question changed.
		forge_set "$FORGE_SET_FILE"
	fi
	rm -f "$_or_tmp" "$_or_tmp.err"
}

owed_role() {
	# Which half of the loop is this box? Decided by the credential it holds, which is how the two
	# boxes already tell themselves apart (deploy/runner/preflight asserts the other's is absent), and
	# printed rather than assumed — a check that silently picks a role can silently pick the wrong one.
	if [ -f "${QUINCE_BOT_TOKEN_FILE:-$HOME/.config/quince/quince-bot.token}" ]; then
		printf 'implementer %s/bin/gh-bot author\n' "$(repo_root)"
	elif [ -f "${QUINCE_ARCH_TOKEN_FILE:-$HOME/.config/quince/quince-arch.token}" ]; then
		printf 'architect %s/bin/gh-arch all\n' "$(repo_root)"
	else
		printf 'none - -\n'
	fi
}

repo_root() {
	CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd
}

owed_arm_hint() {
	# The exact command, because "arm a watch" is the instruction that has already failed twice. A
	# message that makes the reader derive the invocation is a message that gets a different
	# invocation each time — which is how the loop that could not wake anybody got written.
	#
	# And therefore the SET is part of it, which the first version got wrong: it printed `--repo` to
	# both halves. The architect's canon is `--all` over the declared set, so an architect copying a
	# `--repo` line arms a watch SMALLER than its own declaration — precisely the failure
	# `.claude/forge-set` exists to prevent, and one already paid for once with a devlog PR sitting
	# unreviewed while the queue was reported clear (quince-devlog#3). Worse, the resulting state
	# SATISFIES this gate while half the declared set is unwatched, so a check would have been passed
	# by obeying its own remedy. A hint written against derivation cannot require the reader to
	# correct it.
	#
	# One line per owed repository on the implementer side, because its set is the PRs it opened; one
	# line total on the architect side, because `--all` covers the declaration however many
	# repositories are in it (the caller de-duplicates, so this collapses on its own).
	_oh_role=$1
	_oh_gh=$2
	_oh_repo=$3
	case "$_oh_role" in
	architect) printf 'bin/forge-watch watch --all --gh "%s" --interval 60\n' "$_oh_gh" ;;
	*) printf 'bin/forge-watch watch --repo %s --gh "%s" --interval 60\n' "$_oh_repo" "$_oh_gh" ;;
	esac
}

case "${1:-}" in
step)
	shift
	_s='' _o=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--observation)
			_o=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[ -n "$_s" ] && [ -n "$_o" ] || die "step needs --state and --observation"
	[ -f "$_s" ] || printf '{"observed":false}\n' >"$_s"
	step "$_s" "$_o"
	;;
tick)
	shift
	_s='' _repo=novkostya/quince _ghcmd="${FORGE_GH:-gh}" _wpid='' _iv=60 _all=no
	_imode=none _ispecs=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		--all)
			_all=yes
			shift
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--gh)
			_ghcmd=$2
			shift 2
			;;
		--watcher-pid)
			_wpid=$2
			shift 2
			;;
		--interval)
			_iv=$2
			shift 2
			;;
		--issue)
			_imode=replace
			_ispecs="$_ispecs $2"
			shift 2
			;;
		--no-issues)
			_imode=clear
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	issue_specs_ok "$_all" "$_ispecs" "$_repo"
	if [ "$_all" = yes ]; then
		[ -z "$_s" ] || die "--all derives one state file per repo; --state names a single one"
		require_gh "$_ghcmd"
		declare_all "$_imode" "$_ispecs"
		tick_all "$_ghcmd" "$_wpid" "$_iv"
		exit $?
	fi
	# --state is now optional: without it the path is derived from --repo, at a location that outlives
	# the session. It stays available because the fixtures and any second opinion need to point the
	# tool at a scratch file.
	[ -n "$_s" ] || _s=$(state_path_for "$_repo")
	mkdir -p "$(dirname "$_s")"
	case "$_wpid" in
	'') : ;;
	*[!0-9]*) die "--watcher-pid must be a pid: $_wpid" ;;
	esac
	case "$_iv" in *[!0-9]*) die "--interval must be seconds: $_iv" ;; esac
	require_gh "$_ghcmd"
	declare_issues "$_imode" "$_ispecs" "$_repo" "$_s"
	tick "$_s" "$_repo" "$_ghcmd" "$_wpid" "$_iv"
	;;
watch)
	shift
	_s='' _repo=novkostya/quince _ghcmd="${FORGE_GH:-gh}" _iv=60 _all=no _max=1200 _fail=3
	_imode=none _ispecs=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--issue)
			_imode=replace
			_ispecs="$_ispecs $2"
			shift 2
			;;
		--no-issues)
			_imode=clear
			shift
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		--all)
			_all=yes
			shift
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--gh)
			_ghcmd=$2
			shift 2
			;;
		--interval)
			_iv=$2
			shift 2
			;;
		--max-wait)
			_max=$2
			shift 2
			;;
		--fail-after)
			_fail=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	case "$_iv" in *[!0-9]* | '') die "--interval must be seconds: $_iv" ;; esac
	case "$_max" in *[!0-9]* | '') die "--max-wait must be seconds: $_max" ;; esac
	case "$_fail" in *[!0-9]* | '') die "--fail-after must be a count: $_fail" ;; esac
	# A zero interval is a busy loop against the forge, and a zero fail-after would exit before the
	# first tick could fail. Refused rather than clamped: a silent clamp is a cap nobody was told about.
	[ "$_iv" -ge 1 ] || die "--interval must be at least 1 second (got $_iv)"
	[ "$_fail" -ge 1 ] || die "--fail-after must be at least 1 (got $_fail)"
	require_gh "$_ghcmd"
	# Validated BEFORE the preflight, and before anything is written: a malformed --issue must not
	# leave half a declaration behind on the repos that happened to be processed first.
	issue_specs_ok "$_all" "$_ispecs" "$_repo"
	if [ "$_all" = yes ]; then
		[ -z "$_s" ] || die "--all derives one state file per repo; --state names a single one"
		# The set is read BEFORE the preflight so a malformed declaration fails here rather than
		# after the first repo has been reported healthy.
		for _r in $(forge_set "$FORGE_SET_FILE"); do
			watch_preflight "$(state_path_for "$_r")" "$_r"
		done
		declare_all "$_imode" "$_ispecs"
		# AFTER the declaration, because the interval floor is a function of how many issues the first
		# tick will fetch, and that is not known until the declaration is on disk.
		for _r in $(forge_set "$FORGE_SET_FILE"); do
			watch_arm "$(state_path_for "$_r")" "$_iv" "$_r"
		done
	else
		[ -n "$_s" ] || _s=$(state_path_for "$_repo")
		mkdir -p "$(dirname "$_s")"
		watch_preflight "$_s" "$_repo"
		declare_issues "$_imode" "$_ispecs" "$_repo" "$_s"
		watch_arm "$_s" "$_iv" "$_repo"
	fi
	watch_loop "$_all" "$_repo" "$_s" "$_ghcmd" "$_iv" "$_max" "$_fail"
	exit $?
	;;
status)
	shift
	_s='' _repo=novkostya/quince _now='' _all=no
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		--all)
			_all=yes
			shift
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--now)
			_now=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[ -n "$_now" ] || _now=$(now_iso)
	report_one() {
		_rs=$1
		_rr=$2
		_ra=no
		if [ -f "$_rs" ]; then
			_rp=$(jq -r '.watch.pid // empty' "$_rs" 2>/dev/null || true)
			[ -n "$_rp" ] && _ra=$(pid_alive "$_rp")
		fi
		printf 'forge-watch: repo=%s\n' "$_rr"
		watch_report "$_rs" "$_now" "$_ra"
	}
	if [ "$_all" = yes ]; then
		[ -z "$_s" ] || die "--all derives one state file per repo; --state names a single one"
		_set=$(forge_set "$FORGE_SET_FILE")
		# The WORST class is reported, not the first or the last: a session that re-armed one repo and
		# left another dead would otherwise read the reassuring line and stop.
		#
		# Ranking, worst first — wedged(5), dead(3), absent(4), live(0). Wedged outranks dead because it
		# is dead PLUS a live process that must be stopped before re-arming; dead outranks absent because
		# it is the one carrying accrued events on disk that a reseed would throw away. The per-repo
		# lines are all printed regardless, so the exit code narrows nothing — it only refuses to let the
		# best case speak for the set.
		_worst=0
		for _r in $_set; do
			report_one "$(state_path_for "$_r")" "$_r" || _c=$?
			_c=${_c:-0}
			case "$_c" in
			5) _worst=5 ;;
			3) [ "$_worst" = 5 ] || _worst=3 ;;
			4) case "$_worst" in 5 | 3) : ;; *) _worst=4 ;; esac ;;
			esac
			_c=0
		done
		exit "$_worst"
	fi
	[ -n "$_s" ] || _s=$(state_path_for "$_repo")
	report_one "$_s" "$_repo"
	;;
stop)
	# Verify-then-signal, in ONE place. The previous arrangement was a `status` that printed "STOP IT
	# FIRST" and a human or agent running `kill` afterwards — two steps joined by a sentence in a skill,
	# which is precisely the shape this whole unit exists to remove. An agent following that sentence
	# literally, on a box where the pid had been recycled, had no defence at all.
	#
	# Every branch that cannot PROVE the pid is our watcher refuses. `kill` returning success proves a
	# process died, not that the right one did.
	#
	# THE LIMIT OF THIS CHECK, stated because a claim that does not state its own limit is the thing
	# this file keeps being fixed for: verify-then-signal is two syscalls with a gap between them. If
	# the watcher exits after the start-time check and the kernel reuses its pid before the `kill`, the
	# signal lands on a bystander anyway. That race cannot be closed from userspace.
	#
	# What the verb buys is the size of the window, and the difference is not marginal: the old
	# arrangement was `status` printing "stop that pid" and an agent typing `kill` afterwards — a window
	# of however long a session takes to read a sentence and act, seconds to minutes, and the review
	# that produced this fix demonstrated a session using exactly that window to kill init. Here it is
	# microseconds between two syscalls, in one place, behind a refusal. Unbounded to syscall-scale.
	shift
	_s='' _repo=novkostya/quince
	while [ $# -gt 0 ]; do
		case "$1" in
		--state)
			_s=$2
			shift 2
			;;
		--repo)
			_repo=$2
			shift 2
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[ -n "$_s" ] || _s=$(state_path_for "$_repo")
	[ -f "$_s" ] || die "no watch state at $_s — nothing recorded to stop"
	_pid=$(jq -r '.watch.pid // empty' "$_s" 2>/dev/null || true)
	[ -n "$_pid" ] || die "no watcher pid recorded in $_s — nothing to stop"
	_was=$(jq -r '.watch.pid_start // empty' "$_s" 2>/dev/null || true)
	if [ "$(pid_alive "$_pid")" = no ]; then
		printf 'forge-watch: pid %s is already gone — nothing to stop. Re-arm from the state.\n' "$_pid"
		exit 0
	fi
	if [ -z "$_was" ]; then
		die "pid $_pid is running, but this state records no start time for it (armed by an older
    version, or procfs was unreadable at arm time). REFUSING to signal: a pid without a recorded
    start time cannot be shown to be our watcher rather than whatever reused its number. Identify
    it by hand before killing anything."
	fi
	_now_start=$(proc_start "$_pid")
	if [ -z "$_now_start" ]; then
		die "cannot read the start time of pid $_pid (no procfs, or not permitted). REFUSING to
    signal an unverified pid."
	fi
	if [ "$_now_start" != "$_was" ]; then
		die "pid $_pid HAS BEEN RECYCLED — recorded start $_was, actual $_now_start. That pid now
    belongs to something else. REFUSING to signal it; the watcher itself is gone, so treat this
    as \`dead\` and re-arm from the state."
	fi
	kill "$_pid" 2>/dev/null || die "pid $_pid verified as our watcher, but the signal failed"
	printf 'forge-watch: stopped watcher pid=%s repo=%s (start time %s matched)\n' "$_pid" "$_repo" "$_was"
	;;
owed)
	shift
	_ghcmd='' _mode='' _author='@me' _hook=no
	while [ $# -gt 0 ]; do
		case "$1" in
		--author)
			_mode=author
			_author=$2
			shift 2
			;;
		--all)
			_mode=all
			shift
			;;
		--gh)
			_ghcmd=$2
			shift 2
			;;
		--set-file)
			FORGE_SET_FILE=$2
			shift 2
			;;
		--hook)
			_hook=yes
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
	done

	# owed_role prints one line of three fields; read out with cut rather than `set --`, because
	# splitting on IFS is how a path with a space becomes two arguments and nobody notices until it is
	# somebody's home directory.
	_roleline=$(owed_role)
	_role=$(printf '%s' "$_roleline" | cut -d' ' -f1)
	_rolegh=$(printf '%s' "$_roleline" | cut -d' ' -f2)
	_rolemode=$(printf '%s' "$_roleline" | cut -d' ' -f3)

	if [ "$_hook" = yes ]; then
		# The Stop-hook dialect of the same question. It speaks the harness's protocol — JSON in on
		# stdin, JSON out on stdout — and it lives here rather than in a separate script because the
		# predicate and its adapter are one claim, and because a file outside $(SH_ENTRYPOINTS) is a
		# file shellcheck never sees.
		_payload=$(cat)
		_active=$(printf '%s' "$_payload" | jq -r '.stop_hook_active // false' 2>/dev/null || printf 'false')
		if [ "$_role" = none ]; then
			# FAIL OPEN, LOUDLY. A hook that blocked because it could not check would wedge every
			# session in the repository on a box with no forge credential; a hook that returned silence
			# would be the omission it exists to catch, one level up. So it says what it could not do.
			jq -n '{systemMessage: "forge-watch owed: no forge credential on this box, so whether a watch is owed was NOT checked. Nothing is being claimed about it."}'
			exit 0
		fi
		# Split, never piped: a pipeline's status is its LAST command's, so asking the forge inside one
		# would turn "I could not look" into "nothing is owed" — the exact substitution this whole tool
		# exists to prevent, and a trap `tick` already documents one level up.
		_hr=$(mktemp)
		if ! owed_repos "$_rolegh" "$_rolemode" "$_author" >"$_hr" 2>"$_hr.err"; then
			jq -n --arg d "$(cat "$_hr.err")" '{systemMessage: ("forge-watch owed: the check itself failed, so whether a watch is owed is UNKNOWN — which is not the same as \"none\".\n" + $d)}'
			rm -f "$_hr" "$_hr.err"
			exit 0
		fi
		owed_classify <"$_hr" >"$_hr.tab"
		if [ ! -s "$_hr.tab" ]; then
			rm -f "$_hr" "$_hr.err" "$_hr.tab"
			exit 0
		fi
		_hout=$(owed_decide "$_hr.tab" "$_rolemode") && _hrc=0 || _hrc=$?
		rm -f "$_hr" "$_hr.err" "$_hr.tab"
		if [ "$_hrc" = 0 ]; then exit 0; fi
		# The hints are built from the OWED rows themselves, so the message names the real
		# repositories rather than a placeholder the reader has to fill in — and `sort -u` is what
		# collapses the architect's N repositories to the single `--all` line its canon calls for.
		_hhint=$(printf '%s\n' "$_hout" | awk '/^OWED/ {print $2}' | while read -r _hrepo; do
			owed_arm_hint "$_role" "$_rolegh" "$_hrepo"
		done | sort -u | sed 's/^/    /')
		# NEUTRAL about WHY, deliberately, and that is the structural half of the fix rather than a
		# preference. The reason a watch is owed differs by half — open PRs for the implementer, the
		# declared set for the reviewer (quince#71) — and this headline stated one of them as a
		# constant. It was true for the half it was written for and became routinely false for the
		# other the moment `owed --all` stopped consulting the queue: after quince#71 a reviewer is
		# blocked on an empty queue *as the normal case*, and was told every time that it had open PRs.
		#
		# The fix is not to switch this line on the mode as well. The defect exists BECAUSE the reason
		# lived in two places and only one of them was updated; adding a second mode-dependent copy
		# recreates the condition that produced it. So the reason is stated ONCE, in the OWED rows
		# immediately below, which are already mode-aware and already name the repositories. The
		# headline carries the VERDICT, which is the same for both halves and cannot drift.
		_msg="A WATCH IS OWED AND IS NOT LIVE — you are about to end a turn with nothing that can wake you.

$_hout

Arm it as a BACKGROUND task (run_in_background):

$_hhint

The loop must exit when it finds something; a loop that cannot exit cannot wake you, which is why this is a verb and not a loop you write (quince#62). If you have genuinely finished — everything merged, or a stop that is the Operator's — say so and end the turn again: this blocks once, and the second time it tells the human instead of you."
		if [ "$_active" = true ]; then
			# Blocked once already. Do NOT block again: a Stop hook that always blocks is a session
			# that can never end, and the goal was never to make stopping impossible — only to make an
			# unwatched stop impossible to do SILENTLY. So the second attempt is allowed, and the human
			# is told, which is the whole of "make the absence detectable".
			# "AN UNWATCHED PR" was the same mistake one line further on, and this copy is the one that
			# reaches a HUMAN. A reviewer blocked under quince#71 may have no PR at all — the whole
			# point is that the declared set owes a watch regardless — so the escalation would have
			# told the Operator about a PR that does not exist. Same fix: the verdict here, the reason
			# in $d.
			jq -n --arg d "$_hout" '{systemMessage: ("forge-watch owed: this session is ENDING A TURN WITH NO LIVE WATCH after being told once.\n" + $d)}'
			exit 0
		fi
		jq -n --arg r "$_msg" '{decision: "block", reason: $r}'
		exit 0
	fi

	[ -n "$_mode" ] || die "owed needs --author <login|@me> (the implementer half: the PRs you opened)
    or --all (the architect half: the declared set). It is not defaulted, because the two halves owe
    watches over different sets and guessing which you are would answer a question you did not ask."
	[ -n "$_ghcmd" ] || _ghcmd=$_rolegh
	[ "$_ghcmd" != - ] || die "no forge credential on this box, and no --gh given — nothing to ask."
	require_gh "$_ghcmd"
	_or=$(mktemp)
	owed_repos "$_ghcmd" "$_mode" "$_author" >"$_or"
	owed_classify <"$_or" >"$_or.tab"
	if [ ! -s "$_or.tab" ]; then
		printf 'forge-watch: nothing owed — no open PRs authored by this session, so no watch is owed for them.\n    (This branch is the IMPLEMENTER half only. The reviewer half always owes a watch on its declared set,\n     queue or no queue — quince#71.)\n'
		rm -f "$_or" "$_or.tab"
		exit 0
	fi
	owed_decide "$_or.tab" "$_mode" && _orc=0 || _orc=$?
	rm -f "$_or" "$_or.tab"
	exit "$_orc"
	;;
replay)
	shift
	[ $# -gt 0 ] || die "replay needs at least one fixture"
	replay "$@"
	;;
'' | -h | --help | help) usage ;;
*)
	usage >&2
	die "unknown verb: $1"
	;;
esac
