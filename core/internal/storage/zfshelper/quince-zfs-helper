#!/bin/sh
# quince-zfs-helper — the only command quince may run here. It cannot destroy a dataset.
set -eu
PARENT="pool/path/to/iphone-backup"

# Unquoted on purpose: ssh delivers the request as one string, so this split IS the arg parsing.
# shellcheck disable=SC2086
set -- $SSH_ORIGINAL_COMMAND
op="${1:-}"
target=""; for a in "$@"; do target="$a"; done
case "$op" in
  create)   case "$target" in "$PARENT"/*)
              # Checked first: `zfs create -p` silently builds a whole tree from a typo in PARENT.
              pmp=$(zfs get -H -o value mountpoint "$PARENT" 2>/dev/null) || pmp=""
              [ -n "$pmp" ] && [ -d "$pmp" ] || {
                echo "quince-zfs-helper: no such mounted dataset: $PARENT — check the PARENT= line" >&2
                exit 1; }
              zfs create -p "$target" || exit 1
              # A new dataset is host-root-owned; quince may be a userns-mapped root that cannot write it.
              ctuid=$(stat -c %u "$pmp")
              chown "$ctuid:$ctuid" "$(zfs get -H -o value mountpoint "$target")"
              exit 0 ;; esac ;;
  snapshot) case "$target" in "$PARENT"/*@quince-*) exec zfs snapshot "$target" ;; esac ;;
  destroy)  case "$target" in "$PARENT"/*@quince-*) exec zfs destroy "$target" ;; esac ;;
            # No -r, and the parse drops flags, so rollback cannot reach anything but the newest snapshot.
  rollback) case "$target" in "$PARENT"/*@quince-*) exec zfs rollback "$target" ;; esac ;;
  list)     case "$target" in "$PARENT"|"$PARENT"/*) exec zfs list -t snapshot -H -o name -r "$target" ;; esac ;;
  capacity) exec zfs list -H -p -o used,available "$PARENT" ;;
esac
echo "quince-zfs-helper: refused: $SSH_ORIGINAL_COMMAND" >&2
exit 1
