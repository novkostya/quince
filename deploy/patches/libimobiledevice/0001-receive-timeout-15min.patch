diff --git a/src/property_list_service.c b/src/property_list_service.c
index 2fca4e7..6a67ff8 100644
--- a/src/property_list_service.c
+++ b/src/property_list_service.c
@@ -269,7 +269,10 @@ property_list_service_error_t property_list_service_receive_plist_with_timeout(p
 
 property_list_service_error_t property_list_service_receive_plist(property_list_service_client_t client, plist_t *plist)
 {
-	return internal_plist_receive_timeout(client, plist, 30000);
+	/* quince qn.6b patch (upstream #1413): default receive timeout 30s -> 15min so a slow
