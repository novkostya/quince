#!/bin/sh
# storageless-smoke — drive a REAL container through the whole first-run path (qn.6e).
#
# WHY THIS EXISTS, and it is not "more coverage". The first-run path was proven in two halves that
# never met: the daemon's refusal in Go, the client's routing in Playwright with `/api/config`
# intercepted. Nothing started a real quince with no config and used it.
#
# THAT GAP HID TWO BUGS IN ONE DAY, both found by hand rather than by a gate:
#
#   1. An Operator following a PR's click-list got `no such endpoint: /api/config/storage` — the
#      demo had been rebuilt from a branch that predated the route.
#   2. `POST /api/config/storage` returned 422 on a fresh install, so THE FIRST STORAGE COULD NEVER
#      BE ADDED and the entire first-run path was unreachable. Six green unit tests covered that
#      endpoint; every one of them seeded a storage first, so none added the first.
#
# The second is the shape this guards: a missing STARTING STATE, which no amount of reading the test
# list reveals, because each test looks complete and the fixture they share is what is wrong.
#
# IT REFUSES RATHER THAN SKIPS when it cannot run, which is the same discipline privacy-check and
# gates-sh follow: exit 2 is DID NOT RUN and is never a clean result.
set -eu

RUNTIME="${RUNTIME:-}"
if [ -z "$RUNTIME" ]; then
	for c in nerdctl docker podman; do
		if command -v "$c" >/dev/null 2>&1; then RUNTIME=$(command -v "$c"); break; fi
	done
fi
if [ -z "$RUNTIME" ]; then
	echo "storageless-smoke: DID NOT RUN — no container runtime (nerdctl/docker/podman)." >&2
	echo "  This is NOT a clean result. Nothing was smoked." >&2
	exit 2
fi

IMAGE="${IMAGE:-quince:local}"
NAME="storageless-smoke-$$"
# THE SECOND ARM'S CONTAINER (quince#817). A storageless start has TWO causes — no config at all,
# and a config that no longer parses — and they present as one symptom. They need two containers,
# because the cause is a file that has to exist before the daemon starts.
NAME2="$NAME-invalid"
# THE THIRD ARM'S CONTAINER, declared HERE rather than beside its arm so `cleanup` can name it. The
# trap body expands at exit time and `set -u` is on, so a run that dies before the third arm would
# fail inside its own cleanup on an unset variable — leaving the first two containers behind.
NAME3="$NAME-unreadable"
WORK=$(mktemp -d)
PORT="${PORT:-0}"

cleanup() {
	"$RUNTIME" rm -f "$NAME" >/dev/null 2>&1 || true
	"$RUNTIME" rm -f "$NAME2" >/dev/null 2>&1 || true
	"$RUNTIME" rm -f "$NAME3" >/dev/null 2>&1 || true
	rm -rf "$WORK"
}
trap cleanup EXIT INT TERM

if [ "$PORT" = "0" ]; then
	# A FREE PORT, not a fixed one: two runners share this box, and a fixed port makes one smoke
	# fail as though the product were broken — the most expensive possible disguise.
	PORT=$(awk 'BEGIN{srand();print 20000+int(rand()*20000)}')
fi
PORT2=$((PORT + 1))

mkdir -p "$WORK/data" "$WORK/cache" "$WORK/invalid-data" "$WORK/invalid-cache"

# LOGFROM is which container's log a failure dumps. It exists because there are two arms now: a
# failure in the second one that printed the FIRST container's log would send a reader to a healthy
# daemon and read as "the log says nothing is wrong".
LOGFROM="$NAME"
fail() {
	echo "storageless-smoke: FAILED — $1" >&2
	echo "--- container log ($LOGFROM) ---" >&2
	"$RUNTIME" logs "$LOGFROM" 2>&1 | tail -30 >&2
	exit 1
}

# status URL OUTFILE [JAR] — the JAR is not optional decoration: without it an "authenticated"
# check is anonymous and answers 401, which reads as the guard working when it is the test that is
# broken. Cost me one run to find, which is the argument for naming it here.
status() {
	if [ -n "${3:-}" ]; then curl -s -b "$3" -o "$2" -w "%{http_code}" "$1"; else curl -s -o "$2" -w "%{http_code}" "$1"; fi
}

echo "storageless-smoke: image=$IMAGE port=$PORT data=$WORK/data (EMPTY — no config.yml)"

# NO config.yml, WHICH IS THE POINT. A fresh install has none, and quince used to refuse to start.
"$RUNTIME" run -d --name "$NAME" -p "$PORT":8968 \
	-e QUINCE_DATA=/data -e QUINCE_CACHE=/cache -e QUINCE_LISTEN=:8968 \
	-v "$WORK/data":/data -v "$WORK/cache":/cache \
	"$IMAGE" serve >/dev/null || fail "could not start the container"

# Wait for the port rather than sleeping a guess: a slow box must not read as a broken daemon.
i=0
while [ "$i" -lt 60 ]; do
	if [ "$(status "http://127.0.0.1:$PORT/api/health" /dev/null)" = "200" ]; then break; fi
	i=$((i + 1))
	sleep 1
done
[ "$i" -lt 60 ] || fail "the daemon never answered /api/health — it exited rather than serving"
echo "  ok  it SERVES with no storage declared, rather than exiting"

# The setup state must not leak to a stranger: the guard runs after auth, deliberately.
code=$(status "http://127.0.0.1:$PORT/api/devices" /dev/null)
[ "$code" = "401" ] || fail "unauthenticated /api/devices = $code, want 401 (setup state must not be public)"
echo "  ok  an unauthenticated caller gets 401, not the setup state"

JAR="$WORK/jar"
csrf() { curl -s -b "$JAR" -c "$JAR" "http://127.0.0.1:$PORT/api/auth/status" | sed 's/.*"csrf_token":"\([^"]*\)".*/\1/'; }

t=$(csrf)
curl -s -b "$JAR" -c "$JAR" -o /dev/null -X POST -H 'Content-Type: application/json' \
	-H "X-CSRF-Token: $t" -d '{"password":"smoketest1"}' \
	"http://127.0.0.1:$PORT/api/auth/setup" || fail "could not set the admin password"
t=$(csrf)

code=$(status "http://127.0.0.1:$PORT/api/devices" "$WORK/dev.json" "$JAR")
[ "$code" = "503" ] || fail "authenticated /api/devices = $code, want 503 while storageless"
grep -q storage_required "$WORK/dev.json" || fail "the 503 did not carry storage_required"
echo "  ok  the API refuses outside setup, with storage_required"

code=$(curl -s -b "$JAR" -o "$WORK/probe.json" -w '%{http_code}' -X POST \
	-H 'Content-Type: application/json' -H "X-CSRF-Token: $t" \
	-d '{"path":"/cache"}' "http://127.0.0.1:$PORT/api/storages/probe")
[ "$code" = "200" ] || fail "the storage probe = $code, want 200 — the form cannot work without it"
echo "  ok  the probe answers, so the first-run form can be filled in"

# NO WARNINGS ON THIS ARM, and it is half of a PAIR — the other half is the invalid-config arm at
# the foot of this file (quince#817). Neither assertion means much alone: "warnings is empty" is
# only interesting beside a start where it is not, which is what makes the two causes of a
# storageless start distinguishable to anything that reads them.
curl -s -b "$JAR" -o "$WORK/cfg-empty.json" "http://127.0.0.1:$PORT/api/config" \
	|| fail "GET /api/config failed on a fresh install"
warns=$(jq -r '.warnings | length' "$WORK/cfg-empty.json")
[ "$warns" = "0" ] || fail "a fresh install reports $warns config warning(s), want 0 — $(jq -c .warnings "$WORK/cfg-empty.json")"
echo "  ok  a fresh install carries NO config warnings (the other half of the pair below)"

# THE WRITE THAT ENDS THE MODE, and the case six unit tests never covered: the FIRST storage, into a
# config that has none.
code=$(curl -s -b "$JAR" -o "$WORK/add.json" -w '%{http_code}' -X POST \
	-H 'Content-Type: application/json' -H "X-CSRF-Token: $t" \
	-d '{"name":"first","path":"/cache","backend":"copy"}' \
	"http://127.0.0.1:$PORT/api/config/storage")
[ "$code" = "200" ] || fail "adding THE FIRST storage = $code, want 200 — $(cat "$WORK/add.json")"
echo "  ok  the FIRST storage can be added"

# NO RESTART. The mode is derived from the live config, so it clears in the same process.
code=$(status "http://127.0.0.1:$PORT/api/devices" /dev/null "$JAR")
[ "$code" = "200" ] || fail "/api/devices after the add = $code, want 200 — the mode did not clear"
echo "  ok  the setup mode ends in the SAME PROCESS, with no restart"

# THE IMPLICATION IS A FACT ABOUT THE RESOLVED CONFIG, NOT ABOUT THE FILE (qn.6j, quince#728).
#
# This grepped `config.yml` for `default: true`, and its ok line said "written to config.yml". The
# Operator ruled on 2026-08-08 that the file carries ONLY WHAT WAS SET — a lone storage's default is
# IMPLIED, so nobody set it and the file must not say it. `ResolveStorages` re-implies it at every
# parse, which is where the guarantee actually lives.
#
# Asserting the file was always the weaker check: it proved a value reached disk, where what anything
# depends on is that a backup naming no storage resolves to one. That is asserted directly now, from
# the add response the caller already holds.
default_seen=$(jq -r '.config.storage[0].default' "$WORK/add.json")
[ "$default_seen" = "true" ] || fail "the lone storage is not default in the API's view (got '$default_seen') — a backup naming no storage would resolve to nothing"
echo "  ok  the lone storage is default by implication, in the resolved config"

# AND THE TIDY HALF, which nothing else checks end to end. This is the only place the FIRST-RUN FILE
# is examined on a real container, and that file is the one most users will ever read.
if grep -q 'default: true' "$WORK/data/config.yml"; then
	fail "config.yml carries an implied default nobody set — qn.6j: the file contains only what was set
$(cat "$WORK/data/config.yml")"
fi
for ghost in 'zfs:' 'retention:' 'preferred_transport'; do
	if grep -q "$ghost" "$WORK/data/config.yml"; then
		fail "config.yml carries '$ghost', which the caller never sent — the first-run file is inflated
$(cat "$WORK/data/config.yml")"
	fi
done
echo "  ok  the first-run config.yml carries only what the caller sent"


# ── THE SECOND CAUSE OF A STORAGELESS START: A CONFIG THAT NO LONGER PARSES (quince#817) ──────────
#
# quince#793 retired `storage.zfs.mode: exec` and made a config carrying it invalid. The REFUSAL was
# measured at `config validate`; what nobody had watched was a running daemon meeting that file. The
# reasoning was read off `NewService` → `Default()` (which leaves `Storage` nil) → `CheckStorages`,
# and every step of it was read rather than executed.
#
# IT IS GATED HERE RATHER THAN IN ITS OWN TARGET because `storageless-smoke` is a separate CI step
# and no agent seat can push a workflow (quince#113) — an arm costs nothing to wire, a new target
# costs a `.github/workflows/**` write that would have to be relayed to the Operator.
#
# quince#818 IS WHY THIS IS WORTH A GATE RATHER THAN A ONE-OFF MEASUREMENT. That rung retires a
# SECOND key — `hook_cmd`, replaced by structured `ssh_*` — with the same refusal shape, so every
# existing zfs install restarts into exactly this path on upgrade. Whatever this arm proves for one
# retired key it proves for both; if it ever stops being true, an upgrade finds out on somebody's
# install instead of here.
echo "storageless-smoke: second arm — a config that carries the retired \`zfs.mode: exec\`"

cat > "$WORK/invalid-data/config.yml" <<'YML'
storage:
  - path: /cache
    backend: zfs
    zfs:
      parent_dataset: pool/backups
      mode: exec
      hook_cmd: /usr/local/bin/quince-zfs-helper
YML

LOGFROM="$NAME2"
"$RUNTIME" run -d --name "$NAME2" -p "$PORT2":8968 \
	-e QUINCE_DATA=/data -e QUINCE_CACHE=/cache -e QUINCE_LISTEN=:8968 \
	-v "$WORK/invalid-data":/data -v "$WORK/invalid-cache":/cache \
	"$IMAGE" serve >/dev/null || fail "could not start the container with an invalid config"

i=0
while [ "$i" -lt 60 ]; do
	if [ "$(status "http://127.0.0.1:$PORT2/api/health" /dev/null)" = "200" ]; then break; fi
	i=$((i + 1))
	sleep 1
done
# IT MUST NOT EXIT. An invalid config is the operator's to fix through the UI, and a daemon that
# dies on one takes away the only surface that could tell them what is wrong.
[ "$i" -lt 60 ] || fail "the daemon never answered /api/health against an invalid config — it exited rather than serving"
echo "  ok  it SERVES against an invalid config, rather than exiting"

code=$(status "http://127.0.0.1:$PORT2/api/devices" /dev/null)
[ "$code" = "401" ] || fail "unauthenticated /api/devices = $code, want 401 (an invalid config must not make the setup state public)"
echo "  ok  an unauthenticated caller still gets 401"

JAR2="$WORK/jar2"
t2=$(curl -s -b "$JAR2" -c "$JAR2" "http://127.0.0.1:$PORT2/api/auth/status" | sed 's/.*"csrf_token":"\([^"]*\)".*/\1/')
curl -s -b "$JAR2" -c "$JAR2" -o /dev/null -X POST -H 'Content-Type: application/json' \
	-H "X-CSRF-Token: $t2" -d '{"password":"smoketest1"}' \
	"http://127.0.0.1:$PORT2/api/auth/setup" || fail "could not set the admin password on the invalid-config daemon"

code=$(status "http://127.0.0.1:$PORT2/api/devices" "$WORK/dev2.json" "$JAR2")
[ "$code" = "503" ] || fail "authenticated /api/devices = $code, want 503 — an unusable config must reach the same setup state"
grep -q storage_required "$WORK/dev2.json" || fail "the 503 did not carry storage_required"
echo "  ok  it lands in the setup state, with storage_required"

# THE ASSERTION THIS ARM EXISTS FOR. `Default()` leaves `Storage` nil, so *nil storage* is
# indistinguishable from *never declared one* unless the warnings carry the real cause through —
# quince#508 built that distinction, and this is what proves the wiring delivers it. Without this,
# an operator is told "no storage declared" when the truth is "one line of your config is no longer
# legal", which is a two-cause-one-symptom collapse this project has paid for before (quince#799).
curl -s -b "$JAR2" -o "$WORK/cfg-invalid.json" "http://127.0.0.1:$PORT2/api/config" \
	|| fail "GET /api/config failed on the invalid-config daemon"
got=$(jq -r '[.warnings[] | select(.path == "storage[0].zfs.mode")] | length' "$WORK/cfg-invalid.json")
[ "$got" = "1" ] || fail "no warning names storage[0].zfs.mode — the cause reaches the log and nothing else
$(jq -c .warnings "$WORK/cfg-invalid.json")"
jq -r '.warnings[] | select(.path == "storage[0].zfs.mode") | .message' "$WORK/cfg-invalid.json" \
	| grep -q 'must be one of \[hook\]' \
	|| fail "the warning does not carry the daemon's own remedy — a path with no message is a code, not an answer"
echo "  ok  the CAUSE is surfaced over the API, naming storage[0].zfs.mode and its remedy"

# AND THE FILE ITSELF COMES BACK, which is what any surface showing the operator their mistake has
# to render (contracts §6: `file_text` is the file as it is on disk, read at request time).
grep -q 'mode: exec' "$WORK/cfg-invalid.json" || fail "file_text does not carry the operator's own config"
echo "  ok  file_text carries the offending file, so a surface has something to show"

# THE ADD IS REFUSED, AND THE FILE SURVIVES IT (quince#852, Operator ruling 2026-08-12).
#
# THIS IS THE ASSERTION THE BUG WAS FOUND BY. It returned `200` here and left `config.yml` holding
# only the new entry — the zfs storage, its parent dataset and its hook command gone, no undo, and
# `warnings: []` in the response so every surface then reported health. It is gated end to end rather
# than only in Go because that is how it was found: `config.AddStorage`'s unit tests all seeded a
# valid config, so none of them was ever in this state.
t2=$(curl -s -b "$JAR2" -c "$JAR2" "http://127.0.0.1:$PORT2/api/auth/status" | sed 's/.*"csrf_token":"\([^"]*\)".*/\1/')
code=$(curl -s -b "$JAR2" -o "$WORK/add-invalid.json" -w '%{http_code}' -X POST \
	-H 'Content-Type: application/json' -H "X-CSRF-Token: $t2" \
	-d '{"name":"rescue","path":"/cache","backend":"copy"}' \
	"http://127.0.0.1:$PORT2/api/config/storage")
[ "$code" = "422" ] || fail "adding a storage over a DISCARDED config = $code, want 422 — this write replaces the operator's file
$(cat "$WORK/add-invalid.json")"
echo "  ok  the add is REFUSED rather than replacing a config quince could not read"

# THE REFUSAL NAMES THE LINE AND A REMEDY — `qn.6g`: a remedy the user cannot follow is the same
# defect as a silent failure, so a bare "config invalid" would be this bug in a politer form.
jq -e '.errors[0].path == "storage[0].zfs.mode"' "$WORK/add-invalid.json" >/dev/null \
	|| fail "the refusal is not keyed on the offending config path — $(jq -c .errors "$WORK/add-invalid.json")"
jq -r '.errors[0].message' "$WORK/add-invalid.json" | grep -q 'restart' \
	|| fail "the refusal does not tell the operator what to do — $(jq -r '.errors[0].message' "$WORK/add-invalid.json")"
echo "  ok  it names the offending line and the remedy, not just 'invalid'"

# AND THE DECLARATION IS STILL ON DISK. Asserted on the FILE, because the file is what was lost —
# a refusal that returned 422 and wrote anyway would pass every check above this one.
grep -q 'parent_dataset: pool/backups' "$WORK/invalid-data/config.yml" \
	|| fail "the operator's declaration was rewritten by a REFUSED add
$(cat "$WORK/invalid-data/config.yml")"
grep -q 'hook_cmd:' "$WORK/invalid-data/config.yml" \
	|| fail "the operator's hook_cmd is gone from config.yml after a refused add
$(cat "$WORK/invalid-data/config.yml")"
echo "  ok  config.yml is untouched — the declaration survives the refusal"

# ── THIRD ARM: A DISCARD WITH NO `Errors` AT ALL ──────────────────────────────────────────────────
#
# `Load` has THREE discard paths and only ONE fills `Errors` — an unreadable file and invalid YAML
# both return `OK: false` with it empty. quince#852's first fix keyed its guard on the error list, so
# it covered one of the three and let the others through to the write. Measured on a real container
# before this arm existed: an unreadable `config.yml` served with `errors=0` and the add reached
# `AtomicWrite`, answering `500` where a refused add answers `422`.
#
# A DIRECTORY AT THE CONFIG PATH is how this is reached honestly: `os.Stat` succeeds, so `Load` gets
# past the no-file case, and `os.ReadFile` fails. Permissions would not do it — the container runs as
# root, where a mode of 000 is still readable.
#
# WHAT IS ASSERTED IS THE STATUS, NOT THE FILE, and the difference is the point: on this path the
# write would fail anyway, since nothing can rename over a directory — so a 500 and a 422 leave the
# same bytes on disk. **Only the status distinguishes a guard that fired from a write that failed**,
# and it is the guard that has to hold on the paths where the write WOULD have succeeded.
echo "storageless-smoke: third arm — a config that cannot be read at all (warnings, no \`Errors\`)"

PORT3=$((PORT + 2))
# A DIRECTORY where the config file goes — `os.Stat` succeeds, `os.ReadFile` fails.
mkdir -p "$WORK/unread-data/config.yml" "$WORK/unread-cache"

LOGFROM="$NAME3"
"$RUNTIME" run -d --name "$NAME3" -p "$PORT3":8968 \
	-e QUINCE_DATA=/data -e QUINCE_CACHE=/cache -e QUINCE_LISTEN=:8968 \
	-v "$WORK/unread-data":/data -v "$WORK/unread-cache":/cache \
	"$IMAGE" serve >/dev/null || fail "could not start the container with an unreadable config"

i=0
while [ "$i" -lt 60 ]; do
	if [ "$(status "http://127.0.0.1:$PORT3/api/health" /dev/null)" = "200" ]; then break; fi
	i=$((i + 1))
	sleep 1
done
[ "$i" -lt 60 ] || fail "the daemon never answered /api/health with an unreadable config"
echo "  ok  it SERVES — so the add endpoint is reachable in this state"

JAR3="$WORK/jar3"
t3=$(curl -s -b "$JAR3" -c "$JAR3" "http://127.0.0.1:$PORT3/api/auth/status" | sed 's/.*"csrf_token":"\([^"]*\)".*/\1/')
curl -s -b "$JAR3" -c "$JAR3" -o /dev/null -X POST -H 'Content-Type: application/json' \
	-H "X-CSRF-Token: $t3" -d '{"password":"smoketest1"}' \
	"http://127.0.0.1:$PORT3/api/auth/setup" || fail "could not set the admin password on the unreadable-config daemon"
t3=$(curl -s -b "$JAR3" -c "$JAR3" "http://127.0.0.1:$PORT3/api/auth/status" | sed 's/.*"csrf_token":"\([^"]*\)".*/\1/')

# THE CAUSE IS IN `warnings` WHILE `Errors` IS EMPTY — the exact shape that defeated the first guard.
curl -s -b "$JAR3" -o "$WORK/cfg-unread.json" "http://127.0.0.1:$PORT3/api/config" \
	|| fail "GET /api/config failed on the unreadable-config daemon"
jq -e '.warnings | length > 0' "$WORK/cfg-unread.json" >/dev/null \
	|| fail "no warning names the unreadable config — the cause reached the log and nothing else"
echo "  ok  the cause is carried in warnings, where every discard path puts it"

code=$(curl -s -b "$JAR3" -o "$WORK/add-unread.json" -w '%{http_code}' -X POST \
	-H 'Content-Type: application/json' -H "X-CSRF-Token: $t3" \
	-d '{"name":"rescue","path":"/cache","backend":"copy"}' \
	"http://127.0.0.1:$PORT3/api/config/storage")
[ "$code" = "422" ] || fail "adding a storage over an UNREADABLE config = $code, want 422 — a 500 means the guard did not fire and the write was attempted
$(cat "$WORK/add-unread.json")"
jq -r '.errors[0].message' "$WORK/add-unread.json" | grep -q 'restart' \
	|| fail "the refusal does not tell the operator what to do — $(cat "$WORK/add-unread.json")"
echo "  ok  the add is REFUSED on a discard carrying no \`Errors\`, and still names a remedy"

echo "storageless-smoke: clean — a fresh install reaches a working storage without a restart, and
  every way a config can be DISCARDED refuses the add rather than replacing the file"
