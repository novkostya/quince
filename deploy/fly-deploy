#!/bin/sh
# fly-deploy — deploy the public demo to fly.io with the pins deploy/Dockerfile needs.
#
# WHY THIS EXISTS, because `flyctl deploy --remote-only` looks like it should be enough.
#
# flyctl knows nothing about versions.env, so every ARG the Dockerfile declares WITHOUT a
# default arrives empty. The first real deploy died on it (quince#494), and the error names
# nothing that is actually wrong:
#
#   RUN git clone --depth 1 --branch ${NETMUXD_REF} https://github.com/jkcoxson/netmuxd /src/netmuxd
#   fatal: repository '/src/netmuxd' does not exist
#
# With NETMUXD_REF empty, `--branch` swallows the URL and git reads the DESTINATION as the
# repository to clone. So an unset build-arg presents as "that repository does not exist",
# pointing at the one path in the line that is not the problem.
#
# Four ARGs were empty: NETMUXD_REF, LIBIMOBILEDEVICE_REF, GOLANGCI_LINT_VERSION, PNPM_VERSION.
# The image-ref ARGs (GO_IMAGE, ALPINE_IMAGE, …) carry defaults in the Dockerfile and so worked
# silently, which is why the build got far enough to look healthy before it failed.
#
# THE ARG LIST IS DERIVED FROM THE DOCKERFILE, not hand-written here. A hand-written list is
# how this recurs: someone adds an ARG, every other build path supplies it, and only the demo
# deploy is silently short one value. Reading `^ARG` from the Dockerfile means a new ARG is
# either found in versions.env or REPORTED below — never quietly empty.
#
# versions.env stays the single source of the values, which is what its own header claims it is.
set -eu

cd "$(dirname "$0")/.."

[ -f versions.env ] || {
	echo "fly-deploy: versions.env not found — run this from a quince checkout" >&2
	exit 2
}
[ -f deploy/Dockerfile ] || {
	echo "fly-deploy: deploy/Dockerfile not found — run this from a quince checkout" >&2
	exit 2
}
command -v flyctl >/dev/null 2>&1 || {
	echo "fly-deploy: flyctl is not on PATH. This runs where flyctl is installed and" >&2
	echo "            authenticated — a CI runner, or the Operator's machine. It is NOT" >&2
	echo "            expected to work on a session box (deploy/demo.md)." >&2
	exit 2
}

set --
defaulted=''
# Fed by HERE-DOC rather than by a pipe, on purpose. `… | while read` runs the loop body in a
# SUBSHELL, so every `set --` below would be discarded at the `done` and the deploy would carry no
# build-args at all — this script's own bug, reintroduced by the obvious fix for shellcheck's
# SC2013. Here-doc redirection keeps the loop in this shell, and satisfies SC2013 honestly rather
# than by silencing it.
while IFS= read -r name; do
	[ -n "$name" ] || continue
	# The first match wins, matching `.`-sourcing semantics; the pattern is not anchored past
	# `=`, so a value that itself contains `=` survives intact.
	value=$(sed -n "s/^${name}=//p" versions.env | head -n 1)
	if [ -n "$value" ]; then
		set -- "$@" --build-arg "${name}=${value}"
	else
		defaulted="$defaulted $name"
	fi
done <<EOF
$(sed -n 's/^ARG \([A-Za-z_][A-Za-z0-9_]*\).*/\1/p' deploy/Dockerfile | sort -u)
EOF

# An ARG with no versions.env entry keeps the Dockerfile's own default, which is correct for
# the image refs and for VERSION. Announced rather than passed over in silence: an empty
# build-arg is exactly what caused the failure this script exists to prevent, so the one
# remaining way to get one is the one thing that gets printed.
if [ -n "$defaulted" ]; then
	echo "fly-deploy: using the Dockerfile's own default for:$defaulted" >&2
fi

echo "fly-deploy: $# build-arg token(s) from versions.env" >&2
exec flyctl deploy --remote-only "$@"
