#!/bin/sh
# fly-deploy — deploy the public demo to fly.io with the pins deploy/Dockerfile needs.
#
# WHY THIS EXISTS, because `flyctl deploy --remote-only` looks like it should be enough.
#
# flyctl knows nothing about versions.env, so every ARG the Dockerfile declares WITHOUT a default
# arrives empty and the build dies somewhere that looks unrelated. That incident (quince#494), and
# the derivation that prevents it, are `deploy/build-args` — read its header rather than this one
# for why the ARG list is never hand-written, and for why the loop below is shaped as it is.
#
# This script's own remaining job is small: prove flyctl is here, turn those values into
# `--build-arg` tokens, and hand them to a remote build.
set -eu

cd "$(dirname "$0")/.."

command -v flyctl >/dev/null 2>&1 || {
	echo "fly-deploy: flyctl is not on PATH. This runs where flyctl is installed and" >&2
	echo "            authenticated — a CI runner, or the Operator's machine. It is NOT" >&2
	echo "            expected to work on a session box (deploy/demo.md)." >&2
	exit 2
}

# Captured FIRST so a refusal from build-args ends the deploy. Inlining `$(deploy/build-args)` in
# the here-doc body would swallow its exit status — a redirection's command substitution does not
# trip `set -e` — and deploy with no build-args at all.
values=$(deploy/build-args)

set --
while IFS= read -r kv; do
	[ -n "$kv" ] || continue
	set -- "$@" --build-arg "$kv"
done <<EOF
$values
EOF

echo "fly-deploy: $# build-arg token(s) from versions.env" >&2
exec flyctl deploy --remote-only "$@"
