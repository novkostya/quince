#!/bin/sh
# devct — Proxmox containers from a template, driven by a scoped API token.
#
# ALL SIX VERBS ARE BUILT: doctor, onboard, create, list, destroy, deploy. This header said
# otherwise until 2026-07-29 — "Verbs implemented here: doctor. Verbs specified but NOT yet built:
# onboard, create, list, destroy" — which was true when written and false for a long time after.
#
# THAT STALE LINE NEARLY COST THE BOXES. Read together with `docs/specs/devct/devct.md`'s equally
# stale "No code exists" and an Operator ruling that retired the *disposable dev container*, it
# formed three independent-looking sources agreeing this directory was dead, and a session came
# within one command of deleting it. All three were written before the same change, which makes them
# one source, not three.
#
# WHAT IS ACTUALLY HERE, and the distinction the ruling turns on:
#
#   THE PERSISTENT-BOX PATH — LOAD-BEARING. `devct-template`, `onboard`, `doctor`, `list`, and
#   `create --name <host> --role <implementer|arch>` are the path that provisions `quince-runner`
#   and `quince-arch`, and it is this repo's only committed one.
#
#   THE PROOF THIS HEADER OFFERED IS GONE, and saying so is the point of this paragraph. It read:
#   "`quince-runner` and `quince-arch` were built with it and SAY SO: `/etc/quince-devct-stamp` on
#   both reads `alpine=3.24 versions=8c32bf735761 built=2026-07-25T20:24:50Z`, written by
#   `devct-template`" (which does write it). MEASURED 2026-07-29, one seat on each box: the
#   file is ABSENT on the arch box and ABSENT on the runner — no `/etc/*stamp*` of any name, either
#   place.
#
#   WHAT THAT DOES AND DOES NOT ESTABLISH. `/etc/alpine-release` on the runner reads 3.24.1, which
#   matches what the stamp claimed, so the lineage is consistent with this template — it is the
#   ARTIFACT that is missing, not demonstrably the provenance. The likeliest reading is the
#   second-site rebuild quince#205 records, which provisioned the current fleet from an
#   Operator-local `make-nerdctl-template.sh` that is in no repo and writes no stamp. NOBODY HAS
#   CONFIRMED THAT, and this comment must not read as though somebody had. The absence is measured;
#   the cause is a hypothesis with an issue number.
#
#   THE CONSEQUENCE, since `list` reports template freshness by reading this file over ssh: on
#   these two boxes it has nothing to read, so freshness there is UNKNOWN rather than current.
#
#   NONE OF THAT ARGUES FOR DELETING THIS DIRECTORY, and the reason never depended on the stamp:
#   nothing else committed here can build a box. What supersedes it is quince#205's to decide.
#
#   THE DISPOSABLE SERIES — RETIRED by the 2026-07-28 ruling ("no dev containers; the runner is the
#   work host", devlog#45). That is `create <n>`'s numbered `quince-dev-<n>` aliases, `destroy` as a
#   routine step, and `deploy`. Kept rather than cut: removing them is surgery on a working tool and
#   needs its own ruling, not a cleanup.
#
# The ruling retired a WORKFLOW, not this toolkit. Do not read "no dev containers" as "delete devct".
set -eu

DEVCT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# The path is computed at runtime, so the directive names it for the linter; `make gates-sh`
# passes -P SCRIPTDIR, which resolves it beside this script.
# shellcheck source=lib.sh
. "$DEVCT_ROOT/lib.sh"

usage() {
	cat <<'EOF'
usage: devct <verb>

  doctor        report readiness: bindings, credentials, TLS pin, token privileges,
                template freshness. Changes nothing. Non-zero exit when not ready.
  create [N]    clone the template into a disposable dev container, inject this host's
                secrets, and print the ssh alias plus the gate command. No root.
  list          the pool's containers: id, alias, status, and template freshness.
  destroy N     stop and delete one — refuses anything outside the pool.
  onboard       bind this machine: write devct.conf, pin the API certificate, and print
                the ssh config line to add. Never edits your ssh config itself.
  deploy        build a ref's production image on a dev container and serve it in --demo
                mode, then report a URL it has actually fetched.
                  --ref R    branch, tag or sha to deploy (default: the current branch)
                  --vmid N   which container (default: the only running one)
                  --create   make one first if none is running
                  --hosts    also print a hosts line, for direct browser resolution

onboard options (all optional except --api-host and --token-id):
  --api-host H          a name the API certificate carries (NOT an address — curl verifies
                        the URL host against the certificate)
  --api-addr A          where that name lives, when DNS does not know it
  --token-id U@R!NAME   the scoped API token's id; its secret stays in its own file
  --node N              defaults to the node the API reports
  --pool / --storage / --template-storage / --bridge / --sdn-zone / --registry / --ssh-key
EOF
}

# ---------------------------------------------------------------------------
# onboard — the one command a fresh machine runs. It writes only files it owns, and it prints
# (never applies) the one line that belongs to the user's own ssh config.
# ---------------------------------------------------------------------------

onboard() {
	devct_need curl jq openssl
	_o_conf="${DEVCT_CONF:-$DEVCT_CONF_DEFAULT}"
	_o_host='' _o_addr='' _o_token='' _o_node='' _o_pool=quince-dev _o_storage=''
	_o_tstorage='' _o_bridge=vmbr0 _o_zone=localnetwork _o_registry='' _o_key="$HOME/.ssh/id_ed25519.pub"

	while [ $# -gt 0 ]; do
		case "$1" in
		--api-host) _o_host=$2 ;;
		--api-addr) _o_addr=$2 ;;
		--token-id) _o_token=$2 ;;
		--node) _o_node=$2 ;;
		--pool) _o_pool=$2 ;;
		--storage) _o_storage=$2 ;;
		--template-storage) _o_tstorage=$2 ;;
		--bridge) _o_bridge=$2 ;;
		--sdn-zone) _o_zone=$2 ;;
		--registry) _o_registry=$2 ;;
		--ssh-key) _o_key=$2 ;;
		*)
			usage >&2
			devct_die "unknown option: $1"
			;;
		esac
		shift 2
	done

	[ -n "$_o_host" ] || devct_die "--api-host is required (a name the API certificate carries)"
	[ -n "$_o_token" ] || devct_die "--token-id is required (user@realm!tokenid)"
	[ -f "$DEVCT_TOKEN_DEFAULT" ] ||
		devct_die "no token secret at $DEVCT_TOKEN_DEFAULT — place it there (mode 600) before onboarding"
	[ -f "$_o_key" ] || devct_die "ssh public key not found: $_o_key"

	# 1. Pin the certificate. Printed as a fingerprint so it can be confirmed out of band — that
	#    check is the whole security of a self-signed pin, and it is the user's to make.
	_o_pin="$HOME/.config/quince/devct-api.pem"
	mkdir -p "$HOME/.config/quince"
	_o_connect=${_o_addr:-$_o_host}
	openssl s_client -connect "$_o_connect:8006" -servername "$_o_host" </dev/null 2>/dev/null |
		openssl x509 -out "$_o_pin" 2>/dev/null ||
		devct_die "could not fetch the API certificate from $_o_connect:8006"
	printf 'API certificate pinned at %s\n' "$_o_pin"
	printf '  SHA-256: %s\n' "$(openssl x509 -in "$_o_pin" -noout -fingerprint -sha256 | cut -d= -f2)"
	printf '  Confirm that fingerprint against the server before trusting this machine.\n\n'

	# 2. Write the config, then let the API fill in what it knows better than we do.
	umask 077
	{
		printf '# written by "devct onboard" — site bindings, never committed\n'
		printf 'api_host = %s\n' "$_o_host"
		[ -n "$_o_addr" ] && printf 'api_addr = %s\n' "$_o_addr"
		printf 'token_id = %s\n' "$_o_token"
		printf 'ca_pin = %s\n' "$_o_pin"
		printf 'pool = %s\n' "$_o_pool"
		printf 'bridge = %s\n' "$_o_bridge"
		printf 'sdn_zone = %s\n' "$_o_zone"
		printf 'ssh_key = %s\n' "$_o_key"
		[ -n "$_o_storage" ] && printf 'storage = %s\n' "$_o_storage"
		[ -n "$_o_tstorage" ] && printf 'template_storage = %s\n' "$_o_tstorage"
		[ -n "$_o_registry" ] && printf 'registry = %s\n' "$_o_registry"
		[ -n "$_o_node" ] && printf 'node = %s\n' "$_o_node"
	} >"$_o_conf"
	chmod 600 "$_o_conf"

	DEVCT_CONF="$_o_conf" devct_load_conf
	_r=$(devct_api GET /version) ||
		devct_die "the API is not reachable with this pin and token (HTTP $(devct_code "$_r")): $(devct_body "$_r")"
	printf 'API reachable, pin valid — PVE %s\n' "$(devct_body "$_r" | jq -r '.data.version // "?"')"

	if [ -z "$_o_node" ]; then
		_r=$(devct_api GET /nodes) || devct_die "cannot list nodes to discover one — pass --node"
		_o_node=$(devct_body "$_r" | jq -r '.data[0].node // empty')
		[ -n "$_o_node" ] || devct_die "the API returned no nodes — pass --node"
		printf 'node = %s\n' "$_o_node" >>"$_o_conf"
		printf 'node discovered from the API and recorded\n'
	fi
	printf 'config written: %s\n\n' "$_o_conf"

	# 3. The one thing onboard will NOT do for you. Editing a user's ssh config silently is the
	#    kind of helpfulness that loses someone a jump-host entry at 2am.
	printf 'Add this line to ~/.ssh/config (devct owns the file it points at):\n\n'
	printf '  Include ~/.ssh/quince-devct.conf\n\n'
	printf 'Then: devct doctor\n'
}

# ---------------------------------------------------------------------------
# create / list / destroy — the everyday path, and it is pure scoped token. The only root in
# this system is the template build's one block; nothing below ever needs it.
# ---------------------------------------------------------------------------

SSH_INCLUDE="$HOME/.ssh/quince-devct.conf"

template_vmid() {
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || devct_die "cannot list containers"
	devct_body "$_r" | jq -r --arg n "${DEVCT_TEMPLATE_NAME:-quince-dev-template}" \
		'[.data[] | select(.name==$n and .template==1) | .vmid] | first // empty'
}

next_alias_n() {
	# Lowest free N, so aliases stay short and predictable across a day's churn.
	_n=1
	while :; do
		devct_body "$1" | jq -e --arg h "quince-dev-$_n" '.data[] | select(.name==$h)' >/dev/null 2>&1 || {
			printf '%s\n' "$_n"
			return 0
		}
		_n=$((_n + 1))
	done
}

create() {
	devct_need curl jq ssh
	devct_load_conf
	devct_require_conf \
		"api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL" \
		"storage=$DEVCT_STORAGE" "token_id=$DEVCT_TOKEN_ID"

	_tmpl=$(template_vmid)
	[ -n "$_tmpl" ] || devct_die "no template named ${DEVCT_TEMPLATE_NAME:-quince-dev-template} — build one: devct-template build"

	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || devct_die "cannot list containers"
	# `create <n>` picks quince-dev-<n>; `create --name X` takes the name whole, which is how the
	# persistent runner gets a name outside the disposable series. Anything named for the runner is
	# then protected by destroy's guard below — the name IS the marker, so there is no second
	# lifecycle to keep in sync.
	# --role arch means: do NOT inject the bot token. The architect box can approve, and a box that
	# can approve must not also hold the identity that authors — that is devlog#7's whole point, and
	# leaving it to a later cleanup step would mean the separation depends on remembering.
	# Found by running it: create injected the token onto the arch box, and the box's own preflight
	# refused to start. The guard worked; the path that fed it did not.
	_role=implementer
	while :; do
		case "${1:-}" in
		--role)
			[ -n "${2:-}" ] || devct_die "--role needs a value (implementer|arch)"
			_role=$2
			shift 2
			;;
		*) break ;;
		esac
	done
	case "$_role" in implementer | arch) ;; *) devct_die "unknown role '$_role' — expected implementer or arch" ;; esac

	_named=''
	if [ "${1:-}" = --name ]; then
		[ -n "${2:-}" ] || devct_die "--name needs a value"
		_host=$2
		_named=1
	else
		_n=${1:-$(next_alias_n "$_r")}
		_host="quince-dev-$_n"
	fi
	devct_body "$_r" | jq -e --arg h "$_host" '.data[] | select(.name==$h)' >/dev/null 2>&1 &&
		devct_die "$_host already exists — destroy it first, or pick another number"

	_r=$(devct_api GET /cluster/nextid) || devct_die "cannot read /cluster/nextid"
	_vmid=$(devct_body "$_r" | jq -r '.data')

	printf 'creating %s (vmid %s) from template %s\n' "$_host" "$_vmid" "$_tmpl"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc/$_tmpl/clone" \
		"newid=$_vmid" "hostname=$_host" "pool=$DEVCT_POOL") ||
		devct_die "clone refused (HTTP $(devct_code "$_r")): $(devct_body "$_r")"
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')" || devct_die "clone failed"

	# Two tags, because ROLE and PERSISTENCE are different axes and conflating them broke the tool:
	# tagging every default-role box as "implementer" made the destroy guard refuse DISPOSABLE dev
	# containers, which is most of what destroy is for. Found by creating one and watching it be
	# protected.
	#   quince-role-<role>  — which identity the box carries (implementer | arch)
	#   quince-persistent   — this box is not a throwaway: it carries a login ceremony
	# A named box (--name) is persistent by construction; the auto-numbered quince-dev-N series is
	# not. Tags are API metadata: readable while the container is stopped, which is exactly when a
	# destroy is most likely to be the mistake.
	_tags="quince-role-$_role"
	[ -n "$_named" ] && _tags="$_tags;quince-persistent"
	_r=$(devct_api PUT "/nodes/$DEVCT_NODE/lxc/$_vmid/config" "tags=$_tags") ||
		devct_die "could not tag $_host (HTTP $(devct_code "$_r"))"

	devct_start "$_vmid" || devct_die "could not start $_vmid"
	_ip=$(devct_wait_for_ip "$_vmid") || devct_die "$_host never reported an address"
	devct_wait_for_ssh "$_ip" || devct_die "$_host is up but ssh never answered"

	write_ssh_include
	if [ "$_role" = arch ]; then
		printf '  secrets: NONE injected (role arch — this box must not hold the bot identity)\n'
	else
		inject_secrets "$_ip"
	fi
	ensure_tcp_forwarding "$_ip"
	check_stamp "$_ip"

	printf '\n%s is ready.\n' "$_host"
	printf '  ssh %s\n' "$_host"
	printf '  ssh %s '"'"'git clone https://github.com/novkostya/quince.git ~/work && make -C ~/work gates'"'"'\n' "$_host"
}

# ---------------------------------------------------------------------------
# deploy — the PR's clickable half. Builds THE PRODUCTION IMAGE on a dev container (QA against an
# artifact that differs from what CI builds is QA of something nobody ships), serves it in --demo
# mode, and reports a URL only after fetching it.
#
# The URL rule, ruled on the spec's first review: the PR gets the CONVENTION name and never an
# address. `ssh -L` is the documented desktop path because it reuses the binding devct already
# generates and dies with the session, leaving nothing stale pointing at a recycled DHCP lease.
# ---------------------------------------------------------------------------

DEMO_CONTAINER=quince-demo
DEMO_PORT=8080

deploy() {
	devct_need curl jq ssh
	devct_load_conf
	devct_require_conf "api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL"

	_d_ref='' _d_vmid='' _d_create='' _d_hosts=''
	while [ $# -gt 0 ]; do
		case "$1" in
		--ref)
			_d_ref=$2
			shift 2
			;;
		--vmid)
			_d_vmid=$2
			shift 2
			;;
		--create)
			_d_create=1
			shift
			;;
		--hosts)
			_d_hosts=1
			shift
			;;
		*)
			usage >&2
			devct_die "unknown option: $1"
			;;
		esac
	done
	[ -n "$_d_ref" ] || _d_ref=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)

	# 1. Which container.
	if [ -z "$_d_vmid" ]; then
		_d_running=$(running_dev_vmids)
		_d_count=$(printf '%s' "$_d_running" | wc -w | tr -d ' ')
		case "$_d_count" in
		1) _d_vmid=$_d_running ;;
		0)
			[ -n "$_d_create" ] ||
				devct_die "no running dev container — start one with 'devct create', or pass --create"
			create
			_d_running=$(running_dev_vmids)
			[ "$(printf '%s' "$_d_running" | wc -w | tr -d ' ')" -eq 1 ] ||
				devct_die "created a container but could not identify it — pass --vmid N"
			_d_vmid=$_d_running
			;;
		*)
			# Ambiguity is not absence. Naming the containers turns "pick one" into a decision the
			# reader can make without going to look, and --create here would have added a third.
			devct_die "more than one running dev container ($(printf '%s' "$_d_running" | tr ' ' ',')) — pass --vmid N"
			;;
		esac
	fi
	devct_in_pool "$_d_vmid" || devct_die "vmid $_d_vmid is not in pool $DEVCT_POOL"
	_d_name=$(ct_name "$_d_vmid")
	_d_ip=$(devct_wait_for_ip "$_d_vmid") || devct_die "$_d_name reports no address"
	printf 'deploying %s to %s (vmid %s)\n' "$_d_ref" "$_d_name" "$_d_vmid"

	# 2 + 3. Fetch the ref and build the production image, in the container.
	printf '  building the production image (this is the same target CI builds)…\n'
	# NO -n here: this ssh's stdin IS the payload. `-n` is the fix for an ssh that would otherwise
	# eat a loop's stdin; applied to a heredoc-fed call it silently feeds the remote shell nothing,
	# which exits 0 and looks like success. Found by running it — the build never happened and the
	# deploy only noticed three steps later, at the health check.
	# The heredoc is QUOTED and the ref arrives as a positional parameter: with an unquoted one
	# every $ in the remote script would expand here instead of there (SC2087), which works by
	# luck until the remote script wants a variable of its own.
	ssh -o StrictHostKeyChecking=accept-new "root@$_d_ip" "sh -s '$_d_ref'" <<'EOF' || devct_die "the image build failed on $_d_name"
set -eu
ref=$1
if [ ! -d /root/deploy-src/.git ]; then
	git clone -q --depth 50 https://github.com/novkostya/quince.git /root/deploy-src
fi
cd /root/deploy-src
git fetch -q --depth 50 origin "$ref"
git checkout -q FETCH_HEAD
make image
EOF

	# 4. Serve it, replacing any previous deploy so re-deploys do not accumulate.
	ssh -o StrictHostKeyChecking=accept-new "root@$_d_ip" "sh -s '$DEMO_CONTAINER' '$DEMO_PORT'" <<'EOF' || devct_die "could not start the demo"
set -eu
name=$1
port=$2
nerdctl rm -f "$name" >/dev/null 2>&1 || true
nerdctl run -d --name "$name" -p "$port:$port" \
	-e QUINCE_LISTEN=":$port" -e QUINCE_DATA=/tmp -e QUINCE_CACHE=/tmp \
	quince:local serve --demo >/dev/null
EOF

	# 5. Verify before claiming. A URL printed without a successful fetch is the defect class this
	#    rung's predecessor produced six times; the spec named it in advance, so it gets checked.
	printf '  waiting for the demo to answer…\n'
	# 127.0.0.1, not localhost: nerdctl's port proxy binds IPv4 only, and `localhost` resolves to
	# ::1 first, so a probe through the name gets "connection refused" from a perfectly healthy
	# app. Measured here — the first run reported a dead demo that was serving fine.
	_d_n=0
	while :; do
		ssh -n -o StrictHostKeyChecking=accept-new "root@$_d_ip" \
			"wget -qO- http://127.0.0.1:$DEMO_PORT/api/health" 2>/dev/null | grep -q '"status"' && break
		[ "$_d_n" -ge 60 ] && {
			ssh -n "root@$_d_ip" "nerdctl logs --tail 20 $DEMO_CONTAINER" 2>&1 | sed 's/^/    /' >&2
			devct_die "the demo never answered /api/health — logs above"
		}
		sleep 3
		_d_n=$((_d_n + 3))
	done

	# 6. Report. Convention name for the PR; the address stays in this session.
	printf '\n%s is serving %s.\n\n' "$_d_name" "$_d_ref"
	# The address first, because it is what the person running this actually uses: on the LAN it
	# needs no setup, and it stays collision-free when several rungs run in parallel — each
	# container has its own 8080. It is the one line that must never reach a PR.
	printf 'Open it (this session only — never paste this into a PR):\n'
	printf '  http://%s:%s/\n\n' "$_d_ip" "$DEMO_PORT"
	printf 'For the PR (convention name — carries no site information):\n'
	printf '  http://%s:%s/\n\n' "$_d_name" "$DEMO_PORT"
	# The forward's remote end resolves ON THE CONTAINER, where `localhost` means ::1 and nothing
	# listens. 127.0.0.1 is what makes this actually click — found by walking it.
	printf 'Address-free path, for a reader who has the alias but not the LAN:\n'
	printf '  ssh -L %s:127.0.0.1:%s %s     # then open http://localhost:%s\n' \
		"$DEMO_PORT" "$DEMO_PORT" "$_d_name" "$DEMO_PORT"
	printf '  (a second concurrent deploy needs a different LOCAL port: -L 8081:127.0.0.1:%s)\n' \
		"$DEMO_PORT"
	if [ -n "$_d_hosts" ]; then
		printf '\nFor direct browser resolution, add to /etc/hosts:\n'
		printf '  %s %s\n' "$_d_ip" "$_d_name"
	fi
}

# Returns EVERY running dev container, space-separated — the caller distinguishes none from
# several. The first version returned empty for both, so "two are running" was reported as "none
# are running", and its suggested fix would have created a third. An error message is a claim:
# collapsing two conditions into one message makes it a false one half the time.
running_dev_vmids() {
	_r=$(devct_api GET "/pools/$DEVCT_POOL") || return 1
	_l=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || return 1
	devct_body "$_l" | jq -r --argjson m "$(devct_body "$_r" | jq -c '[.data.members[]?|.vmid]')" \
		'[.data[] | select(.template!=1 and .status=="running" and (.vmid as $v | $m | index($v))) | .vmid] |
		 join(" ")'
}

# The role tag is the authority. An untagged container is treated as disposable, which is the
# historical behaviour and the safe default for the dev boxes that predate tagging.
ct_role() {
	ct_tags "$1" | sed -n 's/^quince-role-//p' | head -1
}

ct_tags() {
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc/$1/config") || return 0
	devct_body "$_r" | jq -r '.data.tags // ""' | tr ";" "\n"
}

ct_has_tag() {
	ct_tags "$1" | grep -qx "$2"
}

ct_name() {
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || return 1
	devct_body "$_r" | jq -r --arg v "$1" '.data[] | select((.vmid|tostring)==$v) | .name'
}

list() {
	devct_need curl jq
	devct_load_conf
	devct_require_conf "api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL"

	_r=$(devct_api GET "/pools/$DEVCT_POOL") || devct_die "cannot read pool $DEVCT_POOL"
	_members=$(devct_body "$_r" | jq -r '[.data.members[]? | select(.type=="lxc") | .vmid] | join(" ")')
	[ -n "$_members" ] || {
		printf 'pool %s is empty.\n' "$DEVCT_POOL"
		return 0
	}
	_l=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || devct_die "cannot list containers"
	printf '%-6s %-22s %-9s %s\n' VMID NAME STATUS KIND
	for _v in $_members; do
		devct_body "$_l" | jq -r --arg v "$_v" \
			'.data[] | select((.vmid|tostring)==$v) |
			 [(.vmid|tostring), .name, .status, (if .template==1 then "template" else "container" end)] | @tsv' |
			while IFS="$(printf '\t')" read -r _id _name _st _kind; do
				printf '%-6s %-22s %-9s %s\n' "$_id" "$_name" "$_st" "$_kind"
			done
	done
}

destroy() {
	devct_need curl jq
	devct_load_conf
	devct_require_conf "api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL"

	_force=''
	if [ "${1:-}" = --force ]; then
		_force=1
		shift
	fi
	[ -n "${1:-}" ] || devct_die "usage: devct destroy [--force] <vmid>"

	devct_in_pool "$1" ||
		devct_die "vmid $1 is not in pool $DEVCT_POOL — refusing. The pool is the boundary of what this tool may touch."
	devct_is_template "$1" &&
		devct_die "vmid $1 is the template, not a dev container — rebuild it with devct-template if that is what you meant"

	# Persistent boxes are protected by their ROLE TAG, not by a hard-coded name (architect ruling
	# on #26): guarding the literal string "quince-runner" left quince-arch destroyable by reflex,
	# which is exactly how the runner was lost once. Anything tagged with a persistent role takes a
	# second word.
	if [ -z "$_force" ] && ct_has_tag "$1" quince-persistent; then
		devct_die "vmid $1 is a PERSISTENT box (role: $(ct_role "$1")), not a disposable container — it carries a Claude login ceremony that cannot be scripted, and its credentials. Pass --force if that is genuinely what you want."
	fi

	printf 'destroying %s\n' "$1"
	devct_destroy "$1" || devct_die "destroy failed"
	write_ssh_include
	printf 'destroyed.\n'
}

# The tool owns this file and rewrites it whole from live pool state — no parsing of what was
# there before, so a half-written entry from a crashed run cannot survive.
write_ssh_include() {
	_r=$(devct_api GET "/pools/$DEVCT_POOL") || return 1
	_l=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || return 1
	# Variable names here are deliberately unshared: POSIX sh has no locals, so a helper reusing
	# a caller's name silently overwrites it. This function used `_ip` and blanked the address
	# its caller was about to inject secrets over — the failure surfaced two calls later as
	# "could not resolve hostname ''".
	_wsi_tmp="$SSH_INCLUDE.tmp.$$"
	_wsi_count=0
	{
		printf '# generated by devct — do not edit; rewritten on every create/destroy\n'
		for _wsi_v in $(devct_body "$_r" | jq -r '[.data.members[]? | select(.type=="lxc") | .vmid] | join(" ")'); do
			_wsi_name=$(devct_body "$_l" | jq -r --arg v "$_wsi_v" '.data[] | select((.vmid|tostring)==$v and .template!=1) | .name')
			[ -n "$_wsi_name" ] || continue
			_wsi_ip=$(devct_wait_for_ip "$_wsi_v" 0) || continue
			printf '\nHost %s\n  HostName %s\n  User root\n  StrictHostKeyChecking accept-new\n' "$_wsi_name" "$_wsi_ip"
			_wsi_count=$((_wsi_count + 1))
		done
	} >"$_wsi_tmp" && mv "$_wsi_tmp" "$SSH_INCLUDE"
	# Count what was written rather than announcing the path and hoping: this wrote an empty
	# file once and said nothing was wrong.
	printf '  ssh config: %s (%s host alias(es))\n' "$SSH_INCLUDE" "$_wsi_count"
}

# R3(5): secrets live on the session host and are injected at provision, so nothing accumulates
# on the hypervisor and rotation is one file plus a destroy. They travel over ssh stdin — never
# argv, never a heredoc that could echo them.
inject_secrets() {
	_sent=''
	if [ -f "$HOME/.config/quince/quince-bot.token" ]; then
		ssh -o StrictHostKeyChecking=accept-new "root@$1" \
			'mkdir -p ~/.config/quince && cat > ~/.config/quince/quince-bot.token && chmod 600 ~/.config/quince/quince-bot.token' \
			<"$HOME/.config/quince/quince-bot.token" || devct_die "could not inject the bot token"
		_sent="bot token"
	fi
	if [ -n "${DEVCT_REGISTRY:-}" ] && [ -f "$HOME/.config/quince/registry.auth" ]; then
		ssh -o StrictHostKeyChecking=accept-new "root@$1" \
			'mkdir -p ~/.config/quince && cat > ~/.config/quince/registry.auth && chmod 600 ~/.config/quince/registry.auth' \
			<"$HOME/.config/quince/registry.auth" || devct_die "could not inject the registry credential"
		_sent="$_sent, registry credential"
	fi
	printf '  secrets injected: %s\n' "${_sent:-none found on this host}"
}

# The ruled desktop click path is `ssh -L`, and Alpine's sshd ships `AllowTcpForwarding no` — so a
# reviewer following the PR's own instructions gets "administratively prohibited" and no page.
# Fixed here because it is container-local (no hypervisor privilege, no template rebuild needed for
# containers already cloned), and announced rather than done quietly. The template carries the same
# setting from now on, so this becomes a no-op for anything built after it.
ensure_tcp_forwarding() {
	_fwd=$(ssh -o StrictHostKeyChecking=accept-new "root@$1" 'sh -s' <<'EOF'
set -eu
if grep -qiE '^[[:space:]]*AllowTcpForwarding[[:space:]]+yes' /etc/ssh/sshd_config; then
	printf 'already enabled\n'
	exit 0
fi
sed -i -E 's/^[[:space:]]*#?[[:space:]]*AllowTcpForwarding.*/AllowTcpForwarding yes/I' /etc/ssh/sshd_config
grep -qiE '^AllowTcpForwarding yes' /etc/ssh/sshd_config || printf 'AllowTcpForwarding yes\n' >>/etc/ssh/sshd_config
rc-service sshd restart >/dev/null 2>&1 || /etc/init.d/sshd restart >/dev/null 2>&1
grep -qiE '^AllowTcpForwarding yes' /etc/ssh/sshd_config && printf 'enabled (Alpine ships it off)\n'
EOF
	) || devct_die "could not enable ssh forwarding on the container"
	[ -n "$_fwd" ] || devct_die "ssh forwarding could not be verified after the edit"
	printf '  ssh -L forwarding: %s\n' "$_fwd"
}

# Staleness is surfaced, never silently used (spec story 9). The stamp is read from the box
# itself rather than from a cache, because the box is the thing that will run the gates.
check_stamp() {
	_stamp=$(ssh -n -o StrictHostKeyChecking=accept-new "root@$1" 'cat /etc/quince-devct-stamp 2>/dev/null' || true)
	if [ -z "$_stamp" ]; then
		printf '  stamp: MISSING on this container — it did not come from a devct-built template\n'
		return 0
	fi
	printf '  stamp: %s\n' "$_stamp"
	_want=$(versions_digest)
	case "$_stamp" in
	*"versions=$_want"*) ;;
	*)
		printf '\n  WARNING: this template was built from different versions.env pins.\n'
		printf '  The toolchain cache inside it does not match this checkout, so gates will\n'
		printf '  rebuild toolchains (slow) or test against the wrong ones.\n'
		printf '  Rebuild it: devct-template build --recreate\n\n'
		;;
	esac
}

versions_digest() {
	_v="$DEVCT_ROOT/../../versions.env"
	[ -f "$_v" ] || {
		printf 'unknown'
		return 0
	}
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$_v" | cut -c1-12
	else
		shasum -a 256 "$_v" | cut -c1-12
	fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
# The privilege list below is a HYPOTHESIS. doctor's job is to replace it with a measurement:
# it asks the API what this token can actually do and reports the delta. A recorded scope is
# an interface fact, and interface facts decay — so nothing here trusts what was written down.

DOCTOR_FAIL=0
DOCTOR_TODO=""

ok() { printf '  ok      %s\n' "$*"; }
bad() {
	printf '  MISSING %s\n' "$*"
	DOCTOR_FAIL=1
}
todo() { DOCTOR_TODO="$DOCTOR_TODO
    - $*"; }

# priv_check <api-path> <privilege>... — against the fetched permission map.
priv_check() {
	_path=$1
	shift
	for _priv in "$@"; do
		if printf '%s' "$DOCTOR_PERMS" | jq -e --arg p "$_path" --arg v "$_priv" \
			'.[$p][$v] // empty' >/dev/null 2>&1; then
			ok "$_priv on $_path"
		else
			bad "$_priv on $_path"
			todo "grant $_priv on $_path to $DEVCT_TOKEN_ID (architect, self-service)"
		fi
	done
}

doctor() {
	devct_need curl jq
	devct_load_conf
	devct_require_conf \
		"api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL" \
		"storage=$DEVCT_STORAGE" "template_storage=$DEVCT_TEMPLATE_STORAGE" \
		"bridge=$DEVCT_BRIDGE"

	printf 'devct doctor — %s\n\n' "$DEVCT_API_BASE"

	printf 'local bindings\n'
	if [ -f "$DEVCT_TOKEN_FILE" ]; then
		ok "token file present"
	else
		bad "token file $DEVCT_TOKEN_FILE"
		todo "place the API token secret at $DEVCT_TOKEN_FILE (mode 600)"
	fi
	if [ -f "$DEVCT_CA_PIN" ]; then
		ok "TLS pin present"
	else
		bad "TLS pin $DEVCT_CA_PIN"
		todo "capture the API certificate: devct onboard (verification is never disabled)"
	fi
	if grep -q 'quince-devct.conf' "$HOME/.ssh/config" 2>/dev/null; then
		ok "ssh include wired"
	else
		bad "ssh include in ~/.ssh/config"
		todo "add: Include ~/.ssh/quince-devct.conf"
	fi

	printf '\napi\n'
	_r=$(devct_api GET /version) && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then
		ok "reachable, TLS pin valid — PVE $(devct_body "$_r" | jq -r '.data.version // "?"')"
	else
		bad "GET /version returned HTTP $(devct_code "$_r")"
		devct_body "$_r" | sed 's/^/          /'
		printf '\nnot ready.\n'
		return 1
	fi

	printf '\ntoken privileges (measured, not assumed)\n'
	# Capture the whole response, then check the status: piping straight into jq would hand us
	# jq's exit code and quietly turn a 403 into an empty permission map.
	_r=$(devct_api GET /access/permissions) && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then
		DOCTOR_PERMS=$(devct_body "$_r" | jq -c '.data')
	else
		bad "GET /access/permissions returned HTTP $(devct_code "$_r")"
		printf '\nnot ready.\n'
		return 1
	fi
	# Pool.Allocate: granted during the step-3 diagnosis and possibly required for create-into-pool,
	# but its necessity is masked rather than measured — revoke it and re-run the ladder to settle.
	priv_check "/pool/$DEVCT_POOL" VM.Allocate VM.Clone VM.Config.Network VM.PowerMgmt VM.Audit Pool.Allocate
	priv_check "/storage/$DEVCT_STORAGE" Datastore.AllocateSpace Datastore.Audit
	# The appliance image and the container rootfs live on DIFFERENT storages: a zfspool holds
	# rootdir/images and cannot hold vztmpl content at all. Defaulting template_storage to
	# `storage` (as this check first did) reports a grant as satisfied on a storage that can
	# never hold the thing being granted — so it is required separately, and named separately.
	# AllocateTemplate downloads a template; Audit is what lets a create CONSUME one (measured —
	# PVE checks AllocateSpace|Audit on the ostemplate's storage, and Audit is the read-only half).
	priv_check "/storage/$DEVCT_TEMPLATE_STORAGE" Datastore.AllocateTemplate Datastore.Audit
	priv_check "/sdn/zones/${DEVCT_SDN_ZONE:-localnetwork}/$DEVCT_BRIDGE" SDN.Use

	printf '\ntemplate\n'
	_tmpl=${DEVCT_TEMPLATE_NAME:-quince-dev-template}
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then
		# A container named like the template is NOT the template: an interrupted build leaves
		# exactly that behind, and reporting it as present would be the tool lying about the one
		# thing it is asked to check. The conversion flag is what makes it real.
		if devct_body "$_r" | jq -e --arg n "$_tmpl" '.data[] | select(.name==$n and .template==1)' >/dev/null 2>&1; then
			ok "template $_tmpl exists"
		elif _id=$(devct_body "$_r" | jq -er --arg n "$_tmpl" '.data[] | select(.name==$n) | .vmid' 2>/dev/null); then
			bad "template $_tmpl — vmid $_id carries the name but is still a CONTAINER, not a template"
			todo "finish or discard the interrupted build: devct-template build --vmid $_id"
		else
			bad "template $_tmpl"
			todo "build it: devct-template build"
		fi
	else
		bad "GET /nodes/$DEVCT_NODE/lxc returned HTTP $(devct_code "$_r")"
		todo "the token cannot list containers on node $DEVCT_NODE — check VM.Audit and the node name"
	fi

	if [ -n "$DOCTOR_TODO" ]; then
		printf '\nto fix:%s\n' "$DOCTOR_TODO"
	fi
	if [ "$DOCTOR_FAIL" -eq 0 ]; then
		printf '\nready.\n'
		return 0
	fi
	printf '\nnot ready.\n'
	return 1
}

case "${1:-}" in
doctor) doctor ;;
create)
	shift
	create "$@"
	;;
list) list ;;
destroy)
	shift
	destroy "$@"
	;;
onboard)
	shift
	onboard "$@"
	;;
deploy)
	shift
	deploy "$@"
	;;
'' | -h | --help | help) usage ;;
*)
	usage >&2
	devct_die "unknown verb: $1"
	;;
esac
