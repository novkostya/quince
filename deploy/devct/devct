#!/bin/sh
# devct — disposable dev containers on Proxmox, driven by a scoped API token.
#
# Verbs implemented here: doctor.
# Verbs specified but NOT yet built: onboard, create, list, destroy — they say so when called,
# rather than pretending. See docs/specs/devct/devct.md.
set -eu

DEVCT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# The path is computed at runtime, so the directive names it for the linter; `make gates-sh`
# passes -P SCRIPTDIR, which resolves it beside this script.
# shellcheck source=lib.sh
. "$DEVCT_ROOT/lib.sh"

usage() {
	cat <<'EOF'
usage: devct <verb>

  doctor        report readiness: bindings, credentials, TLS pin, token privileges,
                template freshness. Changes nothing. Non-zero exit when not ready.
  create [N]    clone the template into a disposable dev container, inject this host's
                secrets, and print the ssh alias plus the gate command. No root.
  list          the pool's containers: id, alias, status, and template freshness.
  destroy N     stop and delete one — refuses anything outside the pool.
  onboard       bind this machine: write devct.conf, pin the API certificate, and print
                the ssh config line to add. Never edits your ssh config itself.

onboard options (all optional except --api-host and --token-id):
  --api-host H          a name the API certificate carries (NOT an address — curl verifies
                        the URL host against the certificate)
  --api-addr A          where that name lives, when DNS does not know it
  --token-id U@R!NAME   the scoped API token's id; its secret stays in its own file
  --node N              defaults to the node the API reports
  --pool / --storage / --template-storage / --bridge / --sdn-zone / --registry / --ssh-key
EOF
}

# ---------------------------------------------------------------------------
# onboard — the one command a fresh machine runs. It writes only files it owns, and it prints
# (never applies) the one line that belongs to the user's own ssh config.
# ---------------------------------------------------------------------------

onboard() {
	devct_need curl jq openssl
	_o_conf="${DEVCT_CONF:-$DEVCT_CONF_DEFAULT}"
	_o_host='' _o_addr='' _o_token='' _o_node='' _o_pool=quince-dev _o_storage=''
	_o_tstorage='' _o_bridge=vmbr0 _o_zone=localnetwork _o_registry='' _o_key="$HOME/.ssh/id_ed25519.pub"

	while [ $# -gt 0 ]; do
		case "$1" in
		--api-host) _o_host=$2 ;;
		--api-addr) _o_addr=$2 ;;
		--token-id) _o_token=$2 ;;
		--node) _o_node=$2 ;;
		--pool) _o_pool=$2 ;;
		--storage) _o_storage=$2 ;;
		--template-storage) _o_tstorage=$2 ;;
		--bridge) _o_bridge=$2 ;;
		--sdn-zone) _o_zone=$2 ;;
		--registry) _o_registry=$2 ;;
		--ssh-key) _o_key=$2 ;;
		*)
			usage >&2
			devct_die "unknown option: $1"
			;;
		esac
		shift 2
	done

	[ -n "$_o_host" ] || devct_die "--api-host is required (a name the API certificate carries)"
	[ -n "$_o_token" ] || devct_die "--token-id is required (user@realm!tokenid)"
	[ -f "$DEVCT_TOKEN_DEFAULT" ] ||
		devct_die "no token secret at $DEVCT_TOKEN_DEFAULT — place it there (mode 600) before onboarding"
	[ -f "$_o_key" ] || devct_die "ssh public key not found: $_o_key"

	# 1. Pin the certificate. Printed as a fingerprint so it can be confirmed out of band — that
	#    check is the whole security of a self-signed pin, and it is the user's to make.
	_o_pin="$HOME/.config/quince/devct-api.pem"
	mkdir -p "$HOME/.config/quince"
	_o_connect=${_o_addr:-$_o_host}
	openssl s_client -connect "$_o_connect:8006" -servername "$_o_host" </dev/null 2>/dev/null |
		openssl x509 -out "$_o_pin" 2>/dev/null ||
		devct_die "could not fetch the API certificate from $_o_connect:8006"
	printf 'API certificate pinned at %s\n' "$_o_pin"
	printf '  SHA-256: %s\n' "$(openssl x509 -in "$_o_pin" -noout -fingerprint -sha256 | cut -d= -f2)"
	printf '  Confirm that fingerprint against the server before trusting this machine.\n\n'

	# 2. Write the config, then let the API fill in what it knows better than we do.
	umask 077
	{
		printf '# written by `devct onboard` — site bindings, never committed\n'
		printf 'api_host = %s\n' "$_o_host"
		[ -n "$_o_addr" ] && printf 'api_addr = %s\n' "$_o_addr"
		printf 'token_id = %s\n' "$_o_token"
		printf 'ca_pin = %s\n' "$_o_pin"
		printf 'pool = %s\n' "$_o_pool"
		printf 'bridge = %s\n' "$_o_bridge"
		printf 'sdn_zone = %s\n' "$_o_zone"
		printf 'ssh_key = %s\n' "$_o_key"
		[ -n "$_o_storage" ] && printf 'storage = %s\n' "$_o_storage"
		[ -n "$_o_tstorage" ] && printf 'template_storage = %s\n' "$_o_tstorage"
		[ -n "$_o_registry" ] && printf 'registry = %s\n' "$_o_registry"
		[ -n "$_o_node" ] && printf 'node = %s\n' "$_o_node"
	} >"$_o_conf"
	chmod 600 "$_o_conf"

	DEVCT_CONF="$_o_conf" devct_load_conf
	_r=$(devct_api GET /version) ||
		devct_die "the API is not reachable with this pin and token (HTTP $(devct_code "$_r")): $(devct_body "$_r")"
	printf 'API reachable, pin valid — PVE %s\n' "$(devct_body "$_r" | jq -r '.data.version // "?"')"

	if [ -z "$_o_node" ]; then
		_r=$(devct_api GET /nodes) || devct_die "cannot list nodes to discover one — pass --node"
		_o_node=$(devct_body "$_r" | jq -r '.data[0].node // empty')
		[ -n "$_o_node" ] || devct_die "the API returned no nodes — pass --node"
		printf 'node = %s\n' "$_o_node" >>"$_o_conf"
		printf 'node discovered from the API and recorded\n'
	fi
	printf 'config written: %s\n\n' "$_o_conf"

	# 3. The one thing onboard will NOT do for you. Editing a user's ssh config silently is the
	#    kind of helpfulness that loses someone a jump-host entry at 2am.
	printf 'Add this line to ~/.ssh/config (devct owns the file it points at):\n\n'
	printf '  Include ~/.ssh/quince-devct.conf\n\n'
	printf 'Then: devct doctor\n'
}

# ---------------------------------------------------------------------------
# create / list / destroy — the everyday path, and it is pure scoped token. The only root in
# this system is the template build's one block; nothing below ever needs it.
# ---------------------------------------------------------------------------

SSH_INCLUDE="$HOME/.ssh/quince-devct.conf"

template_vmid() {
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || devct_die "cannot list containers"
	devct_body "$_r" | jq -r --arg n "${DEVCT_TEMPLATE_NAME:-quince-dev-template}" \
		'[.data[] | select(.name==$n and .template==1) | .vmid] | first // empty'
}

next_alias_n() {
	# Lowest free N, so aliases stay short and predictable across a day's churn.
	_n=1
	while :; do
		devct_body "$1" | jq -e --arg h "quince-dev-$_n" '.data[] | select(.name==$h)' >/dev/null 2>&1 || {
			printf '%s\n' "$_n"
			return 0
		}
		_n=$((_n + 1))
	done
}

create() {
	devct_need curl jq ssh
	devct_load_conf
	devct_require_conf \
		"api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL" \
		"storage=$DEVCT_STORAGE" "token_id=$DEVCT_TOKEN_ID"

	_tmpl=$(template_vmid)
	[ -n "$_tmpl" ] || devct_die "no template named ${DEVCT_TEMPLATE_NAME:-quince-dev-template} — build one: devct-template build"

	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || devct_die "cannot list containers"
	_n=${1:-$(next_alias_n "$_r")}
	_host="quince-dev-$_n"
	devct_body "$_r" | jq -e --arg h "$_host" '.data[] | select(.name==$h)' >/dev/null 2>&1 &&
		devct_die "$_host already exists — destroy it first, or pick another number"

	_r=$(devct_api GET /cluster/nextid) || devct_die "cannot read /cluster/nextid"
	_vmid=$(devct_body "$_r" | jq -r '.data')

	printf 'creating %s (vmid %s) from template %s\n' "$_host" "$_vmid" "$_tmpl"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc/$_tmpl/clone" \
		"newid=$_vmid" "hostname=$_host" "pool=$DEVCT_POOL") ||
		devct_die "clone refused (HTTP $(devct_code "$_r")): $(devct_body "$_r")"
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')" || devct_die "clone failed"

	devct_start "$_vmid" || devct_die "could not start $_vmid"
	_ip=$(devct_wait_for_ip "$_vmid") || devct_die "$_host never reported an address"
	devct_wait_for_ssh "$_ip" || devct_die "$_host is up but ssh never answered"

	write_ssh_include
	inject_secrets "$_ip"
	check_stamp "$_ip"

	printf '\n%s is ready.\n' "$_host"
	printf '  ssh %s\n' "$_host"
	printf '  ssh %s '"'"'git clone https://github.com/novkostya/quince.git ~/work && make -C ~/work gates'"'"'\n' "$_host"
}

list() {
	devct_need curl jq
	devct_load_conf
	devct_require_conf "api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL"

	_r=$(devct_api GET "/pools/$DEVCT_POOL") || devct_die "cannot read pool $DEVCT_POOL"
	_members=$(devct_body "$_r" | jq -r '[.data.members[]? | select(.type=="lxc") | .vmid] | join(" ")')
	[ -n "$_members" ] || {
		printf 'pool %s is empty.\n' "$DEVCT_POOL"
		return 0
	}
	_l=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || devct_die "cannot list containers"
	printf '%-6s %-22s %-9s %s\n' VMID NAME STATUS KIND
	for _v in $_members; do
		devct_body "$_l" | jq -r --arg v "$_v" \
			'.data[] | select((.vmid|tostring)==$v) |
			 [(.vmid|tostring), .name, .status, (if .template==1 then "template" else "container" end)] | @tsv' |
			while IFS="$(printf '\t')" read -r _id _name _st _kind; do
				printf '%-6s %-22s %-9s %s\n' "$_id" "$_name" "$_st" "$_kind"
			done
	done
}

destroy() {
	devct_need curl jq
	devct_load_conf
	devct_require_conf "api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL"
	[ -n "${1:-}" ] || devct_die "usage: devct destroy <vmid>"

	devct_in_pool "$1" ||
		devct_die "vmid $1 is not in pool $DEVCT_POOL — refusing. The pool is the boundary of what this tool may touch."
	devct_is_template "$1" &&
		devct_die "vmid $1 is the template, not a dev container — rebuild it with devct-template if that is what you meant"

	printf 'destroying %s\n' "$1"
	devct_destroy "$1" || devct_die "destroy failed"
	write_ssh_include
	printf 'destroyed.\n'
}

# The tool owns this file and rewrites it whole from live pool state — no parsing of what was
# there before, so a half-written entry from a crashed run cannot survive.
write_ssh_include() {
	_r=$(devct_api GET "/pools/$DEVCT_POOL") || return 1
	_l=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") || return 1
	# Variable names here are deliberately unshared: POSIX sh has no locals, so a helper reusing
	# a caller's name silently overwrites it. This function used `_ip` and blanked the address
	# its caller was about to inject secrets over — the failure surfaced two calls later as
	# "could not resolve hostname ''".
	_wsi_tmp="$SSH_INCLUDE.tmp.$$"
	_wsi_count=0
	{
		printf '# generated by devct — do not edit; rewritten on every create/destroy\n'
		for _wsi_v in $(devct_body "$_r" | jq -r '[.data.members[]? | select(.type=="lxc") | .vmid] | join(" ")'); do
			_wsi_name=$(devct_body "$_l" | jq -r --arg v "$_wsi_v" '.data[] | select((.vmid|tostring)==$v and .template!=1) | .name')
			[ -n "$_wsi_name" ] || continue
			_wsi_ip=$(devct_wait_for_ip "$_wsi_v" 0) || continue
			printf '\nHost %s\n  HostName %s\n  User root\n  StrictHostKeyChecking accept-new\n' "$_wsi_name" "$_wsi_ip"
			_wsi_count=$((_wsi_count + 1))
		done
	} >"$_wsi_tmp" && mv "$_wsi_tmp" "$SSH_INCLUDE"
	# Count what was written rather than announcing the path and hoping: this wrote an empty
	# file once and said nothing was wrong.
	printf '  ssh config: %s (%s host alias(es))\n' "$SSH_INCLUDE" "$_wsi_count"
}

# R3(5): secrets live on the session host and are injected at provision, so nothing accumulates
# on the hypervisor and rotation is one file plus a destroy. They travel over ssh stdin — never
# argv, never a heredoc that could echo them.
inject_secrets() {
	_sent=''
	if [ -f "$HOME/.config/quince/quince-bot.token" ]; then
		ssh -o StrictHostKeyChecking=accept-new "root@$1" \
			'mkdir -p ~/.config/quince && cat > ~/.config/quince/quince-bot.token && chmod 600 ~/.config/quince/quince-bot.token' \
			<"$HOME/.config/quince/quince-bot.token" || devct_die "could not inject the bot token"
		_sent="bot token"
	fi
	if [ -n "${DEVCT_REGISTRY:-}" ] && [ -f "$HOME/.config/quince/registry.auth" ]; then
		ssh -o StrictHostKeyChecking=accept-new "root@$1" \
			'mkdir -p ~/.config/quince && cat > ~/.config/quince/registry.auth && chmod 600 ~/.config/quince/registry.auth' \
			<"$HOME/.config/quince/registry.auth" || devct_die "could not inject the registry credential"
		_sent="$_sent, registry credential"
	fi
	printf '  secrets injected: %s\n' "${_sent:-none found on this host}"
}

# Staleness is surfaced, never silently used (spec story 9). The stamp is read from the box
# itself rather than from a cache, because the box is the thing that will run the gates.
check_stamp() {
	_stamp=$(ssh -n -o StrictHostKeyChecking=accept-new "root@$1" 'cat /etc/quince-devct-stamp 2>/dev/null' || true)
	if [ -z "$_stamp" ]; then
		printf '  stamp: MISSING on this container — it did not come from a devct-built template\n'
		return 0
	fi
	printf '  stamp: %s\n' "$_stamp"
	_want=$(versions_digest)
	case "$_stamp" in
	*"versions=$_want"*) ;;
	*)
		printf '\n  WARNING: this template was built from different versions.env pins.\n'
		printf '  The toolchain cache inside it does not match this checkout, so gates will\n'
		printf '  rebuild toolchains (slow) or test against the wrong ones.\n'
		printf '  Rebuild it: devct-template build --recreate\n\n'
		;;
	esac
}

versions_digest() {
	_v="$DEVCT_ROOT/../../versions.env"
	[ -f "$_v" ] || {
		printf 'unknown'
		return 0
	}
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$_v" | cut -c1-12
	else
		shasum -a 256 "$_v" | cut -c1-12
	fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
# The privilege list below is a HYPOTHESIS. doctor's job is to replace it with a measurement:
# it asks the API what this token can actually do and reports the delta. A recorded scope is
# an interface fact, and interface facts decay — so nothing here trusts what was written down.

DOCTOR_FAIL=0
DOCTOR_TODO=""

ok() { printf '  ok      %s\n' "$*"; }
bad() {
	printf '  MISSING %s\n' "$*"
	DOCTOR_FAIL=1
}
todo() { DOCTOR_TODO="$DOCTOR_TODO
    - $*"; }

# priv_check <api-path> <privilege>... — against the fetched permission map.
priv_check() {
	_path=$1
	shift
	for _priv in "$@"; do
		if printf '%s' "$DOCTOR_PERMS" | jq -e --arg p "$_path" --arg v "$_priv" \
			'.[$p][$v] // empty' >/dev/null 2>&1; then
			ok "$_priv on $_path"
		else
			bad "$_priv on $_path"
			todo "grant $_priv on $_path to $DEVCT_TOKEN_ID (architect, self-service)"
		fi
	done
}

doctor() {
	devct_need curl jq
	devct_load_conf
	devct_require_conf \
		"api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL" \
		"storage=$DEVCT_STORAGE" "template_storage=$DEVCT_TEMPLATE_STORAGE" \
		"bridge=$DEVCT_BRIDGE"

	printf 'devct doctor — %s\n\n' "$DEVCT_API_BASE"

	printf 'local bindings\n'
	if [ -f "$DEVCT_TOKEN_FILE" ]; then
		ok "token file present"
	else
		bad "token file $DEVCT_TOKEN_FILE"
		todo "place the API token secret at $DEVCT_TOKEN_FILE (mode 600)"
	fi
	if [ -f "$DEVCT_CA_PIN" ]; then
		ok "TLS pin present"
	else
		bad "TLS pin $DEVCT_CA_PIN"
		todo "capture the API certificate: devct onboard (verification is never disabled)"
	fi
	if grep -q 'quince-devct.conf' "$HOME/.ssh/config" 2>/dev/null; then
		ok "ssh include wired"
	else
		bad "ssh include in ~/.ssh/config"
		todo "add: Include ~/.ssh/quince-devct.conf"
	fi

	printf '\napi\n'
	_r=$(devct_api GET /version) && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then
		ok "reachable, TLS pin valid — PVE $(devct_body "$_r" | jq -r '.data.version // "?"')"
	else
		bad "GET /version returned HTTP $(devct_code "$_r")"
		devct_body "$_r" | sed 's/^/          /'
		printf '\nnot ready.\n'
		return 1
	fi

	printf '\ntoken privileges (measured, not assumed)\n'
	# Capture the whole response, then check the status: piping straight into jq would hand us
	# jq's exit code and quietly turn a 403 into an empty permission map.
	_r=$(devct_api GET /access/permissions) && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then
		DOCTOR_PERMS=$(devct_body "$_r" | jq -c '.data')
	else
		bad "GET /access/permissions returned HTTP $(devct_code "$_r")"
		printf '\nnot ready.\n'
		return 1
	fi
	# Pool.Allocate: granted during the step-3 diagnosis and possibly required for create-into-pool,
	# but its necessity is masked rather than measured — revoke it and re-run the ladder to settle.
	priv_check "/pool/$DEVCT_POOL" VM.Allocate VM.Clone VM.Config.Network VM.PowerMgmt VM.Audit Pool.Allocate
	priv_check "/storage/$DEVCT_STORAGE" Datastore.AllocateSpace Datastore.Audit
	# The appliance image and the container rootfs live on DIFFERENT storages: a zfspool holds
	# rootdir/images and cannot hold vztmpl content at all. Defaulting template_storage to
	# `storage` (as this check first did) reports a grant as satisfied on a storage that can
	# never hold the thing being granted — so it is required separately, and named separately.
	# AllocateTemplate downloads a template; Audit is what lets a create CONSUME one (measured —
	# PVE checks AllocateSpace|Audit on the ostemplate's storage, and Audit is the read-only half).
	priv_check "/storage/$DEVCT_TEMPLATE_STORAGE" Datastore.AllocateTemplate Datastore.Audit
	priv_check "/sdn/zones/${DEVCT_SDN_ZONE:-localnetwork}/$DEVCT_BRIDGE" SDN.Use

	printf '\ntemplate\n'
	_tmpl=${DEVCT_TEMPLATE_NAME:-quince-dev-template}
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc") && _rc=0 || _rc=$?
	if [ "$_rc" -eq 0 ]; then
		# A container named like the template is NOT the template: an interrupted build leaves
		# exactly that behind, and reporting it as present would be the tool lying about the one
		# thing it is asked to check. The conversion flag is what makes it real.
		if devct_body "$_r" | jq -e --arg n "$_tmpl" '.data[] | select(.name==$n and .template==1)' >/dev/null 2>&1; then
			ok "template $_tmpl exists"
		elif _id=$(devct_body "$_r" | jq -er --arg n "$_tmpl" '.data[] | select(.name==$n) | .vmid' 2>/dev/null); then
			bad "template $_tmpl — vmid $_id carries the name but is still a CONTAINER, not a template"
			todo "finish or discard the interrupted build: devct-template build --vmid $_id"
		else
			bad "template $_tmpl"
			todo "build it: devct-template build"
		fi
	else
		bad "GET /nodes/$DEVCT_NODE/lxc returned HTTP $(devct_code "$_r")"
		todo "the token cannot list containers on node $DEVCT_NODE — check VM.Audit and the node name"
	fi

	if [ -n "$DOCTOR_TODO" ]; then
		printf '\nto fix:%s\n' "$DOCTOR_TODO"
	fi
	if [ "$DOCTOR_FAIL" -eq 0 ]; then
		printf '\nready.\n'
		return 0
	fi
	printf '\nnot ready.\n'
	return 1
}

case "${1:-}" in
doctor) doctor ;;
create)
	shift
	create "$@"
	;;
list) list ;;
destroy)
	shift
	destroy "$@"
	;;
onboard)
	shift
	onboard "$@"
	;;
'' | -h | --help | help) usage ;;
*)
	usage >&2
	devct_die "unknown verb: $1"
	;;
esac
