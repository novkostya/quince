#!/bin/sh
# devct-template — build the dev-container template from scratch on any Proxmox host.
#
# TOKEN-FIRST (docs/specs/devct/devct.md, the review amendment): every step is attempted with the
# scoped API token. Root is not a plan here; a step that the API demonstrably refuses stops the
# build and prints the exact grant or ceremony it needs, so the refusal — not an assumption —
# is what justifies escalating.
#
# The ladder:
#   1  privileges     — measured, not assumed
#   2  appliance      — download the Alpine image versions.env pins
#   3  create         — a container in the pool, authorized key baked in
#   4  provision      — toolset + registry config + warmed cache, over ssh
#   5  stop, convert  — to a template
#   6  stamp, verify
set -eu

DEVCT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH='' cd -- "$DEVCT_ROOT/../.." && pwd)
# shellcheck source=lib.sh
. "$DEVCT_ROOT/lib.sh"

STEP=0
step() {
	STEP=$((STEP + 1))
	printf '\n[%d/6] %s\n' "$STEP" "$1"
}
# refused <http-code> <response-body> <what-is-needed>
refused() {
	# The amendment's contract: name the step, QUOTE THE REFUSAL, name the fix. The body is not
	# optional decoration — it carries the reason ("changing feature flags … is only allowed for
	# root@pam" is a different fact from "403"), and the first version of this handler dropped it,
	# which cost a manual reproduction the tool owed its user. State honesty applies to error
	# output too.
	printf '\nSTEP %d REFUSED BY THE API — HTTP %s\n' "$STEP" "$1" >&2
	printf 'the API said:\n' >&2
	printf '%s\n' "$2" | jq -r '.errors // .message // .' 2>/dev/null | sed 's/^/  /' >&2 ||
		printf '%s\n' "$2" | sed 's/^/  /' >&2
	printf 'needed: %s\n' "$3" >&2
	printf 'This is the evidence the spec asks for: report it, fix it, re-run.\n' >&2
	exit 3
}

usage() {
	cat <<'EOF'
usage: devct-template build [--vmid N] [--keep] [--skip-keyctl]

  build   run the six-step ladder and leave a template behind
          --vmid N       use this container id instead of the cluster's next free one
          --keep         leave the container running instead of converting it (debugging)
          --recreate     destroy an existing in-pool container with this id first, instead
                         of resuming from the first unfinished step
          --skip-keyctl  omit the keyctl flag from the root block — an open measurement:
                         if the container toolchain works without it, that half of the
                         block can be dropped for good (the sshd bootstrap still runs)
EOF
}

# ---------------------------------------------------------------------------

build() {
	devct_need curl jq ssh
	devct_load_conf
	devct_require_conf \
		"api_host=$DEVCT_API_HOST" "node=$DEVCT_NODE" "pool=$DEVCT_POOL" \
		"storage=$DEVCT_STORAGE" "template_storage=$DEVCT_TEMPLATE_STORAGE" \
		"bridge=$DEVCT_BRIDGE" "token_id=$DEVCT_TOKEN_ID" "ssh_key=$DEVCT_SSH_KEY"

	_tmpl_name=${DEVCT_TEMPLATE_NAME:-quince-dev-template}
	_zone=${DEVCT_SDN_ZONE:-localnetwork}
	[ -f "$DEVCT_SSH_KEY" ] || devct_die "ssh_key not found: $DEVCT_SSH_KEY"

	# ---- 1: privileges -----------------------------------------------------
	step "privileges — measuring what the token holds"
	_lack=''
	lack() { _lack="$_lack
  $1 on $2"; }
	# Pool.Allocate is here on the reviewer's report that it was granted during the step-3
	# diagnosis and may have been independently required for create-into-pool — its necessity is
	# MASKED, not measured. To settle it: revoke it, re-run the ladder, and see whether create
	# still succeeds. Listed with that caveat rather than quietly becoming folklore.
	for _p in VM.Allocate VM.Clone VM.Config.Network VM.PowerMgmt VM.Audit Pool.Allocate; do
		devct_has_priv "/pool/$DEVCT_POOL" "$_p" || lack "$_p" "/pool/$DEVCT_POOL"
	done
	devct_has_priv "/storage/$DEVCT_STORAGE" Datastore.AllocateSpace ||
		lack Datastore.AllocateSpace "/storage/$DEVCT_STORAGE"
	devct_has_priv "/storage/$DEVCT_TEMPLATE_STORAGE" Datastore.AllocateTemplate ||
		lack Datastore.AllocateTemplate "/storage/$DEVCT_TEMPLATE_STORAGE (the vztmpl storage — NOT the rootfs storage)"
	# Measured in run 4: creating a container FROM an ostemplate reads the storage holding it, so
	# downloading a template and consuming one are two different permissions. PVE accepts
	# AllocateSpace or Audit; Audit is the read-only half, which is the one to ask for.
	devct_has_priv "/storage/$DEVCT_TEMPLATE_STORAGE" Datastore.Audit ||
		lack Datastore.Audit "/storage/$DEVCT_TEMPLATE_STORAGE (to consume the template at create)"
	devct_has_priv "/sdn/zones/$_zone/$DEVCT_BRIDGE" SDN.Use ||
		lack SDN.Use "/sdn/zones/$_zone/$DEVCT_BRIDGE"
	if [ -n "$_lack" ]; then
		printf 'missing privileges:%s\n' "$_lack" >&2
		devct_die "grant these on $DEVCT_TOKEN_ID and re-run (devct doctor reports the same set)"
	fi
	devct_info "  all required privileges held"

	# ---- 2: appliance ------------------------------------------------------
	# The template tracks the Alpine line versions.env pins, so "rebuild on versions.env change"
	# has a mechanical meaning rather than being a note in a doc.
	step "appliance — the Alpine image versions.env pins"
	_alpine=$(sed -n 's/^ALPINE_VERSION=//p' "$REPO_ROOT/versions.env")
	[ -n "$_alpine" ] || devct_die "ALPINE_VERSION not found in $REPO_ROOT/versions.env"
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/aplinfo") ||
		refused "$(devct_code "$_r")" "$(devct_body "$_r")" \
			"Datastore.Audit on /storage/$DEVCT_TEMPLATE_STORAGE (to read the appliance index)"
	_appliance=$(devct_body "$_r" | jq -r --arg v "alpine-$_alpine" \
		'[.data[] | select(.template | startswith($v)) | .template] | sort | last // empty')
	[ -n "$_appliance" ] || devct_die "no Alpine $_alpine appliance offered by this node"
	devct_info "  $_appliance"

	_volid="$DEVCT_TEMPLATE_STORAGE:vztmpl/$_appliance"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/aplinfo" \
		"storage=$DEVCT_TEMPLATE_STORAGE" "template=$_appliance") ||
		refused "$(devct_code "$_r")" "$(devct_body "$_r")" \
			"Datastore.AllocateTemplate on /storage/$DEVCT_TEMPLATE_STORAGE — note this is the storage that holds vztmpl content, NOT the container rootfs storage"
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')" || devct_die "appliance download failed"
	devct_info "  downloaded to $_volid"

	# ---- 3: create ---------------------------------------------------------
	step "create — container in the pool, authorized key baked in"
	if [ -z "${VMID:-}" ]; then
		_r=$(devct_api GET /cluster/nextid) || devct_die "cannot read /cluster/nextid"
		VMID=$(devct_body "$_r" | jq -r '.data')
	fi
	devct_info "  vmid $VMID"

	# Resume. A ladder that can only run on a clean box turns any mid-run failure into an orphan
	# plus a manual destroy — which is what its own first hardware run produced. An existing
	# in-pool container with this id is therefore resumed from the first UNFINISHED step, each
	# skip announced; --recreate takes the clean path by destroying it first (token-only).
	if verify_in_pool "$VMID"; then
		if [ -n "${RECREATE:-}" ]; then
			devct_info "  --recreate: destroying the existing container $VMID"
			destroy_ct "$VMID" || devct_die "could not destroy $VMID"
			create_ct "$_volid" "$_tmpl_name"
		elif is_template "$VMID"; then
			# Already converted: the ladder is done for this id. A template cannot be started,
			# so trying to "resume" one would fail on its own success.
			devct_info "  vmid $VMID is ALREADY a template — nothing left to build"
			devct_info "  (--recreate rebuilds it from scratch)"
			printf '\ntemplate %s (vmid %s) is present and converted.\n' "$_tmpl_name" "$VMID"
			return 0
		else
			devct_info "  container $VMID already exists in the pool — RESUMING from the first unfinished step"
			devct_info "  (--recreate destroys it and takes the clean path instead)"
			ensure_running "$VMID" || devct_die "container $VMID will not start"
		fi
	else
		create_ct "$_volid" "$_tmpl_name"
	fi

	root_bootstrap

	# ---- 4: provision ------------------------------------------------------
	# No hypervisor privilege at all here: this is session-host-to-container ssh, the same path
	# `devct create` uses to inject secrets.
	step "provision — toolset, registry config, warmed cache (over ssh)"
	_ip=$(wait_for_ip "$VMID") || devct_die "container never reported an address"
	devct_info "  $_tmpl_name is up"
	wait_for_ssh "$_ip" || devct_die "ssh never came up on the container"

	_stamp="alpine=$_alpine versions=$(versions_digest) built=${DEVCT_BUILD_DATE:-unknown}"
	provision_script "$_stamp" | ssh -o StrictHostKeyChecking=accept-new "root@$_ip" 'sh -s' ||
		devct_die "provisioning failed"
	devct_info "  provisioned"

	if [ -n "${KEEP:-}" ]; then
		printf '\n--keep: container %s left running at %s (not converted)\n' "$VMID" "$_ip"
		exit 0
	fi

	# ---- 5: stop + convert -------------------------------------------------
	# The one step no lookup settled: whether conversion is covered by the pool's container
	# privileges. It answers for itself here, which is the point.
	step "stop, then convert to a template"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc/$VMID/status/stop") ||
		refused "$(devct_code "$_r")" "$(devct_body "$_r")" "VM.PowerMgmt on /pool/$DEVCT_POOL"
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')" || devct_die "stop failed"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc/$VMID/template") ||
		refused "$(devct_code "$_r")" "$(devct_body "$_r")" \
			"the container-to-template conversion privilege — the one the spec recorded as unmeasured; this refusal is its measurement"
	devct_info "  converted"

	# ---- 6: verify ---------------------------------------------------------
	# The conversion POST returns before the flag is visible, so this polls instead of asserting
	# instantly — the first run "failed" here on a template that had in fact been built, which is
	# a false negative and therefore just as much a state-honesty bug as a false positive.
	step "verify"
	is_template "$VMID" 60 ||
		devct_die "vmid $VMID did not become a template within 60s of a successful conversion"
	printf '\ntemplate %s (vmid %s) built.\n' "$_tmpl_name" "$VMID"
	printf 'stamp: %s\n' "$_stamp"
	printf 'no root was used.\n'
}

# THE ONE ROOT BLOCK (Operator ruling, 2026-07-25). Everything the API cannot do lives here,
# announced before it runs. The readable invariant is deliberate: root touches the box exactly
# once, at template build, and never again — not a root command sprinkled wherever one is handy.
#
# Two things need it, both measured rather than assumed:
#   - keyctl: PVE lets a non-root user set nesting and nothing else (root@pam by design), so no
#     ACL can ever cover it.
#   - the first shell: provisioning runs over ssh, and the Alpine appliance ships no sshd — ssh
#     is the one tool that cannot bootstrap itself. pct exec is the authorized bootstrap,
#     bounded to a pool-verified vmid during template builds.
#
# A no-root alternative was verified and is NOT used: POST .../lxc/<vmid>/termproxy answers 200
# on the scoped token, so a console channel exists if this class is ever narrowed. It costs a
# websocket console driven from shell, which is why the ruling took pct exec instead.
root_bootstrap() {
	verify_in_pool "$VMID" || devct_die "vmid $VMID is not in pool $DEVCT_POOL — refusing to run root commands against it"

	# On a resume, root is not re-entered for work already done. Both halves are checked against
	# the box: the flag against the container's config, ssh against the box itself. Root that is
	# not needed is root that is not taken.
	_need_keyctl=1
	_need_sshd=1
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc/$VMID/config") &&
		case "$(devct_body "$_r" | jq -r '.data.features // ""')" in
		*keyctl=1*) _need_keyctl='' ;;
		esac
	if _ip=$(wait_for_ip "$VMID" 15) && ssh -n -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 \
		-o BatchMode=yes "root@$_ip" true 2>/dev/null; then
		_need_sshd=''
	fi
	if [ -z "$_need_keyctl" ] && [ -z "$_need_sshd" ]; then
		printf '\n  ROOT BLOCK — not needed: keyctl is already set and ssh already answers.\n'
		return 0
	fi

	# The block carries only what this box still needs — the create already set nesting, and a
	# resume may need one half and not the other.
	#
	# Positional parameters, NOT a `printf | while read` pipeline. Two POSIX traps killed that
	# shape on hardware: (1) ssh inherits the pipe as its stdin and swallows the remaining
	# commands, so only the first ever ran; (2) the right side of a pipeline is a subshell, so
	# `devct_die` in the loop body killed the subshell while the parent sailed on and printed
	# `done.`. Together they announced four commands, ran one, and claimed success.
	set --
	if [ -n "$_need_keyctl" ] && [ -z "${SKIP_KEYCTL:-}" ]; then
		set -- "$@" "pct set $VMID -features nesting=1,keyctl=1"
	fi
	if [ -n "$_need_sshd" ]; then
		set -- "$@" \
			"pct exec $VMID -- apk add --no-cache openssh" \
			"pct exec $VMID -- rc-update add sshd default" \
			"pct exec $VMID -- service sshd start"
	fi
	[ $# -gt 0 ] || {
		printf '\n  ROOT BLOCK — nothing left for it to do on this container.\n'
		return 0
	}

	printf '\n  ROOT BLOCK (the ruled fallback — the API cannot do these)\n'
	printf '    scope: vmid %s, verified in pool %s; once per template rebuild.\n' "$VMID" "$DEVCT_POOL"
	printf '    after this block, nothing in devct needs root again — clones inherit features,\n'
	printf '    and devct create is pure-token.\n'
	if [ -n "${SKIP_KEYCTL:-}" ]; then
		printf '    --skip-keyctl: building WITHOUT the keyctl flag, to measure whether the\n'
		printf '    container toolchain needs it. If step 4 warms the cache and the gates run,\n'
		printf '    that half of this block can be dropped for good.\n'
	fi
	for _c in "$@"; do printf '      %s\n' "$_c"; done

	[ -n "$DEVCT_ROOT_SSH" ] || {
		printf '\n  root_ssh is not set, so this block cannot run unattended.\n' >&2
		printf '  Run the commands above on the hypervisor, then re-run with --vmid %s —\n' "$VMID" >&2
		printf '  the ladder resumes from the first unfinished step.\n' >&2
		printf '  (R3(2b): that access should be an authorized_keys entry carrying expiry-time.)\n' >&2
		exit 4
	}
	# -n: ssh must not read this shell's stdin. Without it, an ssh in a loop eats whatever is
	# feeding that loop — which is exactly how three of these four commands disappeared.
	for _c in "$@"; do
		ssh -n -o StrictHostKeyChecking=accept-new "$DEVCT_ROOT_SSH" "$_c" ||
			devct_die "root block failed at: $_c — fix it, then re-run with --vmid $VMID"
	done

	# Verify the postcondition rather than trusting exit codes. "done." is a success claim, and a
	# success claim about work that did not happen is the same lie as a dishonest error — this
	# block printed it once while having run one command in four.
	if [ -z "${SKIP_KEYCTL:-}" ]; then
		_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc/$VMID/config") &&
			case "$(devct_body "$_r" | jq -r '.data.features // ""')" in
			*keyctl=1*) ;;
			*) devct_die "root block ran but keyctl is still not set on $VMID" ;;
			esac
	fi
	_ip=$(wait_for_ip "$VMID") || devct_die "root block ran but the container reports no address"
	wait_for_ssh "$_ip" ||
		devct_die "root block ran but sshd is not answering on $VMID — the commands reported success, the box disagrees"
	printf '    done — verified: keyctl set, sshd answering.\n'
}

# `nesting` is the only feature flag PVE lets a non-root user set; `keyctl` is root@pam BY DESIGN
# — no ACL can grant it (measured: HTTP 403 "changing feature flags (except nesting) is only
# allowed for root@pam"). So the create runs on the token WITHOUT keyctl, and the root block adds
# it. Clones inherit features from the template, so that root touch happens once per TEMPLATE
# REBUILD — `devct create` never needs root at all.
create_ct() {
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc" \
		"vmid=$VMID" \
		"ostemplate=$1" \
		"hostname=$2" \
		"pool=$DEVCT_POOL" \
		"storage=$DEVCT_STORAGE" \
		"rootfs=$DEVCT_STORAGE:${DEVCT_ROOTFS_GB:-32}" \
		"cores=${DEVCT_CORES:-4}" \
		"memory=${DEVCT_MEMORY_MB:-8192}" \
		"swap=0" \
		"unprivileged=1" \
		"features=nesting=1" \
		"net0=name=eth0,bridge=$DEVCT_BRIDGE,ip=dhcp" \
		"ssh-public-keys=$(cat "$DEVCT_SSH_KEY")" \
		"start=1") ||
		refused "$(devct_code "$_r")" "$(devct_body "$_r")" \
			"container create in /pool/$DEVCT_POOL — SDN.Use on the bridge and Pool.Allocate on the pool are the usual culprits"
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')" || devct_die "container create failed"
	devct_info "  created and started (features: nesting only)"
}

destroy_ct() {
	verify_in_pool "$1" || devct_die "vmid $1 is not in pool $DEVCT_POOL — refusing to destroy it"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc/$1/status/stop") &&
		devct_task_wait "$(devct_body "$_r" | jq -r '.data')" || true
	_r=$(devct_api DELETE "/nodes/$DEVCT_NODE/lxc/$1") ||
		refused "$(devct_code "$_r")" "$(devct_body "$_r")" "VM.Allocate on /pool/$DEVCT_POOL (to destroy)"
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')"
}

ensure_running() {
	_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc/$1/status/current") || return 1
	case "$(devct_body "$_r" | jq -r '.data.status')" in
	running) return 0 ;;
	esac
	devct_info "  container is stopped — starting it"
	_r=$(devct_api POST "/nodes/$DEVCT_NODE/lxc/$1/status/start") || return 1
	devct_task_wait "$(devct_body "$_r" | jq -r '.data')"
}

# is_template <vmid> [seconds] — poll until the conversion flag is visible.
is_template() {
	_n=0
	while :; do
		_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc/$1/config") &&
			[ "$(devct_body "$_r" | jq -r '.data.template // 0')" = 1 ] && return 0
		[ "$_n" -ge "${2:-0}" ] && return 1
		sleep 5
		_n=$((_n + 5))
	done
}

# The guard the ruling names: root commands are only ever aimed at a vmid this token owns.
verify_in_pool() {
	_r=$(devct_api GET "/pools/$DEVCT_POOL") || return 1
	devct_body "$_r" | jq -e --arg v "$1" '.data.members[]? | select((.vmid|tostring)==$v)' >/dev/null 2>&1
}

versions_digest() {
	# Ties the template to the pins it was built from; `devct create` compares this and says so
	# when they diverge, rather than handing out a silently stale box.
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$REPO_ROOT/versions.env" | cut -c1-12
	else
		shasum -a 256 "$REPO_ROOT/versions.env" | cut -c1-12
	fi
}

wait_for_ip() {
	_vmid=$1
	_n=0
	while [ "$_n" -lt "${2:-60}" ]; do
		_r=$(devct_api GET "/nodes/$DEVCT_NODE/lxc/$_vmid/interfaces") && {
			_addr=$(devct_body "$_r" | jq -r '[.data[]? | select(.name!="lo") | .inet // empty] | first // empty' | cut -d/ -f1)
			[ -n "$_addr" ] && {
				printf '%s\n' "$_addr"
				return 0
			}
		}
		sleep 5
		_n=$((_n + 5))
	done
	return 1
}

wait_for_ssh() {
	_n=0
	while [ "$_n" -lt 120 ]; do
		ssh -n -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -o BatchMode=yes \
			"root@$1" true 2>/dev/null && return 0
		sleep 5
		_n=$((_n + 5))
	done
	return 1
}

# The provisioning body runs INSIDE the container, fed over ssh on stdin. Site specifics arrive
# as values, never baked into the committed text.
#
# The heredocs below are UNQUOTED so the caller's values interpolate — which means backticks and
# $ inside them execute HERE, on the session host, not in the container. Keep prose out of them.
# (Found by running it: a comment containing backticks ran `apk info -L buildkit` locally.)
#
# buildctl is its own Alpine package: buildkit ships only the DAEMON (usr/bin/buildkitd), and
# nerdctl needs the CLIENT to reach it — without it, "no buildkit host is available … buildctl:
# executable file not found". Verified against the v3.24 community index at fix time
# (buildctl 0.29.0-r1) and installed successfully on the box.
provision_script() {
	cat <<EOF
set -eu
apk update
apk add --no-cache git make openssh-client curl jq containerd nerdctl buildkit buildctl
rc-update add containerd default 2>/dev/null || true
rc-update add buildkitd default 2>/dev/null || true
service containerd start || true
service buildkitd start || true
apk add --no-cache github-cli || echo "note: github-cli not in this Alpine line; gh omitted"
printf '%s\n' "$1" > /etc/quince-devct-stamp
EOF
	if [ -n "${DEVCT_REGISTRY:-}" ]; then
		cat <<EOF
mkdir -p /etc/containerd/certs.d/${DEVCT_REGISTRY%%/*}
cat > /etc/containerd/certs.d/${DEVCT_REGISTRY%%/*}/hosts.toml <<'TOML'
server = "https://${DEVCT_REGISTRY%%/*}"
[host."https://${DEVCT_REGISTRY%%/*}"]
  capabilities = ["pull", "resolve", "push"]
TOML
EOF
	fi
	# Warm the buildkit cache with the real toolchain images, which is what makes a fresh
	# container reach a green gate in minutes rather than re-pulling everything.
	# Idempotent, because a resumed build re-runs this whole script.
	cat <<'EOF'
if [ -d /root/quince/.git ]; then
	git -C /root/quince fetch --depth 1 origin main && git -C /root/quince reset --hard origin/main
else
	git clone --depth 1 https://github.com/novkostya/quince.git /root/quince
fi
make -C /root/quince toolchains
EOF
}

case "${1:-}" in
build)
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
		--vmid)
			VMID=$2
			shift 2
			;;
		--recreate)
			RECREATE=1
			shift
			;;
		--keep)
			KEEP=1
			shift
			;;
		--skip-keyctl)
			SKIP_KEYCTL=1
			shift
			;;
		*)
			usage >&2
			devct_die "unknown option: $1"
			;;
		esac
	done
	build
	;;
'' | -h | --help | help) usage ;;
*)
	usage >&2
	devct_die "unknown verb: $1"
	;;
esac
