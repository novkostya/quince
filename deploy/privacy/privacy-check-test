#!/bin/sh
# privacy-check-test — the failure paths of the privacy gate, asserted.
#
# quince#41 is a bug about a gate that PASSES WHEN IT CANNOT RUN. A fix for that is not
# demonstrated by the gate reporting clean; it is demonstrated by the gate reporting
# FAILURE on inputs where failure is correct. So every case below asserts a non-zero exit
# and the reason attached to it, and the clean cases exist only to prove the failures are
# not the script refusing everything.
#
# Every fixture is SYNTHETIC — its own throwaway git repo and its own fake pattern list.
# Nothing here reads the Operator's private layer, so this suite runs on ANY box, including
# CI and a contributor's laptop. That property is the point: the failure path of a gate that
# only some boxes can run must be testable on all of them.
set -eu

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# Overridable so the NEGATIVE CONTROL is reproducible by a reviewer rather than a thing the author
# did once by hand and reported — the same hook, for the same reason, as PR_TITLE_REFS_BIN. Point it
# at an older copy of the gate and the assertions that pin a fix must FAIL.
CHECK="${PRIVACY_CHECK_BIN:-$HERE/privacy-check}"
[ -x "$CHECK" ] || { printf 'privacy-check-test: %s is not executable\n' "$CHECK" >&2; exit 2; }

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM

pass=0
fail=0

# --- assertions ---------------------------------------------------------------------------
# Each check asserts the exit CODE and a substring of the output, because the code alone
# cannot tell "refused because there is no list" from "refused because a pattern matched" —
# and conflating those two is how the original defect read as clean.
# Run a command in a directory. NOT `env -C`, which is GNU-only: busybox env rejects it, and
# busybox is what /bin/grep and much of this box is. A suite that only runs on GNU userland
# would be testing the gate on a platform the gate does not run on.
at() { d=$1; shift; (cd "$d" && exec "$@"); }

# A SYNTHETIC floor, exported so every case uses it instead of the repo's real one — these fixtures
# carry 1–2 patterns and the real floor is 9, so without this the suite would be asserting the size
# of the Operator's list. Exporting also overrides any ambient PRIVACY_FLOOR_FILE, so the suite
# cannot read the box: the lesson preflight-test learned the hard way, applied before it bites here.
FLOOR_OK="$TMP/floor-1"
printf '# synthetic floor\n1\n' >"$FLOOR_OK"
export PRIVACY_FLOOR_FILE="$FLOOR_OK"

expect() { # <name> <want-exit> <want-substring> -- <command...>
	name=$1 want=$2 substr=$3
	shift 4 # name, want, substr, and the literal --
	out=$("$@" 2>&1) && got=0 || got=$?
	if [ "$got" -ne "$want" ]; then
		printf 'FAIL %s\n  wanted exit %s, got %s\n' "$name" "$want" "$got"
		printf '%s\n' "$out" | sed 's/^/    | /'
		fail=$((fail + 1))
		return 0
	fi
	if [ -n "$substr" ] && ! printf '%s\n' "$out" | grep -qF "$substr"; then
		printf 'FAIL %s\n  exit %s was right, but output lacked: %s\n' "$name" "$got" "$substr"
		printf '%s\n' "$out" | sed 's/^/    | /'
		fail=$((fail + 1))
		return 0
	fi
	printf 'ok   %s (exit %s)\n' "$name" "$got"
	pass=$((pass + 1))
}

# --- fixture builders -----------------------------------------------------------------------
# The synthetic patterns are deliberately absurd strings, so a fixture can never accidentally
# match real content, and the case-sensitive one mirrors the SHAPE of the device-name heuristic
# from quince#41 req 3 without being it.
make_patterns() { # <dir>
	mkdir -p "$1"
	cat >"$1/privacy-patterns.txt" <<'EOF'
# synthetic — case-insensitive list
zzsecrethostzz
203\.0\.113\.[0-9]{1,3}
EOF
}
make_cs_patterns() { # <dir>
	cat >"$1/privacy-patterns-cs.txt" <<'EOF'
# synthetic — case-SENSITIVE list. Relies on case discrimination, which is exactly the
# class that becomes meaningless when the whole set is run under -i (quince#41 req 3).
Quince[A-Z][a-z]+
EOF
}

# A git repo whose branch carries `content` in a file, COMMITTED — the state the old gate was
# blind to, because `git diff --cached` is empty once you have committed.
make_repo() { # <dir> <file-content> [commit-subject]
	repo=$1 content=$2 subject=${3:-add a file}
	mkdir -p "$repo"
	git -C "$repo" init -q -b main
	git -C "$repo" config user.email fixture@example.invalid
	git -C "$repo" config user.name 'fixture'
	echo "baseline" >"$repo/README.md"
	git -C "$repo" add -A
	git -C "$repo" commit -qm "baseline"
	git -C "$repo" checkout -q -b topic
	printf '%s\n' "$content" >"$repo/notes.md"
	git -C "$repo" add -A
	git -C "$repo" commit -qm "$subject"
}

# =============================================================================================
# 1. THE GATE CANNOT RUN  →  exit 2, never 0
# =============================================================================================

# The original defect, verbatim: no pattern list. The old implementation printed
# "…(contributor/CI box) — skipped" and exited 0, so every PR in the 2026-07-26 cycle had to
# hand-declare that the sweep had not really run in order to stop that 0 reading as clean.
empty_dir="$TMP/no-patterns"
mkdir -p "$empty_dir"
expect "absent pattern list refuses" 2 "DID NOT RUN" -- \
	"$CHECK" --patterns "$empty_dir"

# An empty list is the same vacuous pass wearing a costume: the file exists, so `test -f`
# is satisfied, and it matches nothing forever.
zero_dir="$TMP/empty-patterns"
mkdir -p "$zero_dir"
: >"$zero_dir/privacy-patterns.txt"
expect "empty pattern list refuses" 2 "EMPTY" -- \
	"$CHECK" --patterns "$zero_dir"

# A list of nothing but comments and blank lines passes `test -s` and still matches nothing.
comment_dir="$TMP/comments-only"
mkdir -p "$comment_dir"
printf '# only a comment\n\n' >"$comment_dir/privacy-patterns.txt"
expect "comments-only list refuses" 2 "no usable patterns" -- \
	"$CHECK" --patterns "$comment_dir"

# An unusable matcher must refuse rather than fall back to whatever the environment offers. The
# gate really does run under two implementations — busybox on the boxes, GNU grep in CI — and a
# gate that silently picks one is a gate whose semantics depend on where it ran. (This suite is
# green under both: measured on busybox here and on GNU grep 3.11 in a Noble container.)
good="$TMP/good"
make_patterns "$good"
expect "missing matcher refuses" 2 "not found" -- \
	env PRIVACY_GREP=/nonexistent/definitely-not-a-grep "$CHECK" --patterns "$good"

# A typo'd flag must not read as a clean sweep.
expect "unknown argument refuses" 2 "DID NOT RUN" -- \
	"$CHECK" --patterns "$good" --no-such-flag

# A --text file that cannot be read is a sweep that did not happen.
expect "unreadable --text refuses" 2 "not readable" -- \
	"$CHECK" --patterns "$good" --text "$TMP/does-not-exist"

# AND NEITHER IS AN EMPTY ONE (quince#237). The readability guard above was the only one, and an
# empty file is perfectly readable: `add_source` dropped it silently, the scope line still announced
# `+ text`, and the gate printed `clean` and exited 0. That is the invocation CLAUDE.md prescribes
# before every merge reporting a clean sweep of a PR body it never read — and the way a body file
# becomes empty is a FAILED FETCH, so the gate degraded exactly when something upstream had already
# gone wrong.
#
# TWO ASSERTIONS, because the exit code alone would pass against a refusal for any other reason, and
# it is the WORD "EMPTY" that separates "I refused to sweep nothing" from "I could not find the file".
: >"$TMP/empty-body.md"
expect "an EMPTY --text refuses rather than sweeping nothing" 2 "DID NOT RUN" -- \
	"$CHECK" --patterns "$good" --text "$TMP/empty-body.md"
expect "…and says the file was EMPTY, naming the path the caller passed" 2 "is EMPTY" -- \
	"$CHECK" --patterns "$good" --text "$TMP/empty-body.md"
# The control for both: a --text with content must still sweep, and must appear in the SWEPT line.
# Without this the refusal could be satisfied by rejecting every --text, and the suite would not
# notice that the flag had stopped working entirely.
printf 'an ordinary body with nothing private in it\n' >"$TMP/full-body.md"
expect "a NON-empty --text is swept, and the swept line names it" 0 "text" -- \
	"$CHECK" --patterns "$good" --text "$TMP/full-body.md"

# =============================================================================================
# 2. THE GATE CAN RUN AND SOMETHING MATCHES  →  exit 1
# =============================================================================================

# The whole-branch hole (quince#41 req 2). The violation is COMMITTED, so the staged diff is
# empty. The default mode is a commit-time gate and correctly reports clean on an empty stage —
# and that is precisely why a --ref mode has to exist, or /land's "re-check the whole branch
# diff before a merge" has no gate behind it at all.
committed="$TMP/committed"
make_repo "$committed" "the host is zzsecrethostzz today"
# …and the staged-diff mode must not call that "clean". The scope is empty, so there is nothing
# to be clean ABOUT — borrowing the word is how a vacuous pass gets ticked as a real one.
expect "empty staged scope says NOTHING TO SWEEP, not clean" 0 "NOTHING TO SWEEP" -- \
	at "$committed" "$CHECK" --patterns "$good"
expect "committed violation IS caught by whole-branch mode" 1 "PRIVACY VIOLATION" -- \
	at "$committed" "$CHECK" --patterns "$good" --ref main...HEAD
expect "whole-branch hit names its source" 1 "branch-diff:" -- \
	at "$committed" "$CHECK" --patterns "$good" --ref main...HEAD

# Commit messages are public history under the same rule as the diff, and no gate covered them.
msgrepo="$TMP/msg"
make_repo "$msgrepo" "nothing private here" "wire up 203.0.113.42 for the demo"
expect "commit message violation is caught" 1 "commit-message:" -- \
	at "$msgrepo" "$CHECK" --patterns "$good" --ref main...HEAD

# --- AUTHOR AND COMMITTER IDENTITY (quince#196) ------------------------------------------------
# THE POSITIVE CONTROL quince#196 asks for, and the reason it belongs here rather than in the
# private list: this asserts the MECHANISM — that the field reaches the matcher at all — using a
# synthetic identity, so it holds whatever the real pattern list happens to contain. quince#196's
# two defects are independent (the field was unread AND the list lacked the value), and fixing
# either alone still lets a leak through. This gates the first one permanently.
#
# The identity is set per-commit via env rather than `git config`, so author and committer can be
# made to differ — which is the whole point of the second case below.
identrepo="$TMP/ident"
make_repo "$identrepo" "nothing private here" "an ordinary subject"
(
	cd "$identrepo"
	printf 'more\n' >>notes.md
	git add -A
	GIT_AUTHOR_NAME='zzsecrethostzz' GIT_AUTHOR_EMAIL='a@example.invalid' \
		git commit -qm "an innocent subject"
) || true
expect "an AUTHOR identity violation is caught" 1 "commit-identity:" -- \
	at "$identrepo" "$CHECK" --patterns "$good" --ref main...HEAD

# COMMITTER, not author — they differ on every rebase and every `--amend` by another hand, so a
# sweep that read only `%an` would pass a branch whose committer carries the leak. Author here is
# deliberately clean, so only the committer field can produce the hit.
crepo="$TMP/committer"
make_repo "$crepo" "nothing private here" "an ordinary subject"
(
	cd "$crepo"
	printf 'more\n' >>notes.md
	git add -A
	GIT_COMMITTER_NAME='zzsecrethostzz' GIT_COMMITTER_EMAIL='c@example.invalid' \
		git commit -qm "an innocent subject"
) || true
expect "a COMMITTER identity violation is caught, with a clean author" 1 "commit-identity:" -- \
	at "$crepo" "$CHECK" --patterns "$good" --ref main...HEAD

# THE CONTROL, and it needs its own repo. Without it the two cases above would pass just as well
# against a gate that flagged every commit, and the suite would be measuring nothing. `make_repo`'s
# default identity is `fixture <fixture@example.invalid>`, which matches no pattern.
#
# The first draft of this case reused $msgrepo and passed `--text /dev/null` to force a scope. Both
# were wrong: $msgrepo carries a commit-message violation on purpose, and an empty explicitly-named
# --text is now a refusal (quince#237) — so it exited 2 and the fix caught my own test. Recorded
# because a control that fails for the wrong reason is worse than no control.
cleanident="$TMP/clean-ident"
make_repo "$cleanident" "nothing private here" "an ordinary subject"
expect "an ordinary identity is clean — the control for both cases above" 0 "clean" -- \
	at "$cleanident" "$CHECK" --patterns "$good" --ref main...HEAD
expect "the scope line names the FIELDS it swept, not just the categories" 1 "author:name,email" -- \
	at "$identrepo" "$CHECK" --patterns "$good" --ref main...HEAD

# …but ONLY the branch's own commits. `git diff A...B` is merge-base→B while `git log A...B` is
# the SYMMETRIC difference, so one $REF string read by two commands swept commits that are only
# on the base — failing a branch over a message its author never wrote. Safe direction (a false
# positive), but it fires whenever main is ahead, which is the normal state of a queued PR under
# strict up-to-date protection and the state /land creates by rebasing.
basejunk="$TMP/base-junk"
mkdir -p "$basejunk"
git -C "$basejunk" init -q -b main
git -C "$basejunk" config user.email fixture@example.invalid
git -C "$basejunk" config user.name 'fixture'
echo baseline >"$basejunk/README.md"
git -C "$basejunk" add -A
git -C "$basejunk" commit -qm "baseline"
git -C "$basejunk" checkout -q -b topic
echo "ordinary branch content" >"$basejunk/notes.md"
git -C "$basejunk" add -A
git -C "$basejunk" commit -qm "an ordinary branch commit"
# main moves ahead with a commit the branch does not contain, whose MESSAGE would match.
git -C "$basejunk" checkout -q main
echo more >>"$basejunk/README.md"
git -C "$basejunk" add -A
git -C "$basejunk" commit -qm "a base-only commit mentioning zzsecrethostzz"
git -C "$basejunk" checkout -q topic
expect "a commit only on the BASE is not swept" 0 "clean" -- \
	at "$basejunk" "$CHECK" --patterns "$good" --ref main...HEAD
# The two-dot form must keep working — --right-only is a no-op there (measured, not assumed).
expect "two-dot range still sweeps the branch" 0 "clean" -- \
	at "$basejunk" "$CHECK" --patterns "$good" --ref main..HEAD

# PR text is written by a session and reaches the forge without ever passing through git.
prtext="$TMP/pr-body.md"
printf 'The deploy answered on zzsecrethostzz.\n' >"$prtext"
clean_repo="$TMP/clean"
make_repo "$clean_repo" "entirely ordinary content"
expect "PR text violation is caught" 1 "text:" -- \
	at "$clean_repo" "$CHECK" --patterns "$good" --ref main...HEAD --text "$prtext"

# The staged-diff mode still works — the commit-time gate is the one that must not regress.
staged="$TMP/staged"
make_repo "$staged" "ordinary"
printf 'contact 203.0.113.9\n' >"$staged/leak.md"
git -C "$staged" add leak.md
expect "staged diff mode still catches a violation" 1 "staged-diff:" -- \
	at "$staged" "$CHECK" --patterns "$good"

# =============================================================================================
# 3. THE CASE SPLIT IS REAL  (quince#41 req 3)
# =============================================================================================
# Run wholesale under -i, a pattern that relies on case discrimination is not merely noisy —
# it is meaningless, and a recurring false positive on ordinary prose trains the sweeper to
# wave that pattern through. These two cases prove the case-sensitive list keeps its case.
split="$TMP/split"
make_patterns "$split"
make_cs_patterns "$split"

cs_hit="$TMP/cs-hit"
make_repo "$cs_hit" "the box is called QuinceRunner in the lab"
expect "case-sensitive list matches the cased form" 1 "PRIVACY VIOLATION" -- \
	at "$cs_hit" "$CHECK" --patterns "$split" --ref main...HEAD

cs_miss="$TMP/cs-miss"
make_repo "$cs_miss" "the quincerunner conventions are ordinary prose"
expect "case-sensitive list does NOT match the lowercased form" 0 "clean" -- \
	at "$cs_miss" "$CHECK" --patterns "$split" --ref main...HEAD

# The case-INSENSITIVE list keeps ignoring case, so the split does not quietly harden it.
ci_case="$TMP/ci-case"
make_repo "$ci_case" "shouting about ZZSECRETHOSTZZ"
expect "case-insensitive list still ignores case" 1 "PRIVACY VIOLATION" -- \
	at "$ci_case" "$CHECK" --patterns "$split" --ref main...HEAD

# Absence of the case-sensitive list is a DEGRADED MODE and must be announced, not swallowed.
expect "missing case-sensitive list is announced" 0 "NO case-sensitive list" -- \
	at "$cs_miss" "$CHECK" --patterns "$good" --ref main...HEAD

# =============================================================================================
# 4. A CLEAN RESULT SAYS WHAT IT SWEPT  (so a vacuous run is visible)
# =============================================================================================
expect "clean names the pattern count" 0 "against 2 patterns" -- \
	at "$clean_repo" "$CHECK" --patterns "$good" --ref main...HEAD
expect "clean names the matcher" 0 "matcher" -- \
	at "$clean_repo" "$CHECK" --patterns "$good" --ref main...HEAD

# =============================================================================================
# 5. THE CANARY — patterns that compile but match nothing  (the architect's finding on #44)
# =============================================================================================
# Everything above proves the patterns COMPILE. Only a known-positive probe proves they MATCH,
# which is the property that actually fails when a box's grep differs from the one the list was
# authored against.
canary_ok="$TMP/canary-ok"
make_patterns "$canary_ok"
printf 'zzsecrethostzz\n' >"$canary_ok/privacy-canary.txt"
expect "a matching canary passes and says so" 0 "canary ok" -- \
	at "$clean_repo" "$CHECK" --patterns "$canary_ok" --ref main...HEAD

canary_bad="$TMP/canary-bad"
make_patterns "$canary_bad"
printf 'this string matches none of the patterns\n' >"$canary_bad/privacy-canary.txt"
expect "a canary that matches nothing REFUSES" 2 "matched NOTHING" -- \
	at "$clean_repo" "$CHECK" --patterns "$canary_bad" --ref main...HEAD

# The SAME probe with no trailing newline. Plain `read` discards an unterminated final line, so
# a single-probe canary was skipped entirely — while the "canary ok" line still printed. Same
# bytes, opposite verdicts, decided by one invisible character; and a hand-written first canary
# is exactly where a missing \n comes from.
canary_noeol="$TMP/canary-noeol"
make_patterns "$canary_noeol"
printf 'this string matches none of the patterns' >"$canary_noeol/privacy-canary.txt"
expect "an UNTERMINATED failing canary probe still REFUSES" 2 "matched NOTHING" -- \
	at "$clean_repo" "$CHECK" --patterns "$canary_noeol" --ref main...HEAD

# …and the unterminated PASSING case must still be seen, not merely not-crash.
canary_noeol_ok="$TMP/canary-noeol-ok"
make_patterns "$canary_noeol_ok"
printf 'zzsecrethostzz' >"$canary_noeol_ok/privacy-canary.txt"
expect "an UNTERMINATED matching canary probe is honoured" 0 "canary ok" -- \
	at "$clean_repo" "$CHECK" --patterns "$canary_noeol_ok" --ref main...HEAD

# A canary of nothing but comments tests zero probes. It must not announce a verification it
# did not perform — the same defect as the unterminated-line case, one layer further in.
canary_vacuous="$TMP/canary-vacuous"
make_patterns "$canary_vacuous"
printf '# only a comment\n\n' >"$canary_vacuous/privacy-canary.txt"
expect "a canary with no usable probes REFUSES" 2 "no usable probes" -- \
	at "$clean_repo" "$CHECK" --patterns "$canary_vacuous" --ref main...HEAD

# A real canary states HOW MANY probes it proved, so "canary ok" is countable rather than bare.
expect "canary ok states the probe count" 0 "1 probe(s)" -- \
	at "$clean_repo" "$CHECK" --patterns "$canary_ok" --ref main...HEAD

# No canary is a degraded mode: proven to compile, not proven to match. Say so.
expect "absent canary is announced as unproven" 0 "not to match anything" -- \
	at "$clean_repo" "$CHECK" --patterns "$good" --ref main...HEAD

# =============================================================================================

# =============================================================================================
# 6. A LIST THAT SHRINKS IS AS LOUD AS A LIST THAT IS ABSENT (quince#44)
# =============================================================================================
# The gate refused an EMPTY list and accepted a SHORTENED one, so a trim was silently as good as
# the full list — and the identity that can trim it is the one the list constrains, holding `write`
# on the private layer by ruling. Branch protection is unavailable on that repo, so the floor lives
# in this protected one and lowering it needs an approval from somebody who is not the author.
floor_hi="$TMP/floor-5"
printf '# synthetic\n5\n' >"$floor_hi"
expect "a SHRUNKEN list refuses, exactly as an absent one does" 2 "has SHRUNK" -- \
	env "PRIVACY_FLOOR_FILE=$floor_hi" "$CHECK" --patterns "$good"

# The refusal must name the remedy that carries the approval, or it teaches people to edit the
# list instead of the floor — which is the direction that weakens the gate.
expect "…and names the reviewed-PR remedy" 2 "reviewed PR" -- \
	env "PRIVACY_FLOOR_FILE=$floor_hi" "$CHECK" --patterns "$good"

# A list AT the floor is fine: the control is against shrinking, not against a particular size.
floor_exact="$TMP/floor-2"
printf '2\n' >"$floor_exact"
expect "a list exactly at the floor passes" 0 "clean" -- \
	at "$clean_repo" env "PRIVACY_FLOOR_FILE=$floor_exact" "$CHECK" --patterns "$good" --ref main...HEAD

# A floor that can be deleted to disable itself is not a control.
expect "an ABSENT floor refuses rather than skipping the check" 2 "no pattern floor" -- \
	env "PRIVACY_FLOOR_FILE=$TMP/no-such-floor" "$CHECK" --patterns "$good"

# …and one that is not a number refuses rather than being coerced to 0, which would disable it
# silently — the same vacuous pass, one field over.
floor_junk="$TMP/floor-junk"
printf '# synthetic\nnine\n' >"$floor_junk"
expect "a non-numeric floor refuses rather than guessing" 2 "is not a number" -- \
	env "PRIVACY_FLOOR_FILE=$floor_junk" "$CHECK" --patterns "$good"

# The floor counts BOTH lists, so moving patterns into the case-sensitive file is not a shrink.
floor_two="$TMP/floor-2b"
printf '2\n' >"$floor_two"
expect "the floor counts both lists, so a case split is not a shrink" 0 "clean" -- \
	at "$clean_repo" env "PRIVACY_FLOOR_FILE=$floor_two" "$CHECK" --patterns "$split" --ref main...HEAD

printf '\nprivacy-check-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ] || exit 1
