#!/bin/sh
# privacy-check — sweep content for Operator-private strings, and FAIL when it cannot sweep.
#
# The defect this exists to remove (quince#41): the previous implementation printed
# "no local/privacy-patterns.txt (contributor/CI box) — skipped" and exited 0. A checklist
# cannot tell that apart from "clean", so the gate could tick itself on every box that was
# unable to run it — which was every box where work actually happens (quince#44).
#
# Three exit codes, because "violation" and "could not look" are different facts and a
# caller that conflates them is the bug:
#
#   0  swept, nothing matched          — a real clean, and the output says what was scanned
#   1  swept, something matched        — a violation, with source, line number and pattern
#   2  DID NOT SWEEP                   — no list, empty list, unusable matcher, bad arguments
#
# Scope modes, because a sweep of the staged diff proves nothing about a branch that is
# already committed (quince#41 req 2 — after `git commit` the staged diff is empty, so the
# gate reported success having examined nothing):
#
#   privacy-check                         the staged diff        (the commit-time gate)
#   privacy-check --ref origin/main...HEAD the branch: diff, commit messages AND identity
#   privacy-check --text FILE             PR/issue text; FILE may be /dev/stdin
#
# --ref and --text compose; commit messages are public history and are swept by name here
# rather than left to a second command someone has to remember.
#
# AUTHOR/COMMITTER IDENTITY IS SWEPT TOO, and it is called out here because "every commit
# message" was the phrase that made it look covered for as long as it was not (quince#196).
# A leak reached quince-devlog main in three commits under a clean verdict.
set -eu

ME=$(basename "$0")

usage() {
	cat >&2 <<EOF
usage: $ME [--ref <range>] [--text <file>] [--patterns <dir>]

  (no --ref)        scan the staged diff (git diff --cached)
  --ref <range>     scan the whole branch: added lines of \`git diff <range>\`, the commit
                    subjects and bodies, the AUTHOR and COMMITTER name+email, and the
                    branch name. The identity fields are named because "the commit
                    messages" read as covering them and did not (quince#196).
  --text <file>     also scan <file> verbatim — PR body, journal entry. Use /dev/stdin
                    to pipe it.
  --patterns <dir>  where the lists live (default: \$PRIVACY_PATTERN_DIR, else ./local)

exit: 0 clean · 1 violation · 2 DID NOT RUN
EOF
}

# --- arguments ---------------------------------------------------------------------------
REF=""
TEXT=""
PATTERN_DIR="${PRIVACY_PATTERN_DIR:-local}"
while [ $# -gt 0 ]; do
	case "$1" in
	--ref) REF="${2:?--ref needs a range}"; shift 2 ;;
	--text) TEXT="${2:?--text needs a file}"; shift 2 ;;
	--patterns) PATTERN_DIR="${2:?--patterns needs a directory}"; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*)
		printf '%s: unknown argument %s\n' "$ME" "$1" >&2
		usage
		# Exit 2: an argument typo means the sweep did not happen. Anything else would let a
		# misspelled flag read as a clean sweep, which is this file's entire subject.
		exit 2
		;;
	esac
done

CI_LIST="$PATTERN_DIR/privacy-patterns.txt"     # matched case-INSENSITIVELY
CS_LIST="$PATTERN_DIR/privacy-patterns-cs.txt"  # matched case-SENSITIVELY (optional)
CANARY="$PATTERN_DIR/privacy-canary.txt"        # known-positive probes (optional)

say() { printf '%s: %s\n' "$ME" "$*"; }
cannot_run() {
	printf '%s: DID NOT RUN — %s\n' "$ME" "$*" >&2
	printf '%s: this is NOT a clean result. Nothing was swept.\n' "$ME" >&2
	exit 2
}

# --- the matcher, named rather than inherited ----------------------------------------------
# A gate whose semantics come from whichever `grep` the environment resolves first can pass on
# one box and fail on another, and for THIS gate the bad direction is silent: a pattern that
# fails to compile reports clean. So: name the matcher, print it with its version, and prove it
# compiles every pattern before trusting a clean answer.
#
# TWO implementations are in play, measured 2026-07-27: **busybox** on the runner and architect
# boxes (`/bin/grep -> /bin/busybox`; there is no other grep installed on either), and **GNU
# grep 3.11** in CI, which runs `make gates` on ubuntu-latest.
#
# An earlier version of this comment said THREE, citing ugrep 7.5.0 "in PATH" on both boxes.
# That was wrong, and the way it was wrong is worth keeping: in an agent session `grep` is a
# shell FUNCTION installed by the tooling, which routes through a binary that bundles ugrep —
# so two sessions independently measured their own harness and reported it as a property of the
# machines. ugrep is installed on neither. `type` before `--version`, whenever the claim is
# about a box rather than about a session.
GREP="${PRIVACY_GREP:-grep}"
command -v "$GREP" >/dev/null 2>&1 || cannot_run "matcher '$GREP' not found (set PRIVACY_GREP)"
GREP_PATH=$(command -v "$GREP")
# Only believe --version when the matcher ACCEPTS it. busybox grep has no such flag and prints
# "grep: unrecognized option: version" — the first draft of this line reported that error string
# as if it were the version, which is a claim dressed as a fact in the file whose whole subject
# is claims that cannot be checked. Found by running it on this box, not by reasoning about it.
if GREP_VERSION=$("$GREP" --version 2>/dev/null | head -n 1) && [ -n "$GREP_VERSION" ]; then
	:
else
	GREP_VERSION="version not reported by this implementation"
fi

# --- the lists must exist and be non-empty --------------------------------------------------
# `test -s`, not `test -f`: an empty list matches nothing and would report clean forever. That
# is the same vacuous pass in a costume.
# The fix named here must be one that EXISTS (quince#44's ruling, 2026-07-27). This line used to
# say the layer "is placed by deploy/runner/provision" — provision does no such thing yet, so it
# named a fix nobody had built, which is the defect class this very file exists to close. When
# provision learns to place the layer, correcting this belongs to that change and not to a
# follow-up.
[ -e "$CI_LIST" ] || cannot_run "no pattern list at $CI_LIST — place one there (file 0600, directory 0700), or link the private layer into this clone: ln -s /root/quince-local local"
[ -s "$CI_LIST" ] || cannot_run "pattern list $CI_LIST is EMPTY — an empty list matches nothing and would report clean forever"

count_patterns() {
	# `grep -c` exits 1 when the count is zero, so the `|| true` keeps the printed count and
	# stops `set -e` from turning an empty list into an abort. Written the long way because the
	# one-line `&& … || echo 0` form prints the count AND the fallback on a zero count.
	if [ -s "$1" ]; then
		"$GREP" -cvE '^[[:space:]]*(#|$)' "$1" 2>/dev/null || true
	else
		echo 0
	fi
}
CI_COUNT=$(count_patterns "$CI_LIST")
[ "$CI_COUNT" -gt 0 ] || cannot_run "pattern list $CI_LIST holds no usable patterns (only blanks/comments)"

CS_COUNT=0
if [ -s "$CS_LIST" ]; then
	CS_COUNT=$(count_patterns "$CS_LIST")
fi

# --- a list that SHRINKS must be as loud as a list that is ABSENT ------------------------------
# This gate refused an empty list and accepted a shortened one, so a trimmed list was silently as
# good as a full one — and the identity that can trim it is the implementer, which is the identity
# the list constrains and which holds `write` on the private layer by ruling (quince#44). Branch
# protection is unavailable on that repository, so the reviewed-change control lives here instead:
# the floor is a tracked file in this protected repo, and lowering it takes an approval from
# somebody who is not the author. Full reasoning in deploy/privacy/patterns.floor.
#
# An ABSENT floor is not a silent pass — it is the same DID NOT RUN as a missing pattern list,
# because a control that can be deleted to disable itself is not a control.
FLOOR_FILE="${PRIVACY_FLOOR_FILE:-$(dirname -- "$0")/patterns.floor}"
if [ ! -e "$FLOOR_FILE" ]; then
	cannot_run "no pattern floor at $FLOOR_FILE — the check that the list has not been trimmed cannot itself run, and a control that can be deleted to disable itself is not a control"
fi
FLOOR=$("$GREP" -vE '^[[:space:]]*(#|$)' "$FLOOR_FILE" 2>/dev/null | head -n 1 || true)
case "${FLOOR:-}" in
'' | *[!0-9]*) cannot_run "the pattern floor at $FLOOR_FILE is not a number ('${FLOOR:-}') — refusing rather than guessing what it meant" ;;
esac
TOTAL_COUNT=$((CI_COUNT + CS_COUNT))
if [ "$TOTAL_COUNT" -lt "$FLOOR" ]; then
	cannot_run "the pattern list has SHRUNK — $TOTAL_COUNT usable patterns, floor is $FLOOR ($FLOOR_FILE). A shorter list silently sweeps less, so this refuses exactly as an absent list does. If the reduction is intended, lower the floor in a reviewed PR against this repo: that approval is the control."
fi

# --- prove the matcher can actually compile the lists ---------------------------------------
# grep exits 2 on a bad pattern, 1 on no-match. Feeding it empty input separates "your regex
# does not compile here" from "nothing matched", which is the divergence that would otherwise
# surface as a permanent, silent clean.
compiles() { printf '' | "$GREP" -qEf "$1" 2>/dev/null || [ $? -eq 1 ]; }
compiles "$CI_LIST" || cannot_run "matcher $GREP_PATH cannot compile the patterns in $CI_LIST ($GREP_VERSION)"
if [ "$CS_COUNT" -gt 0 ]; then
	compiles "$CS_LIST" || cannot_run "matcher $GREP_PATH cannot compile the patterns in $CS_LIST ($GREP_VERSION)"
fi

say "matcher $GREP_PATH ($GREP_VERSION)"
if [ "$CS_COUNT" -gt 0 ]; then
	say "lists $CI_COUNT case-insensitive + $CS_COUNT case-sensitive"
else
	# A degraded mode, surfaced rather than swallowed (CLAUDE.md: no silent caps or fallbacks).
	# While every pattern runs under -i, any pattern relying on case discrimination is not
	# merely noisy but meaningless: the device-name heuristic matched ordinary product prose
	# in two consecutive sweeps (quince#41 req 3).
	say "lists $CI_COUNT case-insensitive; NO case-sensitive list at $CS_LIST"
	say "      → every pattern runs under -i, so any case-discriminating pattern is inert (quince#41 req 3)"
fi

# --- the matcher is verified against known-positive input, when the Operator supplies it ------
# Everything above proves the patterns COMPILE. Only a known-positive probe proves they MATCH.
if [ -s "$CANARY" ]; then
	# `|| [ -n "$probe" ]` catches a final line with NO trailing newline, which plain `read`
	# discards. Without it a single-probe canary — the likely shape of a hand-written first
	# version — is skipped entirely while the success line below still prints: a check that
	# could not run, reporting that it did, inside the file whose whole subject is that defect.
	probes=0
	while IFS= read -r probe || [ -n "$probe" ]; do
		case "$probe" in '' | \#*) continue ;; esac
		probes=$((probes + 1))
		if printf '%s\n' "$probe" | "$GREP" -qiEf "$CI_LIST" 2>/dev/null; then continue; fi
		if [ "$CS_COUNT" -gt 0 ] && printf '%s\n' "$probe" | "$GREP" -qEf "$CS_LIST" 2>/dev/null; then continue; fi
		cannot_run "canary probe from $CANARY matched NOTHING — the matcher compiles the lists but does not match what they are meant to catch"
	done <"$CANARY"
	# A canary of nothing but comments passes `test -s`, tests zero probes, and would have
	# printed "canary ok" — the third instance of this PR's own thesis inside its own
	# implementation, found while writing the fixture for the second. Count what was actually
	# proven and refuse to announce a verification of nothing.
	[ "$probes" -gt 0 ] || cannot_run "canary $CANARY holds no usable probes (only blanks/comments) — nothing was verified"
	say "canary ok — the matcher matches known-positive input ($probes probe(s))"
else
	say "no canary at $CANARY — matcher proven to COMPILE the lists, not to match anything"
fi

# --- gather what we are sweeping ------------------------------------------------------------
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM
SOURCES=""
# add_source <label> <file> [required]
#
# A source that is empty because there was nothing to collect is an omission; a source the CALLER
# NAMED and which turned out to be empty is a refusal (quince#237). Marking the difference at the
# call site is what closes the class, rather than special-casing `--text` here: any future
# explicitly-requested source gets the right behaviour by passing one word.
#
# THE DEFECT THIS REPLACES. `--text FILE` on an empty FILE was dropped silently, while the scope
# line still announced `+ text` and the gate printed `clean` and exited 0 — so the invocation
# `CLAUDE.md` prescribes before every merge could report a clean sweep of a PR body it never read.
# Twenty lines below, this file already states the principle it was breaking: "An EMPTY scope is not
# a clean sweep, and must not borrow the word." That guard was written for the whole scope being
# empty and was never extended to one requested source going missing.
#
# AND THE WAY A BODY FILE BECOMES EMPTY IS A FAILED FETCH — so the gate degraded precisely when
# something upstream had already gone wrong. The instance that found this was `bin/gh-arch` invoked
# by relative path from a clone that has no `bin/`, writing zero bytes, followed by a sweep that
# reported clean.
# The third argument is the path the CALLER named. Passing it means "this source was asked for by
# name"; omitting it means "collect it if there is any". The origin is carried rather than a bare
# `required` flag so the refusal can name the file the caller actually passed, not the temp copy of
# it under $WORK — a refusal that names a path nobody typed is a refusal nobody can act on.
add_source() { # <label> <file> [caller-named-origin]
	if [ -s "$2" ]; then
		SOURCES="$SOURCES $1:$2"
		return 0
	fi
	[ -n "${3:-}" ] || return 0
	cannot_run "--$1 named $3, and it is EMPTY — there was nothing to sweep.
    Refusing rather than reporting a clean sweep of text nobody read. An empty file here is
    usually a FAILED FETCH upstream: check the command that produced it."
}

if [ -n "$REF" ]; then
	git rev-parse "$REF" >/dev/null 2>&1 ||
		git rev-list "$REF" >/dev/null 2>&1 ||
		cannot_run "git cannot resolve the range '$REF'"
	# Added lines only: a removed private string is a string leaving the tree, and the commit
	# that ADDED it is what history keeps. `^\+\+\+` is the file header, not content.
	git diff "$REF" -U0 | "$GREP" -E '^\+' | "$GREP" -vE '^\+\+\+ ' >"$WORK/diff" || true
	add_source "branch-diff" "$WORK/diff"
	# Commit messages are public forever and are covered by the same rule as the diff
	# (CLAUDE.md: "...never enter committed files, commit messages, branch names...").
	#
	# --right-only, because one $REF string reaches two commands that read three-dot notation
	# DIFFERENTLY: `git diff A...B` is merge-base→B, but `git log A...B` is the symmetric
	# difference and so includes commits that are only on A. Without this the gate fails a
	# branch over a commit message the author never wrote — whenever main is ahead, which under
	# strict up-to-date protection is the normal state of a queued PR and the state /land
	# deliberately creates by rebasing. Measured: no-op for the two-dot form, so both work.
	git log --right-only "$REF" --format='%s%n%b' >"$WORK/messages" 2>/dev/null || true
	add_source "commit-message" "$WORK/messages"
	# AUTHOR AND COMMITTER IDENTITY, which this gate reported `clean` about while never reading
	# (quince#196). Not hypothetical: a real personal name on a real `.lan` hostname reached
	# `quince-devlog` main in three commits under a clean verdict.
	#
	# It is the worst field to miss, because it is the most permanent. Identity travels with the
	# commit forever, is rendered on every view of it, and survives every later edit of the file it
	# touched — where a bad line in a diff can at least be corrected by a later commit.
	#
	# WHY IT LOOKED COVERED. `--help` said "the commit messages", which is TRUE, and a reader checks
	# the box marked *commit metadata is swept* and moves on. `CLAUDE.md` enumerates "committed files,
	# commit messages, branch names, tags, PR/issue text, or fixtures" — identity is not in that list
	# either, so the canon and the gate agreed with each other and both missed the field.
	#
	# Its own label, not folded into commit-message: a hit here means re-authoring commits, which is a
	# different and more expensive remedy than editing a message, and the report should say which.
	git log --right-only "$REF" --format='%an <%ae>%n%cn <%ce>' >"$WORK/identity" 2>/dev/null || true
	add_source "commit-identity" "$WORK/identity"
	# The branch name travels to the forge too, and costs one line to cover.
	git rev-parse --abbrev-ref HEAD >"$WORK/branch" 2>/dev/null || true
	add_source "branch-name" "$WORK/branch"
	# NAMED BY FIELD, not by category (quince#196's "third half"). `clean` reads as *the commit is
	# clean*; it means *the swept subset is clean*. The banner already names the pattern lists it
	# loaded, and naming the FIELDS too is what makes the next uncovered one visible as an absence
	# rather than discoverable only by a leak — the property that made quince#121's stale clone
	# findable at all.
	SCOPE="branch $REF (diff:added + message:subject,body + author:name,email + committer:name,email + branch-name)"
else
	git diff --cached -U0 | "$GREP" -E '^\+' | "$GREP" -vE '^\+\+\+ ' >"$WORK/staged" || true
	add_source "staged-diff" "$WORK/staged"
	SCOPE="staged diff"
fi

if [ -n "$TEXT" ]; then
	# Readability was the ONLY guard here, and an empty file is perfectly readable (quince#237).
	[ -r "$TEXT" ] || cannot_run "--text $TEXT is not readable"
	cat "$TEXT" >"$WORK/text"
	# `$TEXT` third: the caller named this source, so an empty one is a refusal rather than a drop.
	# add_source cannot_run's out of here when that happens, so the announcement below is only ever
	# reached by a source that really entered the sweep — which is the half that made the old
	# behaviour a lie rather than merely a gap. `SCOPE="$SCOPE + text"` was unconditional, so the
	# scope line said `+ text` and the swept line did not, and nothing compared the two.
	add_source "text" "$WORK/text" "$TEXT"
	SCOPE="$SCOPE + text"
fi

say "scope $SCOPE"

# --- sweep ------------------------------------------------------------------------------------
HITS="$WORK/hits"
: >"$HITS"
# SC2086: $SOURCES is a deliberate word-split list. Every path in it is one we built under
# $WORK (mktemp -d), so no element can contain whitespace.
# shellcheck disable=SC2086
for entry in $SOURCES; do
	label=${entry%%:*}
	file=${entry#*:}
	"$GREP" -inEf "$CI_LIST" "$file" 2>/dev/null | sed "s|^|$label:|" >>"$HITS" || true
	if [ "$CS_COUNT" -gt 0 ]; then
		"$GREP" -nEf "$CS_LIST" "$file" 2>/dev/null | sed "s|^|$label:|" >>"$HITS" || true
	fi
done

if [ -s "$HITS" ]; then
	printf '%s: PRIVACY VIOLATION — content matches %s\n' "$ME" "$PATTERN_DIR" >&2
	sed 's/^/    /' "$HITS" >&2
	printf '%s: fix before this reaches history. Public history is forever (CLAUDE.md).\n' "$ME" >&2
	exit 1
fi

# Name what was scanned. "clean" with nothing behind it is the claim this file was written to
# make impossible: a reader must be able to tell a real sweep from a vacuous one.
scanned=""
# shellcheck disable=SC2086
for entry in $SOURCES; do scanned="$scanned ${entry%%:*}"; done

# An EMPTY scope is not a clean sweep, and must not borrow the word. The first draft printed
# "clean — swept (nothing — the scope is empty)" and exited 0 on a branch with nothing staged:
# a vacuous pass wearing the vocabulary of a real one, which is the exact defect this file was
# written to remove. Exit 0 is still right — there was genuinely nothing to examine — but the
# sentence has to say that, because "clean" is what a reader ticks a box against.
if [ -z "$scanned" ]; then
	say "NOTHING TO SWEEP — the scope is empty. This is not evidence that the branch is clean."
	exit 0
fi
say "clean — swept$scanned against $((CI_COUNT + CS_COUNT)) patterns"
