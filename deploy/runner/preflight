#!/bin/sh
# preflight — refuse to start the runner in an environment where Remote Control cannot work, or
# where it would work against the wrong credential.
#
# Every check names what it OBSERVED, never just that something is wrong: an error message is a
# claim (program doc, State honesty), and "the environment is bad" is a claim about a condition
# nobody can act on.
#
# The three facts this enforces were looked up live rather than recalled (2026-07-26):
#   - an API key takes precedence over the subscription login — the billing trap;
#   - a setup-token / CLAUDE_CODE_OAUTH_TOKEN credential CANNOT establish Remote Control at all
#     ("requires a full-scope login token"), so its presence means the runner is misconfigured;
#   - ANTHROPIC_BASE_URL pointing anywhere but api.anthropic.com disables Remote Control.
set -eu

TOKEN_FILE="${QUINCE_BOT_TOKEN_FILE:-/root/.config/quince/quince-bot.token}"
fail=0

bad() {
	printf 'preflight: %s\n' "$*" >&2
	fail=1
}
ok() { printf 'preflight: ok — %s\n' "$*"; }

# --- credentials that must NOT be set -------------------------------------------------------
# Names only. A preflight that echoed a credential to fix a credential problem would be its own
# incident.
for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN; do
	eval "val=\${$var:-}"
	if [ -n "$val" ]; then
		bad "$var is set. It takes precedence over the claude.ai login, and Remote Control needs a full-scope login — unset it in the service environment."
	fi
done
[ "$fail" -eq 0 ] && ok "no API-key or token credential in the environment"

# --- the endpoint must be Anthropic's -------------------------------------------------------
case "${ANTHROPIC_BASE_URL:-}" in
'' | https://api.anthropic.com | https://api.anthropic.com/) ok "ANTHROPIC_BASE_URL is unset or api.anthropic.com" ;;
*) bad "ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL} — Remote Control is disabled for any host other than api.anthropic.com (gateway or proxy). Unset it." ;;
esac

# --- identity: each box asserts the OTHER's absence -------------------------------------------
# This inversion is the whole separation mechanism (devlog#7). The implementer box must hold the
# bot token; the architect box must not. Enforced by the thing that STARTS the service, so the
# boundary survives whoever provisioned the machine and whatever they meant to do.
#
# Role comes from the environment, defaulting to implementer — a box that never declares a role
# gets the stricter, historical behaviour rather than the permissive one.
ROLE="${QUINCE_RUNNER_ROLE:-implementer}"
# Say when the role was ASSUMED rather than declared. Without it, running preflight by hand on the
# arch box reports "no bot token" — true, but it reads as "you are missing a credential" when the
# cause is "you did not say which box this is". Naming the assumption costs a line and saves the
# puzzled minute (architect's note on #26).
if [ -n "${QUINCE_RUNNER_ROLE:-}" ]; then
	ok "role $ROLE (declared)"
else
	printf 'preflight: role %s — ASSUMED, because QUINCE_RUNNER_ROLE is unset. The service sets it from /etc/conf.d; a hand run does not.\n' "$ROLE"
fi
case "$ROLE" in
implementer)
	# THE IMPLEMENTER IDENTITY IS AN APP KEY NOW, NOT A BOT TOKEN (quince-devlog decisions/0014).
	# `quince-bot` was suspended on 2026-07-28; a box holding only that credential cannot author
	# anything. This check demanded it anyway, so the first correctly-provisioned box built after
	# the ruling could not start — measured, not predicted, while standing up a second site.
	#
	# BOTH ARE ACCEPTED, App key first, because the transition is real: existing boxes hold a bot
	# token and 0014's condition 1 requires that record be left in place. Neither present is the
	# only refusal.
	#
	# AND PRESENCE IS NOT ENOUGH — the arch arm below already learned this (quince#121) and this
	# arm had not. A key can be present and unusable in ways a stat cannot see: revoked, mismatched
	# against the app id, unreadable, or on a box with no openssl to sign with. Every one of those
	# reads as "credential installed" to a check that looks at the filesystem. So this asks the
	# credential to MINT, which is the only question the box's start actually depends on.
	CODER_KEY="${QUINCE_CODER_KEY_FILE:-/root/.config/quince/quince-coder.pem}"
	# Prefer the repository's wrapper; fall back to PATH, and SAY WHICH, because bin/gh-coder is
	# not on main yet and a silent fallback to a different copy is how two answers diverge.
	CODER_WRAPPER=""
	if [ -x "$(dirname "$0")/../../bin/gh-coder" ]; then
		CODER_WRAPPER="$(dirname "$0")/../../bin/gh-coder"
	elif command -v gh-coder >/dev/null 2>&1; then
		CODER_WRAPPER="$(command -v gh-coder)"
	fi
	if [ -f "$CODER_KEY" ]; then
		mode=$(stat -c '%a' "$CODER_KEY" 2>/dev/null || stat -f '%Lp' "$CODER_KEY" 2>/dev/null || echo unknown)
		case "$mode" in
		600 | 400) : ;;
		*) bad "the App key at $CODER_KEY is mode $mode — expected 600. It is a signing key; anything wider means any process on this box can author as the implementer." ;;
		esac
		if [ -z "$CODER_WRAPPER" ]; then
			bad "an App key is present at $CODER_KEY but no gh-coder wrapper was found, in bin/ or on PATH, so nothing on this box can mint a token from it."
		elif ! command -v openssl >/dev/null 2>&1; then
			bad "an App key is present at $CODER_KEY but openssl is not installed, so no token can be signed from it. A minimal Alpine image does not ship openssl. Fix: apk add openssl. Refusing rather than starting a box whose identity would fail at its first push."
		elif coder_why=$("$CODER_WRAPPER" api /installation/repositories -q '.total_count' 2>&1); then
			ok "role implementer: App identity can mint a token and reaches $coder_why repositories (via $CODER_WRAPPER)"
		else
			# Print the wrapper's own message rather than a second implementation of its reasoning
			# — that divergence is quince#86.
			bad "the App key at $CODER_KEY cannot produce a usable token, so this box would fail at its first push rather than at start. The wrapper reported — $(printf '%s' "$coder_why" | head -n 2 | tr '\n' ' ')"
		fi
	elif [ -f "$TOKEN_FILE" ]; then
		mode=$(stat -c '%a' "$TOKEN_FILE" 2>/dev/null || stat -f '%Lp' "$TOKEN_FILE" 2>/dev/null || echo unknown)
		case "$mode" in
		600 | 400)
			# NOT `ok` alone: this box can start, and it is also holding a credential belonging to a
			# suspended account. Saying so is the difference between a box that works and a box
			# nobody has looked at since the suspension.
			ok "role implementer: bot token present, mode $mode — LEGACY. quince-bot is suspended; place an App key at $CODER_KEY (decisions/0014)."
			;;
		*) bad "bot token at $TOKEN_FILE is mode $mode — expected 600." ;;
		esac
	else
		bad "no implementer identity on this box: no App key at $CODER_KEY and no bot token at $TOKEN_FILE. Without one, a session would author as whoever is logged in. Place the App key (decisions/0014); the bot token is legacy and its account is suspended."
	fi
	;;
arch)
	# The architect box can approve. A bot token here would let one machine author AND approve,
	# which is `approver ≠ author` degrading from a property into a convention about which
	# credential a session happens to pick up.
	# BOTH FORMS OF THE IMPLEMENTER IDENTITY, and adding the second is the point of this change.
	# This arm refused a bot token and nothing else — so once the implementer identity moved to an
	# App key (decisions/0014), the assertion "the implementer identity is absent" was being made
	# by checking for a credential that no longer carries it. The box could hold `quince-coder.pem`
	# and this would have reported the separation intact.
	#
	# A rule that names one mechanism goes quietly false the moment the mechanism changes, and this
	# one guards `approver ≠ author` — the property the whole two-seat design rests on.
	_arch_impl_creds=""
	[ -f "$TOKEN_FILE" ] && _arch_impl_creds="$TOKEN_FILE"
	_arch_coder_key="${QUINCE_CODER_KEY_FILE:-/root/.config/quince/quince-coder.pem}"
	[ -f "$_arch_coder_key" ] && _arch_impl_creds="${_arch_impl_creds:+$_arch_impl_creds and }$_arch_coder_key"
	if [ -n "$_arch_impl_creds" ]; then
		bad "an IMPLEMENTER CREDENTIAL is present at $_arch_impl_creds on a box whose role is 'arch'. This machine can approve; holding the authoring identity too would let one box author and approve its own work. Remove it — or run this box as role=implementer, but not both."
	else
		ok "role arch: no implementer credential present — neither a bot token nor an App key, as required"
	fi

	# --- the reviewer identity must be able to MINT, not merely to exist (quince#121) ---------
	# quince#121's lesson, applied to the thing it taught us about: that issue's whole cost was a
	# check satisfied by PRESENCE — CLAUDE.md said preflight "refuses to start a box that cannot
	# reach" the private layer, and a clone that could never fetch satisfied it. So this does not
	# ask whether a key file is there. It asks the credential to produce a token, which is the only
	# question a reviewer box's start actually depends on.
	#
	# A key can be present and unusable in ways a stat cannot see: revoked, mismatched against the
	# app id, unreadable, or sitting on a box with no openssl to sign with. Every one of those
	# reads as "credential installed" to a check that looks at the filesystem.
	REVIEW_KEY="${QUINCE_REVIEW_KEY_FILE:-/root/.config/quince/quince-review.pem}"
	if [ ! -f "$REVIEW_KEY" ]; then
		# NOT `bad`. A box provisioned before the App existed is a correct box that predates a
		# change, and refusing to start it would strand the seat that reviews everything. gh-arch
		# still works; what is lost is that verdicts are distinguishable from the Operator's.
		printf 'preflight: role arch: no reviewer key at %s — verdicts will post as the Operator (quince#47 unfixed on this box). Run deploy/runner/provision to install it.\n' "$REVIEW_KEY"
	elif ! command -v openssl >/dev/null 2>&1; then
		bad "a reviewer key is present at $REVIEW_KEY but openssl is not installed, so no token can be signed from it. A minimal Alpine image does not ship openssl. Fix: apk add openssl. Refusing rather than starting a box whose reviewer identity would fail at the first verdict."
	elif review_why=$("$(dirname "$0")/../../bin/gh-review" api /installation/repositories -q '.total_count' 2>&1); then
		ok "role arch: reviewer identity can mint a token and reaches $review_why repositories"
	else
		# Print gh-review's own message: it names the file and the likely cause, and a second
		# implementation of that reasoning here is how the two answers diverge (quince#86).
		bad "the reviewer key at $REVIEW_KEY cannot produce a usable token, so this box would fail at its first verdict rather than at start. The wrapper reported — $(printf '%s' "$review_why" | head -n 2 | tr '\n' ' ')"
	fi
	;;
supervisor)
	# THE THIRD SEAT, AND ITS RULE IS THE ABSENCE OF EVERY OTHER ONE. This is where the Operator and
	# a session talk: it coordinates, measures and prepares, and it holds no forge credential at all.
	# Holding none is what makes it structurally unable to author or approve, so it can never muddy
	# `approver ≠ author` even by accident — and that is the whole of its security property.
	#
	# Said plainly because the box is NOT isolated and claiming otherwise would be worse than saying
	# nothing: it holds ssh into both working seats, and root ssh to a box that holds a credential
	# IS that credential. What this seat buys is ATTRIBUTION — no session on it can commit or push
	# as anybody, so work cannot leave here under an identity nobody chose. That is the failure it
	# exists to prevent (quince-devlog#118), and it is not the same as containment.
	_sv_found=""
	for _sv_f in \
		"${QUINCE_BOT_TOKEN_FILE:-/root/.config/quince/quince-bot.token}" \
		"${QUINCE_CODER_KEY_FILE:-/root/.config/quince/quince-coder.pem}" \
		"${QUINCE_REVIEW_KEY_FILE:-/root/.config/quince/quince-review.pem}" \
		"${QUINCE_ARCH_TOKEN_FILE:-/root/.config/quince/quince-arch.token}"; do
		[ -f "$_sv_f" ] && _sv_found="${_sv_found:+$_sv_found and }$_sv_f"
	done
	if [ -n "$_sv_found" ]; then
		bad "a FORGE CREDENTIAL is present at $_sv_found on a box whose role is 'supervisor'. This seat holds none, deliberately: it is the seat that cannot author and cannot approve, and a credential here makes that false. Remove it — or run this box as the seat that owns that credential, but not both."
	else
		ok "role supervisor: no forge credential present — this seat can neither author nor approve, as required"
	fi
	;;
*)
	bad "unknown QUINCE_RUNNER_ROLE='$ROLE' — expected 'implementer', 'arch' or 'supervisor'. Refusing rather than guessing which identity rules apply."
	;;
esac

# --- the private layer, without which the privacy gate cannot gate ---------------------------
# quince#44, ruled by the Operator on 2026-07-27: a box that cannot reach the private layer
# REFUSES TO START, rather than coming up and running a gate that silently cannot run. The
# consequence was accepted deliberately — a box rebuilt before `provision` learns to place the
# layer will refuse, and the fix is hand-placement, which is a step a rebuild needs anyway. A box
# that starts and cannot gate is the worse of the two failures, and it is the one quince#44 exists
# to remove: sessions had learned to trust a file that a rebuild removes, with nothing announcing
# the regression.
#
# TWO CONSTRAINTS ON THIS MESSAGE, both from that ruling.
#
# 1. It names the fix that EXISTS AT THE TIME. Today that is hand-placement; when `provision`
#    learns to clone the layer, correcting this text belongs to THAT change and is not a
#    follow-up, because a message naming a fix that does not yet exist is the defect class this
#    unit is closing.
#
# 2. It does NOT claim to know WHY the layer is unreachable. A private repository returns 404 for
#    both "does not exist" and "you were not granted it", so this may report that the box cannot
#    reach the layer and may not report which. Guessing sends the next reader off to recreate a
#    repo when the real fix is a one-click collaborator grant — which is exactly the wrong turn
#    taken on quince#44 before the grant was found.
# THE SUPERVISOR SEAT RUNS NO PRIVACY GATE, so it needs no private layer. It commits nothing — it
# holds no forge credential to commit with — and the sweep belongs to the seat that publishes, which
# is the seat that can be held to it. Requiring the layer here would put a second copy of the
# Operator's private material on a third box to satisfy a check that seat can never fail meaningfully.
#
# The guarded block below is NOT re-indented, deliberately: the semantic change is three lines and
# re-indenting ~170 would bury it in a diff nobody can review. Stated so the next reader knows it is
# a choice rather than an oversight.
if [ "$ROLE" != supervisor ]; then

PRIVATE_LAYER="${QUINCE_PRIVATE_LAYER:-/root/quince-local}"
PATTERN_FILE="$PRIVATE_LAYER/privacy-patterns.txt"

# THE VERDICT IS BORROWED, NOT RE-IMPLEMENTED. preflight's question — "can the privacy gate run on
# this box?" — is a question only the gate can answer, and answering it twice is how the two
# answers diverge. The first version of this block did exactly that: it used `test -s`, so a list
# of nothing but comments (bytes present, zero usable patterns) PASSED preflight while
# `privacy-check` returned 2 on the same file. The box came up asserting "the privacy gate can run
# on this box" and every sweep afterwards said DID NOT RUN — quince#44's own failure, inside the
# change that closes it. So: run the gate's validator and take its exit code.
#
# ONLY 2 MEANS "COULD NOT LOOK", and "could not look" is the only thing preflight is asking about:
#
#   0 → swept, nothing matched   1 → swept, something matched   2 → DID NOT SWEEP
#
# So `-ne 2`. Both 0 and 1 PROVE the gate can run — the lists compiled and the sweep executed —
# which is quince#41's three-code contract used as designed rather than worked around.
#
# An earlier version of this comment claimed "1 cannot occur here: no --ref and no --text means an
# empty scope". FALSE, and measured: no --ref means the STAGED DIFF OF THE CURRENT DIRECTORY, and
# preflight inherits the service's cwd, which is `runner_dir` — /root/quince, a real repo that
# sessions work in. An interrupted commit leaving a staged match there made preflight refuse with
# "this box cannot run the privacy gate" while the gate had just run perfectly, and prescribe
# replacing a healthy pattern list. In start_pre, that is a box that will not come up and a log
# telling you to overwrite the one artifact that must not be casually replaced.
#
# NEVER print $layer_why on a non-2 path: on exit 1 it contains the MATCHED LINES, which are
# Operator-private by construction, and this output goes to /var/log/quince-runner.log.
_here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PRIVACY_CHECK="${QUINCE_PRIVACY_CHECK:-$_here/../privacy/privacy-check}"
if [ ! -x "$PRIVACY_CHECK" ]; then
	bad "the privacy gate is missing at $PRIVACY_CHECK — this checkout is incomplete, so preflight cannot establish whether the box can gate. Pull the launchpad."
elif ! _perr=$(mktemp 2>/dev/null); then
	# NO INSECURE FALLBACK, and this is a refusal branch beside the missing-gate one above for the
	# same reason. preflight runs as ROOT (quince-runner.initd start_pre), and on exit 1 the gate
	# writes its MATCHED Operator-private lines to $_perr. A predictable /tmp name opened by root
	# with a plain `>` — no O_EXCL, no O_NOFOLLOW — is a world-readable, symlink-followable temp file
	# (CWE-377) with a root write primitive attached. So a box that cannot make a private temp file
	# cannot capture the gate safely and must not start: the same refuse-don't-degrade answer :156
	# gives everywhere else, rather than a quieter path around it. mktemp is in coreutils and
	# busybox, so its absence is real news, not a case to paper over.
	bad "mktemp is unavailable, so the privacy gate's stderr cannot be captured to a PRIVATE temp file — and preflight will not fall back to a predictable /tmp path as root, which on a match would leak the gate's Operator-private lines somewhere guessable and world-readable (CWE-377). Install mktemp (coreutils or busybox). Refusing to degrade."
else
	# Capture the gate's two streams SEPARATELY into $_perr (made safely above) and $layer_out.
	# stdout is the gate's progress report, including the pattern-count line; stderr carries the
	# reason on exit 2 AND the matched lines on exit 1 (deploy/privacy/privacy-check:268), which are
	# Operator-private and must never be printed on a non-2 path — so they cannot be merged into one
	# capture.
	layer_out=$("$PRIVACY_CHECK" --patterns "$PRIVATE_LAYER" 2>"$_perr") && layer_rc=0 || layer_rc=$?
	layer_why=$(cat "$_perr" 2>/dev/null); rm -f "$_perr"
	if [ "$layer_rc" -ne 2 ]; then
		# THE COUNT IS QUOTED, NOT RE-COUNTED (quince#132). This banner used to run its own
		# `grep -cvE` over privacy-patterns.txt ALONE — so a box with a legitimately split list
		# (privacy-patterns-cs.txt, quince#109) printed "8 usable patterns" beside a floor of 9,
		# which reads as "the list has SHRUNK below its floor": the one alarm the floor exists to
		# raise. The gate already counts BOTH lists and prints the total on stdout ("lists N
		# case-insensitive + M case-sensitive"); preflight discarded that stream and re-derived a
		# worse number. Same :110 principle as the verdict above — borrow the gate's report, do not
		# re-implement it. Match on ": lists " rather than the tool name, so a QUINCE_PRIVACY_CHECK
		# override still resolves; take the first such line only.
		gate_count=$(printf '%s\n' "$layer_out" | sed -n 's/^[^:]*: \(lists .*\)$/\1/p' | head -1)
		[ -n "$gate_count" ] || gate_count="pattern count unavailable — the gate reported none"
		ok "private layer present — the gate reports $gate_count — the privacy gate can run on this box"
		# REPORTED, NOT ENFORCED, matching the apk-drift reporter below and for the same reason:
		# this is a list OF the sensitive strings, so a loose mode is worth saying loudly, but
		# refusing to start over a permission bit turns a one-command fix into an outage.
		pmode=$(stat -c '%a' "$PATTERN_FILE" 2>/dev/null || stat -f '%Lp' "$PATTERN_FILE" 2>/dev/null || echo unknown)
		case "$pmode" in
		600 | 400) ;;
		*) printf 'preflight: note — %s is mode %s, expected 600. It is a list OF the sensitive strings; chmod 600 it.\n' "$PATTERN_FILE" "$pmode" ;;
		esac

		# --- PRESENT IS NOT FRESH: a layer that cannot ADVANCE (quince#121) --------------------
		# "Reach" meant presence, and a clone can be present, readable, and unable to receive
		# anything ever again. That is not hypothetical: `provision` wired its clones with `git -c`,
		# which applies to one invocation and is never written to `.git/config`, so BOTH boxes ran
		# unwired. The arch box sat four commits behind and swept with a matcher proven only to
		# COMPILE — while being the box that performs merges, hence the last gate before public
		# history. The runner looked healthy solely because a session had hand-configured the helper
		# to push and had not registered that it was patching a bug.
		#
		# WHY THE WIRING AND NOT A LIVE FETCH. `git ls-remote` fails identically for "no credential"
		# and "network is down", so refusing on it would take a box out over a flaky link — a false
		# refusal in the one check that decides whether the box starts at all. The credential helper
		# is a LOCAL, deterministic fact and it is precisely what quince#121 was: a box with a helper
		# and no network is fine and will catch up; a box with no helper can never catch up.
		#
		# WHY REFUSE RATHER THAN REPORT, when the permission-bit note above deliberately does not.
		# That one is cosmetic and a refusal would turn a one-command fix into an outage. This one is
		# the difference between a privacy gate that is current and one that is frozen at whatever it
		# held when the box was built — and it is silent, indefinite, and on the merge path. The
		# architect's framing is the deciding one: with the root cause known, this assertion IS the
		# regression test for it, and a regression test that only prints is not one.
		#
		# Only for a GIT clone. A hand-placed layer is a documented path (the refusal below names it)
		# and has no remote to be wired to; refusing it here would forbid the fallback this file
		# already prescribes.
		#
		# ASK THE QUESTION GIT ASKS, WHICH IS NOT `--get credential.helper`. A helper may be wired
		# UNSCOPED (`credential.helper`, which is what `provision` writes) or URL-SCOPED
		# (`credential.https://github.com.helper`, which is how the Operator wired the arch box).
		# `--get credential.helper` sees only the first and returns exit 1 on the second — so the
		# first version of this check would have REFUSED TO START the architect box in the exact
		# configuration that had just been confirmed working on it. Measured:
		#
		#   url-scoped wiring:  config --get credential.helper                    → exit 1, nothing
		#                       config --get-urlmatch credential.helper <url>     → the helper
		#
		# `--get-urlmatch` is the resolution git itself performs for a given remote, so it answers
		# "will a fetch from THIS url find a helper" rather than "is one key set". Both wirings pass
		# it and an unwired clone still fails it. A false refusal here does not degrade a box, it
		# stops it booting — the same reason `ls-remote` was rejected above, arrived at from the
		# other direction, and caught only because the Operator's wiring differed from ours.
		# ASK IT ONLY WHERE IT IS A QUESTION — the credential helper is an http(s) mechanism.
		# The first shipped version demanded a helper for EVERY remote, and an SSH clone can fetch
		# forever without one: SSH authenticates with a key, so there is nothing for a helper to do.
		# That refusal does not degrade a box, it stops it booting — this check's own standard,
		# turned on itself for the second time.
		#
		# TWO DISTINCT FAILURES REACHED ONE `bad`, and only one of them was maskable. Measured on
		# git 2.54.0, `config --get-urlmatch credential.helper <remote>`:
		#
		#   https://host/p.git   → the helper, exit 0        ← the only shape a helper applies to
		#   git@host:p.git       → fatal, exit 128, EMPTY    ← scp-style is not a URL
		#   /srv/p.git           → fatal, exit 128, EMPTY    ← nor is a bare path
		#   ssh://git@host/p.git → exit 1, EMPTY, NO ERROR   ← a valid URL; no helper can ever match
		#   file:///srv/p.git    → exit 1, EMPTY, NO ERROR   ← likewise
		#
		# The first two were hidden by `2>/dev/null` swallowing the fatal. **The last two emit no
		# error at all**, so they were never hidden — they are simply true answers to the wrong
		# question. Un-masking the stderr would therefore have fixed half of this and left `ssh://`
		# refusing silently, which is why the fix is to DISPATCH ON THE SCHEME rather than to stop
		# discarding the error. The `2>/dev/null` goes anyway: on the http(s) branch a fatal is now
		# unreachable, so keeping it could only ever hide something we have not thought of.
		#
		# AND THE TWO STATES STAY APART. "No helper is configured" and "a helper does not apply to
		# this remote" are different facts, and collapsing them is how a boot-blocking check came to
		# refuse a working machine. The non-http(s) arm says what it did NOT establish rather than
		# claiming freshness it cannot see: an ssh key or a filesystem path is not a local fact this
		# script can read, so the honest report is that the check does not cover the box, not that
		# the box is fine.
		if [ -d "$PRIVATE_LAYER/.git" ]; then
			layer_remote=$(git -C "$PRIVATE_LAYER" remote get-url origin 2>/dev/null || true)
			case "$layer_remote" in
			"")
				bad "the private layer at $PRIVATE_LAYER is a git clone with NO 'origin' remote, so it can never fetch: it is frozen at whatever it holds now (quince#121). Fix: run deploy/runner/provision, or re-clone the layer."
				;;
			http://* | https://*)
				if [ -n "$(git -C "$PRIVATE_LAYER" config --get-urlmatch credential.helper "$layer_remote")" ]; then
					ok "private layer can advance — a credential helper resolves for its http(s) remote"
				else
				bad "the private layer at $PRIVATE_LAYER is a git clone with NO credential helper for its remote, so it can never fetch: it is frozen at whatever it holds now, and no future pattern, canary or case-sensitive list will reach this box. Present is not fresh (quince#121). Fix: run deploy/runner/provision, which persists the helper with \`git config\` instead of \`git -c\`, and re-run this. Refusing rather than warning because this box's privacy sweep is the last gate before public history, and a frozen gate reports \`clean\` exactly like a current one."
				fi
				;;
			*)
				ok "private layer remote is not http(s), so no credential helper applies and this check has nothing to assert about it — whether it can fetch depends on an ssh key or a filesystem path, neither of which is a local fact preflight can read (quince#121)"
				;;
			esac
		fi
	else
		# One refusal for every unusable shape — absent, empty, comments-only, uncompilable —
		# because they are one fact: this box cannot gate. The gate's own line is quoted as the
		# OBSERVATION; preflight supplies the fix, which the gate must not, since its message has
		# to stay correct for callers that are not a starting runner.
		# First line only: the gate's second line is "this is NOT a clean result", addressed to
		# somebody reading a sweep, and it reads as a non-sequitur inside a start-up refusal.
		layer_why=$(printf '%s\n' "$layer_why" | head -n 1)
		bad "this box cannot run the privacy gate on $PRIVATE_LAYER, so it must not start. The gate observed — ${layer_why:-no reason reported}. Fix: run deploy/runner/provision, which clones the private layer onto this box; or place a usable pattern list at $PATTERN_FILE by hand (file 0600, directory 0700). Not saying WHY beyond what the gate reported: this cannot tell 'never placed' from 'placed and since lost'."
	fi
fi

else
	ok "role supervisor: no private layer required — this seat runs no privacy gate, because it commits nothing and the sweep belongs to the seat that publishes"
fi

# --- the thing we are about to run ----------------------------------------------------------
if command -v claude >/dev/null 2>&1; then
	ok "claude present ($(claude --version 2>/dev/null || echo 'version unreadable'))"
	# apk installs never auto-update, so nothing else would ever mention that this box is behind.
	# REPORTED, NOT ENFORCED: a runner that refuses to start because a newer version exists would
	# turn a cosmetic lag into an outage. Drift is made visible at the moment someone is already
	# looking at the output, which is the cheapest moment it can be.
	# Ask apk whether an upgrade exists instead of comparing version strings myself. The first
	# version of this took the first line of `apk policy` and string-compared it, and reported "a
	# newer claude-code is available (2.1.108-r1)" on a box running 2.1.212 — while `apk version -l
	# '<'` said nothing was upgradable. A drift reporter that invents drift is the same unchecked
	# claim it exists to catch, so the comparison belongs to the tool that owns the version scheme.
	if command -v apk >/dev/null 2>&1; then
		upgradable=$(apk version -l '<' 2>/dev/null | grep '^claude-code' || true)
		if [ -n "$upgradable" ]; then
			printf 'preflight: note — apk reports an upgrade available: %s\n' "$upgradable"
			printf 'preflight:        apk does not auto-update; run "apk update && apk upgrade claude-code" when convenient.\n'
		fi
	fi
else
	bad "claude is not installed — run deploy/runner/provision."
fi

if [ "$fail" -ne 0 ]; then
	printf 'preflight: REFUSING to start. A runner that comes up unable to do Remote Control, or\n' >&2
	printf 'preflight: billing against an API key, is worse than one that did not start.\n' >&2
	exit 1
fi
printf 'preflight: environment is fit to start.\n'
