#!/bin/sh
# preflight-test — the runner spec's G1, run by a gate instead of by hand.
#
# G1 is "`preflight` against a table of environments: each rejection names the offending variable;
# the clean case exits 0". That table was proven by running it and pasting the output — the same
# honour system quince#64 closed for `forge-watch replay`, and the same one quince#41 closed for
# the privacy gate. A rejection nobody exercises is a promise.
#
# What this asserts is the REFUSALS, deliberately. preflight exists to stop a runner coming up
# unable to do Remote Control, or billing against an API key, or holding the identity of the box
# it is supposed to be separate from — so its failure paths are its whole product, and a suite
# that only proved the happy case would prove the least interesting thing about it.
#
# Every case is synthetic: a temp HOME, a fake token file, and a stub `claude` on PATH. Nothing
# reads the real credentials, nothing needs the private layer, and nothing needs a runner — so
# this runs on CI and on any contributor's box, which is what makes it a gate rather than a ritual.
set -eu

HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PREFLIGHT="$HERE/preflight"
[ -x "$PREFLIGHT" ] || { printf 'preflight-test: %s is not executable\n' "$PREFLIGHT" >&2; exit 2; }

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM

pass=0
fail=0

# A stub `claude`, because preflight checks for it and every case would otherwise fail on the same
# missing binary — which would make the suite assert "claude is absent" over and over rather than
# the thing each case is about. The stub answers --version and nothing else; preflight asks nothing
# else of it.
STUB="$TMP/bin"
mkdir -p "$STUB"
cat >"$STUB/claude" <<'EOF'
#!/bin/sh
[ "${1:-}" = --version ] && { echo "0.0.0-stub"; exit 0; }
exit 0
EOF
chmod +x "$STUB/claude"

# A token file at the mode preflight demands, and one at a mode it must reject.
GOOD_TOKEN="$TMP/good.token"
printf 'not-a-real-token\n' >"$GOOD_TOKEN"
chmod 600 "$GOOD_TOKEN"
LOOSE_TOKEN="$TMP/loose.token"
printf 'not-a-real-token\n' >"$LOOSE_TOKEN"
chmod 644 "$LOOSE_TOKEN"
ABSENT_TOKEN="$TMP/no-such.token"

# EVERY CREDENTIAL PATH IS PINNED INTO $TMP, FOR THE WHOLE SUITE, and this is a correctness fix
# rather than tidiness. `preflight` resolves each credential from an environment variable with a
# DEFAULT UNDER /root/.config/quince. `PF_UNSET` unsets those variables — which for a path does not
# mean "absent", it means "fall back to the real one". So any case that did not pass an explicit
# path was reading the live credential store of the box running the suite.
#
# It was invisible only by luck: it shows up as a failure exactly when the real file EXISTS, so the
# suite was green on a box that happened to lack the credential and would have failed on one that
# had it. Found 2026-07-29 when the arch arm learned to refuse an App key and the box under test
# had one — a real file, reached through a variable the suite believed it had neutralised.
#
# Exported rather than added to PF_UNSET: unsetting is what caused the fallback. Individual cases
# override these per invocation, which is how the fixtures already work.
#
# TWO PATHS WERE STILL MISSING FROM "EVERY", AND THE WORD IS THE POINT (quince#375). The supervisor
# arm reads FIVE credential paths and this list pinned three, so `QUINCE_ARCH_TOKEN_FILE` was still
# falling back to `/root/.config/quince/quince-arch.token` — the exact defect the paragraph above
# describes, surviving inside its own fix, and invisible for the same reason: it fails only on a box
# where that file exists, which is the arch box, which is not where this suite is usually run.
# `QUINCE_ANALYST_KEY_FILE` joins them because the supervisor arm is now an allowlist keyed on it.
export QUINCE_BOT_TOKEN_FILE="$ABSENT_TOKEN"
export QUINCE_CODER_KEY_FILE="$ABSENT_TOKEN"
export QUINCE_REVIEW_KEY_FILE="$ABSENT_TOKEN"
export QUINCE_ARCH_TOKEN_FILE="$ABSENT_TOKEN"
export QUINCE_ANALYST_KEY_FILE="$ABSENT_TOKEN"

# Synthetic private layers (quince#44). Never the Operator's — these hold obvious nonsense, so a
# fixture can neither read the real list nor accidentally match real content.
GOOD_LAYER="$TMP/layer-ok"
mkdir -p "$GOOD_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$GOOD_LAYER/privacy-patterns.txt"
chmod 600 "$GOOD_LAYER/privacy-patterns.txt"

# A SPLIT layer — usable patterns across BOTH lists (privacy-patterns.txt + privacy-patterns-cs.txt,
# quince#109). The banner used to run `grep -cvE` over the case-INSENSITIVE file alone, so a split
# layer read one pattern short of its true size: "8 usable patterns" beside a floor of 9 on the real
# box, which reads as a list that has shrunk below its floor (quince#132). Here it is 1 + 1, and the
# banner — now quoting the gate's own count over both lists — must say so.
SPLIT_LAYER="$TMP/layer-split"
mkdir -p "$SPLIT_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$SPLIT_LAYER/privacy-patterns.txt"
printf '# synthetic\nZZSecretHostZZ\n' >"$SPLIT_LAYER/privacy-patterns-cs.txt"
chmod 600 "$SPLIT_LAYER/privacy-patterns.txt" "$SPLIT_LAYER/privacy-patterns-cs.txt"

ABSENT_LAYER="$TMP/layer-missing" # deliberately never created

# Two GIT-CLONE layers for quince#121: present and readable, differing only in whether they can ever
# ADVANCE. Built with `git init` rather than a real clone so the suite stays offline.
#
# EVERY CASE BELOW THAT REACHES A WIRED LAYER MUST PASS `QUINCE_LAYER_FETCH_PROBE` (quince#675).
# preflight now asks the remote instead of reading the config, so a case that forgets the stub makes
# a REAL NETWORK CALL to `zz-synthetic.invalid` from a unit test — and still goes green, because the
# failure lands in the note arm. Green, slow, and different on a box with no route out.
ZZ_REMOTE="https://github.com/zz-synthetic/zz-synthetic.git"

# UNSCOPED wiring — what `provision` writes: `credential.helper`, applying to every URL.
WIRED_LAYER="$TMP/layer-git-wired"
mkdir -p "$WIRED_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$WIRED_LAYER/privacy-patterns.txt"
chmod 600 "$WIRED_LAYER/privacy-patterns.txt"
git -C "$WIRED_LAYER" init -q
git -C "$WIRED_LAYER" remote add origin "$ZZ_REMOTE"
git -C "$WIRED_LAYER" config credential.helper 'zz-synthetic-helper'

# URL-SCOPED wiring — `credential.<url>.helper`, a DIFFERENT KEY. The first version of this check
# used `config --get credential.helper`, which returns exit 1 here, so it would have REFUSED TO
# START the architect box in the exact configuration just confirmed working on it: the Operator
# wired that box URL-scoped while `provision` writes unscoped. Both are correct and git resolves
# both; only `--get-urlmatch` sees both (quince#121).
URLSCOPED_LAYER="$TMP/layer-git-urlscoped"
mkdir -p "$URLSCOPED_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$URLSCOPED_LAYER/privacy-patterns.txt"
chmod 600 "$URLSCOPED_LAYER/privacy-patterns.txt"
git -C "$URLSCOPED_LAYER" init -q
git -C "$URLSCOPED_LAYER" remote add origin "$ZZ_REMOTE"
git -C "$URLSCOPED_LAYER" config "credential.https://github.com.helper" 'zz-synthetic-helper'

FROZEN_LAYER="$TMP/layer-git-frozen"
mkdir -p "$FROZEN_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$FROZEN_LAYER/privacy-patterns.txt"
chmod 600 "$FROZEN_LAYER/privacy-patterns.txt"
git -C "$FROZEN_LAYER" init -q
git -C "$FROZEN_LAYER" remote add origin "$ZZ_REMOTE"

# A helper wired but NO remote: it cannot fetch either, and must not pass on the helper alone.
NOREMOTE_LAYER="$TMP/layer-git-noremote"
mkdir -p "$NOREMOTE_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$NOREMOTE_LAYER/privacy-patterns.txt"
chmod 600 "$NOREMOTE_LAYER/privacy-patterns.txt"
git -C "$NOREMOTE_LAYER" init -q
git -C "$NOREMOTE_LAYER" config credential.helper 'zz-synthetic-helper'

# Non-http(s) remotes, NONE of which can carry a credential helper — the mechanism is http-only, so
# an SSH clone fetches forever without one. The first shipped version of this check demanded a helper
# from EVERY remote, which made each of these a box that would not start.
#
# Three shapes, because they fail the underlying git command in TWO different ways and a fix aimed at
# either one alone leaves the other refusing. Measured on git 2.54.0 (quince#121):
#
#   scp-style `git@host:path` is NOT A URL   → `--get-urlmatch` FATALS, exit 128, stdout empty
#   `ssh://` and `file://` ARE valid URLs    → exit 1, stdout empty, and NO error printed at all
#
# The fatal was masked by a `2>/dev/null`; the clean exit 1 was never masked, because there was
# nothing to mask — it is a true answer to the wrong question. Un-masking the stderr would have
# fixed the first shape and left `ssh://` refusing silently, which is why the fix dispatches on the
# SCHEME rather than stopping discarding the error. These three pin that distinction.
for zz_transport in ssh-scp ssh-url file-url; do
	case "$zz_transport" in
	ssh-scp) zz_url="git@github.com:zz-synthetic/zz-synthetic.git" ;;
	ssh-url) zz_url="ssh://git@github.com/zz-synthetic/zz-synthetic.git" ;;
	file-url) zz_url="file:///zz-synthetic/zz-synthetic.git" ;;
	esac
	zz_layer="$TMP/layer-git-$zz_transport"
	mkdir -p "$zz_layer"
	printf '# synthetic\nzzsecrethostzz\n' >"$zz_layer/privacy-patterns.txt"
	chmod 600 "$zz_layer/privacy-patterns.txt"
	git -C "$zz_layer" init -q
	git -C "$zz_layer" remote add origin "$zz_url"
done
SSH_SCP_LAYER="$TMP/layer-git-ssh-scp"
SSH_URL_LAYER="$TMP/layer-git-ssh-url"
FILE_URL_LAYER="$TMP/layer-git-file-url"

# --- fetch-probe stubs (quince#675) ------------------------------------------------------------
# THE SUITE STAYS OFFLINE, and the comment above the layer fixtures said that could not survive a
# fetch-based check — "possible precisely because preflight asserts the LOCAL wiring rather than
# attempting a fetch. A fetch-based check could not be fixtured this way." That was true of a
# hard-wired `git ls-remote`, and it is why preflight now takes the probe through
# QUINCE_LAYER_FETCH_PROBE. These stubs are the reason the sentence is no longer a constraint:
# nothing here touches a network, and every case below still exercises the real classifier.
#
# THE STDERR IS COPIED FROM A MEASUREMENT, NOT INVENTED. git 2.54.0, 2026-08-07 — each of these is
# the shape that command actually produced, with the hostnames made synthetic. A fixture that
# guessed at the text would pin the classifier to a string git never emits, and the test would go
# green on a box where the check cannot work.
PROBE_BIN="$TMP/probe"
mkdir -p "$PROBE_BIN"

# Success. Also writes to STDOUT, because `ls-remote` prints the resolved SHA there and preflight
# must discard it: a commit id has no business in /var/log/quince-runner.log, and stdout reaching
# the classifier would make every successful probe carry text the `bad` arm greps.
cat >"$PROBE_BIN/ok" <<'EOF'
#!/bin/sh
echo "zz00000000000000000000000000000000000000	HEAD"
exit 0
EOF

# The credential was supplied and REJECTED — quince#674's exact shape, and the ONLY one that refuses.
cat >"$PROBE_BIN/authfail" <<'EOF'
#!/bin/sh
echo "remote: Invalid username or token. Password authentication is not supported for Git operations." >&2
echo "fatal: Authentication failed for 'https://zz-synthetic.invalid/zz-synthetic.git/'" >&2
exit 128
EOF

# The network, not the credential. Same exit 128 as the case above — which is the whole reason the
# classifier reads stderr and not the exit code.
cat >"$PROBE_BIN/dns" <<'EOF'
#!/bin/sh
echo "fatal: unable to access 'https://zz-synthetic.invalid/zz-synthetic.git/': Could not resolve host: zz-synthetic.invalid (Domain name not found)" >&2
exit 128
EOF

# The helper ran and produced no credential. NOT a refusal, deliberately: a wrapper that failed to
# mint an installation token once looks exactly like this, and it is transient.
cat >"$PROBE_BIN/noprompt" <<'EOF'
#!/bin/sh
echo "fatal: could not read Username for 'https://zz-synthetic.invalid': terminal prompts disabled" >&2
exit 128
EOF

# Timed out: a non-zero exit with NOTHING on stderr, which is the one shape that leaves the message
# with no observation to quote. busybox `timeout` exits 143 where GNU coreutils exits 124 (measured);
# 143 is used here and the classifier must not care, because it reads neither.
cat >"$PROBE_BIN/timedout" <<'EOF'
#!/bin/sh
exit 143
EOF

# A remote URL carrying inline credentials. git 2.54.0 redacts userinfo from its own messages, but
# that is one version's behaviour and this output goes to a logfile, so preflight strips it again.
# This stub is what proves the strip rather than the git version.
cat >"$PROBE_BIN/leaky" <<'EOF'
#!/bin/sh
echo "fatal: unable to access 'https://zzuser:zzsupersecretzz@zz-synthetic.invalid/zz-synthetic.git/': Could not resolve host: zz-synthetic.invalid" >&2
exit 128
EOF
# Writes to stdout AFTER stderr, and fails. The ONLY stub that can prove stdout is discarded rather
# than merged: on the success path nothing is quoted regardless, so a `2>&1` there is invisible, and
# a stub that wrote stdout FIRST would still leave the `fatal:` last. Mutation-tested — merging the
# two streams passes every other case in this file and fails this one.
cat >"$PROBE_BIN/noisy" <<'EOF'
#!/bin/sh
echo "fatal: unable to access 'https://zz-synthetic.invalid/zz-synthetic.git/': Could not resolve host: zz-synthetic.invalid" >&2
echo "zzstdoutleakzz"
exit 128
EOF
chmod +x "$PROBE_BIN/ok" "$PROBE_BIN/authfail" "$PROBE_BIN/dns" "$PROBE_BIN/noprompt" \
	"$PROBE_BIN/timedout" "$PROBE_BIN/leaky" "$PROBE_BIN/noisy"

# preflight delegates its verdict to privacy-check, which since quince#44 enforces a pattern FLOOR
# from the public repo. These layers carry one synthetic pattern and the repo floor is 9, so without
# a synthetic floor every passing case here would be asserting the size of the Operator’s list —
# the ninth variable, and the same read-the-box trap one delegation deeper.
FLOOR_SYNTH="$TMP/floor-1"
printf "1\n" >"$FLOOR_SYNTH"

EMPTY_LAYER="$TMP/layer-empty"
mkdir -p "$EMPTY_LAYER"
: >"$EMPTY_LAYER/privacy-patterns.txt"

# Bytes present, ZERO usable patterns. The gap between "0 bytes" and "1 pattern", and the one
# shape that most looks like a valid list — `test -s` cannot see through it, which is exactly how
# preflight and privacy-check came to disagree about the same file.
COMMENTS_LAYER="$TMP/layer-comments"
mkdir -p "$COMMENTS_LAYER"
printf '# only a comment\n\n# another\n' >"$COMMENTS_LAYER/privacy-patterns.txt"

LOOSE_LAYER="$TMP/layer-loose"
mkdir -p "$LOOSE_LAYER"
printf '# synthetic\nzzsecrethostzz\n' >"$LOOSE_LAYER/privacy-patterns.txt"
chmod 644 "$LOOSE_LAYER/privacy-patterns.txt"

# run_preflight <env assignments...> — every variable preflight reads, UNSET first.
#
# `env FOO=1 cmd` ADDS to the caller's environment; it does not replace it. So a case that asserts
# a variable is *absent* by simply not passing it was asserting a property of the shell running the
# suite, not of the code. That is a claim the TEST cannot support — the same shape this unit keeps
# removing, arriving one layer out — and it made the suite's result depend on the box: on a box
# exporting QUINCE_RUNNER_ROLE=arch (which the architect box does, from conf.d) the "unset role"
# case failed, and with ANTHROPIC_API_KEY exported four cases failed. That variable is the one this
# gate exists to refuse, and anyone working with Claude plausibly has it set, so `make gates` would
# have failed on their shell rather than on their change.
#
# EVERY variable preflight reads, not only the ones observed to break: the three credentials, the
# base URL, the role, and the token-file override. If preflight learns to read a new variable it
# must be added to THIS list — and to exactly one place, which is why the list is a variable rather
# than two copies. It was two: `run_preflight` and the `emptybin` case below, which cannot use
# `run_preflight` because it must override PATH. A seventh variable added to only one of them would
# leave that case reading the box again, and section 5 could not catch it, since those cases all go
# through `expect()` → `run_preflight`. One list, one place to change.
#
# The seventh variable arrived one PR after that sentence was written: QUINCE_PRIVATE_LAYER
# (quince#44). It is added here and nowhere else, which is exactly what the single list was for.
#
# The ninth and tenth arrived with quince#675: QUINCE_LAYER_FETCH_PROBE and
# QUINCE_LAYER_PROBE_TIMEOUT. The first is the one that matters — left un-neutralised, a box that
# exported it would have every layer case probing through somebody else's stub, which is the
# read-the-box defect this list exists to remove, aimed for the first time at the arm that decides
# whether a box starts.
#
# Unquoted on purpose: this is a list of separate arguments, not one word.
# shellcheck disable=SC2086
PF_UNSET="-u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN \
	-u ANTHROPIC_BASE_URL -u QUINCE_RUNNER_ROLE \
	-u QUINCE_PRIVATE_LAYER -u QUINCE_PRIVACY_CHECK -u PRIVACY_FLOOR_FILE \
	-u QUINCE_LAYER_FETCH_PROBE -u QUINCE_LAYER_PROBE_TIMEOUT"
# QUINCE_BOT_TOKEN_FILE is NOT unset here any more, deliberately. Unsetting a PATH does not mean
# "absent" — it means "fall back to the real one under /root/.config/quince". The suite-wide export
# above pins it to a nonexistent file inside $TMP, which is what "absent" was always meant to say,
# and every case that cares still overrides it per invocation.

# Every case gets a SYNTHETIC private layer by default. preflight now refuses without one, so
# otherwise every want-exit-0 case would be asserting "this box happens to have
# /root/quince-local" — true here, false on CI, and the same read-the-box defect the isolation
# above exists to prevent. Placed BEFORE "$@" so a case passing its own QUINCE_PRIVATE_LAYER wins:
# measured on this platform, `env A=1 A=2` yields 2, rather than erroring or taking the first.
run_preflight() {
	# shellcheck disable=SC2086
	env $PF_UNSET "QUINCE_PRIVATE_LAYER=$GOOD_LAYER" "PRIVACY_FLOOR_FILE=$FLOOR_SYNTH" "$@" PATH="$STUB:$PATH" "$PREFLIGHT" 2>&1
}

# expect <name> <want-exit> <substring> -- <env assignments...>
# The substring matters as much as the code: preflight returns 1 for every refusal, so the exit
# alone cannot tell "you set an API key" from "this box holds the wrong identity", and conflating
# those is how someone fixes the wrong thing.
expect() {
	name=$1 want=$2 substr=$3
	shift 4
	out=$(run_preflight "$@") && got=0 || got=$?
	if [ "$got" -ne "$want" ]; then
		printf 'FAIL %s\n  wanted exit %s, got %s\n' "$name" "$want" "$got"
		printf '%s\n' "$out" | sed 's/^/    | /'
		fail=$((fail + 1))
		return 0
	fi
	if [ -n "$substr" ] && ! printf '%s\n' "$out" | grep -qF "$substr"; then
		printf 'FAIL %s\n  exit %s was right, but output lacked: %s\n' "$name" "$got" "$substr"
		printf '%s\n' "$out" | sed 's/^/    | /'
		fail=$((fail + 1))
		return 0
	fi
	printf 'ok   %s (exit %s)\n' "$name" "$got"
	pass=$((pass + 1))
}

# =============================================================================================
# 1. CREDENTIALS THAT MUST NOT BE SET — the billing trap and the Remote-Control trap
# =============================================================================================
# An API key takes precedence over the claude.ai login, so a runner with one set comes up billing
# against it. A setup-token / OAuth token cannot establish Remote Control at all, so its presence
# means the box is misconfigured rather than merely unusual. Each refusal must NAME the variable:
# "the environment is bad" is a claim nobody can act on.
for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN; do
	expect "$var set is refused, by name" 1 "$var is set" -- \
		"$var=whatever" QUINCE_RUNNER_ROLE=implementer "QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"
done

# =============================================================================================
# 2. THE ENDPOINT MUST BE ANTHROPIC'S
# =============================================================================================
# Remote Control is disabled for any host other than api.anthropic.com, so a gateway or proxy
# silently removes the runner's whole purpose.
expect "a non-Anthropic base URL is refused" 1 "Remote Control is disabled" -- \
	ANTHROPIC_BASE_URL=https://gateway.example.invalid QUINCE_RUNNER_ROLE=implementer \
	"QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"
expect "the canonical base URL is accepted" 0 "api.anthropic.com" -- \
	ANTHROPIC_BASE_URL=https://api.anthropic.com QUINCE_RUNNER_ROLE=implementer \
	"QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"

# =============================================================================================
# 3. IDENTITY — each box asserts the OTHER's absence (devlog#7)
# =============================================================================================
# This inversion is the entire separation mechanism, and it is enforced where the service STARTS
# so it survives whoever provisioned the machine. approver ≠ author stops being a property of
# machines the moment either half of this stops being checked.
expect "implementer without the bot token is refused" 1 "no bot token at" -- \
	QUINCE_RUNNER_ROLE=implementer "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN"
expect "implementer with the bot token passes" 0 "bot token present, mode 600" -- \
	QUINCE_RUNNER_ROLE=implementer "QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"
expect "a world-readable bot token is refused, naming the mode" 1 "expected 600" -- \
	QUINCE_RUNNER_ROLE=implementer "QUINCE_BOT_TOKEN_FILE=$LOOSE_TOKEN"

# The arch box must NOT hold the implementer identity: one box that can author AND approve turns
# `approver ≠ author` from a property into a coincidence about which credential a session picks up.
# BOTH FORMS, because the implementer identity moved to an App key and this arm used to refuse only
# a bot token — so the assertion "the implementer identity is absent" was being made by checking for
# a credential that no longer carries it. An arch box could hold `quince-coder.pem` and pass.
expect "arch WITH a bot token is refused" 1 "IMPLEMENTER CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN" "QUINCE_CODER_KEY_FILE=$ABSENT_TOKEN"
expect "arch WITH a coder App key is refused" 1 "IMPLEMENTER CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" "QUINCE_CODER_KEY_FILE=$GOOD_TOKEN"
expect "arch with NEITHER implementer credential passes" 0 "no implementer credential present" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" "QUINCE_CODER_KEY_FILE=$ABSENT_TOKEN"

# --- THE SUPERVISOR ARM, WHICH THIS SUITE HAD NEVER DRIVEN (quince#375) -----------------------
#
# THE COVERAGE GAP IS THE FINDING, and it is worth more than any single case below. `supervisor` is
# one of the three roles `preflight` accepts, its arm is a pure credential check, and until now the
# string did not appear in this file once. The implementer and arch arms are covered in both
# directions; the third was covered in neither — quince#103's rule again, one role over: *checking
# one direction of a two-directional property is not a check*, and here it was zero of two.
#
# It matters now because the arm stopped being a clean denylist. "Absence of every credential" is a
# sentence anyone can verify by reading it; "absence of every credential except one" is a list, and a
# list is what needs a suite. So the weakening quince#375 accepts is exactly what makes these cases
# load-bearing rather than tidy.
#
# ALL FOUR REFUSALS ARE DRIVEN SEPARATELY. A loop over one variable would pass against an arm that
# checked only the first path in its list, which is a plausible way to get this wrong and an
# invisible one — the box would start while holding another seat's identity.
expect "supervisor WITH a bot token is refused" 1 "OTHER SEAT'S FORGE CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=supervisor "QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"
expect "supervisor WITH a coder App key is refused" 1 "OTHER SEAT'S FORGE CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=supervisor "QUINCE_CODER_KEY_FILE=$GOOD_TOKEN"
expect "supervisor WITH a reviewer App key is refused" 1 "OTHER SEAT'S FORGE CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=supervisor "QUINCE_REVIEW_KEY_FILE=$GOOD_TOKEN"
expect "supervisor WITH an architect token is refused" 1 "OTHER SEAT'S FORGE CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=supervisor "QUINCE_ARCH_TOKEN_FILE=$GOOD_TOKEN"

# THE ALLOWLIST'S POSITIVE HALF — the case the whole change exists for, and the one a denylist with
# an exception bolted on would get wrong. Without it, an arm that refused the analyst key too would
# pass every assertion above.
expect "supervisor WITH the analyst key alone STARTS" 0 "exactly one identity" -- \
	QUINCE_RUNNER_ROLE=supervisor "QUINCE_ANALYST_KEY_FILE=$GOOD_TOKEN"

# AND THE PAIR THAT MAKES IT AN ALLOWLIST RATHER THAN A PERMISSION. The analyst key present does not
# license anything else: with another seat's credential beside it the box must still refuse, or
# "exactly one identity" is a claim nothing enforces.
expect "the analyst key does not license a SECOND identity" 1 "OTHER SEAT'S FORGE CREDENTIAL is present" -- \
	QUINCE_RUNNER_ROLE=supervisor "QUINCE_ANALYST_KEY_FILE=$GOOD_TOKEN" "QUINCE_REVIEW_KEY_FILE=$GOOD_TOKEN"

# A TOKEN IN THE ENVIRONMENT IS A CREDENTIAL, and the arm has said so since a box passed while
# holding `GH_TOKEN=…` — a fully working credential, since that variable is exactly how the wrappers
# hand one to `gh`. Driven here because the allowlist rewrite touched the block it lives in, and an
# untested neighbour is how a rewrite loses a check nobody was asserting.
expect "supervisor with GH_TOKEN in the environment is refused" 1 "in the environment" -- \
	QUINCE_RUNNER_ROLE=supervisor GH_TOKEN=ghp_notarealtoken

# THE BOOTSTRAP CASE: no analyst key yet is a NOTE, not a refusal — the arch arm's posture for its
# reviewer key, for the same reason. A box provisioned before the App existed is a correct box that
# predates a change, and refusing to start it would strand the seat the Operator talks to.
expect "supervisor with NO credential at all still starts, and says what is lost" 0 "cannot act under its own name" -- \
	QUINCE_RUNNER_ROLE=supervisor

# THE EXEMPTION IS RULED, AND THE LINE MUST SAY WHICH (quince#375, Operator 2026-08-01). This case
# pinned the literal "unruled gap" for one PR, while the justification's premise was withdrawn and the
# answer was owed. The ruling is now in: no private layer here, the journal pre-push hook carries the
# control. So the string moves with it — pinning "unruled gap" after a ruling would hold the arm at
# the wrong claim, which is this file's own defect class one turn later.
#
# WHAT IS PINNED IS STILL THE ANNOUNCEMENT, not the behaviour, and that is the point: an exemption a
# reader cannot distinguish from an unexamined default is worth no more than the default. The line has
# to say it was DECIDED.
expect "the private-layer exemption says it was RULED, not merely unchecked" 0 "RULED 2026-08-01" -- \
	QUINCE_RUNNER_ROLE=supervisor

# AND IT MUST POINT AT WHAT ACTUALLY CARRIES THE CONTROL. The ruling's own reasoning is that requiring
# the layer would make the gate RUNNABLE without making it RUN — only `bin/pre-push-journal` invokes
# it on a journal push. So a supervisor box that reads "no private layer required" and stops there has
# read half of it; the arm has to send the reader to the hook lines, which are the ones that say
# whether the control is INSTALLED rather than merely decided.
expect "the exemption names the journal hook as the control, not the layer" 0 "journal pre-push hook" -- \
	QUINCE_RUNNER_ROLE=supervisor

# An unknown role refuses rather than guessing which identity rules apply — guessing would pick
# one of two opposite assertions.
expect "an unknown role refuses rather than guessing" 1 "unknown QUINCE_RUNNER_ROLE" -- \
	QUINCE_RUNNER_ROLE=nonsense "QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"

# An undeclared role defaults to the STRICTER historical behaviour, and says that it assumed.
# Without the announcement, a hand run on the arch box reports "no bot token" — true, but it reads
# as "you are missing a credential" when the cause is "you did not say which box this is".
expect "an unset role is ASSUMED implementer, and says so" 0 "ASSUMED" -- \
	"QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"

# =============================================================================================
# 4. THE THING WE ARE ABOUT TO RUN
# =============================================================================================
# Proven by pointing PATH at a directory with no `claude` in it — the one case the stub must not
# cover, since it is the stub's own subject.
emptybin="$TMP/emptybin"
mkdir -p "$emptybin"
# The SAME $PF_UNSET, not a copy of it — this case cannot use run_preflight because it must point
# PATH at a directory with no `claude`, which run_preflight deliberately does not allow.
# shellcheck disable=SC2086
out=$(env $PF_UNSET "PRIVACY_FLOOR_FILE=$FLOOR_SYNTH" PATH="$emptybin" QUINCE_RUNNER_ROLE=arch \
	"QUINCE_PRIVATE_LAYER=$GOOD_LAYER" \
	"QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" "$PREFLIGHT" 2>&1) && got=0 || got=$?
if [ "$got" -eq 1 ] && printf '%s\n' "$out" | grep -qF "claude is not installed"; then
	printf 'ok   an absent claude is refused, naming provision (exit %s)\n' "$got"
	pass=$((pass + 1))
else
	printf 'FAIL an absent claude is refused, naming provision\n  exit=%s\n' "$got"
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
fi

# =============================================================================================
# 4b. THE PRIVATE LAYER — a box that cannot gate must not start (quince#44)
# =============================================================================================
# Ruled by the Operator: refuse, rather than come up and run a gate that silently cannot run. The
# defect being closed is that a rebuilt box returns to the gate-that-cannot-gate state with nothing
# announcing it, while sessions have learned to trust the file a rebuild removed.
expect "an unreachable private layer refuses" 1 "cannot run the privacy gate" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$ABSENT_LAYER"

# quince#132 review (#147): capturing the gate's count needs its two streams SEPARATED into a temp
# file, and preflight runs as ROOT. If mktemp is unavailable the box must REFUSE rather than fall
# back to a predictable /tmp path — which on a match would write the gate's Operator-private lines
# somewhere guessable, world-readable, and symlink-followable (CWE-377) with a root write primitive.
# Simulated by a mktemp stub that exits 1, prepended so every OTHER tool still resolves normally.
# Not run via run_preflight/expect: this must control PATH, which run_preflight deliberately fixes.
MKBAD="$TMP/mktemp-fails"
mkdir -p "$MKBAD"
printf '#!/bin/sh\nexit 1\n' >"$MKBAD/mktemp"
chmod +x "$MKBAD/mktemp"
# shellcheck disable=SC2086
out=$(env $PF_UNSET "PRIVACY_FLOOR_FILE=$FLOOR_SYNTH" PATH="$MKBAD:$STUB:$PATH" QUINCE_RUNNER_ROLE=arch \
	"QUINCE_PRIVATE_LAYER=$GOOD_LAYER" \
	"QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" "$PREFLIGHT" 2>&1) && got=0 || got=$?
if [ "$got" -eq 1 ] && printf '%s\n' "$out" | grep -qF "mktemp is unavailable"; then
	printf 'ok   an unavailable mktemp refuses rather than degrading to a predictable /tmp path (exit %s)\n' "$got"
	pass=$((pass + 1))
else
	printf 'FAIL an unavailable mktemp should refuse, not degrade to a predictable /tmp path\n  exit=%s\n' "$got"
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
fi

# quince#121: PRESENT IS NOT FRESH. A git clone with no credential helper can never fetch, so the box
# would sweep forever with whatever it was built holding — and on the arch box that sweep is the last
# gate before public history. It reports `clean` exactly as a current one does, which is why this
# refuses rather than notes. Both boxes were in this state and only one showed it, because only one
# ever tried to pull.
expect "a git layer with no credential helper refuses" 1 "can never fetch" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$FROZEN_LAYER"

# …and names the fix, which must be the one that EXISTS: `provision` persisting the helper with
# `git config`. Pinned because the previous version of this file used `git -c`, which configures
# nothing, and a message naming a fix nobody has built is the defect class this suite exists for.
expect "…and names provision as the fix" 1 "run deploy/runner/provision" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$FROZEN_LAYER"

# The mirror, and it is what stops the refusal above from being vacuous: the SAME layer, wired,
# passes. Without this a check that refused every git clone would look correct.
#
# THE STUB IS NOW REQUIRED HERE, and its absence would be a bug in the suite rather than a detail:
# a wired layer reaches the probe, and with no override the probe would make a REAL NETWORK CALL to
# `zz-synthetic.invalid` from a unit test. It would still pass — the failure lands in the note arm —
# but it would pass for the wrong reason, slowly, and differently on a box with no route out.
expect "a wired git layer passes and says it can advance" 0 "can advance" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

# …and it says the fetch HAPPENED rather than that the config looks right. This is quince#675's
# whole claim in one substring: the old message read "a credential helper resolves for its http(s)
# remote", which is a property of a file, printed under a heading that promises a property of the
# remote. Pinned so the wording cannot drift back to describing the config.
expect "…and says it MEASURED the remote, not the config" 0 "reached and authenticated just now" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

# QUINCE#675, THE DEFECT ITSELF: a helper that RESOLVES and a credential that is REJECTED. Every
# local fact this check used to read is identical to the passing case directly above — same layer
# shape, same wiring — and the box was reported healthy for it while `git fetch` returned 128 in the
# same minute (quince#674, arch box, 2026-08-06). Only asking the remote separates the two.
expect "a wired layer whose credential is REJECTED refuses" 1 "CREDENTIAL IT NAMES WAS REJECTED" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/authfail"

# …and quotes what the remote SAID. preflight's own rule is that a check names what it OBSERVED
# rather than that something is wrong; "the private layer cannot fetch" is a claim nobody can act on
# without the server's own line under it.
expect "…and quotes the remote's own line" 1 "Authentication failed for" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/authfail"

# THE FALSE-REFUSAL GUARD, and it is the reason this check is allowed to touch the network at all.
# The paragraph in `preflight` that rejected a live fetch was afraid of exactly this: a box taken out
# of service because DNS was slow. Same exit 128 as the refusing case, opposite verdict, and the
# ONLY difference is the text — so if anyone ever reclassifies on the exit code, this fails.
expect "a probe that fails on the NETWORK notes and does not refuse" 0 "not a rejected credential" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/dns"

# The tempting over-reach. "The helper produced no credential" LOOKS permanent and is not: a wrapper
# that could not mint an installation token this once produces it, and so does a forge outage. It is
# also already covered fail-closed one step earlier — a layer with no helper at all never reaches
# here. Pinned because widening the refusal to this string is the obvious next edit and it would
# make a GitHub incident into a box that will not boot.
expect "a probe with NO credential produced notes and does not refuse" 0 "not a rejected credential" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/noprompt"

# A timeout is a non-zero exit with an EMPTY stderr, so the message has no observation to quote and
# must say so rather than printing "observed — " and stopping. It also pins that nothing reads the
# timeout's exit code: this stub returns busybox's 143, GNU coreutils returns 124 for the same
# event, and a classifier that discriminated on either would be correct on one platform only.
expect "a TIMED-OUT probe notes, and says so without an observation to quote" 0 "it timed out after" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/timedout"

# PRIVACY, on the one path where being wrong is a credential in a logfile. `git remote get-url` hands
# back userinfo verbatim, and preflight runs as root writing to /var/log/quince-runner.log. git 2.54.0
# redacts its own messages — measured — but that is one version's behaviour, so the strip is asserted
# here against a stub that does NOT redact. Presence and absence both: `expect` can only prove a
# substring is there, and the claim that matters is that a substring is GONE.
expect "a probe whose output carries inline credentials still notes" 0 "userinfo-redacted" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/leaky"

out=$(run_preflight QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/leaky") || true
if printf '%s\n' "$out" | grep -q 'zzsupersecretzz'; then
	printf 'FAIL the probe must not print an inline credential from the remote URL\n'
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
else
	printf 'ok   …and the secret itself does NOT appear in the output\n'
	pass=$((pass + 1))
fi

# STDOUT IS DISCARDED, NOT MERGED — and this is asserted on the FAILING path because that is the
# only place it is observable. `ls-remote` writes the resolved SHA to stdout on success, but the
# success arm quotes nothing, so a `2>&1` there changes no output at all: an assertion against the
# `ok` stub passes whether the streams are merged or not, which is a test that looks strong and
# proves nothing (mutation-tested, and that is exactly what it did).
#
# The `noisy` stub fails, writes its `fatal:` to stderr, and writes to stdout LAST. Merged, the note
# quotes the stdout line; discarded, it quotes the `fatal:`. Both halves are checked, because
# "quotes the right thing" and "does not quote the wrong thing" are different claims and only the
# second one is about the stream.
#
# It matters beyond tidiness: the classifier greps this text for `Authentication failed`, so merging
# stdout would let whatever a remote puts there sit in front of a boot-blocking decision.
out=$(run_preflight QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$WIRED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/noisy") || true
if printf '%s\n' "$out" | grep -q 'zzstdoutleakzz'; then
	printf 'FAIL the probe must discard stdout; the stub stdout reached the classifier\n'
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
elif ! printf '%s\n' "$out" | grep -q 'Could not resolve host'; then
	printf 'FAIL stdout was discarded but so was the stderr the note must quote\n'
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
else
	printf 'ok   the probe discards stdout and quotes stderr — no stdout in the classifier\n'
	pass=$((pass + 1))
fi

# THE REGRESSION TEST FOR THIS CHECK'S OWN FIRST VERSION. A URL-scoped helper is a different config
# KEY from an unscoped one, and `config --get credential.helper` cannot see it — so the first draft
# refused this shape. It is not hypothetical: it is how the Operator wired the architect box, and
# that box was confirmed fetching in that state. A boot-blocking check that refuses a working
# machine is worse than the staleness it guards against.
expect "a URL-SCOPED helper also counts as wired" 0 "can advance" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$URLSCOPED_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

# A helper with no remote to apply to cannot fetch. Asserted separately because `--get-urlmatch`
# needs a URL: without an explicit refusal here the code would have to invent one, and a check that
# guesses its own input is the shape this file keeps removing.
expect "a git layer with a helper but NO remote refuses" 1 "NO 'origin' remote" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$NOREMOTE_LAYER"

# A CREDENTIAL HELPER IS AN HTTP(S) MECHANISM, so demanding one from a transport that cannot use it
# refuses a box that fetches perfectly. This is the same defect as the `--get credential.helper`
# draft one transport further out: a boot-blocking check refusing a working machine, which the
# comment in `preflight` calls worse than the staleness it guards against. Caught in review, before
# anyone cloned the layer over SSH — and the message it would have handed them was actively wrong,
# since `provision` writes an HTTPS helper, so "run provision" would have repaired a working box by
# replacing its transport.
expect "an SSH (scp-style) layer is not asked for a helper" 0 "can advance" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$SSH_SCP_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

# The sibling that un-masking the stderr would NOT have fixed, which is why it is asserted
# separately rather than folded into the case above. `ssh://` is a valid URL, so `--get-urlmatch`
# does not fatal on it: it exits 1 with empty output and prints nothing. There was never an error to
# discard here — the old code simply read a true answer to the wrong question and refused.
expect "an ssh:// layer is not asked for a helper" 0 "can advance" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$SSH_URL_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

# `file://` behaves as `ssh://` does and is pinned so the fix is not read as SSH-specific. One
# scheme dispatch covers every non-http(s) transport; without this, a later reader could narrow the
# `*)` arm to SSH and break local-path clones with every test still passing.
expect "a file:// layer is not asked for a helper" 0 "can advance" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$FILE_URL_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

# THE THREE CASES ABOVE CHANGED THEIR EXPECTED SUBSTRING, AND THE OLD ONE IS WORTH SAYING OUT LOUD:
# they asserted "nothing to assert", beside a fourth case pinning "whether it can fetch depends on"
# — a deliberate refusal to claim freshness, because an ssh key was not a local fact preflight could
# read. That was right while the check was local. quince#675 makes it non-local, and a probe does
# not care about the scheme, so the honest report for these is the same measured `can advance` the
# http(s) arm gives. The fourth case is DELETED rather than inverted: it existed to stop the check
# claiming a property it never checked, and the property is now checked.
#
# WHAT MUST NOT COME BACK WITH IT is the helper demand. These schemes still get NO wiring check —
# that is quince#121's fix and it is untouched. The case below is what pins it, and it pins it in
# the only way that survives the arms being merged: by the message a helper refusal would carry.
expect "…and non-http(s) is still never asked for a credential helper" 0 "can advance" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$SSH_SCP_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok"

out=$(run_preflight QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$SSH_SCP_LAYER" "QUINCE_LAYER_FETCH_PROBE=$PROBE_BIN/ok") || true
if printf '%s\n' "$out" | grep -q 'NO credential helper'; then
	printf 'FAIL an scp-style remote must never be asked for a credential helper (quince#121)\n'
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
else
	printf 'ok   …and no credential-helper refusal is raised for it\n'
	pass=$((pass + 1))
fi

# A HAND-PLACED layer is not a clone and has no remote to be wired to. preflight's own refusal text
# prescribes hand-placement as a documented path, so refusing it here would forbid the fallback this
# file recommends one screen earlier — the contradiction being pinned rather than trusted.
expect "a hand-placed (non-git) layer is not asked to fetch" 0 "privacy gate can run" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$GOOD_LAYER"

# The message must NAME THE FIX THAT EXISTS TODAY — hand-placement. When `provision` learns to
# place the layer, correcting this belongs to that change, and this assertion is what will fail and
# force it rather than letting the text rot into naming a fix nobody has built.
expect "…and names the fix that exists today: provision" 1 "run deploy/runner/provision" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$ABSENT_LAYER"

# …and must NOT claim to know WHY. A private repo 404s identically for "does not exist" and "not
# granted", so a message that guessed would send the next reader to recreate a repo when the real
# fix is a one-click grant. Asserted by the absence of both wrong words.
out=$(run_preflight QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$ABSENT_LAYER") || true
if printf '%s\n' "$out" | grep -qiE 'does not exist|no such repositor|lack permission|not authori[sz]ed|access denied'; then
	printf 'FAIL the refusal must not guess WHY the layer is unreachable\n'
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
else
	printf 'ok   the refusal does not guess WHY the layer is unreachable (exit 1)\n'
	pass=$((pass + 1))
fi

# An EMPTY list is worse than an absent one: it matches nothing and reports every sweep clean, so
# it looks like it ran. privacy-check exits 2 on it (quince#41); preflight refuses to start a box
# that would produce it.
expect "an EMPTY pattern list refuses, quoting the gate" 1 "is EMPTY" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$EMPTY_LAYER"

# A COMMENTS-ONLY list has bytes and zero usable patterns. Against the first version of this
# change it PASSED — the box started, asserting the gate could run, while privacy-check returned 2
# on the identical file. preflight and the gate must agree about the same file by construction,
# which is why the verdict is now the gate's own exit code rather than a second implementation.
expect "a comments-only pattern list refuses" 1 "cannot run the privacy gate" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$COMMENTS_LAYER"

# …and the refusal quotes what the GATE observed, so the two tools cannot drift into disagreeing
# messages either.
expect "…quoting the gate's own observation" 1 "no usable patterns" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$COMMENTS_LAYER"

# A missing gate is not a pass either: preflight cannot establish that the box can gate without it.
expect "a missing privacy-check refuses rather than assuming" 1 "privacy gate is missing" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	QUINCE_PRIVACY_CHECK=/nonexistent/privacy-check

# A STAGED VIOLATION IN THE CWD MUST NOT STOP THE BOX STARTING. preflight inherits the service's
# cwd — `runner_dir`, /root/quince, a real repo sessions work in — and privacy-check with no --ref
# sweeps the staged diff there. Exit 1 therefore means "the gate ran and matched something in an
# unrelated working tree", which PROVES the gate can run; only 2 means it could not look. Against
# the first version of this borrowing, an interrupted commit in the launchpad made preflight refuse
# with "this box cannot run the privacy gate" — while the gate had just run perfectly — and print a
# fix telling someone to replace a healthy pattern list.
staged_repo="$TMP/staged-cwd"
mkdir -p "$staged_repo"
git -C "$staged_repo" init -q -b main
git -C "$staged_repo" config user.email fixture@example.invalid
git -C "$staged_repo" config user.name 'fixture'
echo baseline >"$staged_repo/README.md"
git -C "$staged_repo" add -A
git -C "$staged_repo" commit -qm baseline
printf 'the host is zzsecrethostzz\n' >"$staged_repo/leak.md"
git -C "$staged_repo" add leak.md
# shellcheck disable=SC2086
out=$(cd "$staged_repo" && env $PF_UNSET "QUINCE_PRIVATE_LAYER=$GOOD_LAYER" "PRIVACY_FLOOR_FILE=$FLOOR_SYNTH" \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	PATH="$STUB:$PATH" "$PREFLIGHT" 2>&1) && got=0 || got=$?
if [ "$got" -eq 0 ] && printf '%s\n' "$out" | grep -qF "private layer present"; then
	printf 'ok   a staged violation in the cwd does not stop the box starting (exit %s)\n' "$got"
	pass=$((pass + 1))
else
	printf 'FAIL a staged violation in the cwd does not stop the box starting\n  exit=%s\n' "$got"
	printf '%s\n' "$out" | sed 's/^/    | /'
	fail=$((fail + 1))
fi
# …and the matched line must NEVER reach preflight's output. This goes to
# /var/log/quince-runner.log, and on exit 1 the gate's stderr carries the private content it
# matched — so a leak here would be preflight publishing exactly what the gate exists to contain.
if printf '%s\n' "$out" | grep -qF "zzsecrethostzz"; then
	printf 'FAIL preflight leaked the matched private content into its own output\n'
	fail=$((fail + 1))
else
	printf 'ok   the matched content never reaches preflight output (service-log safety)\n'
	pass=$((pass + 1))
fi

# A usable layer passes and states the pattern COUNT, so a reader can tell a real layer from a
# nearly-empty one — the same reason privacy-check and forge-watch print their counts. The count is
# now QUOTED from the gate's own line rather than re-counted from one list (quince#132), so this
# asserts the gate's wording — which counts both lists — rather than a locally-derived number.
expect "a usable private layer passes, stating the count" 0 "the gate reports lists 1 case-insensitive" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN"

# THE quince#132 REGRESSION: a SPLIT list is counted across BOTH files. The old banner counted the
# case-insensitive list alone and would have printed "1 usable patterns" for this 1+1 layer; the
# quoted gate count says "lists 1 case-insensitive + 1 case-sensitive". If this ever reverts to a
# single-list count, this fails.
expect "a split private layer counts both lists" 0 "the gate reports lists 1 case-insensitive + 1 case-sensitive" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$SPLIT_LAYER"

# THE COUNT IS QUOTED FROM A BANNER THAT NOW CARRIES OTHER LINES TOO (quince#220). `preflight` took
# the FIRST line beginning "lists"; when quince#220 added a provenance line — under its first name,
# `lists provenance …` — preflight quoted the PROVENANCE where a count belongs, and the two
# assertions above are what caught it.
#
# WHAT THIS DOES AND DOES NOT PROVE, measured rather than assumed. It proves the count survives a
# MULTI-LINE banner, against a git-backed layer that really emits both lines — which the non-git
# fixtures above cannot do. It does **not** prove the `lists <digit>` anchor: once the line was
# renamed to `pattern source …`, no banner line begins with "lists" except the count, so reverting
# the anchor to `lists .*` leaves this passing (verified — 44/0 either way). The anchor is defensive
# against the NEXT such line and is deliberately untested, because testing it would mean keeping a
# decoy line in the banner purely to be matched wrongly.
#
# It needs an `origin` and mode 600: preflight ALREADY refuses a layer clone with no remote
# (quince#121 — "frozen at whatever it holds now") and notes a world-readable list. Both fired on the
# first version of this fixture, which is preflight's other checks doing their job on a fixture built
# to exercise a third.
GIT_LAYER="$TMP/layer-git"
mkdir -p "$GIT_LAYER"
printf 'zzsynthetic-onlyzz\n' >"$GIT_LAYER/privacy-patterns.txt"
chmod 600 "$GIT_LAYER/privacy-patterns.txt"
if git -C "$GIT_LAYER" init -q -b main >/dev/null 2>&1 &&
	git -C "$GIT_LAYER" config user.email fixture@example.invalid &&
	git -C "$GIT_LAYER" config user.name fixture &&
	git -C "$GIT_LAYER" remote add origin "$TMP/layer-git-origin" &&
	git -C "$GIT_LAYER" add -A >/dev/null 2>&1 &&
	git -C "$GIT_LAYER" commit -qm patterns >/dev/null 2>&1; then
	expect "the COUNT is quoted even when a provenance line precedes it" 0 "the gate reports lists 1 case-insensitive" -- \
		QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
		"QUINCE_PRIVATE_LAYER=$GIT_LAYER"
else
	printf 'skip the git-backed layer could not be built — provenance/count ordering unproven here\n'
fi

# A loose mode is REPORTED, NOT ENFORCED — matching the apk-drift reporter, and for the same
# reason: refusing to start over a permission bit turns a one-command fix into an outage. It must
# still be said, because this is a list OF the sensitive strings.
expect "a world-readable pattern list is reported, not refused" 0 "mode 644, expected 600" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN" \
	"QUINCE_PRIVATE_LAYER=$LOOSE_LAYER"

# =============================================================================================
# 5. THE SUITE MUST NOT READ THE BOX
# =============================================================================================
# The isolation above is itself a claim, and an untested one would rot the first time someone adds
# a variable or "simplifies" the unset list. So: export the hostile values that actually broke this
# suite and assert the results do not move. Without `env -u` these four cases fail — which is
# precisely how the defect presented on the architect box.
export QUINCE_RUNNER_ROLE=arch
export ANTHROPIC_API_KEY=sk-ambient-not-real
export ANTHROPIC_BASE_URL=https://gateway.example.invalid
export ANTHROPIC_AUTH_TOKEN=ambient-not-real

expect "ambient role does not reach the unset-role case" 0 "ASSUMED" -- \
	"QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"
expect "ambient API key does not fail an unrelated case" 0 "bot token present, mode 600" -- \
	QUINCE_RUNNER_ROLE=implementer "QUINCE_BOT_TOKEN_FILE=$GOOD_TOKEN"
expect "ambient base URL does not reach the endpoint case" 0 "unset or api.anthropic.com" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN"
expect "ambient auth token does not reach the credential case" 0 "no API-key or token credential" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN"

# The seventh variable needs the same guard as the other six, or the newest read is the only
# unprotected one. Pointed at a layer that does not exist: if it leaked, the passing cases would
# refuse.
export PRIVACY_FLOOR_FILE=/nonexistent/floor
expect "ambient floor path does not reach a passing case" 0 "private layer present" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN"
unset PRIVACY_FLOOR_FILE

export QUINCE_PRIVATE_LAYER="$ABSENT_LAYER"
expect "ambient private-layer path does not reach a passing case" 0 "private layer present" -- \
	QUINCE_RUNNER_ROLE=arch "QUINCE_BOT_TOKEN_FILE=$ABSENT_TOKEN"

unset QUINCE_RUNNER_ROLE ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN QUINCE_PRIVATE_LAYER

# =============================================================================================
printf '\npreflight-test: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ] || exit 1
