#!/bin/sh
# provision — make a container into the runner. Run it ON the runner, as root.
#
#   ssh quince-runner 'sh -s' < deploy/runner/provision
#
# Everything here is idempotent and announces what it did rather than what it intended. What it
# CANNOT do is the login: a setup-token cannot establish Remote Control, so the Operator's
# interactive `claude auth login` is the only path — the script ends by saying exactly that.
set -eu

# --role arch provisions the architect box: same path, inverted identity assertion. The role is
# written into the service's conf so it survives restarts and reboots rather than living in the
# shell that happened to run this script.
ROLE=implementer
[ "${1:-}" = --role ] && { ROLE="${2:?--role needs a value}"; shift 2; }
case "$ROLE" in implementer|arch) ;; *) printf 'provision: unknown role %s\n' "$ROLE" >&2; exit 2 ;; esac
SERVICE_NAME="quince-runner"
[ "$ROLE" = arch ] && SERVICE_NAME="quince-arch"

# --- THE ROLE MUST MATCH THE BOX, AND THIS REFUSES BEFORE ANYTHING IS TOUCHED (quince#121) -----
# Placed HERE, above the package install and the launchpad update, because a refusal that arrives
# after the script has begun mutating the box is a refusal that has already changed it. Everything
# this check needs is known at argument-parse time; the first draft sat beside the layer section a
# hundred lines down and reported `exit=2` having already installed packages and updated the
# launchpad. Correct verdict, wrong moment.
#
# WHAT WENT WRONG, so the guard is not mistaken for ceremony. `--role` is an ARGUMENT and defaults
# to `implementer`. `QUINCE_RUNNER_ROLE` is NOT read as input — it appears once in this file,
# exported TO `preflight` — so an invocation setting it in the environment silently gets the
# default. On the architect box that default found no bot token (correctly: that box must never
# hold one), printed "NOT placing the private layer" as a NOTE, and then carried on to install an
# implementer-role service on the architect's machine. Nothing was repaired, and the box was left
# holding exactly the artifact the two-box identity model exists to prevent.
#
# The missing flag was the trigger. The DEFECT is that this script warned and continued: a run that
# cannot do the thing it exists to do must not proceed to configure the box for it.
#
# Only this one shape refuses, because only this one is unambiguous: the OTHER role's credential is
# present and this role's is not. That is a wrong `--role`, not a box awaiting its first token.
# Neither-token and this-token-present are both left alone — "no credentials yet" is a legitimate
# first-provision state, and the layer section's note already covers it.
_bot_token="${QUINCE_BOT_TOKEN_FILE:-/root/.config/quince/quince-bot.token}"
_arch_token="${QUINCE_ARCH_TOKEN_FILE:-/root/.config/quince/quince-arch.token}"
if [ "$ROLE" = arch ]; then
	_role_token="$_arch_token" _other_token="$_bot_token" _other_role=implementer
else
	_role_token="$_bot_token" _other_token="$_arch_token" _other_role=arch
fi
if [ ! -f "$_role_token" ] && [ -f "$_other_token" ]; then
	printf 'provision: role %s needs %s, which is absent — but this box HOLDS the %s credential.\n' \
		"$ROLE" "$_role_token" "$_other_role" >&2
	printf 'provision: refusing rather than provisioning this box as %s, and refusing BEFORE touching\n' "$ROLE" >&2
	printf '    anything. That is near-certainly a missing or wrong --role: it is an ARGUMENT\n' >&2
	printf '    (--role %s), and QUINCE_RUNNER_ROLE in the environment is NOT read as input.\n' "$_other_role" >&2
	printf '    Re-run as: %s --role %s\n' "$0" "$_other_role" >&2
	printf '    Continuing would install a %s-role service on a %s box (quince#121).\n' \
		"$ROLE" "$_other_role" >&2
	exit 2
fi

REPO_URL="${REPO_URL:-https://github.com/novkostya/quince.git}"
RUNNER_DIR="${RUNNER_DIR:-/root/quince}"
# Verified at pin time from the Claude Code setup docs (2026-07-26). The apk repository is signed;
# this is the published checksum of the signing key, and provisioning refuses a key that does not
# match rather than trusting whatever it downloaded.
CLAUDE_APK_KEY_URL="https://downloads.claude.ai/keys/claude-code.rsa.pub"
CLAUDE_APK_KEY_SHA="395759c1f7449ef4cdef305a42e820f3c766d6090d142634ebdb049f113168b6"
CLAUDE_APK_REPO="https://downloads.claude.ai/claude-code/apk/stable"

say() { printf '==> %s\n' "$*"; }

# --- 1. base packages ------------------------------------------------------------------------
# ripgrep is a runtime dependency on musl, and the built-in one is disabled below per the docs.
say "installing base packages"
apk add --no-cache git make openssh-client curl bash ripgrep libgcc libstdc++ jq >/dev/null
say "base packages present"

# --- 2. Claude Code, from the signed apk repository -------------------------------------------
# The `stable` channel deliberately: apk installs do not auto-update, so the runner's version moves
# when someone runs an upgrade — which suits a project that pins toolchains and dislikes silent
# drift. `latest` is one line away if that trade is ever wrong.
if command -v claude >/dev/null 2>&1; then
	say "claude already installed ($(claude --version 2>/dev/null || echo '?'))"
else
	say "adding the Claude Code apk repository (signed)"
	wget -qO /etc/apk/keys/claude-code.rsa.pub "$CLAUDE_APK_KEY_URL"
	got=$(sha256sum /etc/apk/keys/claude-code.rsa.pub | cut -d' ' -f1)
	if [ "$got" != "$CLAUDE_APK_KEY_SHA" ]; then
		rm -f /etc/apk/keys/claude-code.rsa.pub
		printf 'provision: signing key checksum mismatch\n  expected %s\n  got      %s\nRefusing to add the repository.\n' \
			"$CLAUDE_APK_KEY_SHA" "$got" >&2
		exit 1
	fi
	say "signing key verified against the published checksum"
	grep -q "$CLAUDE_APK_REPO" /etc/apk/repositories || printf '%s\n' "$CLAUDE_APK_REPO" >>/etc/apk/repositories
	apk update >/dev/null
	apk add --no-cache claude-code >/dev/null
	say "claude installed ($(claude --version 2>/dev/null || echo '?'))"
fi

# --- 3. musl setting -------------------------------------------------------------------------
# On musl the bundled ripgrep is not used; the docs require pointing Claude Code at the system one.
mkdir -p /root/.claude
if [ -f /root/.claude/settings.json ]; then
	tmp=$(mktemp)
	jq '.env = ((.env // {}) + {"USE_BUILTIN_RIPGREP":"0"})' /root/.claude/settings.json >"$tmp" &&
		mv "$tmp" /root/.claude/settings.json
else
	printf '{\n  "env": { "USE_BUILTIN_RIPGREP": "0" }\n}\n' >/root/.claude/settings.json
fi
say "USE_BUILTIN_RIPGREP=0 set (musl: the system ripgrep is used)"

# --- 4. the launchpad ------------------------------------------------------------------------
# A pristine checkout used to START sessions. Never a workspace: every unit of work is a fresh
# clone elsewhere, so anything modified here is a finding rather than a habit.
if [ -d "$RUNNER_DIR/.git" ]; then
	git -C "$RUNNER_DIR" fetch -q origin main && git -C "$RUNNER_DIR" reset -q --hard origin/main
	say "launchpad updated at $RUNNER_DIR (pristine checkout — not a workspace)"
else
	git clone -q "$REPO_URL" "$RUNNER_DIR"
	say "launchpad cloned at $RUNNER_DIR (pristine checkout — not a workspace)"
fi

# --- 4b. the private layer ----------------------------------------------------------------------
# quince#44, Operator ruling 2026-07-27: the private layer is a PROPERTY OF THE BOX, cloned here
# rather than hand-placed and remembered. Before this, a rebuilt box silently returned to a state
# where the privacy gate could not run, while sessions had learned to trust a file the rebuild
# removed, and nothing announced the regression. `preflight` now refuses to start such a box; this
# is what stops that refusal from being the normal case.
#
# A FULL CLONE, ruled deliberately over a narrow single-file fetch. The two rulings are coherent:
# the implementer holds `write` because the layer is a living document it must be able to maintain,
# and an implementer that can write `environment.md` but cannot see it would reintroduce the human
# hop the write grant exists to remove.
#
# ACCEPTED EXPOSURE, stated where somebody reading the provisioning will meet it: this places the
# COMPLETE private record on the box — ~610 KB across 8 files, including the lab topology and the
# external review transcripts — not the 107-byte pattern list. `pr.6`'s credential-concentration
# boundary owes a line saying so.
#
# THE CREDENTIAL IS ROLE-DEPENDENT, and the ruling did not say so because it could not: the arch
# box must NOT hold the bot token — `preflight` refuses to start if it does, and that inversion is
# the whole separation mechanism (devlog#7). So each box clones with its OWN identity; cloning as
# the bot on the arch box would mean placing the one credential that box must never hold.
LAYER_DIR="${QUINCE_PRIVATE_LAYER:-/root/quince-local}"
LAYER_URL="${LAYER_URL:-https://github.com/novkostya/quince-local.git}"
# The role/box mismatch was already refused at argument-parse time, above, before anything on this
# box was touched. Here we only need the credential this role actually uses.
LAYER_TOKEN="$_role_token"
LAYER_USER=quince-bot
[ "$ROLE" = arch ] && LAYER_USER=novkostya

# The token reaches git through a credential helper — never argv, never the remote URL, never
# .git/config. The same discipline as every other credential in this project.
# SC2016 is correct that `$(cat …)` does not expand here, and that is the point: it must be
# evaluated by GIT when it runs the helper, not by this shell when it builds the string. Expanding
# it now would put the token into a variable, and from there into `git config` and `.git/config` —
# which is the one thing the helper exists to prevent.
# shellcheck disable=SC2016
_layer_helper='!f() { echo username='"$LAYER_USER"'; echo "password=$(cat '"$LAYER_TOKEN"')"; }; f'

# WIRE THE HELPER INTO THE CLONE, which is a separate act from using it to clone (quince#121).
#
# `git -c key=value <cmd>` applies to THAT INVOCATION ONLY. It is not written to `.git/config`, so
# every clone below authenticated once and then carried NO credential helper at all. The result is a
# private layer that is present, readable, and unable to advance: `git pull` says `fatal: could not
# read Username for 'https://github.com' `, and nothing on the box can ever update it.
#
# Measured rather than reasoned, because the obvious reading of `-c` is that it configures the clone:
#
#   git -c credential.helper=H clone <url> dst
#   git -C dst config --get credential.helper   → exit 1, no value
#
# This is why the architect box sat on a private layer four commits behind — `git rev-list --count
# e6eba87..dd2d1e1` in the layer repo, checkable by anyone who holds it — and swept with a matcher
# proven only to COMPILE, while being the box that performs merges, and therefore the last gate any
# change passes before public history. It was NOT arch-specific: the runner's clone was equally
# unwired and only worked because a session hand-configured the helper in order to push, without
# registering that it was patching this bug rather than doing setup.
#
# Written with `git config` at the repository level, so it lands in `.git/config` where a later
# `git pull` by a human or an agent will find it. The token itself still never appears: the helper is
# a shell snippet that reads the file at use time, exactly as elsewhere.
layer_wire_helper() {
	git -C "$LAYER_DIR" config credential.helper "$_layer_helper"
}

if [ ! -f "$LAYER_TOKEN" ]; then
	say "NOT placing the private layer: no credential at $LAYER_TOKEN for role $ROLE."
	say "     preflight will refuse to start this box until the layer is present. Place the"
	say "     credential and re-run, or hand-place $LAYER_DIR/privacy-patterns.txt (0600)."
elif [ -d "$LAYER_DIR/.git" ]; then
	# Re-wired on every run, not only on first clone: this is what REPAIRS the boxes already in the
	# field, which were provisioned before the helper was persisted and cannot fetch until it is.
	layer_wire_helper
	git -C "$LAYER_DIR" -c credential.helper="$_layer_helper" fetch -q origin main &&
		git -C "$LAYER_DIR" reset -q --hard origin/main
	say "private layer updated at $LAYER_DIR ($(git -C "$LAYER_DIR" rev-parse --short HEAD))"
elif [ -e "$LAYER_DIR" ]; then
	# A hand-placed layer from before this landed. NOT deleted: it is the artifact the privacy gate
	# depends on, and a provisioning script that silently replaced the Operator's own file would be
	# the kind of quiet mutation this project has canon against.
	if [ -e "$LAYER_DIR.superseded" ]; then
		say "REFUSING to move $LAYER_DIR aside: $LAYER_DIR.superseded already exists. Resolve by hand."
	else
		mv "$LAYER_DIR" "$LAYER_DIR.superseded"
		git -c credential.helper="$_layer_helper" clone -q "$LAYER_URL" "$LAYER_DIR"
		layer_wire_helper
		chmod 700 "$LAYER_DIR"
		say "private layer cloned at $LAYER_DIR; the previous hand-placed copy is at $LAYER_DIR.superseded"
		say "     (kept, not deleted — compare and remove it yourself)"
	fi
else
	git -c credential.helper="$_layer_helper" clone -q "$LAYER_URL" "$LAYER_DIR"
	layer_wire_helper
	chmod 700 "$LAYER_DIR"
	say "private layer cloned at $LAYER_DIR"
fi

# The layer is only useful if it can ADVANCE, so say which it is rather than leaving both to look the
# same. quince#123 makes the same point about `preflight`'s "reach": presence is not freshness, and a
# clone that cannot fetch is the failure that hides behind a directory that exists.
#
# TWO CHECKS, IN THIS ORDER, AND THE ORDER IS THE POINT. `git ls-remote` fails identically for "no
# credential" and "the network is down", so it cannot support a claim about a DURABLE state — and
# "present but frozen" is exactly such a claim. An earlier version of this block made it from
# `ls-remote` alone, which would have announced a correctly-wired box as frozen on a flaky link and
# sent somebody to re-provision a machine that needed nothing.
#
# So the helper — LOCAL and deterministic — decides the durable verdict, and `ls-remote` is only
# consulted once the wiring is known good, where a failure genuinely is transient and is reported as
# unverified rather than as broken. Same reasoning as `preflight`'s check in the follow-up PR; the
# two should not disagree about what evidence supports what claim.
if [ -d "$LAYER_DIR/.git" ]; then
	if [ -z "$(git -C "$LAYER_DIR" config --get credential.helper 2>/dev/null)" ]; then
		say "WARNING: private layer at $LAYER_DIR has NO credential helper — it is present but frozen."
		say "     Every privacy sweep on this box will use whatever it holds now, and no future"
		say "     pattern, canary or case-sensitive list will ever reach it (quince#121)."
	elif git -C "$LAYER_DIR" ls-remote -q origin HEAD >/dev/null 2>&1; then
		say "private layer can FETCH (credential helper wired, remote answered)"
	else
		say "note: private layer is wired (credential helper present) but the remote did not answer"
		say "     just now, so fetching is UNVERIFIED rather than known-broken. Transient network"
		say "     failure and a bad credential look the same here; the wiring above is the durable fact."
	fi
fi

# --- 5. the service --------------------------------------------------------------------------
# PROVENANCE, and it is not decoration: the service file comes from the launchpad clone, which
# tracks main. So a fix merged into a branch reaches this box only after it LANDS and the launchpad
# is pulled — a runner can therefore be running a service that predates its own fix, which is
# exactly how a false "started" survived the commit that fixed it. Say which ref this came from so
# that situation is visible rather than puzzling.
_ref_sha=$(git -C "$RUNNER_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
_ref_name=$(git -C "$RUNNER_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
install -m 0755 "$RUNNER_DIR/deploy/runner/quince-runner.initd" "/etc/init.d/$SERVICE_NAME"
mkdir -p /etc/conf.d
printf 'runner_role="%s"\nrunner_name="%s"\n' "$ROLE" "$SERVICE_NAME" > "/etc/conf.d/$SERVICE_NAME"
rc-update add "$SERVICE_NAME" default >/dev/null 2>&1 || true
say "service $SERVICE_NAME (role $ROLE) installed from ${_ref_sha} (${_ref_name}) and added to the default runlevel"
if ! grep -q '^status()' "/etc/init.d/$SERVICE_NAME" 2>/dev/null; then
	say "note: this service file predates the status() override — 'rc-service status' will report"
	say "      the SUPERVISOR (started) rather than whether a session is alive. Pull the launchpad"
	say "      once that change is on main and re-run this script."
fi

# --- 6. report, including what is NOT done ----------------------------------------------------
printf '\n'
if QUINCE_RUNNER_ROLE="$ROLE" "$RUNNER_DIR/deploy/runner/preflight"; then
	printf '\n'
	say "environment is fit — but the session still needs YOUR login:"
else
	printf '\n'
	say "preflight is not satisfied yet (above); fix that, then:"
fi
cat <<'EOF'

    claude auth login          # full-scope claude.ai login. A setup-token CANNOT do Remote
                               # Control, so this interactive step is the only path.
    cd /root/quince && claude  # once, to accept workspace trust
    /config                    # enable "Push when Claude decides" and "Push when actions required"

  then:  rc-service quince-runner start

EOF
