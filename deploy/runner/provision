#!/bin/sh
# provision — make a container into the runner. Run it ON the runner, as root.
#
#   ssh quince-runner 'sh -s' < deploy/runner/provision
#
# Everything here is idempotent and announces what it did rather than what it intended. What it
# CANNOT do is the login: a setup-token cannot establish Remote Control, so the Operator's
# interactive `claude auth login` is the only path — the script ends by saying exactly that.
set -eu

# --role arch provisions the architect box: same path, inverted identity assertion. The role is
# written into the service's conf so it survives restarts and reboots rather than living in the
# shell that happened to run this script.
#
# `--check-credentials` runs the identity guard below and stops, without touching the box. It exists
# because everything after that guard mutates — so its NON-refusing cases were unobservable to any
# suite that could not afford to provision the machine it ran on (quince#234).
ROLE=implementer
CHECK_ONLY=no
while [ $# -gt 0 ]; do
	case "$1" in
	--role) ROLE="${2:?--role needs a value}"; shift 2 ;;
	--check-credentials) CHECK_ONLY=yes; shift ;;
	*) printf 'provision: unknown argument %s\n' "$1" >&2; exit 2 ;;
	esac
done
case "$ROLE" in implementer|arch) ;; *) printf 'provision: unknown role %s\n' "$ROLE" >&2; exit 2 ;; esac
SERVICE_NAME="quince-runner"
[ "$ROLE" = arch ] && SERVICE_NAME="quince-arch"

# --- THE ROLE MUST MATCH THE BOX, AND THIS REFUSES BEFORE ANYTHING IS TOUCHED (quince#121) -----
# Placed HERE, above the package install and the launchpad update, because a refusal that arrives
# after the script has begun mutating the box is a refusal that has already changed it. Everything
# this check needs is known at argument-parse time; the first draft sat beside the layer section a
# hundred lines down and reported `exit=2` having already installed packages and updated the
# launchpad. Correct verdict, wrong moment.
#
# WHAT WENT WRONG, so the guard is not mistaken for ceremony. `--role` is an ARGUMENT and defaults
# to `implementer`. `QUINCE_RUNNER_ROLE` is NOT read as input — it appears once in this file,
# exported TO `preflight` — so an invocation setting it in the environment silently gets the
# default. On the architect box that default found no bot token (correctly: that box must never
# hold one), printed "NOT placing the private layer" as a NOTE, and then carried on to install an
# implementer-role service on the architect's machine. Nothing was repaired, and the box was left
# holding exactly the artifact the two-box identity model exists to prevent.
#
# The missing flag was the trigger. The DEFECT is that this script warned and continued: a run that
# cannot do the thing it exists to do must not proceed to configure the box for it.
#
# A SEAT IS A SET OF CREDENTIALS, NOT ONE TOKEN, AND ANY OF THE OTHER SEAT'S IS A REFUSAL
# (quince#234). This guard compared exactly two files — the bot token against the architect token —
# and refused in exactly one of the three states that should worry it. Both halves were wrong by the
# time they were measured, and the measurement is what makes this worth the space:
#
#   box           holds                                   old guard's view              verdict
#   implementer   quince-coder.pem                        both tokens absent -> no branch  BLIND
#   architect     quince-arch.token + quince-review.pem   own present, other absent        BLIND
#
# So the guard had NO LIVE COVERAGE ON EITHER REAL BOX. Not a rot risk: the present condition of the
# whole fleet, measured one seat each on 2026-07-29. Two things caused it, and they are separable:
#
#   1. IT KNEW ONLY TOKENS. `decisions/0014` moved the implementer identity to a GitHub App key and
#      the reviewer identity is another; this compared a pair that predates both. Third instance in
#      one day of a guard naming a credential set that has since moved (quince#203, quince#204).
#   2. BOTH-PRESENT PASSED THROUGH. It fired only when this role's credential was absent AND the
#      other's present — reading "own present" as "fine" even with the other seat's beside it, which
#      is the exact author-and-approve box the two-box design exists to prevent.
#
# So the condition is now simply: ANY credential belonging to the other seat is a refusal. The two
# cases keep DIFFERENT messages because they want different repairs — a wrong `--role` is fixed by
# re-running with the right one, while a box holding both seats is fixed by removing a credential,
# and telling someone to re-run when the remedy is `rm` sends them in a circle.
#
# WHY REFUSING ON BOTH-PRESENT IS SAFE, since it closes a state that used to pass. Architect ruling
# on quince#234: there is no legitimate STEADY state in which one box holds two seats' credentials,
# `preflight` already refuses to start a service on one, and a provision-time gate more permissive
# than the startup gate is quince#204's inversion — the earliest gate being the narrowest. If the
# Operator re-roles a box by hand and transiently holds both, the ruled order is remove-then-provision:
# a refusal costs one `rm` and leaves a record, where a silent pass leaves neither. Ruled explicitly
# as cheaply reversible — if real re-roling practice needs that window, this is a one-condition
# change and the ruling should be overturned rather than worked around.
#
# `_role_token` IS GONE (quince#236). It existed to answer one question — which credential this role
# CLONES THE PRIVATE LAYER with — and that question no longer has a file for an answer: the layer's
# credential is now selected by asking which wrapper can ACT, further down. quince#249's review
# flagged the name as misleading and this change removes the mapping that made it so, rather than
# renaming it. What remains here is only which credentials a seat MAY HOLD, which is a different
# question and the one this block was always really about.
_bot_token="${QUINCE_BOT_TOKEN_FILE:-/root/.config/quince/quince-bot.token}"
_arch_token="${QUINCE_ARCH_TOKEN_FILE:-/root/.config/quince/quince-arch.token}"
_coder_key="${QUINCE_CODER_KEY_FILE:-/root/.config/quince/quince-coder.pem}"
_review_key="${QUINCE_REVIEW_KEY_FILE:-/root/.config/quince/quince-review.pem}"
_analyst_key="${QUINCE_ANALYST_KEY_FILE:-/root/.config/quince/quince-analyst.pem}"
if [ "$ROLE" = arch ]; then
	_other_role=implementer
	_own_creds="$_arch_token $_review_key" _other_creds="$_bot_token $_coder_key"
else
	_other_role=arch
	_own_creds="$_bot_token $_coder_key" _other_creds="$_arch_token $_review_key"
fi
# Names only, never contents — a guard that echoed a credential to report a credential problem would
# be its own incident. `preflight`'s header makes the same point about the same class of check.
_present() {
	_p_found=""
	for _p_f in $1; do
		[ -f "$_p_f" ] && _p_found="${_p_found:+$_p_found and }$_p_f"
	done
	printf '%s' "$_p_found"
}
_have_own=$(_present "$_own_creds")
_have_other=$(_present "$_other_creds")

# THE THIRD SEAT, WHICH THIS SCRIPT CANNOT PROVISION AND MUST NOT PASS OVER (quince#375).
#
# This guard is quince#234's — *a seat is a set of credentials, not one token* — and quince#375 added
# a credential to a set nothing here knew about. `--role` accepts `implementer` and `arch` only, so
# the analyst key belongs to NEITHER `_own_creds` nor `_other_creds`, and the two-way comparison below
# is blind to it: a box holding `quince-coder.pem` AND `quince-analyst.pem` — two seats, one box —
# passes the both-seats refusal cleanly. That is the exact state that refusal exists to catch, reached
# by a credential arriving rather than by the check being wrong, which is the third time this file has
# recorded that shape (quince#203, quince#204, quince#234).
#
# IT REFUSES RATHER THAN CLASSIFYING, and the distinction is the honest part. The two messages below
# are actionable because each names a remedy: re-run with the right `--role`, or remove a credential.
# Neither remedy exists here. There is no `--role supervisor` — `preflight` accepts that role and this
# script does not, so the supervisor box has never been provisioned by it — so telling somebody to
# re-run would send them to an argument that is refused twenty lines above, and telling them to remove
# the analyst key would be telling them to un-do quince#375's ceremony.
#
# Placed BEFORE the two-way block so the analyst key can never be reported under another seat's name:
# a "BOTH SEATS … (arch)" message naming `quince-analyst.pem` would send the reader to the wrong box.
#
# WHEN `--role supervisor` EXISTS, this becomes conditional rather than unconditional — the analyst key
# is then that role's OWN credential and the refusal must fire only for the other two. Written as one
# guard with one condition so that change is a line rather than an untangling.
_have_analyst=$(_present "$_analyst_key")
if [ -n "$_have_analyst" ]; then
	printf 'provision: this box holds the ANALYST KEY, which is the SUPERVISOR seat: %s\n' "$_have_analyst" >&2
	printf 'provision: refusing BEFORE touching anything — and NOT because holding it is wrong. It is\n' >&2
	printf '    that seat OWN identity, ruled on quince#375. What is wrong is that this script cannot\n' >&2
	printf '    provision the seat: it accepts --role implementer and --role arch, and there is no\n' >&2
	printf '    --role supervisor at all.\n' >&2
	printf '    So neither remedy this guard usually offers applies here. Do NOT re-run with another\n' >&2
	printf '    --role: that would configure a %s box on the supervisor machine. Do NOT remove the\n' "$ROLE" >&2
	printf '    key: that would undo the ceremony quince#375 performed.\n' >&2
	printf '    The supervisor box is provisioned BY HAND today. Giving it a role here is quince#375.\n' >&2
	exit 2
fi

if [ -n "$_have_other" ] && [ -n "$_have_own" ]; then
	printf 'provision: this box holds BOTH SEATS: %s (role %s) and %s (%s).\n' \
		"$_have_own" "$ROLE" "$_have_other" "$_other_role" >&2
	printf 'provision: refusing BEFORE touching anything. One box that can author and approve its own\n' >&2
	printf '    work is the whole of what the two-box design exists to prevent, and no --role can\n' >&2
	printf '    make it correct — so re-running is not the fix. REMOVE the credential that does not\n' >&2
	printf '    belong to this seat: %s\n' "$_have_other" >&2
	printf '    If you are re-roling this box by hand, remove the old seat first, then provision\n' >&2
	printf '    (quince#234). preflight would refuse to start this box in any case.\n' >&2
	exit 2
elif [ -n "$_have_other" ]; then
	printf 'provision: role %s needs a credential of its own, and this box has none — but it HOLDS the\n' "$ROLE" >&2
	printf '    %s credential: %s\n' "$_other_role" "$_have_other" >&2
	printf 'provision: refusing rather than provisioning this box as %s, and refusing BEFORE touching\n' "$ROLE" >&2
	printf '    anything. That is near-certainly a missing or wrong --role: it is an ARGUMENT\n' >&2
	printf '    (--role %s), and QUINCE_RUNNER_ROLE in the environment is NOT read as input.\n' "$_other_role" >&2
	printf '    Re-run as: %s --role %s\n' "$0" "$_other_role" >&2
	printf '    Continuing would install a %s-role service on a %s box (quince#121).\n' \
		"$ROLE" "$_other_role" >&2
	exit 2
fi

# A DRY RUN EXISTS SO THIS GUARD CAN BE DRIVEN AT ALL. Everything below mutates the box — `apk add`
# on the second step — so a suite that wanted to assert the NON-refusing cases had no way to observe
# one without provisioning the machine it was running on. The refusals could be tested and the
# passes could not, which is half a check (quince#103). `--check-credentials` runs exactly the block
# above and stops; it is the last thing before the first mutation, so what it proves is what the
# real invocation would do.
#
# `say` and `die` are defined HERE, above their first use. The layer-identity guard below refuses
# before this box is touched, and a `die` defined further down — where it used to be — is a
# `command not found` on exactly the path that must refuse cleanly: it exits 127 with no message,
# which is the shape quince#224 spent a PR on. Refusals go to stderr and exit 2, matching the role
# guard above, which predates these helpers and writes the same shape inline because it runs first.
say() { printf '==> %s\n' "$*"; }
die() {
	printf 'provision: %s\n' "$*" >&2
	exit 2
}

REPO_URL="${REPO_URL:-https://github.com/novkostya/quince.git}"
RUNNER_DIR="${RUNNER_DIR:-/root/quince}"

# --- WHICH IDENTITY THE PRIVATE LAYER WILL USE — decided HERE, before anything is touched --------
#
# The decision is pure: it selects a wrapper and builds a helper string, and mutates nothing. It sits
# above the `--check-credentials` exit for the two reasons this file already argues for the role
# guard at the top — a refusal that arrives after the script has begun mutating the box is a refusal
# that has already changed it, and a guard whose non-refusing cases run only on a real provision is a
# guard no suite can observe (quince#234, and now quince#236).
#
# The PLACEMENT of the layer stays far below, where it belongs. Only the credential question is
# answered early.
#
# SELECT ON CAPABILITY, NEVER ON PRESENCE — the rule quince#255 established for `/onboard`, for the
# same measured reason: all four wrappers are COMMITTED, so every box carries every one of them and
# an `-x` test cannot tell two seats apart. Asking which one can ACT does, because each fails closed
# when it is not this box's seat.
# `/usr/local/bin` first — that is where the box installs them, and the helper string is evaluated by
# GIT long after this script exits, so it must name a path that PERSISTS rather than one that happens
# to exist in whatever checkout provisioned the box. Overridable so the refusal below is reachable by
# a suite: on a real box `/usr/local/bin/gh-coder` exists AND works, so without this seam the
# no-usable-credential path could never be exercised anywhere it matters.
LAYER_WRAPPER_DIRS="${QUINCE_WRAPPER_DIRS:-/usr/local/bin $RUNNER_DIR/bin}"
# `gh-review` IS IN THIS LIST AND `gh-arch` IS GONE FROM IT (quince#674, then quince#676). The arch
# box has no `gh-coder` by design (`decisions/0007`: the box that approves must not hold the identity
# that authors), so this loop used to fall through to `gh-arch` — the PAT the Operator DELETED on
# 2026-08-06 when ruling that wrapper legacy. The private layer's clone on that box could not fetch,
# which freezes the privacy pattern list while the gate goes on reporting `clean` (quince#121,
# quince#220).
#
# NO NEW MECHANISM WAS NEEDED, and that is worth stating because the issue expected one: `gh-review`
# already exposes a token exactly as `gh-coder` does. Neither wrapper implements an `auth` verb —
# both export `GH_TOKEN` and `exec gh "$@"`, and `gh auth token` prints `$GH_TOKEN` verbatim. So
# `gh-review auth token` works for the same reason `gh-coder auth token` does, and this loop was the
# only thing that could not see it.
#
# THE LIST IS NOW ZERO PATs, which is what quince#676 was for: one shape on both boxes. quince#674
# ordered the App BEFORE the PAT so a box still carrying `quince-arch.token` would migrate on its
# next provision instead of re-pinning to a credential that was going away. It has gone, so what was
# an ordering is now simply the list — and a box that still holds that token gets it ignored rather
# than preferred, which is the same outcome the ordering bought.
layer_wrapper() {
	for _lw_n in gh-coder gh-review; do
		for _lw_d in $LAYER_WRAPPER_DIRS; do
			_lw_p="$_lw_d/$_lw_n"
			[ -x "$_lw_p" ] || continue
			"$_lw_p" api /rate_limit >/dev/null 2>&1 && {
				printf '%s\n' "$_lw_p"
				return 0
			}
		done
	done
	return 1
}
LAYER_WRAPPER=$(layer_wrapper || true)
# `x-access-token` for an App installation token, the login for a PAT. Keyed on WHICH WRAPPER can
# act rather than on the role, so the username cannot disagree with the credential actually used.
# BOTH APPS TAKE `x-access-token`, and the arm is shared rather than duplicated because the rule is
# about the CREDENTIAL KIND, not the seat: an installation token authenticates as that user whichever
# App minted it.
#
# THE DEFAULT ARM NOW COVERS NOTHING THIS SCRIPT CAN SELECT, and it is kept anyway (quince#676).
# `gh-arch` was the last PAT and it is deleted, so `layer_wrapper` can only ever return an App —
# which means `*) LAYER_USER=novkostya` is unreachable today. It stays because the arm answers
# *"what username does a NON-App credential want"*, and deleting it would make the next PAT-shaped
# wrapper silently inherit `x-access-token` and authenticate as the wrong user. An unreachable
# default that is correct costs a line; a missing one costs a debugging session.
case ${LAYER_WRAPPER##*/} in
gh-coder | gh-review) LAYER_USER=x-access-token ;;
*) LAYER_USER=novkostya ;;
esac

# NO USABLE CREDENTIAL IS A REFUSAL, NOT A NOTE (quince#236, ruling item 2). The old
# `say`-and-carry-on was right when it meant "this box has no token yet". It came to also cover
# "this box's identity MOVED and I cannot see it", and those want opposite outcomes — which is
# exactly how this defect survived a day while the layer quietly depended on an unrecorded
# hand-repair. Same posture as the rest of the subsystem: `preflight` refuses rather than degrades,
# and the role guard above refuses rather than passing (quince#249).
#
# BOOTSTRAPPING MUST STILL WORK — the ruling's constraint, and why this is two states rather than
# one. They are cleanly distinguishable:
#   no own credential FILES at all  → a genuine first provision. Not a refusal; the layer is skipped
#                                     further down with a message naming what to place.
#   some credential present, but no wrapper can act → the identity moved, the credential is broken,
#                                     or the forge is unreachable. REFUSE: continuing leaves a box
#                                     whose layer silently never advances.
if [ -z "$LAYER_WRAPPER" ] && [ -n "$_have_own" ]; then
	die "a $ROLE credential is present but NO wrapper could authenticate with it, so the private
    layer could not be placed or kept current. Refusing before touching this box.
      credential(s) present: $_have_own
      wrappers tried:        gh-coder, gh-review — in /usr/local/bin, then $RUNNER_DIR/bin
    Causes, in the order worth checking: the credential is invalid or unreadable; the identity moved
    and this box still holds the old one; the forge is unreachable from here.
    This is a REFUSAL rather than a note because 'no credential yet' and 'the identity moved' want
    opposite outcomes, and one message covering both is how quince#236 survived a day — with the
    layer silently depending on an undocumented hand-repair. A stale layer makes the privacy gate
    report \`clean\` against a matcher missing patterns (quince#220)."
fi

LAYER_DIR="${QUINCE_PRIVATE_LAYER:-/root/quince-local}"

# The token reaches git through a credential helper — never argv, never the remote URL, never
# .git/config. The same discipline as every other credential here; the ruling permits the helper to
# invoke a WRAPPER rather than read a file precisely because the file is what rotted.
#
# IT FAILS CLOSED, mirrored from `bin/git-coder` rather than invented (quince#198): a bare
# `password=$(wrapper auth token)` with a failing substitution still emits a SYNTACTICALLY VALID
# credential with an EMPTY password, so git reports `authentication failed` while the real reason — a
# boundary refusal — is stranded on stderr. The token is captured FIRST and `username` is not printed
# until it is known good, so a refusal emits no credential at all rather than a blank one.
#
# SC2016 is correct that `$t` and `$(…)` do not expand here, and that is the point: they must be
# evaluated by GIT when it runs the helper, not by this shell when it builds the string. Expanding
# now would put the token into a variable, and from there into `git config` and `.git/config` — the
# one thing the helper exists to prevent.
# shellcheck disable=SC2016
_layer_helper='!f() { t=$('"$LAYER_WRAPPER"' auth token) || exit 1; [ -n "$t" ] || exit 1; echo username='"$LAYER_USER"'; echo "password=$t"; }; f'

# SHAPE, NEVER VALUE. The existing helper is never printed: a hand-written one could carry an inline
# token, and echoing a credential to report a credential problem would be its own incident — the same
# rule `_present` above follows for filenames. Probed by asking WHAT IT MENTIONS.
layer_helper_shape() { # <helper-string>
	_lhs=$1
	case $_lhs in *'!f('*) _lhs_out="inline shell function" ;; *) _lhs_out="not an inline function" ;; esac
	case $_lhs in *gh-coder*) _lhs_out="$_lhs_out; mentions gh-coder" ;; esac
	case $_lhs in *gh-arch*) _lhs_out="$_lhs_out; mentions gh-arch (RETIRED wrapper)" ;; esac
	case $_lhs in *quince-bot*) _lhs_out="$_lhs_out; mentions quince-bot (RETIRED identity)" ;; esac
	case $_lhs in *quince-arch.token*) _lhs_out="$_lhs_out; mentions quince-arch.token" ;; esac
	case $_lhs in *x-access-token*) _lhs_out="$_lhs_out; uses x-access-token" ;; esac
	printf '%s' "$_lhs_out"
}

# REFUSE TO OVERWRITE A HELPER THIS RUN DID NOT WRITE (quince#236, ruling item 3) — and refuse HERE,
# before the box is touched, for the reason the role guard at the top gives.
#
# It used to overwrite unconditionally, which is a no-op on the arch box BY COINCIDENCE: the string it
# would write there happens to equal the one already present. The consequence it guards is concrete —
# had a bot token been placed on an implementer box to satisfy the old guard, a routine re-provision
# would have replaced a working `gh-coder` helper with one authenticating as a SUSPENDED account, and
# the layer would have stopped fetching, while `preflight` still reported the layer present and
# resolvable, because a helper naming a dead account resolves perfectly well.
#
# THE COST IS ACKNOWLEDGED: this file is documented as idempotent and self-healing (`:193`,
# `README.md:41`), so a refusal trades convergence for safety. The ruling accepts that trade and
# requires the refusal to be ACTIONABLE — hence the shape of what is present, of what would be
# written, and the one command that clears it. A refusal a session cannot act on turns the documented
# repair path into the dead end this issue opened with.
if [ -n "$LAYER_WRAPPER" ] && [ -d "$LAYER_DIR/.git" ]; then
	_lwh_have=$(git -C "$LAYER_DIR" config --get credential.helper 2>/dev/null || true)
	if [ -n "$_lwh_have" ] && [ "$_lwh_have" != "$_layer_helper" ]; then
		die "REFUSING to overwrite the private layer's credential helper at $LAYER_DIR.
    It carries a helper this run did not write, and replacing it could leave the layer unable to
    fetch — silently, because a helper naming a dead identity still RESOLVES.
      present:     $(layer_helper_shape "$_lwh_have")
      would write: $(layer_helper_shape "$_layer_helper")
    If the present one is wrong, clear it and re-run:
      git -C $LAYER_DIR config --unset credential.helper
    If it is right, nothing here needs doing and you can leave it. Refusing rather than overwriting
    is quince#236 ruling item 3; this file is otherwise idempotent and that trade is deliberate."
	fi
fi

if [ "$CHECK_ONLY" = yes ]; then
	printf 'provision: credential check only — role %s, own %s, other %s\n' \
		"$ROLE" "${_have_own:-none}" "${_have_other:-none}"
	# The layer identity is reported here too, because it is a credential question and this flag is
	# how a suite observes credential questions without provisioning the box it runs on.
	printf 'provision: private-layer identity — wrapper %s, username %s\n' \
		"${LAYER_WRAPPER:-none}" "${LAYER_WRAPPER:+$LAYER_USER}"
	exit 0
fi
# Verified at pin time from the Claude Code setup docs (2026-07-26). The apk repository is signed;
# this is the published checksum of the signing key, and provisioning refuses a key that does not
# match rather than trusting whatever it downloaded.
CLAUDE_APK_KEY_URL="https://downloads.claude.ai/keys/claude-code.rsa.pub"
CLAUDE_APK_KEY_SHA="395759c1f7449ef4cdef305a42e820f3c766d6090d142634ebdb049f113168b6"
CLAUDE_APK_REPO="https://downloads.claude.ai/claude-code/apk/stable"


# --- 1. base packages ------------------------------------------------------------------------
# ripgrep is a runtime dependency on musl, and the built-in one is disabled below per the docs.
#
# imagemagick AND ffmpeg ARE HERE SO A SESSION CAN OPEN WHAT THE OPERATOR SENDS — Operator
# instruction, 2026-08-19, quince#1045: *"install imagemagick and ffmpeg in provision script the way
# how openssh is installed."*
#
# The Operator reports UI bugs with screenshots and screen recordings, and the screenshots ARE the
# evidence — quince#1028 grew a second commit off a landscape capture, and quince#931's
# scroll-restoration case was identified from a three-shot sequence. A box with no image tooling
# answers from the prose alone. Measured on this box before the fix: `convert`, `magick`, `ffmpeg`,
# `gm`, `vips` and `python3` were all absent, and every iPhone capture (1206x2622) exceeds the
# reader's 2000px limit, so none of them could be opened at all.
#
# BOTH, BECAUSE THEY ANSWER DIFFERENT HALVES. imagemagick resizes a still under the limit; ffmpeg is
# the only one of the two that reads an `.mp4` screen recording, which quince#1045 recorded as NOT
# solved and could not be read at all. It also extracts frames, which is what turns a recording into
# something a reader can look at.
#
# NOT THE ALTERNATIVE quince#1045 PROPOSED. That issue offered a ~100-line hand-written PNG halver
# using node's own zlib, on the argument that no new runtime is added. This instruction supersedes
# it: two packages beat a bespoke decoder that refuses 16-bit, palette and interlaced PNGs, handles
# one halving rather than looping to a bound, and would have been a new file category for
# `sh-lint-coverage` and the suite-totality gate.
#
# THE SYNOLOGY CONSTRAINT DOES NOT APPLY, and it is worth saying because it is the reflex here:
# these are SESSION tooling on a provisioned box, not product dependencies. They ship in no image
# and `deploy/Dockerfile` is untouched.
#
# WHAT IT COSTS ON DISK: ~101 MB INSTALLED, across 131 packages. Measured in a clean `alpine:3.24`
# container, `du -sm /` before and after — 7 MB to 108 MB. imagemagick and ffmpeg account for almost
# none of it themselves (3700 KiB and 624 KiB by `apk info -s`); the rest is transitive codec and
# delegate libraries.
#
# ~55 MB IS THE DOWNLOAD, NOT THE COST, and this comment said the latter until quince#1245's review.
# `apk fetch -R` retrieves the COMPRESSED .apk files, so summing them answers a different question
# from the one this paragraph asks — and it understated the disk figure by about a factor of two, in
# the sentence that invokes a disk incident. A stated cost is more useful than no stated cost and
# worse than a wrong one.
#
# Stated at all because this box ran to 99% of a 32 GB volume on 2026-08-18, and because the next
# session weighing whether to add session tooling reads this number. The clone reaper (quince#823)
# is what has to keep that volume clear; this is not what filled it, and it is not free either.
#
# ImageMagick 7 ships `magick` AND the v6-compatible `convert`, verified by listing the package
# rather than assuming which name survived the major version.
say "installing base packages"
apk add --no-cache git make openssh-client curl bash ripgrep libgcc libstdc++ jq \
	imagemagick ffmpeg >/dev/null
say "base packages present"

# --- 2. Claude Code, from the signed apk repository -------------------------------------------
# The `stable` channel deliberately: apk installs do not auto-update, so the runner's version moves
# when someone runs an upgrade — which suits a project that pins toolchains and dislikes silent
# drift. `latest` is one line away if that trade is ever wrong.
if command -v claude >/dev/null 2>&1; then
	say "claude already installed ($(claude --version 2>/dev/null || echo '?'))"
else
	say "adding the Claude Code apk repository (signed)"
	wget -qO /etc/apk/keys/claude-code.rsa.pub "$CLAUDE_APK_KEY_URL"
	got=$(sha256sum /etc/apk/keys/claude-code.rsa.pub | cut -d' ' -f1)
	if [ "$got" != "$CLAUDE_APK_KEY_SHA" ]; then
		rm -f /etc/apk/keys/claude-code.rsa.pub
		printf 'provision: signing key checksum mismatch\n  expected %s\n  got      %s\nRefusing to add the repository.\n' \
			"$CLAUDE_APK_KEY_SHA" "$got" >&2
		exit 1
	fi
	say "signing key verified against the published checksum"
	grep -q "$CLAUDE_APK_REPO" /etc/apk/repositories || printf '%s\n' "$CLAUDE_APK_REPO" >>/etc/apk/repositories
	apk update >/dev/null
	apk add --no-cache claude-code >/dev/null
	say "claude installed ($(claude --version 2>/dev/null || echo '?'))"
fi

# --- 3. musl setting -------------------------------------------------------------------------
# On musl the bundled ripgrep is not used; the docs require pointing Claude Code at the system one.
mkdir -p /root/.claude
if [ -f /root/.claude/settings.json ]; then
	tmp=$(mktemp)
	jq '.env = ((.env // {}) + {"USE_BUILTIN_RIPGREP":"0"})' /root/.claude/settings.json >"$tmp" &&
		mv "$tmp" /root/.claude/settings.json
else
	printf '{\n  "env": { "USE_BUILTIN_RIPGREP": "0" }\n}\n' >/root/.claude/settings.json
fi
say "USE_BUILTIN_RIPGREP=0 set (musl: the system ripgrep is used)"

# --- 4. the launchpad ------------------------------------------------------------------------
# A pristine checkout used to START sessions. Never a workspace: every unit of work is a fresh
# clone elsewhere, so anything modified here is a finding rather than a habit.
if [ -d "$RUNNER_DIR/.git" ]; then
	git -C "$RUNNER_DIR" fetch -q origin main && git -C "$RUNNER_DIR" reset -q --hard origin/main
	say "launchpad updated at $RUNNER_DIR (pristine checkout — not a workspace)"
else
	git clone -q "$REPO_URL" "$RUNNER_DIR"
	say "launchpad cloned at $RUNNER_DIR (pristine checkout — not a workspace)"
fi

# --- 4b. the private layer ----------------------------------------------------------------------
# quince#44, Operator ruling 2026-07-27: the private layer is a PROPERTY OF THE BOX, cloned here
# rather than hand-placed and remembered. Before this, a rebuilt box silently returned to a state
# where the privacy gate could not run, while sessions had learned to trust a file the rebuild
# removed, and nothing announced the regression. `preflight` now refuses to start such a box; this
# is what stops that refusal from being the normal case.
#
# A FULL CLONE, ruled deliberately over a narrow single-file fetch. The two rulings are coherent:
# the implementer holds `write` because the layer is a living document it must be able to maintain,
# and an implementer that can write `environment.md` but cannot see it would reintroduce the human
# hop the write grant exists to remove.
#
# ACCEPTED EXPOSURE, stated where somebody reading the provisioning will meet it: this places the
# COMPLETE private record on the box — ~610 KB across 8 files, including the lab topology and the
# external review transcripts — not the 107-byte pattern list. `pr.6`'s credential-concentration
# boundary owes a line saying so.
#
# THE CREDENTIAL IS IDENTITY-DEPENDENT, and the ruling did not say so because it could not: the arch
# box must NOT hold the bot token — `preflight` refuses to start if it does, and that inversion is
# the whole separation mechanism (devlog#7). So each box clones with its OWN identity; cloning as
# the bot on the arch box would mean placing the one credential that box must never hold.
#
# This said ROLE-dependent until quince#236, and the difference is the defect: a role mapped to a
# FILE, and the implementer's file stopped existing when the identity became an App key. Which
# identity is now decided far above, by asking which wrapper can ACT — see `layer_wrapper`.
LAYER_URL="${LAYER_URL:-https://github.com/novkostya/quince-local.git}"

# WIRE THE HELPER INTO THE CLONE, which is a separate act from using it to clone (quince#121).
#
# `git -c key=value <cmd>` applies to THAT INVOCATION ONLY. It is not written to `.git/config`, so
# every clone below authenticated once and then carried NO credential helper at all. The result is a
# private layer that is present, readable, and unable to advance: `git pull` says `fatal: could not
# read Username for 'https://github.com' `, and nothing on the box can ever update it.
#
# Measured rather than reasoned, because the obvious reading of `-c` is that it configures the clone:
#
#   git -c credential.helper=H clone <url> dst
#   git -C dst config --get credential.helper   → exit 1, no value
#
# This is why the architect box sat on a private layer four commits behind — `git rev-list --count
# e6eba87..dd2d1e1` in the layer repo, checkable by anyone who holds it — and swept with a matcher
# proven only to COMPILE, while being the box that performs merges, and therefore the last gate any
# change passes before public history. It was NOT arch-specific: the runner's clone was equally
# unwired and only worked because a session hand-configured the helper in order to push, without
# registering that it was patching this bug rather than doing setup.
#
# Written with `git config` at the repository level, so it lands in `.git/config` where a later
# `git pull` by a human or an agent will find it. The token itself still never appears: the helper is
# a shell snippet that reads the file at use time, exactly as elsewhere.
# The MISMATCH REFUSAL that used to live here now runs far above, before this box is touched — see
# `layer_helper_shape` and the guard beside it. This function is what remains: a plain writer, run on
# every provision so it REPAIRS boxes provisioned before the helper was persisted.
layer_wire_helper() {
	git -C "$LAYER_DIR" config credential.helper "$_layer_helper"
}

# The only way to reach here with no wrapper is a GENUINE FIRST PROVISION: the other state — a
# credential present that nothing can authenticate with — already refused, far above, before this box
# was touched (quince#236, ruling item 2). So this branch has one meaning again, which is what it had
# before the identity moved and what made the old `say`-and-continue correct.
if [ -z "$LAYER_WRAPPER" ]; then
	say "NOT placing the private layer: this box holds no $ROLE credential yet."
	say "     That is expected on a FIRST provision. preflight will refuse to start the box"
	say "     until the layer is present. Place the credential and re-run, or hand-place"
	say "     $LAYER_DIR/privacy-patterns.txt (0600)."
elif [ -d "$LAYER_DIR/.git" ]; then
	# Re-wired on every run, not only on first clone: this is what REPAIRS the boxes already in the
	# field, which were provisioned before the helper was persisted and cannot fetch until it is.
	layer_wire_helper
	git -C "$LAYER_DIR" -c credential.helper="$_layer_helper" fetch -q origin main &&
		git -C "$LAYER_DIR" reset -q --hard origin/main
	say "private layer updated at $LAYER_DIR ($(git -C "$LAYER_DIR" rev-parse --short HEAD))"
elif [ -e "$LAYER_DIR" ]; then
	# A hand-placed layer from before this landed. NOT deleted: it is the artifact the privacy gate
	# depends on, and a provisioning script that silently replaced the Operator's own file would be
	# the kind of quiet mutation this project has canon against.
	if [ -e "$LAYER_DIR.superseded" ]; then
		say "REFUSING to move $LAYER_DIR aside: $LAYER_DIR.superseded already exists. Resolve by hand."
	else
		mv "$LAYER_DIR" "$LAYER_DIR.superseded"
		git -c credential.helper="$_layer_helper" clone -q "$LAYER_URL" "$LAYER_DIR"
		layer_wire_helper
		say "private layer cloned at $LAYER_DIR; the previous hand-placed copy is at $LAYER_DIR.superseded"
		say "     (kept, not deleted — compare and remove it yourself)"
	fi
else
	git -c credential.helper="$_layer_helper" clone -q "$LAYER_URL" "$LAYER_DIR"
	layer_wire_helper
	say "private layer cloned at $LAYER_DIR"
fi

# Lock the layer down on EVERY placement path — both clones AND the field-repair fetch above, which
# leaves whatever perms the box was cloned with. `git clone` writes files at the inherited umask
# (0644 by default) and never corrects them, so provision set `chmod 700` on the directory and left
# the files inside it world-readable — the note `preflight` prints on every start, on a healthy box,
# since the layer was first cloned (quince#131). The directory being 0700 already stops traversal, so
# this is defence-in-depth, not a live exposure — but these ARE the sensitive strings, plus the lab
# topology and the review transcripts, so 0600 each, matched to preflight's own fix text ("file 0600,
# directory 0700"). Unconditional, so it also REPAIRS a box cloned before this landed. `.git` internals
# are left alone (the glob skips dotfiles, and `-f` skips the `.git` directory).
if [ -d "$LAYER_DIR" ]; then
	chmod 700 "$LAYER_DIR"
	for _lf in "$LAYER_DIR"/*; do
		[ -f "$_lf" ] || continue
		chmod 600 "$_lf"
	done
fi

# The layer is only useful if it can ADVANCE, so say which it is rather than leaving both to look the
# same. quince#123 makes the same point about `preflight`'s "reach": presence is not freshness, and a
# clone that cannot fetch is the failure that hides behind a directory that exists.
#
# TWO CHECKS, IN THIS ORDER, AND THE ORDER IS THE POINT. `git ls-remote` fails identically for "no
# credential" and "the network is down", so it cannot support a claim about a DURABLE state — and
# "present but frozen" is exactly such a claim. An earlier version of this block made it from
# `ls-remote` alone, which would have announced a correctly-wired box as frozen on a flaky link and
# sent somebody to re-provision a machine that needed nothing.
#
# So the helper — LOCAL and deterministic — decides the durable verdict, and `ls-remote` is only
# consulted once the wiring is known good, where a failure genuinely is transient and is reported as
# unverified rather than as broken. Same reasoning as `preflight`'s check in the follow-up PR; the
# two should not disagree about what evidence supports what claim.
if [ -d "$LAYER_DIR/.git" ]; then
	if [ -z "$(git -C "$LAYER_DIR" config --get credential.helper 2>/dev/null)" ]; then
		say "WARNING: private layer at $LAYER_DIR has NO credential helper — it is present but frozen."
		say "     Every privacy sweep on this box will use whatever it holds now, and no future"
		say "     pattern, canary or case-sensitive list will ever reach it (quince#121)."
	elif git -C "$LAYER_DIR" ls-remote -q origin HEAD >/dev/null 2>&1; then
		say "private layer can FETCH (credential helper wired, remote answered)"
	else
		say "note: private layer is wired (credential helper present) but the remote did not answer"
		say "     just now, so fetching is UNVERIFIED rather than known-broken. Transient network"
		say "     failure and a bad credential look the same here; the wiring above is the durable fact."
	fi
fi

# --- 4c. the journal pre-push hook, as a property of the BOX -----------------------------------
# quince#308. quince-devlog's `journal` branch is appended to directly — no pull request, no
# reviewer — so `bin/pre-push-journal` is the only thing between an Operator-private string and a
# public branch that every box replicates. Git does not distribute hooks: that guard was in force
# only in a clone where somebody ran `--install`, which is the property the hook was built to
# remove, moved one level up.
#
# WHY A TEMPLATE AND NOT AN INSTALL. A per-box install does nothing for a scratch clone made an hour
# later, and a scratch clone is where journal entries are actually written (`/report` clones
# quince-devlog per session). `init.templateDir` is the only mechanism that acts at CLONE time, so
# it is the only one whose reach matches where the pushes come from.
#
# MEASURED, git 2.54.0, because the obvious reading of the name is that it is an `init` setting:
#   git -c init.templateDir=T clone …                     -> hook present
#   git config --global init.templateDir T; git clone …   -> hook present
# Both. It is honoured by `clone` and it is read from persistent config, which is what makes a
# one-time provisioning step cover every future clone.
#
# NOT `core.hooksPath`, which would need no template and could never go stale. A global
# `core.hooksPath` REPLACES `.git/hooks` for every repository on the box, so any repo-local hook
# installed afterwards is silently inert — and silently inert is the failure mode this project files
# most often. The template costs a copy per clone; `hooksPath` costs the ability to notice.
#
# UNCONDITIONAL ACROSS ROLES, including supervisor. The hook is inert for every push that does not
# touch `refs/heads/journal`, and on a seat with no private layer the gate exits 2 (DID NOT RUN) so
# the hook REFUSES — the right answer for a seat that cannot sweep, not a reason to leave it out.
DEVLOG_URL="${DEVLOG_URL:-https://github.com/novkostya/quince-devlog.git}"
DEVLOG_DIR="${DEVLOG_DIR:-/root/quince-devlog}"
GIT_TEMPLATE_DIR="${GIT_TEMPLATE_DIR:-/root/.config/git/template}"

# The delegate source. Pristine, like the launchpad and for the same reason: it is where a tool is
# READ from, never a workspace. Public, so no credential is involved — a session that needs to
# WRITE the devlog clones its own copy under $HOME/scratch with its own helper.
if [ -d "$DEVLOG_DIR/.git" ]; then
	if git -C "$DEVLOG_DIR" fetch -q origin main && git -C "$DEVLOG_DIR" reset -q --hard origin/main; then
		say "devlog clone updated at $DEVLOG_DIR ($(git -C "$DEVLOG_DIR" rev-parse --short HEAD))"
	else
		say "WARNING: could not update the devlog clone at $DEVLOG_DIR — the journal hook it supplies"
		say "     is whatever that clone holds now. Present is not fresh (quince#121)."
	fi
elif git clone -q "$DEVLOG_URL" "$DEVLOG_DIR"; then
	say "devlog clone placed at $DEVLOG_DIR ($(git -C "$DEVLOG_DIR" rev-parse --short HEAD))"
else
	say "WARNING: could not clone $DEVLOG_URL to $DEVLOG_DIR. The template hook below is still"
	say "     installed, and it will REFUSE any push to the journal branch until this succeeds."
fi

# The template carries a SHIM, not a copy of the hook — see deploy/runner/pre-push-shim for why.
# Installed even when the clone above failed: a shim with no delegate refuses journal pushes and
# waves everything else through, which is the state a box should be in when it cannot sweep.
mkdir -p "$GIT_TEMPLATE_DIR/hooks"
install -m 0755 "$RUNNER_DIR/deploy/runner/pre-push-shim" "$GIT_TEMPLATE_DIR/hooks/pre-push"
git config --global init.templateDir "$GIT_TEMPLATE_DIR"
say "git template at $GIT_TEMPLATE_DIR — every clone made on this box from now on carries the journal pre-push hook"

# The hook refuses every journal push until this is set, by design: it will not guess where the
# product checkout lives, because guessing wrong means sweeping with a gate that is not this box's.
# The launchpad is the right target for the same reason it supplies the service file — provision
# resets it to origin/main on every run, so it is the checkout whose freshness this script owns.
# (quince#322 and quince#324 are about a launchpad that is behind because provision has not been
# RE-RUN; that is the same freshness story as everything else here, not a reason to point elsewhere.)
git config --global quince.privacy-check "$RUNNER_DIR/deploy/privacy/privacy-check"
say "privacy gate for the journal hook: $RUNNER_DIR/deploy/privacy/privacy-check"

# CLONES THAT ALREADY EXIST ON THIS BOX ARE NOT RETROFITTED, and saying so is the point: a template
# acts at clone time and cannot reach backwards. Scratch clones are short-lived by design
# (`bin/scratch-reap`), so the window closes on its own — but a long-lived one made before this ran
# has no hook, and nothing on the box will tell you which.
say "note: clones made BEFORE this run have no hook — a template acts at clone time only"

# --- 5. the service --------------------------------------------------------------------------
# PROVENANCE, and it is not decoration: the service file comes from the launchpad clone, which
# tracks main. So a fix merged into a branch reaches this box only after it LANDS and the launchpad
# is pulled — a runner can therefore be running a service that predates its own fix, which is
# exactly how a false "started" survived the commit that fixed it. Say which ref this came from so
# that situation is visible rather than puzzling.
_ref_sha=$(git -C "$RUNNER_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
_ref_name=$(git -C "$RUNNER_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
install -m 0755 "$RUNNER_DIR/deploy/runner/quince-runner.initd" "/etc/init.d/$SERVICE_NAME"
mkdir -p /etc/conf.d
printf 'runner_role="%s"\nrunner_name="%s"\n' "$ROLE" "$SERVICE_NAME" > "/etc/conf.d/$SERVICE_NAME"
rc-update add "$SERVICE_NAME" default >/dev/null 2>&1 || true
say "service $SERVICE_NAME (role $ROLE) installed from ${_ref_sha} (${_ref_name}) and added to the default runlevel"
if ! grep -q '^status()' "/etc/init.d/$SERVICE_NAME" 2>/dev/null; then
	say "note: this service file predates the status() override — 'rc-service status' will report"
	say "      the SUPERVISOR (started) rather than whether a session is alive. Pull the launchpad"
	say "      once that change is on main and re-run this script."
fi

# --- 6. report, including what is NOT done ----------------------------------------------------
printf '\n'
if QUINCE_RUNNER_ROLE="$ROLE" "$RUNNER_DIR/deploy/runner/preflight"; then
	printf '\n'
	say "environment is fit — but the session still needs YOUR login:"
else
	printf '\n'
	say "preflight is not satisfied yet (above); fix that, then:"
fi
cat <<'EOF'

    claude auth login          # full-scope claude.ai login. A setup-token CANNOT do Remote
                               # Control, so this interactive step is the only path.
    cd /root/quince && claude  # once, to accept workspace trust
    /config                    # enable "Push when Claude decides" and "Push when actions required"
EOF
# The service name is role-derived (quince-runner | quince-arch), so the instruction must name the
# one this box actually installed, not the literal. On an arch box the old text told the Operator to
# start `quince-runner`, a unit that does not exist here — and once the stray implementer service was
# removed from the arch box, that instruction failed outright (quince#131). $SERVICE_NAME is exactly
# what §5 installed to /etc/init.d and wrote into conf.d, so it cannot disagree.
printf '\n  then:  rc-service %s start\n\n' "$SERVICE_NAME"
