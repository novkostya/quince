#!/bin/sh
# provision — make a container into the runner. Run it ON the runner, as root.
#
#   ssh quince-runner 'sh -s' < deploy/runner/provision
#
# Everything here is idempotent and announces what it did rather than what it intended. What it
# CANNOT do is the login: a setup-token cannot establish Remote Control, so the Operator's
# interactive `claude auth login` is the only path — the script ends by saying exactly that.
set -eu

# --role arch provisions the architect box: same path, inverted identity assertion. The role is
# written into the service's conf so it survives restarts and reboots rather than living in the
# shell that happened to run this script.
ROLE=implementer
[ "${1:-}" = --role ] && { ROLE="${2:?--role needs a value}"; shift 2; }
case "$ROLE" in implementer|arch) ;; *) printf 'provision: unknown role %s\n' "$ROLE" >&2; exit 2 ;; esac
SERVICE_NAME="quince-runner"
[ "$ROLE" = arch ] && SERVICE_NAME="quince-arch"

REPO_URL="${REPO_URL:-https://github.com/novkostya/quince.git}"
RUNNER_DIR="${RUNNER_DIR:-/root/quince}"
# Verified at pin time from the Claude Code setup docs (2026-07-26). The apk repository is signed;
# this is the published checksum of the signing key, and provisioning refuses a key that does not
# match rather than trusting whatever it downloaded.
CLAUDE_APK_KEY_URL="https://downloads.claude.ai/keys/claude-code.rsa.pub"
CLAUDE_APK_KEY_SHA="395759c1f7449ef4cdef305a42e820f3c766d6090d142634ebdb049f113168b6"
CLAUDE_APK_REPO="https://downloads.claude.ai/claude-code/apk/stable"

say() { printf '==> %s\n' "$*"; }

# --- 1. base packages ------------------------------------------------------------------------
# ripgrep is a runtime dependency on musl, and the built-in one is disabled below per the docs.
say "installing base packages"
apk add --no-cache git make openssh-client curl bash ripgrep libgcc libstdc++ jq >/dev/null
say "base packages present"

# --- 2. Claude Code, from the signed apk repository -------------------------------------------
# The `stable` channel deliberately: apk installs do not auto-update, so the runner's version moves
# when someone runs an upgrade — which suits a project that pins toolchains and dislikes silent
# drift. `latest` is one line away if that trade is ever wrong.
if command -v claude >/dev/null 2>&1; then
	say "claude already installed ($(claude --version 2>/dev/null || echo '?'))"
else
	say "adding the Claude Code apk repository (signed)"
	wget -qO /etc/apk/keys/claude-code.rsa.pub "$CLAUDE_APK_KEY_URL"
	got=$(sha256sum /etc/apk/keys/claude-code.rsa.pub | cut -d' ' -f1)
	if [ "$got" != "$CLAUDE_APK_KEY_SHA" ]; then
		rm -f /etc/apk/keys/claude-code.rsa.pub
		printf 'provision: signing key checksum mismatch\n  expected %s\n  got      %s\nRefusing to add the repository.\n' \
			"$CLAUDE_APK_KEY_SHA" "$got" >&2
		exit 1
	fi
	say "signing key verified against the published checksum"
	grep -q "$CLAUDE_APK_REPO" /etc/apk/repositories || printf '%s\n' "$CLAUDE_APK_REPO" >>/etc/apk/repositories
	apk update >/dev/null
	apk add --no-cache claude-code >/dev/null
	say "claude installed ($(claude --version 2>/dev/null || echo '?'))"
fi

# --- 3. musl setting -------------------------------------------------------------------------
# On musl the bundled ripgrep is not used; the docs require pointing Claude Code at the system one.
mkdir -p /root/.claude
if [ -f /root/.claude/settings.json ]; then
	tmp=$(mktemp)
	jq '.env = ((.env // {}) + {"USE_BUILTIN_RIPGREP":"0"})' /root/.claude/settings.json >"$tmp" &&
		mv "$tmp" /root/.claude/settings.json
else
	printf '{\n  "env": { "USE_BUILTIN_RIPGREP": "0" }\n}\n' >/root/.claude/settings.json
fi
say "USE_BUILTIN_RIPGREP=0 set (musl: the system ripgrep is used)"

# --- 4. the launchpad ------------------------------------------------------------------------
# A pristine checkout used to START sessions. Never a workspace: every unit of work is a fresh
# clone elsewhere, so anything modified here is a finding rather than a habit.
if [ -d "$RUNNER_DIR/.git" ]; then
	git -C "$RUNNER_DIR" fetch -q origin main && git -C "$RUNNER_DIR" reset -q --hard origin/main
	say "launchpad updated at $RUNNER_DIR (pristine checkout — not a workspace)"
else
	git clone -q "$REPO_URL" "$RUNNER_DIR"
	say "launchpad cloned at $RUNNER_DIR (pristine checkout — not a workspace)"
fi

# --- 5. the service --------------------------------------------------------------------------
# PROVENANCE, and it is not decoration: the service file comes from the launchpad clone, which
# tracks main. So a fix merged into a branch reaches this box only after it LANDS and the launchpad
# is pulled — a runner can therefore be running a service that predates its own fix, which is
# exactly how a false "started" survived the commit that fixed it. Say which ref this came from so
# that situation is visible rather than puzzling.
_ref_sha=$(git -C "$RUNNER_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
_ref_name=$(git -C "$RUNNER_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
install -m 0755 "$RUNNER_DIR/deploy/runner/quince-runner.initd" "/etc/init.d/$SERVICE_NAME"
mkdir -p /etc/conf.d
printf 'runner_role="%s"\nrunner_name="%s"\n' "$ROLE" "$SERVICE_NAME" > "/etc/conf.d/$SERVICE_NAME"
rc-update add "$SERVICE_NAME" default >/dev/null 2>&1 || true
say "service $SERVICE_NAME (role $ROLE) installed from ${_ref_sha} (${_ref_name}) and added to the default runlevel"
if ! grep -q '^status()' "/etc/init.d/$SERVICE_NAME" 2>/dev/null; then
	say "note: this service file predates the status() override — 'rc-service status' will report"
	say "      the SUPERVISOR (started) rather than whether a session is alive. Pull the launchpad"
	say "      once that change is on main and re-run this script."
fi

# --- 6. report, including what is NOT done ----------------------------------------------------
printf '\n'
if QUINCE_RUNNER_ROLE="$ROLE" "$RUNNER_DIR/deploy/runner/preflight"; then
	printf '\n'
	say "environment is fit — but the session still needs YOUR login:"
else
	printf '\n'
	say "preflight is not satisfied yet (above); fix that, then:"
fi
cat <<'EOF'

    claude auth login          # full-scope claude.ai login. A setup-token CANNOT do Remote
                               # Control, so this interactive step is the only path.
    cd /root/quince && claude  # once, to accept workspace trust
    /config                    # enable "Push when Claude decides" and "Push when actions required"

  then:  rc-service quince-runner start

EOF
