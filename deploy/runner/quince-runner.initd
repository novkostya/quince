#!/sbin/openrc-run
# quince-runner — Claude Code Remote Control, supervised.
#
# OpenRC, not systemd: the dev template is Alpine (the Operator's ruling in pr.2 kept Alpine
# everywhere for dev/staging parity), and Alpine ships OpenRC with no systemd at all. The spec's
# first draft said "systemd unit"; that was wrong for this platform, found by looking at the box
# rather than at the spec.
#
# supervise-daemon gives the restart-always semantics this needs, and it needs them for a measured
# reason: a network outage of ~10 minutes times the session out and the PROCESS EXITS. Supervision
# here is correctness, not tidiness.

# From RC_SVCNAME, not hardcoded (quince#32). This one file is installed as BOTH
# /etc/init.d/quince-runner and /etc/init.d/quince-arch, so a literal name meant
# `rc-service quince-arch status` answered about a differently-named service — on a two-box design
# whose entire point is that the boxes are NOT interchangeable, and in a project whose canon says an
# error message is a claim. The fallback covers a hand run outside OpenRC, where RC_SVCNAME is unset.
name="${RC_SVCNAME:-quince-runner}"
description="Claude Code Remote Control session host"

: "${runner_dir:=/root/quince}"
: "${runner_name:=quince-runner}"
: "${runner_role:=implementer}"

supervisor=supervise-daemon
command="/usr/bin/claude"
command_args="remote-control --spawn same-dir --name ${runner_name}"
# The role travels to preflight through the environment, so the identity assertion a box makes is
# a property of the box rather than of whoever typed the start command.
export QUINCE_RUNNER_ROLE="${runner_role}"
command_user="root"
directory="${runner_dir}"
supervise_daemon_args="--respawn-delay 10 --respawn-max 0"
output_log="/var/log/quince-runner.log"
error_log="/var/log/quince-runner.log"

depend() {
	need net
	after firewall
}

start_pre() {
	# The environment is asserted before every start, not once at install: a variable added later
	# by a well-meaning edit is exactly how the billing trap would arrive.
	QUINCE_RUNNER_ROLE="${runner_role}" /root/quince/deploy/runner/preflight || return 1

	# A restart registers a NEW Remote Control session rather than resuming the old one. Say so,
	# because a log that implies continuity across a restart would be claiming something untrue.
	einfo "role=${runner_role}: starting a NEW Remote Control session (a restart never resumes the previous one)"
}

# `rc-service status` reports on the SUPERVISOR, so it says "started" while the supervised process
# crash-loops — which is exactly the claim-nobody-checked defect this project has canon about.
# Found by running it before the login ceremony: status said started, the log said "You must be
# logged in". So status answers the question a reader is actually asking: is a session up?
status() {
	if ! service_started; then
		einfo "${name}: stopped"
		return 3
	fi
	# Classify on the NEWEST lifecycle line in the session log, not on whether a bad string appears
	# anywhere in a fixed window (quince#101). The log is a state machine: a session starts, it may
	# end — `Session failed: Process exited with error …` is the NORMAL terminal event of every unit —
	# the supervisor reconnects, and it settles on the idle banner (`Ready …`, `Capacity: …`). The old
	# check had two defects. It decided on the last 20 lines and SHOWED the last 3, so the evidence
	# under the claim need not be the line that triggered it; and any `error|failed` in the window read
	# as a live failure, so a RECOVERED error — which every retirement leaves — kept a fit, idle box
	# reporting `failed` (exit 1) until twenty more lines scrolled past, on the one occasion the box is
	# most likely to be inspected. Deciding on the single newest lifecycle line fixes both: that line
	# IS the verdict AND the evidence, and a failure FOLLOWED BY a `Ready` is a recovery, not news.
	#
	# The markers are the session's own lifecycle, not arbitrary error text — an `error` in ordinary
	# task output must not read as a dead session, which was the over-broad `error|failed` match. Every
	# string here is one this box actually prints (quince#101's transcript). The `must be logged in`
	# state is folded into the same newest-wins pass, because it carried the identical window bug: a box
	# logged in AFTER an earlier `must be logged in` would otherwise still read as no-session.
	if [ -f "$output_log" ]; then
		_up='Ready|Capacity:|to show QR code|claude\.ai/code'
		_login='must be logged in'
		_fail='Session failed|Process exited with error'
		_newest=$(grep -nE "$_up|$_login|$_fail" "$output_log" 2>/dev/null | tail -n 1)
		case "${_newest#*:}" in
		*"$_login"*)
			ewarn "${name}: supervisor is up, but the newest session-log state is NO SESSION — not logged in."
			ewarn "  the ceremony is owed: claude auth login (a token cannot do Remote Control)"
			return 1
			;;
		esac
		# A failure line only when it is the newest state AND no up-marker sits on it — a line cannot be
		# both, but the guard states the rule rather than relying on the strings staying disjoint.
		if printf '%s\n' "$_newest" | grep -qE "$_fail" && ! printf '%s\n' "$_newest" | grep -qE "$_up"; then
			ewarn "${name}: supervisor is up, but the newest session-log state is a failure:"
			printf '%s\n' "$_newest" | sed 's/^[0-9]*:/    /'
			return 1
		fi
	fi
	einfo "${name}: supervisor up; the session log's newest state is healthy (no failure since)"
	return 0
}
