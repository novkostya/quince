{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/forge-watch",
            "args": ["owed", "--hook"],
            "timeout": 30,
            "statusMessage": "checking whether you owe a watch"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.config/quince/**)",
      "Bash(git push origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh repo delete *)"
    ],
    "allow": [
      "Bash(make help)",
      "Bash(make preflight)",
      "Bash(make privacy-check)",
      "Bash(make toolchains)",
      "Bash(make fmt)",
      "Bash(make gen-golden)",
      "Bash(make gates)",
      "Bash(make gates *)",
      "Bash(make gates-go)",
      "Bash(make gates-vault)",
      "Bash(make gates-ui)",
      "Bash(make gates-ui-e2e)",
      "Bash(make image)",
      "Bash(make image *)",
      "Bash(make push *)",
      "Bash(make clean)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git clone https://github.com/novkostya/*)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git push origin *)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh label *)",
      "Bash(gh-bot *)",
      "Bash(bin/gh-bot *)",
      "Bash(./bin/gh-bot *)",
      "Bash(gh-arch *)",
      "Bash(bin/gh-arch *)",
      "Bash(./bin/gh-arch *)",
      "Bash(bin/forge-watch *)",
      "Bash(./bin/forge-watch *)",
      "Bash(gh api repos/novkostya/*)",
      "Bash(gh api -X PATCH repos/novkostya/*)",
      "Bash(gh api -X POST repos/novkostya/*)",
      "Bash(nerdctl *)",
      "Bash(docker *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:endoflife.date)",
      "WebFetch(domain:*.alpinelinux.org)",
      "WebFetch(domain:*.libimobiledevice.org)",
      "WebFetch(domain:openzfs.github.io)",
      "Bash(ssh quince-dev-* *)",
      "Bash(scp * quince-dev-*:*)",
      "Bash(ssh quince-pve pct *)",
      "Bash(deploy/devct/devct *)",
      "Bash(deploy/devct/devct-template *)",
      "Bash(./deploy/devct/devct *)",
      "Bash(./deploy/devct/devct-template *)"
    ]
  }
}
