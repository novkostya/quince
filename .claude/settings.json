{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/forge-watch",
            "args": [
              "owed",
              "--hook"
            ],
            "timeout": 30,
            "statusMessage": "checking whether you owe a watch"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.config/quince/**)",
      "Bash(git push origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh repo delete *)"
    ],
    "allow": [
      "Bash(make help)",
      "Bash(make preflight)",
      "Bash(make privacy-check)",
      "Bash(make privacy-check *)",
      "Bash(make demo)",
      "Bash(make demo-stop)",
      "Bash(make toolchains)",
      "Bash(make fmt)",
      "Bash(make gen-golden)",
      "Bash(make gates)",
      "Bash(make gates *)",
      "Bash(make gates-go)",
      "Bash(make gates-vault)",
      "Bash(make gates-ui)",
      "Bash(make gates-ui-e2e)",
      "Bash(make image)",
      "Bash(make image *)",
      "Bash(make push *)",
      "Bash(make clean)",
      "Bash(make gates-sh)",
      "Bash(make forge-watch-test)",
      "Bash(make forge-watch-exits-test)",
      "Bash(make forge-watch-stop-test)",
      "Bash(make forge-watch-roundtrip-test)",
      "Bash(make forge-watch-ownership-test)",
      "Bash(make forge-watch-seats-test)",
      "Bash(make forge-watch-composition-test)",
      "Bash(make forge-watch-fixtures-doc-test)",
      "Bash(make gate-scope-test)",
      "Bash(make sh-lint-coverage-test)",
      "Bash(make privacy-check-test)",
      "Bash(make preflight-test)",
      "Bash(make provision-guard-test)",
      "Bash(make quince-runner-status-test)",
      "Bash(make scratch-reap-test)",
      "Bash(make home-resolution-test)",
      "Bash(make wrapper-boundary-test)",
      "Bash(make pr-title-refs-test)",
      "Bash(make pr-title-check)",
      "Bash(make pr-title-check *)",
      "Bash(make -C /root/scratch/* *)",
